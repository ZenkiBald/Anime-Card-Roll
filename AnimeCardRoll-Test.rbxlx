          <string name="Name">BossModels</string>
          <string name="Source"><![CDATA[--!strict
-- Blocky NPC figures built from plain parts (no meshes, textures or uploads), shared so the
-- hub NPCs and the battle screen's 3D boss portrait are the same model.
-- Models stand on y = 0 and face -Z; their PrimaryPart is an invisible "Root" at the waist.

local BossModels = {}

export type Look = {
	Scale: number,
	Skin: Color3,
	Body: Color3,
	Arms: Color3,
	Legs: Color3,
	Trim: Color3, -- neon accents
	Eyes: Color3,
}

local LOOKS: { [string]: Look } = {
	kurogane = {
		Scale = 1.7,
		Skin = Color3.fromRGB(214, 170, 132),
		Body = Color3.fromRGB(64, 60, 70),
		Arms = Color3.fromRGB(52, 48, 58),
		Legs = Color3.fromRGB(34, 30, 38),
		Trim = Color3.fromRGB(255, 104, 56),
		Eyes = Color3.fromRGB(255, 150, 60),
	},
	rimeveil = {
		Scale = 1.75,
		Skin = Color3.fromRGB(214, 232, 248),
		Body = Color3.fromRGB(110, 180, 236),
		Arms = Color3.fromRGB(188, 222, 246),
		Legs = Color3.fromRGB(70, 140, 220),
		Trim = Color3.fromRGB(150, 236, 255),
		Eyes = Color3.fromRGB(140, 240, 255),
	},
	vex = {
		Scale = 1.85,
		Skin = Color3.fromRGB(70, 60, 92),
		Body = Color3.fromRGB(26, 22, 36),
		Arms = Color3.fromRGB(34, 28, 46),
		Legs = Color3.fromRGB(20, 16, 28),
		Trim = Color3.fromRGB(220, 70, 255),
		Eyes = Color3.fromRGB(255, 90, 240),
	},
	sage = {
		Scale = 1,
		Skin = Color3.fromRGB(226, 186, 150),
		Body = Color3.fromRGB(70, 150, 120),
		Arms = Color3.fromRGB(60, 130, 104),
		Legs = Color3.fromRGB(46, 70, 66),
		Trim = Color3.fromRGB(255, 214, 120),
		Eyes = Color3.fromRGB(40, 30, 30),
	},
}

local function add(
	model: Model,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	if shape then
		part.Shape = shape
	end
	part.Parent = model
	return part
end

local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- stands a cylinder on its end

-- The shared body: legs, torso, arms, rounded head and glowing eyes.
local function body(model: Model, look: Look, skirt: boolean)
	local s = look.Scale
	local function v(x: number, y: number, z: number): Vector3
		return Vector3.new(x * s, y * s, z * s)
	end
	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x * s, y * s, z * s)
	end
	if skirt then
		add(model, "Skirt", v(2.6, 2.1, 1.7), at(0, 1.05, 0), look.Legs)
		add(model, "Hem", v(2.7, 0.18, 1.8), at(0, 0.12, 0), look.Trim, Enum.Material.Neon)
	else
		add(model, "LeftLeg", v(0.95, 2, 1), at(-0.5, 1, 0), look.Legs)
		add(model, "RightLeg", v(0.95, 2, 1), at(0.5, 1, 0), look.Legs)
	end
	add(model, "Torso", v(2, 2, 1), at(0, 3, 0), look.Body)
	add(model, "LeftArm", v(1, 2, 1), at(-1.5, 3, 0), look.Arms)
	add(model, "RightArm", v(1, 2, 1), at(1.5, 3, 0), look.Arms)
	add(model, "LeftHand", v(0.9, 0.5, 0.9), at(-1.5, 1.85, 0), look.Skin)
	add(model, "RightHand", v(0.9, 0.5, 0.9), at(1.5, 1.85, 0), look.Skin)
	add(model, "Head", v(1.3, 1.3, 1.3), at(0, 4.62, 0), look.Skin, nil, Enum.PartType.Ball)
	add(model, "LeftEye", v(0.26, 0.14, 0.05), at(-0.27, 4.68, -0.64), look.Eyes, Enum.Material.Neon)
	add(model, "RightEye", v(0.26, 0.14, 0.05), at(0.27, 4.68, -0.64), look.Eyes, Enum.Material.Neon)
end

local function kurogane(model: Model, look: Look)
	local s = look.Scale
	local function v(x: number, y: number, z: number): Vector3
		return Vector3.new(x * s, y * s, z * s)
	end
	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x * s, y * s, z * s)
	end
	body(model, look, false)
	-- Red sash, open robe collar, straw hat, katana at the hip.
	add(model, "Sash", v(2.06, 0.34, 1.06), at(0, 2.2, 0), look.Trim, Enum.Material.Neon)
	add(model, "Collar", v(0.5, 1.4, 0.05), at(0, 3.4, -0.52) * CFrame.Angles(0, 0, math.rad(20)), Color3.fromRGB(150, 40, 30))
	add(model, "HatBrim", v(0.18, 3.6, 3.6), at(0, 5.28, 0) * FLAT, Color3.fromRGB(196, 158, 92), nil, Enum.PartType.Cylinder)
	add(model, "HatTop", v(0.55, 1.5, 1.5), at(0, 5.6, 0) * FLAT, Color3.fromRGB(176, 140, 80), nil, Enum.PartType.Cylinder)
	add(model, "HatBand", v(0.16, 1.56, 1.56), at(0, 5.42, 0) * FLAT, look.Trim, Enum.Material.Neon, Enum.PartType.Cylinder)
	local hip = at(-1.15, 2.2, -0.3) * CFrame.Angles(math.rad(-65), 0, math.rad(-10))
	add(model, "Hilt", v(0.22, 0.22, 1.1), hip * CFrame.new(0, 0, 0.9 * s), Color3.fromRGB(30, 26, 30))
	add(model, "Guard", v(0.5, 0.5, 0.1), hip * CFrame.new(0, 0, 0.32 * s), look.Trim, Enum.Material.Neon)
	add(model, "Blade", v(0.12, 0.26, 3.4), hip * CFrame.new(0, 0, -1.4 * s), Color3.fromRGB(210, 214, 224), Enum.Material.Metal)
	add(model, "Edge", v(0.06, 0.06, 3.3), hip * CFrame.new(0, -0.14 * s, -1.4 * s), look.Trim, Enum.Material.Neon)
end

local function rimeveil(model: Model, look: Look)
	local s = look.Scale
	local function v(x: number, y: number, z: number): Vector3
		return Vector3.new(x * s, y * s, z * s)
	end
	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x * s, y * s, z * s)
	end
	body(model, look, true)
	-- Long frost hair, ice crown, shoulder shards, a staff of ice.
	add(model, "Hair", v(1.5, 2.2, 0.5), at(0, 4.1, 0.55), Color3.fromRGB(230, 244, 255))
	add(model, "Fringe", v(1.45, 0.4, 1.3), at(0, 5.2, 0.02), Color3.fromRGB(230, 244, 255))
	for i, x in { -0.5, -0.25, 0, 0.25, 0.5 } do
		local height = if i == 3 then 1.1 elseif i == 2 or i == 4 then 0.8 else 0.55
		add(model, `Crown{i}`, v(0.16, height, 0.16), at(x, 5.4 + height / 2, -0.1), look.Trim, Enum.Material.Neon)
	end
	for _, side in { -1, 1 } do
		add(
			model,
			"Shard",
			v(0.4, 1.3, 0.4),
			at(side * 1.75, 4.35, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)),
			look.Trim,
			Enum.Material.Neon
		)
	end
	add(model, "Staff", v(0.18, 5.2, 0.18), at(2.15, 2.6, -0.3), Color3.fromRGB(200, 230, 255), Enum.Material.Glass)
	add(model, "StaffGem", v(0.6, 0.9, 0.6), at(2.15, 5.5, -0.3) * CFrame.Angles(0, math.rad(45), 0), look.Trim, Enum.Material.Neon)
end

local function vex(model: Model, look: Look)
	local s = look.Scale
	local function v(x: number, y: number, z: number): Vector3
		return Vector3.new(x * s, y * s, z * s)
	end
	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x * s, y * s, z * s)
	end
	body(model, look, false)
	-- Armour trims, pauldrons, a long cape and a halo of void shards.
	add(model, "ChestTrim", v(0.18, 1.8, 0.05), at(0, 3, -0.52), look.Trim, Enum.Material.Neon)
	add(model, "BeltTrim", v(2.06, 0.14, 1.06), at(0, 2.1, 0), look.Trim, Enum.Material.Neon)
	for _, side in { -1, 1 } do
		add(model, "Pauldron", v(1.5, 0.6, 1.4), at(side * 1.6, 4.1, 0), Color3.fromRGB(40, 32, 56))
		add(model, "PauldronGlow", v(1.52, 0.12, 1.42), at(side * 1.6, 3.82, 0), look.Trim, Enum.Material.Neon)
	end
	add(model, "Cape", v(2.3, 3.8, 0.14), at(0, 2.5, 0.62), Color3.fromRGB(60, 16, 84))
	add(model, "Visor", v(1.2, 0.22, 0.08), at(0, 4.68, -0.66), look.Trim, Enum.Material.Neon)
	for i = 1, 8 do
		local angle = (i - 1) / 8 * math.pi * 2
		add(
			model,
			`Halo{i}`,
			v(0.32, 0.32, 0.32),
			at(math.cos(angle) * 1.25, 4.9 + math.sin(angle) * 1.25, 0.9) * CFrame.Angles(0, 0, angle),
			look.Trim,
			Enum.Material.Neon
		)
	end
end

local function sage(model: Model, look: Look)
	local s = look.Scale
	local function v(x: number, y: number, z: number): Vector3
		return Vector3.new(x * s, y * s, z * s)
	end
	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x * s, y * s, z * s)
	end
	body(model, look, true)
	-- White beard, round hat, a glowing card in hand.
	add(model, "Beard", v(0.9, 0.9, 0.3), at(0, 4.05, -0.6), Color3.fromRGB(240, 240, 236))
	add(model, "Hat", v(0.5, 1.7, 1.7), at(0, 5.3, 0) * FLAT, Color3.fromRGB(60, 50, 40), nil, Enum.PartType.Cylinder)
	add(model, "HatBand", v(0.14, 1.74, 1.74), at(0, 5.12, 0) * FLAT, look.Trim, Enum.Material.Neon, Enum.PartType.Cylinder)
	add(model, "Card", v(0.7, 1, 0.06), at(1.5, 1.9, -0.6) * CFrame.Angles(0, 0, math.rad(-12)), look.Trim, Enum.Material.Neon)
end

local BUILDERS: { [string]: (Model, Look) -> () } = {
	kurogane = kurogane,
	rimeveil = rimeveil,
	vex = vex,
	sage = sage,
}

function BossModels.Has(id: string): boolean
	return LOOKS[id] ~= nil
end

function BossModels.Height(id: string): number
	local look = LOOKS[id]
	return (if look then look.Scale else 1) * 6
end

-- Builds the figure for a boss id (or "sage"). Unknown ids get a plain figure.
function BossModels.Build(id: string): Model
	local look = LOOKS[id] or LOOKS.sage
	local model = Instance.new("Model")
	model.Name = id
	local root = add(model, "Root", Vector3.new(1, 1, 1) * look.Scale, CFrame.new(0, 3 * look.Scale, 0), Color3.new(1, 1, 1))
	root.Transparency = 1
	model.PrimaryPart = root
	local build: (Model, Look) -> () = BUILDERS[id] or sage
	build(model, look)
	return model
end

return BossModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Bosses</string>
          <string name="Source"><![CDATA[--!strict
-- World bosses. A new boss or difficulty is one entry here; the battle engine reads it as data.
-- Boss models for the hub and the battle screen are built from BossModels.luau.
--
-- Moves are checked top to bottom each time the boss acts; the first one that is due is used,
-- and the last move (no Every) is the default. Every = N fires on every Nth boss action
-- (counted from the start of its phase). Warn = true shows a warning marker first
-- (Difficulty.WarnSeconds long). MinDifficulty = "Hard" adds the move on Hard and Nightmare only.
-- Target: Single (a random Attack card, or the taunting one) | Random (each hit picks again) | All | Self.
-- Pct is a share of the boss's ATK. Optional riders on each hit:
--   Burn = { Pct, Turns }   damage over time      Freeze = true   the card skips its next action
--   Slow = { Amount, Turns } every card loses SPD  Barrier = share of max HP (Target Self): only
--   Skills and Ultimates break it, everything else deals Config.Battle.BarrierLeak of its damage.
-- OnPhase.Steal: at 50% and 20% HP the boss steals the biggest buff from each Attack card and gains ATK.

export type Burn = { Pct: number, Turns: number }
export type Slow = { Amount: number, Turns: number }

export type Move = {
	Name: string,
	Target: string,
	Pct: number,
	Hits: number?,
	Every: number?,
	Phase: number?, -- 2 = only from 50% HP
	MinDifficulty: string?,
	Warn: boolean?,
	Burn: Burn?,
	Freeze: boolean?,
	Slow: Slow?,
	Barrier: number?,
}

export type Difficulty = {
	D: number, -- difficulty score: rewards scale with it (Rewards.luau)
	Recommended: number, -- recommended Deck Power
	HP: number,
	ATK: number,
	WarnSeconds: number,
}

export type Boss = {
	Id: string,
	World: number,
	WorldName: string,
	Name: string,
	Title: string,
	Glyph: string,
	Accent: Color3, -- main colour
	Deep: Color3, -- dark backdrop colour for the world
	Particles: string, -- battle backdrop: Embers | Snow | Motes
	Mechanic: string,
	DEF: number, -- 0 to 0.4
	SPD: number,
	OnPhase: { Steal: number? }?,
	Moves: { Move },
	Difficulties: { [string]: Difficulty },
}

local Bosses = {}

Bosses.DifficultyOrder = { "Normal", "Hard", "Nightmare" }

-- HP / ATK per difficulty are tuned with tests/battle_test.luau so a deck at the recommended
-- power wins in 60-90 seconds and usually loses a card or two on the way.
local list: { Boss } = {
	{
		Id = "kurogane",
		World = 1,
		WorldName = "Ember Village",
		Name = "Kurogane",
		Title = "the Ash Ronin",
		Glyph = "KG",
		Accent = Color3.fromRGB(255, 104, 56),
		Deep = Color3.fromRGB(70, 22, 14),
		Particles = "Embers",
		Mechanic = "His hits Burn their target. At 50% HP he adds Ash Storm, which hits every Attack card.",
		DEF = 0.1,
		SPD = 95,
		Moves = {
			{ Name = "Ash Storm", Target = "All", Pct = 0.55, Every = 4, Phase = 2, Warn = true, Burn = { Pct = 0.1, Turns = 2 } },
			{ Name = "Twin Ember", Target = "Single", Pct = 0.8, Hits = 2, Every = 6, MinDifficulty = "Hard", Burn = { Pct = 0.1, Turns = 2 } },
			{ Name = "Ember Iaido", Target = "Single", Pct = 2.2, Every = 5, Warn = true, Burn = { Pct = 0.15, Turns = 2 } },
			{ Name = "Ash Cut", Target = "Single", Pct = 1, Burn = { Pct = 0.15, Turns = 2 } },
		},
		Difficulties = {
			Normal = { D = 1, Recommended = 12000, HP = 21000, ATK = 120, WarnSeconds = 2 },
			Hard = { D = 2, Recommended = 18000, HP = 28000, ATK = 145, WarnSeconds = 2 },
			Nightmare = { D = 3, Recommended = 24000, HP = 63500, ATK = 270, WarnSeconds = 1 },
		},
	},
	{
		Id = "rimeveil",
		World = 2,
		WorldName = "Frostfang Peaks",
		Name = "Rimeveil",
		Title = "the Glacier Queen",
		Glyph = "RV",
		Accent = Color3.fromRGB(120, 210, 255),
		Deep = Color3.fromRGB(12, 30, 62),
		Particles = "Snow",
		Mechanic = "Rime Spear Freezes a card so it skips its next action. At 50% HP Glacier Veil slows your whole deck.",
		DEF = 0.15,
		SPD = 100,
		Moves = {
			{ Name = "Glacier Veil", Target = "All", Pct = 0.45, Every = 4, Phase = 2, Warn = true, Slow = { Amount = 0.25, Turns = 3 } },
			{ Name = "Hailstorm", Target = "Random", Pct = 0.7, Hits = 3, Every = 6, MinDifficulty = "Hard", Freeze = true },
			{ Name = "Rime Spear", Target = "Single", Pct = 1.8, Every = 4, Warn = true, Freeze = true },
			{ Name = "Ice Shard", Target = "Single", Pct = 1 },
		},
		Difficulties = {
			Normal = { D = 4, Recommended = 28000, HP = 57000, ATK = 360, WarnSeconds = 2 },
			Hard = { D = 5, Recommended = 42000, HP = 182000, ATK = 445, WarnSeconds = 2 },
			Nightmare = { D = 6, Recommended = 56000, HP = 249000, ATK = 595, WarnSeconds = 1 },
		},
	},
	{
		Id = "vex",
		World = 3,
		WorldName = "Neon Abyss",
		Name = "Null Emperor Vex",
		Title = "the Void Tyrant",
		Glyph = "VX",
		Accent = Color3.fromRGB(220, 70, 255),
		Deep = Color3.fromRGB(26, 8, 44),
		Particles = "Motes",
		Mechanic = "Null Barrier blocks most damage until Skills or Ultimates break it. At 50% and 20% HP he steals your buffs.",
		DEF = 0.2,
		SPD = 105,
		OnPhase = { Steal = 0.1 },
		Moves = {
			{ Name = "Collapse", Target = "All", Pct = 0.6, Every = 4, Phase = 2, Warn = true },
			{ Name = "Zero Point", Target = "Single", Pct = 3, Every = 7, MinDifficulty = "Hard", Warn = true },
			{ Name = "Null Barrier", Target = "Self", Pct = 0, Every = 5, Barrier = 0.06 },
			{ Name = "Void Slash", Target = "Single", Pct = 1 },
		},
		Difficulties = {
			Normal = { D = 7, Recommended = 50000, HP = 190000, ATK = 700, WarnSeconds = 2 },
			Hard = { D = 8, Recommended = 75000, HP = 546000, ATK = 760, WarnSeconds = 2 },
			Nightmare = { D = 9, Recommended = 100000, HP = 1500000, ATK = 1000, WarnSeconds = 1 },
		},
	},
}

Bosses.List = list
Bosses.ById = {} :: { [string]: Boss }
for _, boss in list do
	assert(Bosses.ById[boss.Id] == nil, `Duplicate boss id "{boss.Id}"`)
	Bosses.ById[boss.Id] = boss
end

function Bosses.Get(id: string): Boss?
	return Bosses.ById[id]
end

-- "kurogane:Normal": the key for saved clears and best times.
function Bosses.FightKey(bossId: string, difficulty: string): string
	return `{bossId}:{difficulty}`
end

function Bosses.DifficultyIndex(difficulty: string): number
	return table.find(Bosses.DifficultyOrder, difficulty) or 1
end

-- Progression: Normal needs the previous world's Normal; Hard and Nightmare need the
-- difficulty below on the same boss. `cleared` is the saved Progress.Cleared table.
function Bosses.IsUnlocked(cleared: { [string]: boolean }, bossId: string, difficulty: string): boolean
	local boss = Bosses.Get(bossId)
	if boss == nil then
		return false
	end
	local index = Bosses.DifficultyIndex(difficulty)
	if index > 1 then
		return cleared[Bosses.FightKey(bossId, Bosses.DifficultyOrder[index - 1])] == true
	end
	for _, other in list do
		if other.World == boss.World - 1 then
			return cleared[Bosses.FightKey(other.Id, "Normal")] == true
		end
	end
	return true
end

-- What the player must beat first, for the locked label.
function Bosses.UnlockHint(bossId: string, difficulty: string): string
	local boss = Bosses.Get(bossId)
	if boss == nil then
		return ""
	end
	local index = Bosses.DifficultyIndex(difficulty)
	if index > 1 then
		return `Beat {boss.Name} on {Bosses.DifficultyOrder[index - 1]}`
	end
	for _, other in list do
		if other.World == boss.World - 1 then
			return `Beat {other.Name} on Normal`
		end
	end
	return ""
end

return Bosses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">CardArt</string>
          <string name="Source"><![CDATA[--!strict
-- Card character art: a chibi figure built from plain parts (no meshes, textures or uploads),
-- drawn on the card in a ViewportFrame. Each card's look is data (Card.Look in Cards.luau):
-- colours, a hair style, something on the head, a prop and an optional aura.
-- Figures stand on y = 0 and face -Z.

local Cards = require(script.Parent.Cards)

type Look = Cards.Look

local CardArt = {}

local DARK = Color3.fromRGB(34, 28, 40)
local WHITE = Color3.fromRGB(250, 250, 255)
local METAL = Color3.fromRGB(205, 210, 222)
local NEON = Enum.Material.Neon

local function part(model: Model, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = model
	return p
end

local function ball(model: Model, name: string, diameter: number, at: Vector3, color: Color3, material: Enum.Material?): Part
	return part(model, name, Vector3.one * diameter, CFrame.new(at), color, material, Enum.PartType.Ball)
end

-- A round disc facing the camera (cylinder turned to point along Z).
local FACING = CFrame.Angles(0, math.rad(90), 0)
local function disc(model: Model, name: string, diameter: number, at: Vector3, color: Color3, material: Enum.Material?, transparency: number?): Part
	local p = part(model, name, Vector3.new(0.05, diameter, diameter), CFrame.new(at) * FACING, color, material, Enum.PartType.Cylinder)
	p.Transparency = transparency or 0
	return p
end

-- A flat disc lying level (cylinder turned to point up).
local LEVEL = CFrame.Angles(0, 0, math.rad(90))
local function plate(model: Model, name: string, thickness: number, diameter: number, at: Vector3, color: Color3, material: Enum.Material?): Part
	return part(model, name, Vector3.new(thickness, diameter, diameter), CFrame.new(at) * LEVEL, color, material, Enum.PartType.Cylinder)
end

local function rot(x: number, y: number, z: number): CFrame
	return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

local HEAD = Vector3.new(0, 2.95, 0)

local function body(model: Model, look: Look)
	-- Legs and shoes.
	for _, x in { -0.3, 0.3 } do
		part(model, "Leg", Vector3.new(0.52, 0.8, 0.58), CFrame.new(x, 0.42, 0), look.Outfit2)
		part(model, "Shoe", Vector3.new(0.58, 0.24, 0.74), CFrame.new(x, 0.12, -0.06), DARK)
	end
	-- Torso with a belt and a chest mark.
	part(model, "Torso", Vector3.new(1.3, 1.15, 0.8), CFrame.new(0, 1.38, 0), look.Outfit)
	part(model, "Belt", Vector3.new(1.34, 0.18, 0.84), CFrame.new(0, 0.9, 0), look.Trim)
	part(model, "Chest", Vector3.new(0.42, 0.42, 0.05), CFrame.new(0, 1.6, -0.42) * rot(0, 0, 45), look.Trim)
	-- Arms and hands.
	for _, side in { -1, 1 } do
		part(model, "Arm", Vector3.new(0.42, 0.95, 0.48), CFrame.new(side * 0.86, 1.4, 0) * rot(0, 0, side * 12), look.Outfit2)
		ball(model, "Hand", 0.46, Vector3.new(side * 0.98, 0.88, 0), look.Skin)
	end
	-- Big head with anime eyes, blush and a small mouth.
	ball(model, "Head", 2.1, HEAD, look.Skin)
	for i, x in { -0.4, 0.4 } do
		disc(model, "EyeWhite", 0.5, Vector3.new(x, 2.86, -0.99), WHITE)
		local glowing = look.GlowEye == true and i == 1
		disc(model, "Iris", 0.37, Vector3.new(x, 2.84, -1.02), if glowing then Color3.fromRGB(255, 200, 60) else look.Eyes, if glowing then NEON else nil)
		disc(model, "Pupil", 0.17, Vector3.new(x, 2.82, -1.04), DARK)
		disc(model, "Shine", 0.12, Vector3.new(x + 0.08, 2.96, -1.06), WHITE, NEON)
		disc(model, "Blush", 0.26, Vector3.new(x * 1.55, 2.58, -0.8), Color3.fromRGB(255, 140, 160), nil, 0.45)
	end
	part(model, "Mouth", Vector3.new(0.2, 0.05, 0.04), CFrame.new(0, 2.42, -1.0), Color3.fromRGB(150, 60, 70))
end

local function fringe(model: Model, look: Look)
	for i, x in { -0.45, 0, 0.45 } do
		part(model, "Fringe", Vector3.new(0.42, 0.55, 0.3), CFrame.new(x, 3.62, -0.86) * rot(-18, 0, (i - 2) * -14), look.Hair)
	end
end

local STYLES: { [string]: (Model, Look) -> () } = {
	Spiky = function(model, look)
		local spikes: { CFrame } = {
			CFrame.new(0, 4.2, 0.1),
			CFrame.new(-0.62, 4.02, 0.2) * rot(0, 0, 32),
			CFrame.new(0.62, 4.02, 0.2) * rot(0, 0, -32),
			CFrame.new(-1.0, 3.6, 0.3) * rot(0, 0, 58),
			CFrame.new(1.0, 3.6, 0.3) * rot(0, 0, -58),
			CFrame.new(0, 3.75, 0.95) * rot(-52, 0, 0),
		}
		for _, spike in spikes do
			part(model, "Spike", Vector3.new(0.42, 1.05, 0.42), spike * rot(0, 45, 0), look.Hair)
		end
		fringe(model, look)
	end,
	Long = function(model, look)
		part(model, "Back", Vector3.new(1.9, 2.4, 0.45), CFrame.new(0, 2.45, 0.78), look.Hair)
		for _, side in { -1, 1 } do
			part(model, "Lock", Vector3.new(0.42, 1.8, 0.45), CFrame.new(side * 1.0, 2.4, -0.15) * rot(0, 0, side * -4), look.Hair)
		end
		fringe(model, look)
	end,
	Bob = function(model, look)
		for _, side in { -1, 1 } do
			part(model, "Side", Vector3.new(0.5, 1.3, 1.5), CFrame.new(side * 0.95, 2.72, 0.08), look.Hair)
		end
		fringe(model, look)
	end,
	Ponytail = function(model, look)
		part(model, "Tail", Vector3.new(0.52, 1.6, 0.52), CFrame.new(0, 2.95, 1.32) * rot(28, 0, 0), look.Hair)
		ball(model, "Tie", 0.4, Vector3.new(0, 3.62, 1.12), look.Trim)
		fringe(model, look)
	end,
	Twin = function(model, look)
		for _, side in { -1, 1 } do
			part(model, "Tail", Vector3.new(0.5, 1.7, 0.5), CFrame.new(side * 1.3, 2.6, 0.2) * rot(0, 0, side * 16), look.Hair)
			ball(model, "Tie", 0.36, Vector3.new(side * 1.12, 3.42, 0.2), look.Trim)
		end
		fringe(model, look)
	end,
	Swept = function(model, look)
		part(model, "Sweep", Vector3.new(1.3, 0.5, 1.7), CFrame.new(-0.45, 3.78, -0.25) * rot(0, 0, 18), look.Hair)
		part(model, "Lock", Vector3.new(0.42, 1.3, 0.45), CFrame.new(-1.0, 2.7, -0.2), look.Hair)
		part(model, "Back", Vector3.new(1.6, 0.9, 0.4), CFrame.new(0.2, 3.1, 0.95) * rot(-20, 0, -10), look.Hair)
	end,
	Short = function(model, look)
		fringe(model, look)
	end,
}

local HEADWEAR: { [string]: (Model, Look) -> () } = {
	Headband = function(model, look)
		plate(model, "Band", 0.26, 2.2, Vector3.new(0, 3.28, 0), look.Trim)
		part(model, "Knot", Vector3.new(0.2, 0.7, 0.12), CFrame.new(0.25, 3.0, 1.12) * rot(0, 0, -25), look.Trim)
	end,
	Witch = function(model, look)
		plate(model, "Brim", 0.14, 3.3, Vector3.new(0, 3.98, 0), DARK)
		plate(model, "Band", 0.22, 1.75, Vector3.new(0, 4.15, 0), look.Trim, NEON)
		local base = CFrame.new(0, 4.1, 0.05) * rot(-12, 0, 0)
		for i, size in { 1.7, 1.25, 0.85, 0.45 } do
			part(model, "Cone", Vector3.new(0.5, size, size), base * CFrame.new(0, i * 0.42, 0) * LEVEL, DARK, nil, Enum.PartType.Cylinder)
		end
		ball(model, "Star", 0.3, (base * CFrame.new(0, 2.05, 0)).Position, look.Trim, NEON)
	end,
	Crown = function(model, look)
		plate(model, "Ring", 0.2, 1.3, Vector3.new(0, 4.05, 0), look.Trim, NEON)
		for i = 1, 5 do
			local angle = (i - 1) / 5 * math.pi * 2
			part(model, "Spike", Vector3.new(0.18, 0.5, 0.18), CFrame.new(math.cos(angle) * 0.55, 4.35, math.sin(angle) * 0.55), look.Trim, NEON)
		end
	end,
	Halo = function(model, look)
		for i = 1, 12 do
			local angle = (i - 1) / 12 * math.pi * 2
			part(model, "Halo", Vector3.new(0.2, 0.12, 0.2), CFrame.new(math.cos(angle) * 0.85, 4.55, math.sin(angle) * 0.85), look.Trim, NEON)
		end
	end,
	Horns = function(model, look)
		for _, side in { -1, 1 } do
			part(model, "Horn", Vector3.new(0.26, 0.95, 0.26), CFrame.new(side * 0.58, 4.12, 0) * rot(0, 0, side * -24), DARK)
			part(model, "Tip", Vector3.new(0.2, 0.3, 0.2), CFrame.new(side * 0.78, 4.55, 0) * rot(0, 0, side * -24), look.Trim, NEON)
		end
	end,
	Helmet = function(model, look)
		ball(model, "Helmet", 2.3, Vector3.new(0, 3.25, 0.1), METAL, Enum.Material.Metal)
		part(model, "Crest", Vector3.new(0.2, 0.6, 1.5), CFrame.new(0, 4.35, 0.1), look.Trim)
	end,
	Hood = function(model, look)
		ball(model, "Hood", 2.4, Vector3.new(0, 3.15, 0.3), look.Outfit)
	end,
	Straw = function(model, look)
		plate(model, "Brim", 0.14, 3.5, Vector3.new(0, 4.0, 0), Color3.fromRGB(196, 158, 92))
		plate(model, "Top", 0.45, 1.5, Vector3.new(0, 4.25, 0), Color3.fromRGB(176, 140, 80))
		plate(model, "Band", 0.14, 1.56, Vector3.new(0, 4.1, 0), look.Trim)
	end,
	Flower = function(model, look)
		for i, offset in { Vector3.new(0, 0, 0), Vector3.new(0.28, 0.12, 0.05), Vector3.new(0.1, -0.25, 0.05) } do
			ball(model, `Petal{i}`, 0.36, Vector3.new(0.85, 3.62, -0.42) + offset, Color3.fromRGB(255, 150, 200), NEON)
		end
	end,
	Glasses = function(model, look)
		for _, x in { -0.4, 0.4 } do
			disc(model, "Lens", 0.62, Vector3.new(x, 2.86, -1.09), Color3.fromRGB(200, 230, 255), Enum.Material.Glass, 0.6)
		end
		part(model, "Bridge", Vector3.new(0.3, 0.06, 0.04), CFrame.new(0, 2.92, -1.1), DARK)
	end,
	Mask = function(model, look)
		part(model, "Mask", Vector3.new(1.62, 0.52, 0.5), CFrame.new(0, 2.45, -0.74), look.Trim)
	end,
}

local function hold(at: Vector3, tilt: number): CFrame
	return CFrame.new(at) * rot(0, 0, tilt)
end

local PROPS: { [string]: (Model, Look, Color3) -> () } = {
	Fists = function(model, look, color)
		for _, side in { -1, 1 } do
			ball(model, "Fist", 0.66, Vector3.new(side * 0.72, 1.55, -0.62), look.Skin)
			part(model, "Wrap", Vector3.new(0.5, 0.2, 0.5), CFrame.new(side * 0.72, 1.3, -0.62), WHITE)
		end
	end,
	Kunai = function(model, look, color)
		for _, side in { -1, 1 } do
			local grip = hold(Vector3.new(side * 0.98, 1.25, -0.45), side * -35)
			part(model, "Blade", Vector3.new(0.1, 0.75, 0.05), grip * CFrame.new(0, 0.55, 0), METAL, Enum.Material.Metal)
			part(model, "Ring", Vector3.new(0.18, 0.18, 0.05), grip * CFrame.new(0, -0.1, 0), color, NEON)
		end
	end,
	Sword = function(model, look, color)
		local grip = hold(Vector3.new(1.12, 1.05, -0.2), -24)
		part(model, "Blade", Vector3.new(0.16, 2.7, 0.06), grip * CFrame.new(0, 1.6, 0), METAL, Enum.Material.Metal)
		part(model, "Edge", Vector3.new(0.05, 2.6, 0.07), grip * CFrame.new(0.07, 1.6, 0), color, NEON)
		part(model, "Guard", Vector3.new(0.55, 0.12, 0.2), grip * CFrame.new(0, 0.25, 0), color)
		part(model, "Hilt", Vector3.new(0.12, 0.5, 0.12), grip, DARK)
	end,
	Katana = function(model, look, color)
		local grip = hold(Vector3.new(1.1, 1.0, -0.2), -30)
		part(model, "Blade", Vector3.new(0.12, 2.9, 0.05), grip * CFrame.new(0, 1.7, 0) * rot(0, 0, -3), METAL, Enum.Material.Metal)
		part(model, "Tsuba", Vector3.new(0.4, 0.08, 0.4), grip * CFrame.new(0, 0.25, 0), color, NEON)
		part(model, "Hilt", Vector3.new(0.12, 0.6, 0.12), grip, DARK)
		part(model, "Sheath", Vector3.new(0.16, 2.4, 0.16), CFrame.new(-0.75, 1.0, 0.45) * rot(20, 0, 60), DARK)
	end,
	Lance = function(model, look, color)
		local grip = hold(Vector3.new(1.12, 2.0, -0.15), -8)
		part(model, "Shaft", Vector3.new(0.14, 4.2, 0.14), grip, color)
		part(model, "Tip", Vector3.new(0.34, 0.9, 0.12), grip * CFrame.new(0, 2.5, 0) * rot(0, 0, 45), METAL, Enum.Material.Metal)
		part(model, "Tassel", Vector3.new(0.3, 0.3, 0.1), grip * CFrame.new(0, 1.95, 0), color, NEON)
	end,
	Bow = function(model, look, color)
		for i = -2, 2 do
			local angle = i * 22
			local at = Vector3.new(-1.25 - math.cos(math.rad(angle)) * 0.4 + 0.4, 1.9 + math.sin(math.rad(angle)) * 1.1, -0.4)
			part(model, "Limb", Vector3.new(0.14, 0.62, 0.14), CFrame.new(at) * rot(0, 0, angle), color)
		end
		part(model, "String", Vector3.new(0.03, 2.3, 0.03), CFrame.new(-0.9, 1.9, -0.4), WHITE, NEON)
	end,
	Staff = function(model, look, color)
		local grip = hold(Vector3.new(1.12, 1.8, -0.1), -6)
		part(model, "Shaft", Vector3.new(0.13, 3.6, 0.13), grip, Color3.fromRGB(120, 86, 60))
		ball(model, "Gem", 0.58, (grip * CFrame.new(0, 1.95, 0)).Position, color, NEON)
	end,
	Shield = function(model, look, color)
		disc(model, "Shield", 1.7, Vector3.new(-0.95, 1.4, -0.62), color)
		disc(model, "Rim", 1.85, Vector3.new(-0.95, 1.4, -0.58), DARK)
		ball(model, "Boss", 0.4, Vector3.new(-0.95, 1.4, -0.68), METAL, Enum.Material.Metal)
	end,
	TowerShield = function(model, look, color)
		part(model, "Shield", Vector3.new(1.35, 2.1, 0.25), CFrame.new(-0.95, 1.45, -0.7), METAL, Enum.Material.Metal)
		part(model, "CrossV", Vector3.new(0.18, 1.7, 0.27), CFrame.new(-0.95, 1.45, -0.72), color, NEON)
		part(model, "CrossH", Vector3.new(1.0, 0.18, 0.27), CFrame.new(-0.95, 1.7, -0.72), color, NEON)
	end,
	Drum = function(model, look, color)
		part(model, "Drum", Vector3.new(0.85, 1.15, 1.15), CFrame.new(0, 0.95, -0.85), color, nil, Enum.PartType.Cylinder)
		for _, side in { -1, 1 } do
			part(model, "Stick", Vector3.new(0.08, 0.9, 0.08), CFrame.new(side * 0.75, 1.45, -0.65) * rot(-30, 0, side * 30), Color3.fromRGB(200, 160, 110))
		end
	end,
	Fan = function(model, look, color)
		for i = -3, 3 do
			part(model, "Rib", Vector3.new(0.12, 0.95, 0.04), CFrame.new(1.0, 1.7, -0.62) * rot(0, 0, i * 16) * CFrame.new(0, 0.45, 0), color, if i % 2 == 0 then NEON else nil)
		end
	end,
	Book = function(model, look, color)
		part(model, "Book", Vector3.new(0.9, 1.05, 0.2), CFrame.new(1.05, 1.75, -0.62) * rot(0, -20, 0), DARK)
		part(model, "Page", Vector3.new(0.75, 0.9, 0.05), CFrame.new(1.02, 1.75, -0.74) * rot(0, -20, 0), color, NEON)
	end,
	Orb = function(model, look, color)
		ball(model, "Orb", 0.85, Vector3.new(1.15, 2.2, -0.55), color, NEON)
		ball(model, "Core", 0.4, Vector3.new(1.15, 2.2, -0.95), WHITE, NEON)
	end,
	Clock = function(model, look, color)
		disc(model, "Face", 1.3, Vector3.new(1.15, 2.2, -0.45), WHITE)
		disc(model, "Rim", 1.45, Vector3.new(1.15, 2.2, -0.42), color)
		part(model, "Hour", Vector3.new(0.08, 0.35, 0.04), CFrame.new(1.15, 2.35, -0.5), DARK)
		part(model, "Minute", Vector3.new(0.06, 0.5, 0.04), CFrame.new(1.28, 2.2, -0.5) * rot(0, 0, -60), DARK)
	end,
	Sun = function(model, look, color)
		local grip = hold(Vector3.new(1.12, 1.8, -0.1), -6)
		part(model, "Shaft", Vector3.new(0.13, 3.6, 0.13), grip, Color3.fromRGB(240, 220, 160))
		local top = (grip * CFrame.new(0, 2.0, 0)).Position
		ball(model, "Sun", 0.62, top, color, NEON)
		for i = 1, 6 do
			part(model, "Ray", Vector3.new(0.1, 0.5, 0.05), CFrame.new(top) * rot(0, 0, i * 60) * CFrame.new(0, 0.55, 0), color, NEON)
		end
	end,
	Blade = function(model, look, color)
		local grip = hold(Vector3.new(1.12, 1.05, -0.2), -24)
		part(model, "Blade", Vector3.new(0.3, 3.0, 0.08), grip * CFrame.new(0, 1.75, 0), Color3.fromRGB(28, 22, 40))
		part(model, "Edge", Vector3.new(0.06, 2.9, 0.09), grip * CFrame.new(0.15, 1.75, 0), color, NEON)
		part(model, "Guard", Vector3.new(0.7, 0.14, 0.22), grip * CFrame.new(0, 0.25, 0), color, NEON)
		part(model, "Hilt", Vector3.new(0.12, 0.5, 0.12), grip, DARK)
	end,
}

-- Builds the figure for a look. Its PrimaryPart is an invisible root at the waist.
function CardArt.Build(look: Look): Model
	local model = Instance.new("Model")
	model.Name = "CardArt"
	local root = part(model, "Root", Vector3.one, CFrame.new(0, 1.5, 0), WHITE)
	root.Transparency = 1
	model.PrimaryPart = root

	body(model, look)
	if look.Style ~= "Bald" then
		ball(model, "HairCap", 2.24, Vector3.new(0, 3.2, 0.14), look.Hair)
	end
	local style = STYLES[look.Style]
	if style then
		style(model, look)
	end
	local headwear = look.Head and HEADWEAR[look.Head]
	if headwear then
		headwear(model, look)
	end
	local prop = look.Prop and PROPS[look.Prop]
	if prop then
		prop(model, look, look.PropColor or look.Trim)
	end
	if look.Aura then
		for i = 1, 14 do
			local angle = (i - 1) / 14 * math.pi * 2
			part(
				model,
				"Aura",
				Vector3.new(0.22, 0.22, 0.22),
				CFrame.new(math.cos(angle) * 1.9, 2.4 + math.sin(angle) * 1.9, 1.1) * rot(0, 0, math.deg(angle)),
				look.Aura,
				NEON
			)
		end
	end
	return model
end

-- Where the card camera sits for every figure (whole chibi body and prop in view).
CardArt.CameraCFrame = CFrame.lookAt(Vector3.new(1.1, 2.6, -7.4), Vector3.new(0, 2.25, 0))
CardArt.FieldOfView = 40

return CardArt
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Cards</string>
          <string name="Source"><![CDATA[--!strict
-- The 18 starter cards from the concept doc. All characters are original.
-- Adding a card = adding one entry here (plus art later). No other code changes.
--
-- Attack cards (front row) have ATK and HP: they deal the damage and take the boss's hits.
-- Support cards (back row) have PWR only: no HP, never hit, never KO'd. They cast heals, shields,
-- buffs, debuffs and chip damage, and each casts its Basic once as the fight opens.
-- Stats stay within +-10% of their tier's base, so rarity always decides power.

-- What an ability does in battle, built from the effect library (BattleEngine runs them).
-- Pct is a share of the caster's ATK (Attack) or PWR (Support).
--   Damage  Pct per hit, Hits, IgnoreDef                Burn    Pct per turn, Turns, Chance
--   Heal    Pct                                         Shield  Pct (lasts Config.Battle.ShieldTurns)
--   Buff    Stat ATK | Crit | CritDamage | SPD | Guard (less damage taken), Amount, Turns (nil = whole battle)
--   Debuff  boss Stat DEF | ATK | SPD | Vuln (takes more damage), Amount, Turns (nil = whole battle)
--   Energy  Amount, ResetSkill                          Cleanse Amount (burns/freezes removed per card)
--   Taunt   Turns                                       Revive  Pct of max HP
--   Evade   Hits (boss hits that miss)
-- Target: Boss (default for Damage/Burn/Debuff) | Self | Lowest | Attack | All | Random.
--   Heals, shields, cleanses and evades only reach Attack cards (Support cards have no HP).
-- When (Passive only): BossAbove50 | SelfBelow50 | OnAct | OnHit; nil = always on.
-- Secret signatures are the only coded mechanics: Kind = Eclipse | DawnOath.
export type Effect = {
	Kind: string,
	Pct: number?,
	Hits: number?,
	Target: string?,
	Stat: string?,
	Amount: number?,
	Turns: number?,
	Chance: number?,
	When: string?,
	IgnoreDef: boolean?,
	ResetSkill: boolean?,
	Every: number?,
}

export type Ability = {
	Slot: string, -- Basic | Skill | Passive | Ultimate | Aura | Signature
	Name: string,
	Text: string,
	Effects: { Effect },
	Every: number?, -- Skill: used instead of the Basic every N actions
}

-- How the card's character is drawn (CardArt.luau builds a chibi figure from this).
export type Look = {
	Skin: Color3,
	Hair: Color3,
	Outfit: Color3,
	Outfit2: Color3, -- sleeves / legs
	Trim: Color3,
	Eyes: Color3,
	Style: string, -- hair: Spiky | Long | Bob | Ponytail | Twin | Swept | Short | Bald
	Head: string?, -- Headband | Witch | Crown | Halo | Horns | Helmet | Hood | Straw | Flower | Glasses | Mask
	Prop: string?, -- Fists | Kunai | Sword | Katana | Lance | Bow | Staff | Shield | TowerShield | Drum | Fan | Book | Orb | Clock | Sun | Blade
	PropColor: Color3?,
	Aura: Color3?, -- ring of light behind the figure
	GlowEye: boolean?, -- one glowing eye
}

export type Card = {
	Id: string,
	Name: string,
	Title: string,
	Type: string, -- "Attack" | "Support"
	Rarity: string,
	Main: number, -- ATK for Attack, PWR for Support
	HP: number?, -- Attack cards only
	SPD: number,
	Glyph: string, -- initials, used where the 3D art isn't drawn
	Accent: Color3, -- portrait background colour
	Look: Look?, -- the character's 3D chibi art
	Image: string?, -- optional uploaded illustration ("rbxassetid://..."); drawn instead of the 3D art
	Abilities: { Ability },
}

local Config = require(script.Parent.Config)

local function ability(slot: string, name: string, text: string, effects: { Effect }, every: number?): Ability
	return { Slot = slot, Name = name, Text = text, Effects = effects, Every = every }
end

