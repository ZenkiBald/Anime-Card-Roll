        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The client's copy of the player's data. The server is the source of truth;
-- this mirrors what it last sent so the UI can draw without asking again.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Meta = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Meta"))

local State = {
	Cards = {}, -- [cardId] = { Copies, Stars }
	Summary = {
		TotalRolls = 0,
		Shards = 0,
		Pity = { Epic = 0, Legendary = 0 },
		Luck = 1,
		AutoStop = "Legendary",
		AutoActive = false,
		Playtime = 0,
		Unlocked = { QuickRoll = true, AutoRoll = true },
	},
	Decks = { Active = 1, Presets = {} }, -- presets: { Attack = {4 ids}, Support = {4 ids} }, "" = empty
	Progress = { Cleared = {}, BestTime = {} },
	Battle = { AutoUlt = false, Speed = 1 },
	-- Long-term progression (MetaService.State): potions, upgrades, Index claims, daily, gifts, milestones.
	Meta = {
		Shards = 0,
		TotalRolls = 0,
		Inventory = {},
		Active = {},
		Upgrades = {},
		IndexClaimed = {},
		IndexComplete = {},
		Daily = { CanClaim = false, Day = 1, Streak = 0 },
		SessionSeconds = 0,
		GiftsClaimed = {},
		Milestones = {},
		BaseLuck = 1,
		Luck = 1,
		Cooldown = 1.2,
	},
	MetaAt = os.clock(), -- when Meta arrived; timers count down from here
	InBattle = false,
	TestMode = false,
}

local changed = Instance.new("BindableEvent")
State.Changed = changed.Event -- fires (kind: "all" | "roll" | "decks" | "progress" | "meta", result?)

function State.ApplyFull(full)
	State.Cards = full.Cards or {}
	if full.Summary then
		State.Summary = full.Summary
	end
	if full.Decks then
		State.Decks = full.Decks
	end
	if full.Progress then
		State.Progress = full.Progress
	end
	if full.Battle then
		State.Battle = full.Battle
	end
	if full.Meta then
		State.Meta = full.Meta
		State.MetaAt = os.clock()
	end
	State.TestMode = full.TestMode == true
	changed:Fire("all")
end

-- Progression update from the server; also refreshes the HUD numbers it changes.
function State.ApplyMeta(meta)
	State.Meta = meta
	State.MetaAt = os.clock()
	State.Summary.Shards = meta.Shards
	State.Summary.Luck = meta.Luck
	State.Summary.Cooldown = meta.Cooldown
	changed:Fire("meta")
end

-- Seconds left on a running potion, counted down locally between server updates.
function State.PotionLeft(id: string): number
	local seconds = State.Meta.Active[id]
	if seconds == nil then
		return 0
	end
	return math.max(0, seconds - (os.clock() - State.MetaAt))
end

local function liveActive()
	local active = {}
	for id in State.Meta.Active or {} do
		active[id] = State.PotionLeft(id)
	end
	return active
end

-- Luck right now (base x the strongest running potion), matching what the server will use.
function State.Luck(): number
	return Meta.TotalLuck(State.Meta.BaseLuck or 1, Meta.PotionLuck(liveActive()))
end

function State.Cooldown(): number
	return Meta.Cooldown(State.Meta.Upgrades or {}, liveActive())
end

function State.SessionSeconds(): number
	return (State.Meta.SessionSeconds or 0) + (os.clock() - State.MetaAt)
end

-- Total rolls, kept current between progression updates.
function State.Rolls(): number
	return math.max(State.Summary.TotalRolls or 0, State.Meta.TotalRolls or 0)
end

function State.ApplyRoll(result)
	if result.CardId then
		State.Cards[result.CardId] = { Copies = result.Copies, Stars = result.Stars }
	end
	if result.Summary then
		State.Summary = result.Summary
	end
	changed:Fire("roll", result)
end

function State.ApplyDecks(decks)
	State.Decks = decks
	changed:Fire("decks")
end

function State.ApplyProgress(progress)
	State.Progress = progress
	changed:Fire("progress")
end

function State.ActiveDeck()
	return State.Decks.Presets[State.Decks.Active]
end

function State.Owned(): number
	local n = 0
	for _ in State.Cards do
		n += 1
	end
	return n
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="43">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Battle</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Battle screen. The fight runs on the server; this draws the snapshots it streams
-- (HP, shields, action bars, energy) and animates its events (hits, heals, warnings).
-- The player only taps charged cards to fire Ultimates, toggles Auto and speed, or gives up.
-- Plain Frames + tweens and one 3D boss in a ViewportFrame, so it stays cheap on phones.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared.Rarity)
local Cards = require(Shared.Cards)
local Bosses = require(Shared.Bosses)
local Config = require(Shared.Config)
local Meta = require(Shared.Meta)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Effects = require(script.Parent.Effects)
local ModelView = require(script.Parent.ModelView)
local CardView = require(script.Parent.CardView)
local RewardReveal = require(script.Parent.RewardReveal)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.Parent.State)

local Battle = {}

export type Hooks = {
	OnStart: () -> (), -- battle screen opened (hide the roll HUD)
	OnEnd: () -> (), -- back to the hub
}

local hooks: Hooks
local gui: ScreenGui
local backdrop: any -- children read by name
local particles: Frame
local stage: Frame -- everything inside the safe area
local fxLayer: Frame -- bolts, slashes and cut-ins, positioned in screen pixels
local bossName: TextLabel
local bossChip: any
local bossHpFill: Frame
local bossHpTrail: Frame
local bossBarrier: Frame
local bossHpText: TextLabel
local bossGauge: Frame
local bossStatus: TextLabel
local bossHolder: Frame
local barrierRing: Frame
local bossView = nil -- ModelView
local timerLabel: TextLabel
local calloutLabel: TextLabel
local warnBanner: Frame
local warnLabel: TextLabel
local hintLabel: TextLabel
local frontRow: Frame
local backRow: Frame
local autoButton: any -- children read by name
local speedButton: any
local forfeitButton: any
local intro: Frame
local results: Frame

local tiles = {} -- [unitId] = tile table (see makeTile)
local current = nil -- the fight on screen
local lastSnap = nil
local calloutToken = 0
local hintToken = 0
local warnToken = 0
local trailTokens = {} -- [fill] = number
local ultTapped = {} -- [unitId] = os.clock(); stops double taps until the server answers

local FLUSH_SPACING = 0.14 -- spread a batch of events over about one server flush
local BOLT_TIME = 0.14
local SHIELD_COLOR = Color3.fromRGB(150, 210, 255)
local ICE_COLOR = Color3.fromRGB(150, 230, 255)

local REASONS = {
	NoAttack = "Put at least one Attack card in your deck first",
	Locked = "Beat the previous fight first",
	InBattle = "Already in a fight",
	TooFast = "Slow down a little",
	Loading = "Still loading your cards",
}

local STATUS = { B = "BURN", Z = "FROZEN", T = "TAUNT", U = "BUFFED", S = "SLOWED", G = "GUARDED", I = "SAFE" }
local BOSS_STATUS = {
	D = "DEF DOWN",
	A = "ATK DOWN",
	S = "SLOWED",
	V = "VULNERABLE",
	B = "BURNING",
	E = "ENRAGED",
	W = "CHARGING",
	R = "BARRIER",
}

local function clock(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function hint(text: string)
	hintToken += 1
	local token = hintToken
	hintLabel.Text = text
	hintLabel.TextTransparency = 0
	task.delay(2.2, function()
		if token == hintToken then
			Kit.tween(hintLabel, 0.4, { TextTransparency = 1 })
		end
	end)
end

local function callout(text: string, color: Color3, seconds: number?)
	calloutToken += 1
	local token = calloutToken
	calloutLabel.Text = text
	calloutLabel.TextColor3 = color
	calloutLabel.TextTransparency = 0
	local scale = calloutLabel:FindFirstChildOfClass("UIScale")
	if scale then
		scale.Scale = 0.5
		Kit.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	task.delay(seconds or 1.4, function()
		if token == calloutToken then
			Kit.tween(calloutLabel, 0.3, { TextTransparency = 1 })
		end
	end)
end

-- Number or word that pops, floats up off a tile or the boss, and fades.
local function float(parent: GuiObject?, text: string, color: Color3, big: boolean?)
	if parent == nil or parent.Parent == nil then
		return
	end
	local label = Kit.label({
		Name = "Float",
		Text = text,
		Font = Theme.Font.Display,
		TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.25 + math.random() * 0.5, 0.42),
		Size = UDim2.fromScale(if big then 1.2 else 0.95, if big then 0.5 else 0.36),
		ZIndex = 40,
		Parent = parent,
	}, if big then 44 else 26)
	Kit.textStroke(Color3.new(0, 0, 0), 2, 0.15).Parent = label
	local scale = Kit.new("UIScale", { Scale = 0.3, Parent = label })
	Kit.tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	Kit.tween(label, 0.9, { Position = label.Position - UDim2.fromScale(0, 0.5) }, Enum.EasingStyle.Quad)
	task.delay(0.5, function()
		if label.Parent then
			Kit.tween(label, 0.4, { TextTransparency = 1 }).Completed:Connect(function()
				label:Destroy()
			end)
		end
	end)
end

local function bump(scale: UIScale?, amount: number)
	if scale then
		task.spawn(Effects.Pulse, scale, 1, 0.22, amount)
	end
end

-- Shakes can overlap, so the stage is put back at its home position afterwards.
local STAGE_HOME: UDim2
local function shakeStage(intensity: number, duration: number)
	Effects.Shake(stage, intensity, duration)
	task.delay(duration + 0.05, function()
		stage.Position = STAGE_HOME
	end)
end

-- Same idea for a card face inside its slot.
local function shakeCard(tile, intensity: number)
	Effects.Shake(tile.Card, intensity, 0.22)
	task.delay(0.27, function()
		tile.Card.Position = UDim2.fromScale(0.5, 0.5)
	end)
end

-- Bars --------------------------------------------------------------------------------------

local function bar(parent: Instance, name: string, y: number, height: number, color: Color3, trail: boolean?)
	local track = Kit.new("Frame", {
		Name = name,
		Position = UDim2.fromScale(0, y),
		Size = UDim2.fromScale(1, height),
		BackgroundColor3 = Color3.fromRGB(10, 8, 20),
		BackgroundTransparency = 0.15,
		ClipsDescendants = true,
		Parent = parent,
	}, { Kit.corner(UDim.new(1, 0)) })
	local trailFrame = nil
	if trail then
		trailFrame = Kit.new("Frame", {
			Name = "Trail",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(255, 240, 220),
			BorderSizePixel = 0,
			Parent = track,
		}, { Kit.corner(UDim.new(1, 0)) })
	end
	local fill = Kit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	}, { Kit.corner(UDim.new(1, 0)) })
	return track, fill, trailFrame
end

-- Damage drops the bar at once and the light trail follows a moment later; heals just grow.
local function setHp(fill: Frame, trail: Frame?, ratio: number)
	ratio = math.clamp(ratio, 0, 1)
	local goal = UDim2.fromScale(ratio, 1)
	trailTokens[fill] = (trailTokens[fill] or 0) + 1
	local token = trailTokens[fill]
	if ratio < fill.Size.X.Scale - 0.0005 then
		Kit.tween(fill, 0.1, { Size = goal })
		if trail then
			task.delay(0.35, function()
				if trailTokens[fill] == token then
					Kit.tween(trail, 0.45, { Size = goal }, Enum.EasingStyle.Quad)
				end
			end)
		end
	else
		Kit.tween(fill, 0.25, { Size = goal })
		if trail then
			Kit.tween(trail, 0.25, { Size = goal })
		end
	end
end

local function hpColor(ratio: number): Color3
	if ratio > 0.5 then
		return Theme.Color.Quick
	elseif ratio > 0.25 then
		return Theme.Color.Gold
	end
	return Theme.Color.Danger
end

-- Screen-space effects --------------------------------------------------------------------------

local function centerOf(object: GuiObject): Vector2
	return object.AbsolutePosition + object.AbsoluteSize / 2 - fxLayer.AbsolutePosition
end

local function ring(at: Vector2, color: Color3, size: number)
	local circle = Kit.new("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(at.X, at.Y),
		Size = UDim2.fromOffset(size * 0.3, size * 0.3),
		BackgroundTransparency = 1,
		ZIndex = 62,
		Parent = fxLayer,
	}, { Kit.corner(UDim.new(1, 0)) })
	local stroke = Kit.stroke(color, 4, 0)
	stroke.Parent = circle
	Kit.tween(circle, 0.32, { Size = UDim2.fromOffset(size, size) }, Enum.EasingStyle.Quad)
	Kit.tween(stroke, 0.32, { Transparency = 1, Thickness = 1 }).Completed:Connect(function()
		circle:Destroy()
	end)
end

-- A glowing streak from a card to the boss, ending in an impact ring.
local function bolt(from: GuiObject, to: GuiObject, color: Color3, thick: number?)
	if Theme.FxLow and math.random() < 0.5 then
		return
	end
	local a, b = centerOf(from), centerOf(to)
	b += Vector2.new(math.random(-18, 18), math.random(-22, 10))
	local delta = b - a
	local streak = Kit.new("Frame", {
		Name = "Bolt",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(a.X, a.Y),
		Size = UDim2.fromOffset(18, thick or 6),
		Rotation = math.deg(math.atan2(delta.Y, delta.X)),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = fxLayer,
	}, {
		Kit.corner(UDim.new(1, 0)),
		Kit.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.6, 0.2),
				NumberSequenceKeypoint.new(1, 0),
			}),
		}),
	})
	Kit.tween(streak, BOLT_TIME, {
		Position = UDim2.fromOffset(b.X, b.Y),
		Size = UDim2.fromOffset(46, thick or 6),
	}, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Connect(function()
		streak:Destroy()
		ring(b, color, 70)
	end)
end

-- Two crossing slashes over a card the boss hits.
local function slash(tile, color: Color3)
	for i, angle in { 32, -28 } do
		local line = Kit.new("Frame", {
			Name = "Slash",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 0, 0, 4),
			Rotation = angle,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = tile.Card,
		}, { Kit.corner(UDim.new(1, 0)) })
		task.delay((i - 1) * 0.06, function()
			Kit.tween(line, 0.12, { Size = UDim2.new(1.25, 0, 0, 4) }, Enum.EasingStyle.Quad)
			task.delay(0.12, function()
				Kit.tween(line, 0.2, { BackgroundTransparency = 1 }).Completed:Connect(function()
					line:Destroy()
				end)
			end)
		end)
	end
end

local function glow(tile, color: Color3)
	local flash = tile.Flash
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 0.45
	Kit.tween(flash, 0.35, { BackgroundTransparency = 1 })
end

-- A band across the screen naming an Ultimate.
local function cutIn(cardId: string, ultName: string)
	local card = Cards.Get(cardId)
	if card == nil then
		return
	end
	local tier = Rarity.Get(card.Rarity)
	local band = Kit.new("Frame", {
		Name = "CutIn",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(-0.8, 0.46),
		Size = UDim2.fromScale(1.5, 0.17),
		Rotation = -5,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 70,
		Parent = fxLayer,
	}, { Kit.gradient(ColorSequence.new(tier.Dark, card.Accent), 0) })
	local portrait = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.33, 0.5),
		Size = UDim2.fromScale(0.1, 1.15),
		BackgroundColor3 = card.Accent,
		ZIndex = 71,
		Parent = band,
	}, {
		Kit.corner(UDim.new(1, 0)),
		Kit.aspect(1, Enum.DominantAxis.Height),
		Kit.stroke(tier.Color, 4, 0),
	})
	Kit.label({
		Text = card.Glyph,
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.5),
		ZIndex = 72,
		Parent = portrait,
	}, 60)
	local name = Kit.label({
		Text = string.upper(ultName),
		Font = Theme.Font.Display,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromScale(0.4, 0.12),
		Size = UDim2.fromScale(0.42, 0.55),
		ZIndex = 72,
		Parent = band,
	}, 64)
	Kit.textStroke(Color3.new(0, 0, 0), 3, 0.1).Parent = name
	Kit.label({
		Text = `{card.Name} · ULTIMATE`,
		Font = Theme.Font.Heavy,
		TextColor3 = tier.Color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromScale(0.4, 0.66),
		Size = UDim2.fromScale(0.42, 0.24),
		ZIndex = 72,
		Parent = band,
	}, 26)
	Kit.tween(band, 0.22, { Position = UDim2.fromScale(0.5, 0.46) }, Enum.EasingStyle.Quart).Completed:Connect(function()
		task.delay(0.55, function()
			Kit.tween(band, 0.2, { Position = UDim2.fromScale(1.8, 0.46) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In).Completed
				:Connect(function()
					band:Destroy()
				end)
		end)
	end)
end

-- Tiles ---------------------------------------------------------------------------------------------

local function pulseForever(instance: Instance, goal: { [string]: any }, period: number)
	TweenService:Create(instance, TweenInfo.new(period, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), goal):Play()
end

-- One card in the fight. Attack: portrait, name, status, HP / shield, action and energy bars.
-- Support: portrait, name, what it casts, action and energy bars (no HP).
local function makeTile(unit, order: number)
	local card = Cards.Get(unit.CardId)
	local tier = Rarity.Get(card.Rarity)
	local isAttack = card.Type == "Attack"
	local stars = 0
	local entry = State.Cards[unit.CardId]
	if entry then
		stars = entry.Stars
	end

	local slot = Kit.new("Frame", {
		Name = unit.Id,
		LayoutOrder = order,
		Size = UDim2.new(0.25, -8, 1, 0),
		BackgroundTransparency = 1,
	})
	local button = Kit.new("TextButton", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
		Parent = slot,
	}, {
		Kit.corner(UDim.new(0.12, 0)),
		Kit.gradient(ColorSequence.new(tier.Dark:Lerp(Color3.new(1, 1, 1), 0.12), tier.Dark:Lerp(Color3.new(0, 0, 0), 0.35)), 90),
	})
	local stroke = Kit.stroke(Color3.new(1, 1, 1), 2, 0)
	local strokeGradient = Kit.gradient(Rarity.Gradient(card.Rarity), 45)
	strokeGradient.Parent = stroke
	stroke.Parent = button
	if card.Rarity == "Secret" then
		Effects.Spin(strokeGradient, 90)
	end
	local scale = Kit.new("UIScale", { Scale = 1, Parent = button })

	local portrait = Kit.new("Frame", {
		Name = "Portrait",
		Position = UDim2.new(0, 4, 0, 4),
		Size = UDim2.new(0.36, 0, 1, -8),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Parent = button,
	}, {
		Kit.corner(UDim.new(0.16, 0)),
		Kit.aspect(1, Enum.DominantAxis.Height),
		Kit.gradient(ColorSequence.new(card.Accent, tier.Dark), 120),
	})
	Kit.new("Frame", {
		Name = "Halo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.85, 0.85),
		BackgroundColor3 = tier.Color,
		BackgroundTransparency = 0.7,
		Parent = portrait,
	}, { Kit.corner(UDim.new(1, 0)) })
	local art = CardView.Art(unit.CardId, true, false)
	if art then
		art.Size = UDim2.fromScale(1.25, 1.25)
		art.AnchorPoint = Vector2.new(0.5, 0.5)
		art.Position = UDim2.fromScale(0.5, 0.58)
		art.Parent = portrait
	else
		Kit.label({
			Name = "Glyph",
			Text = card.Glyph,
			Font = Theme.Font.Display,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.46),
			Size = UDim2.fromScale(0.85, 0.5),
			Parent = portrait,
		}, 40)
	end
	if stars > 0 then
		Kit.label({
			Name = "Stars",
			Text = string.rep("★", stars),
			Font = Theme.Font.Heavy,
			TextColor3 = Theme.Color.Gold,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.98),
			Size = UDim2.fromScale(0.9, 0.2),
			ZIndex = 3,
			Parent = portrait,
		}, 14)
	end

	local info = Kit.new("Frame", {
		Name = "Info",
		Position = UDim2.new(0.4, 0, 0, 4),
		Size = UDim2.new(0.6, -6, 1, -8),
		BackgroundTransparency = 1,
		Parent = button,
	})
	Kit.label({
		Name = "CardName",
		Text = card.Name,
		Font = Theme.Font.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromScale(1, if isAttack then 0.24 else 0.32),
		Parent = info,
	}, 18)
	local status = Kit.label({
		Name = "Status",
		Text = if isAttack then "" else (if card.Abilities[1] then card.Abilities[1].Name else ""),
		Font = Theme.Font.Heavy,
		TextColor3 = if isAttack then Theme.Color.Gold else Theme.Color.Support,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromScale(0, if isAttack then 0.25 else 0.34),
		Size = UDim2.fromScale(1, if isAttack then 0.17 else 0.22),
		Parent = info,
	}, 13)

	local tile = {
		Slot = slot,
		Card = button,
		Scale = scale,
		Status = status,
		IsAttack = isAttack,
		MaxHP = unit.MaxHP,
		HasUlt = unit.Ultimate ~= nil,
		UltName = unit.Ultimate,
		Accent = card.Accent,
		TierColor = tier.Color,
		CardId = unit.CardId,
		BaseStatus = status.Text,
	}

	if isAttack then
		local hpTrack, hpFill, hpTrail = bar(info, "HP", 0.45, 0.25, Theme.Color.Quick, true)
		hpFill.Size = UDim2.fromScale(1, 1)
		tile.HpFill, tile.HpTrail = hpFill, hpTrail
		tile.Shield = Kit.new("Frame", {
			Name = "Shield",
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = SHIELD_COLOR,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = hpTrack,
		}, { Kit.corner(UDim.new(1, 0)) })
		tile.HpText = Kit.label({
			Name = "HpText",
			Text = "",
			Font = Theme.Font.Heavy,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 4,
			Parent = hpTrack,
		}, 13)
		Kit.textStroke(Color3.new(0, 0, 0), 1, 0.25).Parent = tile.HpText
	end
	local _, gauge = bar(info, "Action", if isAttack then 0.76 else 0.62, if isAttack then 0.09 else 0.12, Color3.fromRGB(232, 228, 255))
	tile.Gauge = gauge
	if unit.Ultimate then
		local _, energy = bar(info, "Energy", if isAttack then 0.89 else 0.8, if isAttack then 0.09 else 0.12, Theme.Color.Gold)
		tile.Energy = energy
	end

	tile.Flash = Kit.new("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 9,
		Parent = button,
	}, { Kit.corner(UDim.new(0.12, 0)) })

	tile.Ready = Kit.new("Frame", {
		Name = "Ready",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Color.Gold,
		BackgroundTransparency = 0.85,
		Visible = false,
		ZIndex = 10,
		Parent = button,
	}, { Kit.corner(UDim.new(0.12, 0)) })
	local readyStroke = Kit.stroke(Theme.Color.Gold, 3, 0)
	readyStroke.Parent = tile.Ready
	pulseForever(readyStroke, { Transparency = 0.75, Thickness = 5 }, 0.45)
	local readyLabel = Kit.label({
		Text = "TAP: ULTIMATE",
		Font = Theme.Font.Display,
		TextColor3 = Theme.Color.Gold,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -14),
		Size = UDim2.new(0.9, 0, 0, 18),
		ZIndex = 11,
		Parent = tile.Ready,
	}, 16)
	Kit.textStroke(Color3.new(0, 0, 0), 2, 0.1).Parent = readyLabel

	tile.Warn = Kit.new("Frame", {
		Name = "Warn",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Color.Danger,
		BackgroundTransparency = 0.78,
		Visible = false,
		ZIndex = 12,
		Parent = button,
	}, { Kit.corner(UDim.new(0.12, 0)) })
	local warnStroke = Kit.stroke(Theme.Color.Danger, 3, 0)
	warnStroke.Parent = tile.Warn
	pulseForever(warnStroke, { Transparency = 0.6 }, 0.2)
	Kit.label({
		Text = "!",
		Font = Theme.Font.Display,
		TextColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -4, 0, 2),
		Size = UDim2.fromScale(0.2, 0.5),
		ZIndex = 13,
		Parent = tile.Warn,
	}, 30)

	tile.Frozen = Kit.new("Frame", {
		Name = "Frozen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = ICE_COLOR,
		BackgroundTransparency = 0.6,
		Visible = false,
		ZIndex = 13,
		Parent = button,
	}, { Kit.corner(UDim.new(0.12, 0)), Kit.stroke(Color3.new(1, 1, 1), 2, 0.3) })
	Kit.label({
		Text = "FROZEN",
		Font = Theme.Font.Display,
		TextColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.4),
		ZIndex = 14,
		Parent = tile.Frozen,
	}, 28)

	tile.Ko = Kit.new("Frame", {
		Name = "KO",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 8, 14),
		BackgroundTransparency = 0.25,
		Visible = false,
		ZIndex = 15,
		Parent = button,
	}, { Kit.corner(UDim.new(0.12, 0)) })
	Kit.label({
		Text = "KO",
		Font = Theme.Font.Display,
		TextColor3 = Theme.Color.Danger,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.6, 0.6),
		ZIndex = 16,
		Parent = tile.Ko,
	}, 44)

	tiles[unit.Id] = tile

	button.Activated:Connect(function()
		if current == nil or current.Ended or not tile.HasUlt then
			return
		end
		if not tile.Ready.Visible then
			if not tile.Ko.Visible then
				hint(if current.AutoUlt then "AUTO ULT is on: Ultimates fire by themselves" else "Ultimate charges as this card acts and gets hit")
			end
			return
		end
		ultTapped[unit.Id] = os.clock()
		tile.Ready.Visible = false
		Sfx.Play("Click", 1.3)
		Remotes.BattleInput:FireServer("Ultimate", unit.Id)
	end)
	return slot
end

-- Snapshots -------------------------------------------------------------------------------

local function flagWords(flags: string, names): string
	local words = {}
	for flag in string.gmatch(flags, ".") do
		if names[flag] then
			table.insert(words, names[flag])
		end
	end
	return table.concat(words, " · ")
end

local function applySnapshot(snap)
	if current == nil then
		return
	end
	lastSnap = snap
	local cost = current.Info.UltimateCost
	for id, s in snap.U do
		if id == "Boss" then
			local maxHP = current.Info.Boss.MaxHP
			setHp(bossHpFill, bossHpTrail, s.H / maxHP)
			local barrier = s.Bar or 0
			Kit.tween(bossBarrier, 0.2, { Size = UDim2.fromScale(math.min(1, barrier / maxHP * 8), 1) })
			bossHpText.Text = if barrier > 0
				then `{Kit.commas(s.H)} / {Kit.commas(maxHP)}   ·   BARRIER {Kit.commas(barrier)}`
				else `{Kit.commas(s.H)} / {Kit.commas(maxHP)}`
			barrierRing.Visible = barrier > 0
			Kit.tween(bossGauge, 0.15, { Size = UDim2.fromScale(s.G, 1) }, Enum.EasingStyle.Linear)
			bossStatus.Text = flagWords(s.F, BOSS_STATUS)
		else
			local tile = tiles[id]
			if tile then
				local alive = true
				if tile.IsAttack and s.H then
					local ratio = s.H / tile.MaxHP
					setHp(tile.HpFill, tile.HpTrail, ratio)
					tile.HpFill.BackgroundColor3 = hpColor(ratio)
					tile.Shield.Size = UDim2.fromScale(math.min(1, (s.S or 0) / tile.MaxHP), 1)
					tile.HpText.Text = if (s.S or 0) > 0 then `{Kit.commas(s.H)} +{Kit.commas(s.S)}` else Kit.commas(s.H)
					alive = s.H > 0
					tile.Status.Text = flagWords(s.F, STATUS)
					tile.Status.TextColor3 = if string.find(s.F, "B") then Theme.Color.Roll
						elseif string.find(s.F, "Z") then ICE_COLOR
						else Theme.Color.Gold
				else
					local words = flagWords(s.F, STATUS)
					tile.Status.Text = if words ~= "" then words else tile.BaseStatus
				end
				local gaugeGoal = UDim2.fromScale(s.G, 1)
				if s.G < tile.Gauge.Size.X.Scale then
					tile.Gauge.Size = gaugeGoal -- it just acted: snap back
				else
					Kit.tween(tile.Gauge, 0.15, { Size = gaugeGoal }, Enum.EasingStyle.Linear)
				end
				if tile.Energy then
					Kit.tween(tile.Energy, 0.15, { Size = UDim2.fromScale(s.E / cost, 1) })
				end
				if tile.Ko.Visible ~= not alive then
					tile.Ko.Visible = not alive
					tile.Card.BackgroundTransparency = if alive then 0 else 0.4
				end
				tile.Frozen.Visible = alive and string.find(s.F, "Z") ~= nil
				local tapped = ultTapped[id]
				local waiting = tapped ~= nil and os.clock() - tapped < 0.6
				tile.Ready.Visible = alive and tile.HasUlt and s.E >= cost and not waiting and not current.AutoUlt
			end
		end
	end
	timerLabel.Text = clock(current.Info.TimeLimit - snap.T)
	timerLabel.TextColor3 = if current.Info.TimeLimit - snap.T <= 30 then Theme.Color.Danger else Theme.Color.Text
end

-- Events ------------------------------------------------------------------------------------

local function targetFrame(id: string): GuiObject?
	if id == "Boss" then
		return bossHolder
	end
	local tile = tiles[id]
	return if tile then tile.Card else nil
end

local function showWarning(event)
	warnToken += 1
	local token = warnToken
	for _, id in event.T do
		local tile = tiles[id]
		if tile then
			tile.Warn.Visible = true
		end
	end
	local seconds = event.S / math.max(1, current.Speed)
	warnLabel.Text = `{string.upper(event.N)} INCOMING`
	warnBanner.Visible = true
	if bossView then
		bossView:Flash(Color3.fromRGB(255, 120, 120), seconds)
	end
	task.delay(seconds, function()
		if token ~= warnToken then
			return
		end
		warnBanner.Visible = false
		for _, tile in tiles do
			tile.Warn.Visible = false
		end
	end)
end

local function playEvent(event)
	if current == nil then
		return
	end
	local kind = event.K
	if kind == "Act" then
		if event.U == "Boss" then
			if bossView then
				bossView:Lunge()
			end
			if event.Ab == "Skill" then
				callout(event.N .. "!", Theme.Color.Danger, 1.1)
				shakeStage(9, 0.35)
				Sfx.Play("Impact", 0.9)
			else
				Sfx.Play("Thud", 0.8)
			end
			return
		end
		local tile = tiles[event.U]
		if tile == nil then
			return
		end
		if event.Ab == "Ultimate" then
			cutIn(tile.CardId, event.N)
			Effects.Flash(gui, tile.TierColor, 0.45, 0.55)
			Sfx.Play("Impact", 1.15)
			bump(tile.Scale, 0.15)
			if tile.IsAttack then
				for i = 1, 3 do
					task.delay(i * 0.05, bolt, tile.Card, bossHolder, tile.TierColor, 10)
				end
			end
		elseif tile.IsAttack then
			-- Lunge up and fire at the boss.
			tile.Card.Position = UDim2.new(0.5, 0, 0.5, 0)
			Kit.tween(tile.Card, 0.08, { Position = UDim2.new(0.5, 0, 0.5, -12) }, Enum.EasingStyle.Quad).Completed:Connect(function()
				Kit.tween(tile.Card, 0.18, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
			end)
			bolt(tile.Card, bossHolder, tile.Accent, if event.Ab == "Skill" then 9 else 6)
			if event.Ab == "Skill" then
				float(tile.Card, event.N, Theme.Color.Text)
				task.delay(0.06, bolt, tile.Card, bossHolder, tile.TierColor, 9)
			end
		else
			-- Support: a soft glow and a lift as it casts.
			glow(tile, tile.Accent)
			bump(tile.Scale, 0.06)
			if event.Ab == "Skill" or event.Ab == "Opening" then
				float(tile.Card, event.N, Theme.Color.Support)
			end
		end
	elseif kind == "Hit" or kind == "Burn" then
		local frame = targetFrame(event.T)
		if event.T == "Boss" then
			local color = if kind == "Burn" then Theme.Color.Roll
				elseif event.Bl then SHIELD_COLOR
				elseif event.C then Theme.Color.Gold
				else Color3.new(1, 1, 1)
			local text = if event.C then `{Kit.commas(event.A)}!` else Kit.commas(event.A)
			float(frame, text, color, event.C)
			if kind == "Hit" and bossView then
				bossView:Kick(if event.C then 1.1 else 0.45)
				bossView:Flash(if event.C then Color3.fromRGB(255, 220, 160) else Color3.fromRGB(255, 190, 190), 0.18)
				if event.C then
					ring(centerOf(bossHolder), Theme.Color.Gold, 140)
				end
			end
		else
			local tile = tiles[event.T]
			if tile == nil then
				return
			end
			if event.A == 0 then
				float(tile.Card, "SAFE", Theme.Color.Gold)
			elseif kind == "Burn" then
				float(tile.Card, `-{Kit.commas(event.A)}`, Theme.Color.Roll)
			else
				float(tile.Card, `-{Kit.commas(event.A)}`, if event.Sh then SHIELD_COLOR else Theme.Color.Danger)
				slash(tile, if event.Sh then SHIELD_COLOR else Color3.fromRGB(255, 90, 90))
				glow(tile, Theme.Color.Danger)
				shakeCard(tile, 6)
			end
		end
	elseif kind == "Heal" then
		local tile = tiles[event.T]
		if tile and event.A > 0 then
			float(tile.Card, `+{Kit.commas(event.A)}`, Theme.Color.Quick)
			glow(tile, Theme.Color.Quick)
		end
	elseif kind == "Shield" then
		local tile = tiles[event.T]
		if tile then
			float(tile.Card, `+{Kit.commas(event.A)}`, SHIELD_COLOR)
			glow(tile, SHIELD_COLOR)
		end
	elseif kind == "Buff" then
		local tile = tiles[event.U]
		if tile then
			local label = if event.Stat == "Guard" then "GUARD" else event.Stat
			float(tile.Card, `{label} +{math.floor(event.A * 100 + 0.5)}%`, Theme.Color.Gold)
		end
		for _, id in event.T or {} do
			local target = tiles[id]
			if target and target ~= tile then
				glow(target, Theme.Color.Gold)
			end
		end
	elseif kind == "Debuff" then
		local label = if event.Stat == "Vuln" then "DMG TAKEN" else event.Stat
		local sign = if event.Stat == "Vuln" then "+" else "-"
		float(bossHolder, `{label} {sign}{math.floor(event.A * 100 + 0.5)}%`, Theme.Color.Support)
	elseif kind == "Energy" then
		for _, id in event.T or {} do
			local tile = tiles[id]
			if tile and tile.HasUlt then
				glow(tile, Theme.Color.Gold)
			end
		end
	elseif kind == "Burned" then
		float(targetFrame(event.T), "BURN", Theme.Color.Roll)
	elseif kind == "Miss" then
		float(targetFrame(event.T), "MISS", Theme.Color.Muted, true)
	elseif kind == "KO" then
		local tile = tiles[event.T]
		if tile then
			float(tile.Card, "KO!", Theme.Color.Danger, true)
			shakeCard(tile, 10)
			Sfx.Play("Thud", 0.6)
		end
	elseif kind == "Revive" then
		local tile = tiles[event.T]
		if tile then
			float(tile.Card, "REVIVED", Theme.Color.Quick, true)
			glow(tile, Theme.Color.Quick)
		end
	elseif kind == "Taunt" then
		float(targetFrame(event.U), "TAUNT", Theme.Color.Gold)
	elseif kind == "Cleanse" then
		float(targetFrame(event.T), "CLEANSED", Theme.Color.Support)
	elseif kind == "Frozen" then
		local tile = tiles[event.T]
		if tile then
			float(tile.Card, "FROZEN", ICE_COLOR, true)
			glow(tile, ICE_COLOR)
			tile.Frozen.Visible = true
		end
	elseif kind == "Thaw" then
		local tile = tiles[event.U]
		if tile then
			float(tile.Card, "SKIPPED", ICE_COLOR)
			tile.Frozen.Visible = false
		end
	elseif kind == "Slow" then
		callout(`DECK SLOWED -{math.floor(event.A * 100 + 0.5)}% SPD`, ICE_COLOR, 1.5)
		for _, tile in tiles do
			glow(tile, ICE_COLOR)
		end
	elseif kind == "Barrier" then
		callout("NULL BARRIER! Break it with Skills and Ultimates", Color3.fromRGB(230, 130, 255), 2)
		if bossView then
			bossView:Flash(Color3.fromRGB(220, 140, 255), 0.5)
		end
	elseif kind == "Break" then
		callout("BARRIER BROKEN!", Theme.Color.Gold, 1.4)
		Effects.Sparks(bossHolder, Color3.fromRGB(230, 130, 255), 22, 0.9)
		Effects.Flash(gui, Color3.fromRGB(230, 130, 255), 0.35, 0.6)
		Sfx.Play("Impact", 1.4)
	elseif kind == "Steal" then
		callout(`{string.upper(current.BossName)} STEALS YOUR BUFFS!`, Color3.fromRGB(230, 130, 255), 1.6)
	elseif kind == "Opening" then
		callout("SUPPORT OPENING!", Theme.Color.Support, 1.2)
	elseif kind == "Signature" then
		callout(event.N .. "!", Color3.fromRGB(240, 236, 255), 1.2)
		if event.T then
			float(targetFrame(event.T), "SAVED", Theme.Color.Gold, true)
		end
	elseif kind == "Warn" then
		showWarning(event)
	elseif kind == "Phase" then
		callout(`{string.upper(current.BossName)} UNLEASHES {string.upper(event.N)}!`, current.BossColor, 2)
		shakeStage(12, 0.5)
		Sfx.Play("Impact", 0.8)
		if bossView then
			bossView:Flash(current.BossColor, 0.6)
		end
	elseif kind == "Enrage" then
		callout(`ENRAGED! +{math.floor(Config.Battle.EnrageATK * 100)}% ATK`, Theme.Color.Danger, 2)
		Effects.Flash(gui, Theme.Color.Danger, 0.5, 0.5)
		if bossView then
			bossView:SetTint(Color3.fromRGB(255, 170, 170))
		end
	end
end

local function playBatch(events)
	-- Spread the batch out so actions don't all land on the same frame, and let a card's
	-- hits land when its bolt reaches the boss.
	local groups = 0
	for _, event in events do
		if event.K == "Act" then
			groups += 1
		end
	end
	local spacing = if groups > 1 then FLUSH_SPACING / groups else 0
	local group = 0
	local shooter = nil
	for _, event in events do
		if event.K == "Act" then
			group += 1
			local tile = tiles[event.U]
			shooter = if tile and tile.IsAttack then event.U else nil
		end
		local delay = math.max(0, group - 1) * spacing
		if (event.K == "Hit" or event.K == "Burned") and event.T == "Boss" and event.U == shooter then
			delay += BOLT_TIME
		end
		if delay > 0 then
			task.delay(delay, playEvent, event)
		else
			playEvent(event)
		end
	end
end

-- Backdrop particles -----------------------------------------------------------------------------

local function spawnParticles(kind: string, color: Color3)
	for _, child in particles:GetChildren() do
		child:Destroy()
	end
	local count = if Theme.FxLow then 8 else 20
	for _ = 1, count do
		local size = math.random(3, 8)
		local x = math.random()
		local mote = Kit.new("Frame", {
			Name = "Mote",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(size, size),
			Rotation = math.random(0, 90),
			BackgroundColor3 = if math.random() < 0.25 then Color3.new(1, 1, 1) else color,
			BackgroundTransparency = 0.25 + math.random() * 0.35,
			BorderSizePixel = 0,
			Parent = particles,
		})
		if kind == "Snow" then
			Kit.corner(UDim.new(1, 0)).Parent = mote
		end
		local duration = 5 + math.random() * 6
		local from, to
		if kind == "Snow" then
			from, to = UDim2.fromScale(x, -0.05), UDim2.fromScale(x + (math.random() - 0.5) * 0.2, 1.05)
		elseif kind == "Motes" then
			from = UDim2.fromScale(x, math.random())
			to = UDim2.fromScale(x + (math.random() - 0.5) * 0.15, math.random())
			duration *= 0.8
		else
			from, to = UDim2.fromScale(x, 1.05), UDim2.fromScale(x + (math.random() - 0.5) * 0.25, -0.05)
		end
		mote.Position = from
		local info = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, kind == "Motes", math.random() * duration)
		TweenService:Create(mote, info, { Position = to, Rotation = mote.Rotation + 180 }):Play()
	end
end

-- Intro ------------------------------------------------------------------------------------------

local function playIntro(boss, difficulty: string, deckPower: number, seconds: number)
	for _, child in intro:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	intro.Visible = true
	intro.BackgroundTransparency = 0.35
	local function panel(fromLeft: boolean, color: Color3, deep: Color3, title: string, sub: string)
		local frame = Kit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(if fromLeft then -0.4 else 1.4, if fromLeft then 0.38 else 0.62),
			Size = UDim2.fromScale(0.7, 0.2),
			Rotation = -6,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = intro,
		}, { Kit.gradient(ColorSequence.new(deep, color), if fromLeft then 0 else 180) })
		local name = Kit.label({
			Text = title,
			Font = Theme.Font.Display,
			TextXAlignment = if fromLeft then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right,
			Position = UDim2.fromScale(0.08, 0.1),
			Size = UDim2.fromScale(0.84, 0.55),
			Parent = frame,
		}, 56)
		Kit.textStroke(Color3.new(0, 0, 0), 3, 0.1).Parent = name
		Kit.label({
			Text = sub,
			Font = Theme.Font.Heavy,
			TextXAlignment = if fromLeft then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right,
			Position = UDim2.fromScale(0.08, 0.66),
			Size = UDim2.fromScale(0.84, 0.26),
			Parent = frame,
		}, 24)
		Kit.tween(frame, 0.32, { Position = UDim2.fromScale(0.5, if fromLeft then 0.38 else 0.62) }, Enum.EasingStyle.Quart)
		return frame
	end
	local left = panel(true, Theme.Color.Accent, Theme.Color.AccentDeep, "YOUR DECK", `Deck Power {Kit.commas(deckPower)}`)
	local right = panel(false, boss.Accent, boss.Deep, string.upper(boss.Name), `{boss.Title} · {string.upper(difficulty)}`)
	local vs = Kit.label({
		Text = "VS",
		Font = Theme.Font.Display,
		TextColor3 = Theme.Color.Gold,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.3, 0.16),
		ZIndex = 5,
		Parent = intro,
	}, 90)
	Kit.textStroke(Color3.new(0, 0, 0), 4, 0).Parent = vs
	local vsScale = Kit.new("UIScale", { Scale = 0, Parent = vs })
	task.delay(0.25, function()
		Kit.tween(vsScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		Sfx.Play("Impact", 1.3)
	end)
	task.delay(math.max(0.6, seconds - 0.7), function()
		Kit.tween(left, 0.25, { Position = UDim2.fromScale(-0.5, 0.38) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		Kit.tween(right, 0.25, { Position = UDim2.fromScale(1.5, 0.62) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		vs.Text = "FIGHT!"
		vs.TextColor3 = Color3.new(1, 1, 1)
		vsScale.Scale = 1.6
		Kit.tween(vsScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		Kit.tween(intro, 0.4, { BackgroundTransparency = 1 })
	end)
	task.delay(seconds, function()
		Kit.tween(vs, 0.2, { TextTransparency = 1 }).Completed:Connect(function()
			intro.Visible = false
		end)
	end)
end

-- Results ----------------------------------------------------------------------------------------

local function clearChildren(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local exit -- forward declarations
local startFight

local function showResults(summary)
	current.Ended = true
	warnBanner.Visible = false
	clearChildren(results)
	results.Visible = true
	results.BackgroundTransparency = 1
	Kit.tween(results, 0.3, { BackgroundTransparency = 0.25 })

	local titles = {
		Win = { "VICTORY!", Theme.Color.Gold },
		Lose = { "DEFEAT", Theme.Color.Danger },
		Timeout = { "TIME UP", Theme.Color.Danger },
		Forfeit = { "GAVE UP", Theme.Color.Muted },
	}
	local title = titles[summary.Result] or titles.Lose
	local rewards = summary.Rewards
	local hasRewards = rewards ~= nil and rewards.Results ~= nil and #rewards.Results > 0

	local panel = Kit.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromScale(if hasRewards then 0.9 else 0.55, 0.88),
		BackgroundColor3 = Theme.Color.Panel,
		Parent = results,
	}, {
		Kit.corner(UDim.new(0, 18)),
		Kit.stroke(title[2], 2, 0.2),
		Kit.new("UISizeConstraint", { MaxSize = Vector2.new(if hasRewards then 1100 else 560, 620), MinSize = Vector2.new(300, 220) }),
	})
	local panelScale = Kit.new("UIScale", { Scale = 0.85, Parent = panel })
	Kit.tween(panelScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

	local list = Kit.new("Frame", {
		Name = "Summary",
		Size = UDim2.new(if hasRewards then 0.36 else 1, 0, 1, -64),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		Kit.padding(14),
		Kit.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 5),
		}),
	})
	local order = 0
	local function line(text: string, color: Color3, height: number, font: Enum.Font?)
		order += 1
		return Kit.label({
			Text = text,
			RichText = true,
			Font = font or Theme.Font.Heavy,
			TextColor3 = color,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, height),
			Parent = list,
		}, height)
	end
	local heading = line(title[1], title[2], 46, Theme.Font.Display)
	local headingScale = Kit.new("UIScale", { Scale = 0.4, Parent = heading })
	Kit.tween(headingScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)

	local timeText = string.format("%d:%04.1f", summary.Time // 60, summary.Time % 60)
	if summary.Result == "Win" then
		line(`{current.BossName} · {current.Difficulty} · {timeText}`, Theme.Color.Text, 18, Theme.Font.Bold)
		local notes = {}
		if summary.FirstClear then
			table.insert(notes, "First clear!")
		end
		if summary.NewBest and not summary.FirstClear then
			table.insert(notes, "New best time!")
		end
		if summary.SpeedUnlocked and not current.SpeedUnlocked then
			table.insert(notes, "2x speed unlocked!")
		end
		if #notes > 0 then
			line(table.concat(notes, "  ·  "), Theme.Color.Gold, 18)
		end
		if hasRewards then
			local floor = rewards.Floor and Rarity.Get(rewards.Floor)
			line(
				`{#rewards.Results} reward rolls · {string.format("%.2f", rewards.Luck or 1)}x luck · <font color="#{floor and floor.Color:ToHex() or "FFFFFF"}">{rewards.Floor or ""}+</font>`,
				Theme.Color.Muted,
				15,
				Theme.Font.Bold
			)
			if rewards.Bundle then
				line(`Loot: {Meta.Describe(rewards.Bundle)}`, Theme.Color.Gold, 18)
			end
			if rewards.Meta then
				State.ApplyMeta(rewards.Meta)
			end
		end
		Effects.Sparks(panel, Theme.Color.Gold, 30, 0.8)
		Sfx.Play("Impact", 1.2)
	else
		local left = summary.BossHP and summary.BossMaxHP and math.floor(summary.BossHP / summary.BossMaxHP * 100 + 0.5)
		line(`{current.BossName} had {left or "?"}% HP left · {timeText}`, Theme.Color.Text, 18, Theme.Font.Bold)
		line("Roll for stronger cards, tune your deck, then try again.", Theme.Color.Muted, 15, Theme.Font.Medium)
	end

	-- Damage dealt by each card, biggest first, as small bars.
	if summary.Units then
		local rows = {}
		local top = 1
		for id, u in summary.Units do
			table.insert(rows, { Id = id, Dealt = u.Dealt, Healed = u.Healed, Alive = u.Alive })
			top = math.max(top, u.Dealt, u.Healed)
		end
		table.sort(rows, function(a, b)
			if a.Dealt ~= b.Dealt then
				return a.Dealt > b.Dealt
			end
			return a.Healed > b.Healed
		end)
		for i, row in rows do
			local card = Cards.Get(current.CardOf[row.Id])
			if card then
				order += 1
				local value = if card.Type == "Attack" then row.Dealt else row.Healed
				local holder = Kit.new("Frame", {
					LayoutOrder = order,
					Size = UDim2.new(1, 0, 0, 20),
					BackgroundColor3 = Theme.Color.PanelLight,
					BackgroundTransparency = 0.4,
					Parent = list,
				}, { Kit.corner(UDim.new(0.4, 0)) })
				local fill = Kit.new("Frame", {
					Size = UDim2.fromScale(0, 1),
					BackgroundColor3 = if card.Type == "Attack" then Theme.Color.Attack else Theme.Color.Support,
					BackgroundTransparency = 0.45,
					Parent = holder,
				}, { Kit.corner(UDim.new(0.4, 0)) })
				task.delay(0.1 + i * 0.05, function()
					Kit.tween(fill, 0.5, { Size = UDim2.fromScale(math.max(0.02, value / top), 1) }, Enum.EasingStyle.Quad)
				end)
				local mvp = if i == 1 and row.Dealt > 0 then ' <font color="#FFC42E">MVP</font>' else ""
				local ko = if row.Alive then "" else ' <font color="#FF5064">KO</font>'
				local what = if card.Type == "Attack" then "dmg" else "healed + shielded"
				Kit.label({
					Text = `  {card.Name}{mvp}{ko}  <font color="#E6E2FF">{Kit.commas(value)} {what}</font>`,
					RichText = true,
					Font = Theme.Font.Bold,
					TextXAlignment = Enum.TextXAlignment.Left,
					Size = UDim2.fromScale(1, 0.8),
					Position = UDim2.fromScale(0, 0.1),
					ZIndex = 2,
					Parent = holder,
				}, 14)
			end
		end
	end

	-- Rewards on the right.
	local buttons = Kit.new("Frame", {
		Name = "Buttons",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(1, -24, 0, 44),
		BackgroundTransparency = 1,
		Visible = not hasRewards,
		Parent = panel,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10),
		}),
	})
	if hasRewards then
		local area = Kit.new("Frame", {
			Name = "Rewards",
			Position = UDim2.new(0.37, 0, 0, 14),
			Size = UDim2.new(0.61, 0, 1, -84),
			BackgroundColor3 = Theme.Color.Backdrop,
			BackgroundTransparency = 0.4,
			Parent = panel,
		}, { Kit.corner(UDim.new(0, 14)), Kit.padding(10) })
		Kit.label({
			Text = "REWARDS",
			Font = Theme.Font.Display,
			TextColor3 = Theme.Color.Gold,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 0, -2),
			Size = UDim2.new(0.5, 0, 0, 22),
			Parent = area,
		}, 22)
		RewardReveal.Play(area, rewards, function()
			if buttons.Parent then
				buttons.Visible = true
			end
		end)
	end

	local back = Kit.button("BACK TO HUB", Theme.Color.Auto, Theme.Color.AutoDeep, {
		LayoutOrder = 1,
		Size = UDim2.new(0, 170, 1, 0),
		Parent = buttons,
	})
	back.Activated:Connect(function()
		Sfx.Play("Click")
		exit()
	end)
	local again = Kit.button("FIGHT AGAIN", Theme.Color.Roll, Theme.Color.RollDeep, {
		LayoutOrder = 2,
		Size = UDim2.new(0, 170, 1, 0),
		Parent = buttons,
	})
	local bossId, difficulty = current.BossId, current.Difficulty
	again.Activated:Connect(function()
		Sfx.Play("Click")
		local ok, message = startFight(bossId, difficulty)
		if not ok and message then
			hint(message)
		end
	end)
end

-- Scene -----------------------------------------------------------------------------------------

local function setAutoLabel()
	local on = current ~= nil and current.AutoUlt
	autoButton.Label.Text = if on then "AUTO ULT: ON" else "AUTO ULT: OFF"
	autoButton.UIStroke.Transparency = if on then 0 else 0.75
	autoButton.UIStroke.Thickness = if on then 3 else 1.5
end

local function setSpeedLabel()
	local speed = if current then current.Speed else 1
	speedButton.Label.Text = `SPEED {speed}x`
	speedButton.Label.TextTransparency = if current and current.SpeedUnlocked then 0 else 0.5
end

local function begin(start, bossId: string, difficulty: string)
	local boss = Bosses.Get(bossId)
	current = {
		Info = start.Info,
		BossId = bossId,
		Difficulty = difficulty,
		BossName = boss.Name,
		BossColor = boss.Accent,
		Speed = start.Speed,
		SpeedUnlocked = start.SpeedUnlocked,
		AutoUlt = start.AutoUlt,
		Ended = false,
		CardOf = {},
	}
	State.InBattle = true
	table.clear(tiles)
	table.clear(ultTapped)
	clearChildren(frontRow)
	clearChildren(backRow)
	clearChildren(fxLayer)
	results.Visible = false
	warnBanner.Visible = false
	calloutLabel.TextTransparency = 1

	-- World theme.
	backdrop.UIGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, boss.Deep:Lerp(Color3.new(0, 0, 0), 0.35)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(16, 12, 26)),
		ColorSequenceKeypoint.new(1, boss.Deep),
	})
	spawnParticles(boss.Particles, boss.Accent)

	-- The boss, live in 3D.
	if bossView then
		bossView.Frame:Destroy()
	end
	bossView = ModelView.new(bossId, {
		Name = "BossView",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.6, 1.25),
		ZIndex = 2,
		Parent = bossHolder,
	}, 10)
	barrierRing.Visible = false

	for i, unit in start.Info.Allies do
		current.CardOf[unit.Id] = unit.CardId
		local tile = makeTile(unit, i)
		tile.Parent = if string.sub(unit.Id, 1, 1) == "A" then frontRow else backRow
	end
	local diffIndex = Bosses.DifficultyIndex(difficulty)
	bossName.Text = `{string.upper(boss.Name)}  <font color="#A8A2C8">{boss.Title}</font>`
	bossChip.Label.Text = string.upper(difficulty)
	bossChip.BackgroundColor3 = if diffIndex == 3 then Theme.Color.Danger elseif diffIndex == 2 then Theme.Color.Roll else Theme.Color.Quick
	bossHpFill.Size = UDim2.fromScale(1, 1)
	bossHpTrail.Size = UDim2.fromScale(1, 1)
	bossBarrier.Size = UDim2.fromScale(0, 1)
	bossGauge.Size = UDim2.fromScale(0, 1)
	bossStatus.Text = ""
	setAutoLabel()
	setSpeedLabel()
	applySnapshot(start.Snap)

	gui.Enabled = true
	hooks.OnStart()
	playIntro(boss, difficulty, start.DeckPower or 0, start.Intro or 2)
end

function startFight(bossId: string, difficulty: string)
	if current and not current.Ended then
		return false, nil
	end
	local ok, result = pcall(function()
		return Remotes.BattleStart:InvokeServer(bossId, difficulty)
	end)
	if not ok or not result or not result.Ok then
		local reason = if ok and result then result.Reason else nil
		return false, REASONS[reason] or "Couldn't start the fight"
	end
	begin(result, bossId, difficulty)
	return true, nil
end

function exit()
	current = nil
	lastSnap = nil
	State.InBattle = false
	gui.Enabled = false
	results.Visible = false
	if bossView then
		bossView.Frame:Destroy()
		bossView = nil
	end
	for _, child in particles:GetChildren() do
		child:Destroy()
	end
	hooks.OnEnd()
end

function Battle.Init(playerGui: Instance, battleHooks: Hooks)
	hooks = battleHooks
	gui = Kit.screenGui("BattleGui", 4, playerGui) -- below the HUD so the Auto Roll feed stays visible
	gui.IgnoreGuiInset = true
	gui.Enabled = false

	backdrop = Kit.new("Frame", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.02,
		Active = true,
		ZIndex = 1,
		Parent = gui,
	}, {
		Kit.gradient(ColorSequence.new(Color3.fromRGB(20, 14, 30), Color3.fromRGB(70, 26, 20)), 90),
	})
	particles = Kit.new("Frame", {
		Name = "Particles",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = gui,
	})
	-- Soft spotlight behind the boss.
	Kit.new("Frame", {
		Name = "Spotlight",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromScale(0.55, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.9,
		ZIndex = 2,
		Parent = gui,
	}, {
		Kit.corner(UDim.new(1, 0)),
		Kit.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})

	local inset = GuiService:GetGuiInset()
	STAGE_HOME = UDim2.new(0, 0, 0, inset.Y + 4)
	stage = Kit.new("Frame", {
		Name = "Stage",
		Position = STAGE_HOME,
		Size = UDim2.new(1, 0, 1, -inset.Y - 10),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = gui,
	})

	-- Boss panel: name + difficulty, HP bar (trail, barrier, 50% / 20% markers), action bar, status.
	local bossArea = Kit.new("Frame", {
		Name = "Boss",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.6, 0.17),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = stage,
	}, { Kit.new("UISizeConstraint", { MaxSize = Vector2.new(820, 112) }) })
	bossName = Kit.label({
		Name = "BossName",
		Text = "",
		RichText = true,
		Font = Theme.Font.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromScale(0.62, 0.3),
		Parent = bossArea,
	}, 22)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.3).Parent = bossName
	bossChip = Kit.new("Frame", {
		Name = "Difficulty",
		Position = UDim2.fromScale(0.63, 0.02),
		Size = UDim2.fromScale(0.15, 0.25),
		BackgroundColor3 = Theme.Color.Quick,
		Parent = bossArea,
	}, { Kit.corner(UDim.new(0.5, 0)) })
	Kit.label({
		Name = "Label",
		Text = "NORMAL",
		Font = Theme.Font.Heavy,
		Size = UDim2.fromScale(0.9, 0.75),
		Position = UDim2.fromScale(0.05, 0.12),
		Parent = bossChip,
	}, 14)
	timerLabel = Kit.label({
		Name = "Timer",
		Text = "3:00",
		Font = Theme.Font.Display,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(0.2, 0.3),
		Parent = bossArea,
	}, 26)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.3).Parent = timerLabel
	local hpTrack
	hpTrack, bossHpFill, bossHpTrail = bar(bossArea, "BossHP", 0.34, 0.34, Color3.new(1, 1, 1), true)
	bossHpFill.Size = UDim2.fromScale(1, 1)
	Kit.gradient(ColorSequence.new(Color3.fromRGB(255, 170, 70), Color3.fromRGB(220, 50, 60)), 0).Parent = bossHpFill
	bossBarrier = Kit.new("Frame", {
		Name = "Barrier",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(220, 140, 255),
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = hpTrack,
	}, { Kit.corner(UDim.new(1, 0)) })
	for _, at in { Config.Battle.PhaseAt, Config.Battle.EnrageAt } do
		Kit.new("Frame", {
			Name = "Marker",
			Position = UDim2.fromScale(at, 0),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = hpTrack,
		})
	end
	bossHpText = Kit.label({
		Name = "HpText",
		Text = "",
		Font = Theme.Font.Heavy,
		Size = UDim2.fromScale(1, 0.9),
		Position = UDim2.fromScale(0, 0.05),
		ZIndex = 5,
		Parent = hpTrack,
	}, 18)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.2).Parent = bossHpText
	local _, gaugeFill = bar(bossArea, "BossAction", 0.72, 0.08, Theme.Color.Danger)
	bossGauge = gaugeFill
	bossStatus = Kit.label({
		Name = "Status",
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Support,
		Position = UDim2.fromScale(0, 0.82),
		Size = UDim2.fromScale(1, 0.18),
		Parent = bossArea,
	}, 15)

	-- The boss figure sits in this holder; floats and hit rings anchor to it.
	bossHolder = Kit.new("Frame", {
		Name = "BossHolder",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.33),
		Size = UDim2.fromScale(0.26, 0.26),
		BackgroundTransparency = 1,
		Parent = stage,
	}, { Kit.aspect(1, Enum.DominantAxis.Height) })
	barrierRing = Kit.new("Frame", {
		Name = "BarrierRing",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.15, 1.15),
		BackgroundColor3 = Color3.fromRGB(200, 120, 255),
		BackgroundTransparency = 0.88,
		Visible = false,
		ZIndex = 3,
		Parent = bossHolder,
	}, { Kit.corner(UDim.new(1, 0)) })
	local barrierStroke = Kit.stroke(Color3.fromRGB(230, 150, 255), 3, 0.1)
	barrierStroke.Parent = barrierRing
	pulseForever(barrierStroke, { Transparency = 0.6, Thickness = 6 }, 0.6)

	calloutLabel = Kit.label({
		Name = "Callout",
		Text = "",
		Font = Theme.Font.Display,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.75, 0.065),
		ZIndex = 30,
		Parent = stage,
	}, 40)
	Kit.textStroke(Color3.new(0, 0, 0), 2.5, 0.1).Parent = calloutLabel
	Kit.new("UIScale", { Scale = 1, Parent = calloutLabel })

	warnBanner = Kit.new("Frame", {
		Name = "Warning",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.42, 0.06),
		BackgroundColor3 = Theme.Color.Danger,
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 25,
		Parent = stage,
	}, {
		Kit.corner(UDim.new(0.5, 0)),
		Kit.new("UISizeConstraint", { MinSize = Vector2.new(220, 28), MaxSize = Vector2.new(560, 52) }),
	})
	pulseForever(warnBanner, { BackgroundTransparency = 0.45 }, 0.25)
	warnLabel = Kit.label({
		Name = "Text",
		Text = "",
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.7),
		ZIndex = 26,
		Parent = warnBanner,
	}, 28)

	-- Card rows: Attack (front) above Support (back, slimmer: no HP).
	local rowsFrame = Kit.new("Frame", {
		Name = "Rows",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(0.64, 0.46),
		BackgroundTransparency = 1,
		Parent = stage,
	}, { Kit.new("UISizeConstraint", { MaxSize = Vector2.new(980, 320) }) })
	local function rowLabel(text: string, y: number, color: Color3)
		Kit.label({
			Text = text,
			Font = Theme.Font.Heavy,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromScale(0, y),
			Size = UDim2.fromScale(0.6, 0.07),
			Parent = rowsFrame,
		}, 14)
	end
	local function row(name: string, y: number, height: number): Frame
		return Kit.new("Frame", {
			Name = name,
			Position = UDim2.fromScale(0, y),
			Size = UDim2.fromScale(1, height),
			BackgroundTransparency = 1,
			Parent = rowsFrame,
		}, {
			Kit.new("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 8),
			}),
		})
	end
	rowLabel("ATTACK · FRONT ROW", 0, Theme.Color.Attack)
	frontRow = row("Front", 0.08, 0.5)
	rowLabel("SUPPORT · BACK ROW · CAN'T BE HIT", 0.6, Theme.Color.Support)
	backRow = row("Back", 0.68, 0.32)

	-- Controls down the left edge (where the main menu sits outside battle).
	local controlsFrame = Kit.new("Frame", {
		Name = "Controls",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.66, 0),
		Size = UDim2.fromScale(0.15, 0.4),
		BackgroundTransparency = 1,
		Parent = stage,
	}, {
		Kit.new("UISizeConstraint", { MinSize = Vector2.new(96, 120), MaxSize = Vector2.new(170, 220) }),
		Kit.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 8),
		}),
	})
	autoButton = Kit.button("AUTO ULT: OFF", Theme.Color.Accent, Theme.Color.AutoDeep, {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0.28, 0),
		Parent = controlsFrame,
	})
	autoButton.Activated:Connect(function()
		if current == nil or current.Ended then
			return
		end
		Sfx.Play("Click")
		current.AutoUlt = not current.AutoUlt
		State.Battle.AutoUlt = current.AutoUlt
		Remotes.BattleInput:FireServer("Auto", current.AutoUlt)
		setAutoLabel()
		if lastSnap then
			applySnapshot(lastSnap)
		end
	end)
	speedButton = Kit.button("SPEED 1x", Theme.Color.Auto, Theme.Color.AutoDeep, {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0.28, 0),
		Parent = controlsFrame,
	})
	speedButton.Activated:Connect(function()
		if current == nil or current.Ended then
			return
		end
		Sfx.Play("Click")
		if not current.SpeedUnlocked then
			hint("2x speed unlocks after clearing World 1 Normal")
			return
		end
		local speeds = Config.Battle.Speeds
		local index = table.find(speeds, current.Speed) or 1
		current.Speed = speeds[index % #speeds + 1]
		State.Battle.Speed = current.Speed
		Remotes.BattleInput:FireServer("Speed", current.Speed)
		setSpeedLabel()
	end)
	forfeitButton = Kit.button("GIVE UP", Theme.Color.Danger, Color3.fromRGB(120, 20, 40), {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0.28, 0),
		Parent = controlsFrame,
	})
	local armed = false
	forfeitButton.Activated:Connect(function()
		if current == nil or current.Ended then
			return
		end
		Sfx.Play("Click")
		if not armed then
			armed = true
			forfeitButton.Label.Text = "TAP AGAIN"
			task.delay(2.5, function()
				armed = false
				forfeitButton.Label.Text = "GIVE UP"
			end)
			return
		end
		armed = false
		forfeitButton.Label.Text = "GIVE UP"
		Remotes.BattleInput:FireServer("Forfeit")
	end)

	hintLabel = Kit.label({
		Name = "Hint",
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Gold,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.22),
		Size = UDim2.fromScale(0.6, 0.05),
		ZIndex = 30,
		Parent = stage,
	}, 20)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.3).Parent = hintLabel

	fxLayer = Kit.new("Frame", {
		Name = "Fx",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = gui,
	})
	intro = Kit.new("Frame", {
		Name = "Intro",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		Visible = false,
		ZIndex = 45,
		Parent = gui,
	})
	results = Kit.new("Frame", {
		Name = "Results",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Color.Backdrop,
		BackgroundTransparency = 0.25,
		Visible = false,
		Active = true,
		ZIndex = 50,
		Parent = gui,
	})

	Remotes.BattleEvent.OnClientEvent:Connect(function(message)
		if current == nil then
			return
		end
		if message.Events then
			playBatch(message.Events)
		end
		if message.Snap then
			applySnapshot(message.Snap)
		end
		if message.Done then
			if message.Done.Progress then
				State.ApplyProgress(message.Done.Progress)
			end
			if message.Done.Result == "Stopped" then
				exit()
				return
			end
			-- Let the last hits land before the results panel.
			task.delay(0.9, function()
				if current and not current.Ended then
					showResults(message.Done)
				end
			end)
		end
	end)
end

-- Starts a fight. Returns false and a message when the server refuses.
function Battle.Start(bossId: string, difficulty: string): (boolean, string?)
	return startFight(bossId, difficulty)
end

function Battle.IsActive(): boolean
	return current ~= nil
end

return Battle
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">BossScreen</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Boss screen: pick a world and difficulty, see the boss in 3D, compare Deck Power with the
-- recommended power, preview the rewards, switch deck presets, then fight.
-- Opened from the BATTLE button or by challenging a boss in the hub.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cards = require(Shared.Cards)
local Bosses = require(Shared.Bosses)
local Config = require(Shared.Config)
local Deck = require(Shared.Deck)
local Rarity = require(Shared.Rarity)
local Rewards = require(Shared.Rewards)
local Meta = require(Shared.Meta)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local ModelView = require(script.Parent.ModelView)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.Parent.State)

local BossScreen = {}

export type Actions = {
	EditDeck: () -> (),
	Fight: (bossId: string, difficulty: string) -> (boolean, string?),
}

local actions: Actions
local modal
local bossId = Bosses.List[1].Id
local difficulty = "Normal"
local showcase: Frame -- left: the boss in 3D
local showcaseGradient: UIGradient
local showcaseName: TextLabel
local showcaseTitle: TextLabel
local showcaseWorld: TextLabel
local view = nil -- ModelView
local viewBoss = nil
local body: ScrollingFrame -- right: details
local tabs: Frame
local hintLabel: TextLabel
local hintToken = 0

local function cleared(): { [string]: boolean }
	return State.Progress.Cleared or {}
end

local function hint(text: string)
	hintToken += 1
	local token = hintToken
	hintLabel.Text = text
	hintLabel.TextTransparency = 0
	task.delay(2.5, function()
		if token == hintToken then
			Kit.tween(hintLabel, 0.4, { TextTransparency = 1 })
		end
	end)
end

local function pill(parent: Instance, text: string, order: number, width: number, color: Color3, on: boolean, locked: boolean): TextButton
	local button = Kit.new("TextButton", {
		Name = text,
		LayoutOrder = order,
		Size = UDim2.new(0, width, 1, 0),
		AutoButtonColor = false,
		BackgroundColor3 = if on then color else Theme.Color.PanelLight,
		BackgroundTransparency = if locked then 0.55 else 0,
		Text = "",
		Parent = parent,
	}, { Kit.corner(UDim.new(0.5, 0)) })
	if on then
		Kit.stroke(Color3.new(1, 1, 1), 2, 0.3).Parent = button
	end
	Kit.label({
		Text = text,
		Font = Theme.Font.Heavy,
		TextTransparency = if locked then 0.45 else 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.88, 0.6),
		Parent = button,
	}, 15)
	Kit.pressable(button)
	return button
end

local function row(order: number, height: number): Frame
	return Kit.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			Wraps = true,
		}),
	})
end

local function text(parent: Instance, order: number, value: string, color: Color3, size: number, font: Enum.Font?): TextLabel
	return Kit.label({
		LayoutOrder = order,
		Text = value,
		RichText = true,
		Font = font or Theme.Font.Bold,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = false,
		TextSize = size,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, size + 4),
		Parent = parent,
	}, size)
end

local function box(order: number, color: Color3): Frame
	return Kit.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Color.PanelLight,
		BackgroundTransparency = 0.25,
		Parent = body,
	}, {
		Kit.corner(UDim.new(0, 12)),
		Kit.stroke(color, 1.5, 0.5),
		Kit.padding(10),
		Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
	})
end

local refresh

local function setShowcase(boss)
	showcaseGradient.Color = ColorSequence.new(boss.Accent:Lerp(Color3.new(0, 0, 0), 0.25), boss.Deep)
	showcaseName.Text = string.upper(boss.Name)
	showcaseTitle.Text = boss.Title
	showcaseWorld.Text = `WORLD {boss.World} · {string.upper(boss.WorldName)}`
	if viewBoss ~= boss.Id then
		if view then
			view.Frame:Destroy()
		end
		view = ModelView.new(boss.Id, {
			Name = "Boss",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 0.8),
			ZIndex = 2,
			Parent = showcase,
		}, 0, 5)
		viewBoss = boss.Id
	end
	local locked = not Bosses.IsUnlocked(cleared(), boss.Id, "Normal")
	view:SetTint(if locked then Color3.fromRGB(60, 56, 80) else Color3.new(1, 1, 1))
end

local function buildTabs()
	for _, child in tabs:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for i, other in Bosses.List do
		local open = Bosses.IsUnlocked(cleared(), other.Id, "Normal")
		local button = pill(tabs, if open then `WORLD {other.World}` else `WORLD {other.World} · LOCKED`, i, if open then 92 else 150, other.Accent, other.Id == bossId, not open)
		button.Activated:Connect(function()
			Sfx.Play("Click")
			bossId = other.Id
			difficulty = "Normal"
			refresh()
		end)
	end
end

local function build()
	hintLabel.Parent = nil -- reused across rebuilds
	for _, child in body:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local boss = Bosses.Get(bossId)
	local fight = boss.Difficulties[difficulty]
	local key = Bosses.FightKey(boss.Id, difficulty)
	local unlocked = Bosses.IsUnlocked(cleared(), boss.Id, difficulty)
	local deck = State.ActiveDeck() or Deck.Empty()
	local power = Deck.Power(deck, State.Cards)
	setShowcase(boss)
	buildTabs()

	text(body, 1, boss.Mechanic, Theme.Color.Muted, 15, Theme.Font.Medium)

	-- Difficulty: cleared ones get a tick, locked ones say what opens them.
	local diffRow = row(2, 32)
	for i, name in Bosses.DifficultyOrder do
		local open = Bosses.IsUnlocked(cleared(), boss.Id, name)
		local done = cleared()[Bosses.FightKey(boss.Id, name)] == true
		local color = if i == 3 then Theme.Color.Danger elseif i == 2 then Theme.Color.Roll else Theme.Color.Quick
		local label = string.upper(name) .. (if done then "  ✓" else "")
		local button = pill(diffRow, label, i, 118, color, name == difficulty, not open)
		button.Activated:Connect(function()
			Sfx.Play("Click")
			difficulty = name
			refresh()
		end)
	end
	if not unlocked then
		text(body, 3, `LOCKED · {Bosses.UnlockHint(boss.Id, difficulty)} to open this fight.`, Theme.Color.Roll, 15, Theme.Font.Heavy)
	end

	-- Power check with a bar against the recommended power.
	local enough = power >= fight.Recommended
	local powerBox = box(4, if enough then Theme.Color.Quick else Theme.Color.Roll)
	text(
		powerBox,
		1,
		`Recommended <b>{Kit.commas(fight.Recommended)}</b>   ·   Your deck <font color="{if enough then "#56D68A" else "#FF7846"}"><b>{Kit.commas(power)}</b></font>`,
		Theme.Color.Text,
		17,
		Theme.Font.Heavy
	)
	local track = Kit.new("Frame", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 10),
		BackgroundColor3 = Theme.Color.Backdrop,
		Parent = powerBox,
	}, { Kit.corner(UDim.new(1, 0)) })
	local fill = Kit.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = if enough then Theme.Color.Quick else Theme.Color.Roll,
		Parent = track,
	}, { Kit.corner(UDim.new(1, 0)) })
	Kit.tween(fill, 0.5, { Size = UDim2.fromScale(math.clamp(power / (fight.Recommended * 1.5), 0.02, 1), 1) }, Enum.EasingStyle.Quad)
	Kit.new("Frame", {
		Position = UDim2.fromScale(1 / 1.5, 0),
		Size = UDim2.new(0, 2, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	})
	if not enough then
		text(powerBox, 3, "Below the recommended power: roll for more cards, or try anyway!", Theme.Color.Roll, 14, Theme.Font.Medium)
	end

	-- Rewards preview.
	local reward = Rewards.For(fight.D)
	local floor = Rarity.Get(reward.Floor)
	local bonus = Rarity.Get(reward.Bonus)
	local rewardBox = box(5, Theme.Color.Gold)
	text(rewardBox, 1, "WIN REWARDS", Theme.Color.Gold, 15, Theme.Font.Heavy)
	text(
		rewardBox,
		2,
		`<b>{reward.Rolls}</b> reward rolls  ·  <b>{string.format("%.2f", reward.Luck)}x</b> luck  ·  every card <font color="#{floor.Color:ToHex()}"><b>{reward.Floor}</b></font> or better`,
		Theme.Color.Text,
		15
	)
	local dropPotion = Meta.PotionById[reward.Potion]
	text(
		rewardBox,
		3,
		`+💎{reward.Shards} Shards  ·  {math.floor(Config.Rewards.PotionChance * 100)}% chance of a {dropPotion.Icon} {dropPotion.Name}`,
		Theme.Color.Text,
		14,
		Theme.Font.Bold
	)
	local best = State.Progress.BestTime and State.Progress.BestTime[key]
	if cleared()[key] then
		local bestText = if best then string.format("Best time %d:%04.1f", best // 60, best % 60) else "Cleared"
		text(rewardBox, 4, `✓ {bestText}`, Theme.Color.Quick, 14, Theme.Font.Heavy)
	else
		text(
			rewardBox,
			4,
			`FIRST CLEAR BONUS: +1 <font color="#{bonus.Color:ToHex()}"><b>{reward.Bonus}</b></font> or better card`,
			Theme.Color.Text,
			14,
			Theme.Font.Heavy
		)
	end

	-- Deck presets + a peek at the active deck.
	local presetRow = row(6, 30)
	for i = 1, Config.Deck.Presets do
		local preset = State.Decks.Presets[i] or Deck.Empty()
		local button = pill(presetRow, `DECK {i} · {Kit.commas(Deck.Power(preset, State.Cards))}`, i, 136, Theme.Color.Accent, i == State.Decks.Active, false)
		button.Activated:Connect(function()
			Sfx.Play("Click")
			if i == State.Decks.Active then
				return
			end
			local ok, result = pcall(function()
				return Remotes.Deck:InvokeServer("Select", i)
			end)
			if ok and result and result.Decks then
				State.ApplyDecks(result.Decks)
			end
		end)
	end

	local peek = row(7, 38)
	local order = 0
	for _, deckRow in Deck.Rows do
		for _, id in deck[deckRow] do
			order += 1
			local card = if id ~= "" then Cards.Get(id) else nil
			local chip = Kit.new("Frame", {
				LayoutOrder = order,
				Size = UDim2.fromOffset(36, 36),
				BackgroundColor3 = if card then card.Accent else Theme.Color.PanelLight,
				BackgroundTransparency = if card then 0 else 0.5,
				Parent = peek,
			}, { Kit.corner(UDim.new(0.25, 0)) })
			if card then
				Kit.stroke(Rarity.Get(card.Rarity).Color, 2, 0).Parent = chip
			end
			Kit.label({
				Text = if card then card.Glyph else "-",
				Font = Theme.Font.Display,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.8, 0.6),
				Parent = chip,
			}, 16)
		end
		if deckRow == "Attack" then
			order += 1
			Kit.new("Frame", { LayoutOrder = order, Size = UDim2.fromOffset(10, 36), BackgroundTransparency = 1, Parent = peek })
		end
	end

	-- Buttons
	local buttons = row(8, 48)
	local edit = Kit.button("EDIT DECK", Theme.Color.Auto, Theme.Color.AutoDeep, {
		LayoutOrder = 1,
		Size = UDim2.new(0, 150, 1, 0),
		Parent = buttons,
	})
	edit.Activated:Connect(function()
		Sfx.Play("Click")
		actions.EditDeck()
	end)
	local fightButton = Kit.button(if unlocked then "FIGHT!" else "LOCKED", Theme.Color.Roll, Theme.Color.RollDeep, {
		LayoutOrder = 2,
		Size = UDim2.new(0, 180, 1, 0),
		Parent = buttons,
	})
	if not unlocked then
		fightButton.BackgroundTransparency = 0.5
	end
	fightButton.Activated:Connect(function()
		Sfx.Play("Click")
		if not unlocked then
			hint(`{Bosses.UnlockHint(boss.Id, difficulty)} first`)
			return
		end
		if Deck.Count(deck, "Attack") == 0 then
			hint("Put at least one Attack card in your deck first")
			return
		end
		local ok, message = actions.Fight(bossId, difficulty)
		if ok then
			modal:Close()
		elseif message then
			hint(message)
		end
	end)
	hintLabel.Parent = buttons
end

function refresh()
	if modal.IsOpen then
		build()
	end
end

function BossScreen.Init(playerGui: Instance, bossActions: Actions)
	actions = bossActions
	modal = Modal.new(playerGui, "BossGui", "BATTLE", Vector2.new(0.9, 0.86), Vector2.new(1040, 660))

	tabs = Kit.new("Frame", {
		Name = "Worlds",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -58, 0, 12),
		Size = UDim2.new(0.62, 0, 0, 30),
		BackgroundTransparency = 1,
		Parent = modal.Header,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}),
	})

	showcase = Kit.new("Frame", {
		Name = "Showcase",
		Size = UDim2.new(0.38, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Parent = modal.Body,
	}, { Kit.corner(UDim.new(0, 16)) })
	showcaseGradient = Kit.gradient(ColorSequence.new(Color3.fromRGB(80, 40, 30), Color3.fromRGB(20, 12, 20)), 90)
	showcaseGradient.Parent = showcase
	Kit.new("Frame", {
		Name = "Floor",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.86),
		Size = UDim2.fromScale(0.8, 0.08),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Parent = showcase,
	}, { Kit.corner(UDim.new(1, 0)) })
	showcaseWorld = Kit.label({
		Name = "World",
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Color3.fromRGB(230, 226, 255),
		Position = UDim2.new(0, 12, 0, 10),
		Size = UDim2.new(1, -24, 0, 18),
		ZIndex = 3,
		Parent = showcase,
	}, 16)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.3).Parent = showcaseWorld
	showcaseName = Kit.label({
		Name = "Name",
		Text = "",
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.new(1, -20, 0.1, 0),
		ZIndex = 3,
		Parent = showcase,
	}, 34)
	Kit.textStroke(Color3.new(0, 0, 0), 2, 0.2).Parent = showcaseName
	showcaseTitle = Kit.label({
		Name = "Title",
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Color3.fromRGB(216, 210, 240),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -20, 0, 18),
		ZIndex = 3,
		Parent = showcase,
	}, 17)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.3).Parent = showcaseTitle

	body = Kit.new("ScrollingFrame", {
		Name = "Details",
		Position = UDim2.fromScale(0.4, 0),
		Size = UDim2.fromScale(0.6, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = modal.Body,
	}, {
		Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
		Kit.new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 2) }),
	})
	hintLabel = Kit.label({
		Name = "Hint",
		LayoutOrder = 3,
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0, 260, 0.8, 0),
	}, 16)

	modal.OnOpen = build
	State.Changed:Connect(function(kind)
		if kind ~= "roll" then
			refresh()
		end
	end)
end

function BossScreen.Toggle()
	modal:Toggle()
end

function BossScreen.Open(id: string?)
	if id and Bosses.Get(id) then
		if id ~= bossId then
			difficulty = "Normal"
		end
		bossId = id
	end
	modal:Open()
end

return BossScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">CardTile</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Square card tile for the deck and Index grids: full art, rarity border, letter badge,
-- star and copies pills and a big power number. Size it from outside (grid cell or slot).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared.Rarity)
local Cards = require(Shared.Cards)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Skin = require(script.Parent.Skin)
local Effects = require(script.Parent.Effects)
local CardView = require(script.Parent.CardView)

local CardTile = {}

CardTile.Letters = { Common = "C", Uncommon = "U", Rare = "R", Epic = "E", Legendary = "L", Mythic = "M", Secret = "S" }

export type Options = {
	Owned: boolean?,
	Stars: number?,
	Copies: number?,
	Power: number?, -- shown big along the bottom
	InDeck: boolean?,
	Selected: boolean?,
	Spin: boolean?, -- spin a Secret card's prismatic border (only for a few tiles at once)
}

local function outlined(label: TextLabel, thickness: number?)
	Kit.textStroke(Color3.fromRGB(16, 8, 30), thickness or 2, 0).Parent = label
	return label
end

function CardTile.new(cardId: string, opts: Options?): TextButton
	local options = opts or {}
	local card = Cards.Get(cardId)
	assert(card, `Unknown card {cardId}`)
	local tier = Rarity.Get(card.Rarity)
	local owned = options.Owned ~= false

	local button = Kit.new("TextButton", {
		Name = cardId,
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Text = "",
	}, {
		Kit.corner(UDim.new(0.12, 0)),
		Kit.gradient(
			ColorSequence.new(
				if owned then card.Accent:Lerp(Color3.new(1, 1, 1), 0.1) else Color3.fromRGB(46, 42, 62),
				if owned then tier.Dark:Lerp(Color3.new(0, 0, 0), 0.2) else Color3.fromRGB(18, 16, 28)
			),
			120
		),
	})
	local stroke = Kit.stroke(Color3.new(1, 1, 1), 3, 0)
	local strokeGradient = Kit.gradient(Rarity.Gradient(card.Rarity), 45)
	strokeGradient.Parent = stroke
	stroke.Parent = button
	if card.Rarity == "Secret" and options.Spin then
		Effects.Spin(strokeGradient, 100)
	end

	-- Light rays behind the character.
	local rays = Kit.new("Frame", {
		Name = "Rays",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(1.3, 1.3),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
		Parent = button,
	}, { Kit.aspect(1, Enum.DominantAxis.Width) })
	for i = 1, 6 do
		Kit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.08, 0.72),
			Rotation = (i - 1) * 30,
			BackgroundColor3 = tier.Color,
			BackgroundTransparency = if owned then 0.84 else 0.95,
			BorderSizePixel = 0,
			Parent = rays,
		})
	end

	-- The character (3D figure now, uploaded illustration later).
	local art = CardView.Art(cardId, owned, false)
	if art then
		art.AnchorPoint = Vector2.new(0.5, 0.5)
		art.Position = UDim2.fromScale(0.5, 0.52)
		art.Size = UDim2.fromScale(1.12, 1.12)
		art.Parent = button
	else
		outlined(Kit.label({
			Text = if owned then card.Glyph else "?",
			Font = Theme.Font.Display,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.45),
			Size = UDim2.fromScale(0.7, 0.4),
			ZIndex = 2,
			Parent = button,
		}, 60), 3)
	end
	if not owned and art then
		outlined(Kit.label({
			Text = "?",
			Font = Theme.Font.Display,
			TextColor3 = Color3.fromRGB(200, 196, 230),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.45),
			Size = UDim2.fromScale(0.5, 0.36),
			ZIndex = 4,
			Parent = button,
		}, 60), 3)
	end

	-- Dark fade along the bottom so the number reads on any art.
	Kit.new("Frame", {
		Name = "Shade",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.42),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = button,
	}, {
		Kit.corner(UDim.new(0.25, 0)),
		Kit.new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0.15),
			}),
		}),
	})

	-- Uploaded rarity frame art goes over the character (it replaces the plain coloured border).
	Skin.Frame(button, card.Rarity, 4)

	local bottomText = if owned then (if options.Power then Kit.commas(options.Power) else card.Name) else "???"
	outlined(Kit.label({
		Name = "Power",
		Text = bottomText,
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.fromScale(0.94, 0.17),
		ZIndex = 5,
		Parent = button,
	}, 22), 2)

	-- Rarity letter badge (top-left) and the star pill next to it.
	local badge = Kit.new("Frame", {
		Name = "Rarity",
		Position = UDim2.fromScale(0.05, 0.05),
		Size = UDim2.fromScale(0.22, 0.22),
		BackgroundColor3 = tier.Color,
		ZIndex = 5,
		Parent = button,
	}, {
		Kit.corner(UDim.new(1, 0)),
		Kit.aspect(1, Enum.DominantAxis.Width),
		Kit.stroke(Color3.new(1, 1, 1), 2, 0),
	})
	if card.Rarity == "Secret" then
		Kit.gradient(Rarity.Gradient("Secret"), 45).Parent = badge
	end
	outlined(Kit.label({
		Text = CardTile.Letters[card.Rarity] or "?",
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromScale(0.75, 0.75),
		ZIndex = 6,
		Parent = badge,
	}, 22), 1.5)

	if owned and (options.Stars or 0) > 0 then
		local pill = Kit.new("Frame", {
			Name = "Stars",
			Position = UDim2.fromScale(0.28, 0.07),
			Size = UDim2.fromScale(0.3, 0.17),
			BackgroundColor3 = Color3.fromRGB(20, 14, 40),
			BackgroundTransparency = 0.25,
			ZIndex = 5,
			Parent = button,
		}, { Kit.corner(UDim.new(0.5, 0)), Kit.stroke(Theme.Color.Gold, 1.5, 0.3) })
		outlined(Kit.label({
			Text = `★{options.Stars}`,
			Font = Theme.Font.Heavy,
			TextColor3 = Theme.Color.Gold,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.85, 0.8),
			ZIndex = 6,
			Parent = pill,
		}, 18), 1.5)
	end

	if owned and options.Copies then
		outlined(Kit.label({
			Name = "Copies",
			Text = `x{options.Copies}`,
			Font = Theme.Font.Display,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(0.95, 0.05),
			Size = UDim2.fromScale(0.34, 0.16),
			ZIndex = 5,
			Parent = button,
		}, 20), 2)
	end

	if options.InDeck then
		local check = Kit.new("Frame", {
			Name = "InDeck",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -4, 0.8, 0),
			Size = UDim2.fromScale(0.22, 0.22),
			BackgroundColor3 = Theme.Color.Quick,
			ZIndex = 6,
			Parent = button,
		}, {
			Kit.corner(UDim.new(1, 0)),
			Kit.aspect(1, Enum.DominantAxis.Width),
			Kit.stroke(Color3.new(1, 1, 1), 2, 0),
		})
		outlined(Kit.label({
			Text = "✓",
			Font = Theme.Font.Heavy,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.75, 0.75),
			ZIndex = 7,
			Parent = check,
		}, 22), 1.5)
	end

	if options.Selected then
		local ring = Kit.new("Frame", {
			Name = "Selected",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Color.Gold,
			BackgroundTransparency = 0.85,
			ZIndex = 8,
			Parent = button,
		}, { Kit.corner(UDim.new(0.12, 0)) })
		Kit.stroke(Theme.Color.Gold, 4, 0).Parent = ring
	end

	Kit.pressable(button)
	return button
end

-- An empty deck slot: soft panel with a plus and the row's icon.
function CardTile.Empty(row: string, selected: boolean?): TextButton
	local color = if row == "Attack" then Theme.Color.Attack else Theme.Color.Quick
	local button = Kit.new("TextButton", {
		Name = "Empty",
		AutoButtonColor = false,
		BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.75),
		BackgroundTransparency = 0.2,
		Text = "",
	}, { Kit.corner(UDim.new(0.12, 0)) })
	Kit.stroke(if selected then Theme.Color.Gold else color, if selected then 4 else 2, if selected then 0 else 0.5).Parent = button
	outlined(Kit.label({
		Text = "+",
		Font = Theme.Font.Display,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(0.5, 0.45),
		Parent = button,
	}, 60), 2)
	Kit.label({
		Text = if selected then "PICK A CARD" else "EMPTY",
		Font = Theme.Font.Heavy,
		TextColor3 = if selected then Theme.Color.Gold else Theme.Color.Muted,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.fromScale(0.9, 0.16),
		Parent = button,
	}, 14)
	Kit.pressable(button)
	return button
end

return CardTile
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">CardView</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Draws a card: rarity frame, a sunburst portrait with the character's 3D chibi art
-- (CardArt.luau, from Card.Look), name ribbon, stars and stats. Cards not found yet show the
-- character as a dark silhouette.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared.Rarity)
local Cards = require(Shared.Cards)
local CardArt = require(Shared.CardArt)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Skin = require(script.Parent.Skin)
local Effects = require(script.Parent.Effects)

local CardView = {}

export type Options = {
	Owned: boolean?,
	Stars: number?,
	Compact: boolean?, -- small grid tile: hides title and stats
	Animate: boolean?, -- the figure sways (big reveals and detail views only)
}

local SILHOUETTE = Color3.fromRGB(14, 10, 24)

local function starText(stars: number): string
	return string.rep("★", stars) .. string.rep("☆", 5 - stars)
end

-- The character's art: an uploaded illustration (Card.Image) if there is one, otherwise the
-- 3D chibi figure in a ViewportFrame; nil when the card has neither.
function CardView.Art(cardId: string, owned: boolean, animate: boolean?): GuiObject?
	local card = Cards.Get(cardId)
	if card == nil then
		return nil
	end
	if card.Image then
		return Kit.new("ImageLabel", {
			Name = "Art",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = card.Image,
			ScaleType = Enum.ScaleType.Crop,
			ImageColor3 = if owned then Color3.new(1, 1, 1) else SILHOUETTE,
			ZIndex = 2,
		})
	end
	if card.Look == nil then
		return nil
	end
	local viewport = Kit.new("ViewportFrame", {
		Name = "Art",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(175, 165, 190),
		LightColor = Color3.fromRGB(255, 246, 236),
		LightDirection = Vector3.new(-0.5, -1, 0.7),
		ImageColor3 = if owned then Color3.new(1, 1, 1) else SILHOUETTE,
		ImageTransparency = if owned then 0 else 0.1,
		ZIndex = 2,
	})
	local model = CardArt.Build(card.Look)
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = CardArt.FieldOfView
	camera.CFrame = CardArt.CameraCFrame
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	if animate then
		local base = model:GetPivot()
		local start = os.clock()
		local connection
		connection = RunService.RenderStepped:Connect(function()
			if viewport.Parent == nil then
				connection:Disconnect()
				return
			end
			local t = os.clock() - start
			model:PivotTo(base * CFrame.new(0, math.sin(t * 2.2) * 0.06, 0) * CFrame.Angles(0, math.sin(t * 0.9) * 0.35, 0))
		end)
	end
	return viewport
end

-- Returns the card Frame. Size/position it from outside; it keeps a 0.72 width:height ratio.
function CardView.new(cardId: string, opts: Options?): Frame
	local options = opts or {}
	local card = Cards.Get(cardId)
	assert(card, `Unknown card {cardId}`)
	local tier = Rarity.Get(card.Rarity)
	local owned = options.Owned ~= false
	local stars = options.Stars or 0
	local compact = options.Compact == true

	local frame = Kit.new("Frame", {
		Name = "Card_" .. card.Id,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
	}, {
		Kit.corner(UDim.new(0.07, 0)),
		Kit.aspect(0.72, Enum.DominantAxis.Height),
		Kit.gradient(
			ColorSequence.new(tier.Dark:Lerp(Color3.new(1, 1, 1), 0.14), tier.Dark:Lerp(Color3.new(0, 0, 0), 0.45)),
			90
		),
	})

	-- Rarity frame: gradient stroke (prismatic for Secret).
	local stroke = Kit.stroke(Color3.new(1, 1, 1), if compact then 2.5 else 4, 0)
	stroke.Name = "RarityStroke"
	local strokeGradient = Kit.gradient(Rarity.Gradient(card.Rarity), 45)
	strokeGradient.Name = "RarityGradient"
	strokeGradient.Parent = stroke
	stroke.Parent = frame
	if card.Rarity == "Secret" and options.Animate then
		Effects.Spin(strokeGradient, 120)
	end

	-- Thin inner border.
	Kit.new("Frame", {
		Name = "Inner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.94, 0.955),
		BackgroundTransparency = 1,
		Parent = frame,
	}, { Kit.corner(UDim.new(0.06, 0)), Kit.stroke(tier.Color, 1, 0.55) })

	-- Portrait.
	local portraitHeight = if compact then 0.7 else 0.6
	local portrait = Kit.new("Frame", {
		Name = "Portrait",
		Position = UDim2.fromScale(0.06, 0.045),
		Size = UDim2.fromScale(0.88, portraitHeight),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Parent = frame,
	}, {
		Kit.corner(UDim.new(0.08, 0)),
		Kit.gradient(
			ColorSequence.new(
				if owned then card.Accent:Lerp(Color3.new(1, 1, 1), 0.15) else Color3.fromRGB(44, 42, 58),
				if owned then tier.Dark else Color3.fromRGB(16, 14, 24)
			),
			120
		),
	})

	-- Sunburst behind the character.
	local burst = Kit.new("Frame", {
		Name = "Burst",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.fromScale(1.6, 1.6),
		BackgroundTransparency = 1,
		Parent = portrait,
	}, { Kit.aspect(1, Enum.DominantAxis.Width) })
	for i = 1, 8 do
		Kit.new("Frame", {
			Name = "Ray",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.09, 1),
			Rotation = (i - 1) * 22.5,
			BackgroundColor3 = tier.Color,
			BackgroundTransparency = if owned then 0.82 else 0.94,
			BorderSizePixel = 0,
			Parent = burst,
		})
	end
	Kit.new("Frame", {
		Name = "Halo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.85, 0.85),
		BackgroundColor3 = tier.Color,
		BackgroundTransparency = if owned then 0.72 else 0.92,
		Parent = portrait,
	}, {
		Kit.corner(UDim.new(1, 0)),
		Kit.aspect(1, Enum.DominantAxis.Width),
	})

	local art = CardView.Art(card.Id, owned, options.Animate)
	if art then
		art.Parent = portrait
	end
	if art == nil or not owned then
		Kit.label({
			Name = "Glyph",
			Text = if owned then card.Glyph else "?",
			Font = Theme.Font.Display,
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = if owned then 0.05 else 0.25,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.52),
			Size = UDim2.fromScale(0.6, if art then 0.36 else 0.5),
			ZIndex = 3,
			Parent = portrait,
		}, 120)
	end

	-- Type badge (top-left) and rarity mark (top-right).
	local typeBadge = Kit.new("Frame", {
		Name = "TypeBadge",
		Position = UDim2.fromScale(0.04, 0.04),
		Size = UDim2.fromScale(0.22, 0.22),
		BackgroundColor3 = if card.Type == "Attack" then Theme.Color.Attack else Theme.Color.Support,
		ZIndex = 4,
		Parent = portrait,
	}, {
		Kit.corner(UDim.new(1, 0)),
		Kit.aspect(1, Enum.DominantAxis.Width),
		Kit.stroke(Color3.new(1, 1, 1), 1.5, 0.3),
	})
	Kit.label({
		Text = if card.Type == "Attack" then "⚔️" else "✨",
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.72, 0.72),
		ZIndex = 5,
		Parent = typeBadge,
	}, 22)

	if compact then
		Kit.new("Frame", {
			Name = "Gem",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.86, 0.12),
			Size = UDim2.fromScale(0.13, 0.13),
			Rotation = 45,
			BackgroundColor3 = tier.Color,
			ZIndex = 4,
			Parent = portrait,
		}, {
			Kit.aspect(1, Enum.DominantAxis.Width),
			Kit.stroke(Color3.new(1, 1, 1), 1.5, 0.2),
		})
	else
		local pill = Kit.new("Frame", {
			Name = "RarityPill",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(0.96, 0.04),
			Size = UDim2.fromScale(0.5, 0.12),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.3,
			ZIndex = 4,
			Parent = portrait,
		}, { Kit.corner(UDim.new(0.5, 0)), Kit.stroke(tier.Color, 1.5, 0.2) })
		Kit.label({
			Text = string.upper(card.Rarity),
			Font = Theme.Font.Heavy,
			TextColor3 = tier.Color,
			Size = UDim2.fromScale(0.9, 0.8),
			Position = UDim2.fromScale(0.05, 0.1),
			ZIndex = 5,
			Parent = pill,
		}, 16)
	end

	-- Stars along the bottom of the portrait.
	if owned then
		local starLabel = Kit.label({
			Name = "Stars",
			Text = starText(stars),
			Font = Theme.Font.Heavy,
			TextColor3 = Theme.Color.Gold,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.98),
			Size = UDim2.fromScale(0.8, 0.13),
			ZIndex = 4,
			Parent = portrait,
		}, 22)
		Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.2).Parent = starLabel
	end

	-- Name ribbon.
	local nameTop = portraitHeight + 0.06
	local ribbon = Kit.new("Frame", {
		Name = "Ribbon",
		Position = UDim2.fromScale(0.04, nameTop),
		Size = UDim2.fromScale(0.92, if compact then 0.17 else 0.12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = frame,
	}, {
		Kit.corner(UDim.new(0.3, 0)),
		Kit.gradient(
			ColorSequence.new({
				ColorSequenceKeypoint.new(0, tier.Dark),
				ColorSequenceKeypoint.new(0.5, if owned then tier.Color:Lerp(tier.Dark, 0.35) else Color3.fromRGB(50, 48, 64)),
				ColorSequenceKeypoint.new(1, tier.Dark),
			}),
			0
		),
	})
	local nameLabel = Kit.label({
		Name = "CardName",
		Text = if owned or not compact then card.Name else "???",
		Font = Theme.Font.Heavy,
		TextColor3 = if owned then Theme.Color.Text else Theme.Color.Muted,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.78),
		Parent = ribbon,
	}, if compact then 18 else 30)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.35).Parent = nameLabel

	if not compact then
		Kit.label({
			Name = "CardTitle",
			Text = card.Title,
			Font = Theme.Font.Medium,
			TextColor3 = Theme.Color.Muted,
			Position = UDim2.fromScale(0.06, nameTop + 0.13),
			Size = UDim2.fromScale(0.88, 0.065),
			Parent = frame,
		}, 20)
		local main = Cards.StatWithStars(card.Main, stars)
		local stats = if card.Type == "Attack"
			then `⚔️ {Kit.commas(main)}   ❤️ {Kit.commas(Cards.StatWithStars(card.HP or 0, stars))}   ⚡ {card.SPD}`
			else `✨ {Kit.commas(main)} PWR   ⚡ {card.SPD}`
		local chip = Kit.new("Frame", {
			Name = "Stats",
			Position = UDim2.fromScale(0.08, nameTop + 0.205),
			Size = UDim2.fromScale(0.84, 0.075),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.55,
			Parent = frame,
		}, { Kit.corner(UDim.new(0.5, 0)) })
		Kit.label({
			Text = stats,
			Font = Theme.Font.Bold,
			TextColor3 = Theme.Color.Text,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.92, 0.8),
			Parent = chip,
		}, 20)
	end

	-- Uploaded rarity frame art, over everything but the foil.
	Skin.Frame(frame, card.Rarity, 7)

	-- Foil layer used by the shimmer (Legendary and up).
	if Rarity.AtLeast(card.Rarity, "Legendary") and owned then
		local shine = Kit.new("Frame", {
			Name = "Shine",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0,
			ZIndex = 8,
			Parent = frame,
		}, { Kit.corner(UDim.new(0.07, 0)) })
		Kit.new("UIGradient", {
			Name = "ShineGradient",
			Rotation = 25,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.42, 1),
				NumberSequenceKeypoint.new(0.5, 0.55),
				NumberSequenceKeypoint.new(0.58, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Offset = Vector2.new(-1, 0),
			Parent = shine,
		})
	end

	return frame
end

-- The face-down card shown before a reveal.
function CardView.back(): Frame
	local frame = Kit.new("Frame", {
		Name = "CardBack",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
	}, {
		Kit.corner(UDim.new(0.07, 0)),
		Kit.aspect(0.72, Enum.DominantAxis.Height),
		Kit.gradient(ColorSequence.new(Color3.fromRGB(60, 40, 110), Color3.fromRGB(16, 12, 34)), 135),
	})
	local stroke = Kit.stroke(Color3.fromRGB(200, 180, 255), 4, 0.2)
	stroke.Name = "BackStroke"
	stroke.Parent = frame
	Kit.new("Frame", {
		Name = "Inner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.88, 0.91),
		BackgroundTransparency = 1,
		Parent = frame,
	}, { Kit.corner(UDim.new(0.06, 0)), Kit.stroke(Color3.fromRGB(200, 180, 255), 1.5, 0.5) })
	Kit.new("Frame", {
		Name = "Emblem",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.55, 0.55),
		Rotation = 45,
		BackgroundColor3 = Color3.fromRGB(176, 92, 255),
		BackgroundTransparency = 0.55,
		Parent = frame,
	}, {
		Kit.corner(UDim.new(0.12, 0)),
		Kit.aspect(1, Enum.DominantAxis.Width),
		Kit.stroke(Color3.fromRGB(230, 220, 255), 2, 0.3),
	})
	Kit.label({
		Name = "Mark",
		Text = "?",
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.5, 0.3),
		Parent = frame,
	}, 120)
	return frame
end

return CardView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Controls</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Shared menu controls in the game's chunky purple style: two-line option pills (Sort / Filter),
-- coloured tab pills, a search box and slanted section headers.

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Skin = require(script.Parent.Skin)

local Controls = {}

Controls.Purple = Color3.fromRGB(130, 90, 255)
Controls.PurpleDeep = Color3.fromRGB(80, 40, 210)
Controls.Outline = Color3.fromRGB(30, 10, 70)

local function outlined(label: TextLabel, thickness: number?)
	Kit.textStroke(Controls.Outline, thickness or 2, 0).Parent = label
	return label
end
Controls.Outlined = outlined

-- "Sort / Rarity": tap to cycle through `options`; onChange gets the new value.
function Controls.Option(parent: Instance, caption: string, options: { string }, order: number, onChange: (string) -> ())
	local index = 1
	local button = Kit.new("TextButton", {
		Name = caption,
		LayoutOrder = order,
		Size = UDim2.new(0, 112, 1, 0),
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
		Parent = parent,
	}, {
		Kit.corner(UDim.new(0.3, 0)),
		Kit.gradient(ColorSequence.new(Controls.Purple, Controls.PurpleDeep), 90),
		Kit.stroke(Color3.fromRGB(210, 190, 255), 2, 0.2),
	})
	Skin.Apply(button, "ButtonPurple")
	outlined(Kit.label({
		Name = "Caption",
		Text = caption,
		Font = Theme.Font.Heavy,
		Position = UDim2.fromScale(0.05, 0.06),
		Size = UDim2.fromScale(0.9, 0.36),
		Parent = button,
	}, 14), 1.5)
	local value = outlined(Kit.label({
		Name = "Value",
		Text = options[1],
		Font = Theme.Font.Display,
		Position = UDim2.fromScale(0.05, 0.4),
		Size = UDim2.fromScale(0.9, 0.52),
		Parent = button,
	}, 22), 2)
	Kit.pressable(button)
	button.Activated:Connect(function()
		index = index % #options + 1
		value.Text = options[index]
		onChange(options[index])
	end)
	return button
end

-- A big coloured tab pill; returns the button and a setter for its on/off look.
function Controls.Tab(parent: Instance, text: string, color: Color3, order: number, width: number?)
	local button = Kit.new("TextButton", {
		Name = text,
		LayoutOrder = order,
		Size = UDim2.new(0, width or 140, 1, 0),
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
		Parent = parent,
	}, { Kit.corner(UDim.new(0.5, 0)) })
	local gradient = Kit.gradient(ColorSequence.new(color, color:Lerp(Color3.new(0, 0, 0), 0.35)), 90)
	gradient.Parent = button
	local stroke = Kit.stroke(Color3.new(1, 1, 1), 2, 0.2)
	stroke.Parent = button
	local skin = Skin.Apply(button, Skin.ButtonFor(color))
	local label = outlined(Kit.label({
		Text = text,
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.86, 0.62),
		Parent = button,
	}, 24), 2)
	Kit.pressable(button)
	local function set(on: boolean)
		if skin then
			skin.ImageColor3 = if on then Color3.new(1, 1, 1) else Color3.fromRGB(120, 116, 140) -- greyed when off
		else
			gradient.Color = if on
				then ColorSequence.new(color, color:Lerp(Color3.new(0, 0, 0), 0.35))
				else ColorSequence.new(Color3.fromRGB(150, 146, 170), Color3.fromRGB(96, 92, 118))
			stroke.Transparency = if on then 0 else 0.6
		end
		label.TextTransparency = if on then 0 else 0.25
	end
	return button, set
end

-- Rounded dark search box. onChange gets the lower-cased text.
function Controls.Search(parent: Instance, props: { [string]: any }, onChange: (string) -> ()): TextBox
	local frame = Kit.new("Frame", {
		Name = "Search",
		BackgroundColor3 = Color3.fromRGB(16, 10, 34),
		BackgroundTransparency = 0.1,
		Parent = parent,
	}, { Kit.corner(UDim.new(0.5, 0)), Kit.stroke(Color3.fromRGB(150, 120, 230), 2, 0.3) })
	for key, value in props do
		frame[key] = value
	end
	local box = Kit.new("TextBox", {
		Name = "Box",
		Position = UDim2.new(0, 16, 0, 0),
		Size = UDim2.new(1, -32, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = "Search...",
		PlaceholderColor3 = Color3.fromRGB(170, 160, 210),
		TextColor3 = Color3.new(1, 1, 1),
		Font = Theme.Font.Display,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = frame,
	})
	box:GetPropertyChangedSignal("Text"):Connect(function()
		onChange(string.lower(box.Text))
	end)
	return box
end

-- Slanted coloured header strip for a column or section.
function Controls.Header(parent: Instance, text: string, color: Color3, props: { [string]: any }?): Frame
	local header = Kit.new("Frame", {
		Name = "Header",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = parent,
	}, {
		Kit.corner(UDim.new(0.3, 0)),
		Kit.gradient(ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.15), color:Lerp(Color3.new(0, 0, 0), 0.3)), 90),
		Kit.stroke(Color3.new(1, 1, 1), 2, 0.3),
	})
	if props then
		for key, value in props do
			header[key] = value
		end
	end
	Skin.Apply(header, Skin.ButtonFor(color))
	outlined(Kit.label({
		Name = "Text",
		Text = text,
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.7),
		Parent = header,
	}, 26), 2)
	return header
end

-- Small square icon button (◀ ▶ ✕ ...).
function Controls.Icon(parent: Instance, text: string, color: Color3, order: number, onClick: () -> ())
	local button = Kit.new("TextButton", {
		Name = text,
		LayoutOrder = order,
		Size = UDim2.new(0, 44, 1, 0),
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
		Parent = parent,
	}, {
		Kit.corner(UDim.new(1, 0)),
		Kit.gradient(ColorSequence.new(color, color:Lerp(Color3.new(0, 0, 0), 0.4)), 90),
		Kit.stroke(Color3.new(1, 1, 1), 2, 0.3),
	})
	Skin.Apply(button, Skin.ButtonFor(color))
	outlined(Kit.label({
		Text = text,
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.62, 0.62),
		Parent = button,
	}, 24), 1.5)
	Kit.pressable(button)
	button.Activated:Connect(onClick)
	return button
end

return Controls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">DeckBuilder</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Deck screen. Left: the Attack and Support slot columns, deck presets, Deck Power and Auto-build.
-- Right: every owned card as an art tile with tabs, sort, filter and search.
-- Tap a card to put it in the deck (or take it out if it's already in). Tap a slot first to choose
-- which slot it goes in or replaces. Every change goes to the server, which validates it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cards = require(Shared.Cards)
local Config = require(Shared.Config)
local Deck = require(Shared.Deck)
local Rarity = require(Shared.Rarity)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local CardTile = require(script.Parent.CardTile)
local Controls = require(script.Parent.Controls)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.Parent.State)

local DeckBuilder = {}

local modal
local columns = {} -- [row] = Frame holding the slot tiles
local grid: ScrollingFrame
local gridLayout: UIGridLayout
local powerLabel: TextLabel
local presetLabel: TextLabel
local hintLabel: TextLabel
local slotTools: Frame
local backButton: TextButton
local tabSetters = {}
local emptyLabel: TextLabel
local returnTo: (() -> ())? = nil

local tab = "Attack"
local sortBy = "Power"
local filterBy = "All"
local search = ""
local selected = nil -- { Row, Index } or nil
local working = nil -- the deck being edited (mirrors the active preset)
local hintToken = 0
local refreshQueued = false

local REASONS = {
	Duplicate = "That card is already in the deck",
	WrongType = "That slot takes the other card type",
	NotOwned = "You don't own that card",
	TooFast = "Slow down a little",
	Loading = "Still loading your cards",
}

local ROW_COLORS = { Attack = Theme.Color.Attack, Support = Theme.Color.Quick }

local function hint(text: string)
	hintToken += 1
	local token = hintToken
	hintLabel.Text = text
	hintLabel.TextTransparency = 0
	task.delay(2.4, function()
		if token == hintToken then
			Kit.tween(hintLabel, 0.4, { TextTransparency = 1 })
		end
	end)
end

local function entry(id: string)
	return State.Cards[id]
end

local function findInDeck(id: string)
	for _, row in Deck.Rows do
		for i, slot in working[row] do
			if slot == id then
				return row, i
			end
		end
	end
	return nil, nil
end

local function call(action: string, preset: number, deck)
	local ok, result = pcall(function()
		return Remotes.Deck:InvokeServer(action, preset, deck)
	end)
	if ok and result then
		if result.Decks then
			State.ApplyDecks(result.Decks)
		end
		if not result.Ok then
			hint(REASONS[result.Reason] or "Couldn't save the deck")
		end
		return result.Ok
	end
	hint("Couldn't reach the server")
	return false
end

local refresh -- forward declaration

local function save()
	refresh()
	call("Save", State.Decks.Active, working)
end

local function firstEmpty(row: string): number?
	for i, id in working[row] do
		if id == "" then
			return i
		end
	end
	return nil
end

-- Tapping a card in the grid.
local function tapCard(id: string)
	local card = Cards.Get(id)
	if card == nil then
		return
	end
	local fromRow, fromIndex = findInDeck(id)
	if fromRow then
		working[fromRow][fromIndex] = ""
		selected = { Row = fromRow, Index = fromIndex }
		Sfx.Play("Click", 0.8)
		hint(`{card.Name} taken out`)
		save()
		return
	end
	local row = card.Type
	local index = nil
	if selected and selected.Row == row then
		index = selected.Index
	else
		index = firstEmpty(row)
	end
	if index == nil then
		hint(`Your {row} row is full: tap a slot to replace it`)
		return
	end
	working[row][index] = id
	local nextEmpty = firstEmpty(row)
	selected = if nextEmpty then { Row = row, Index = nextEmpty } else nil
	Sfx.Play("Click", 1.2)
	save()
end

local function moveSelected(step: number)
	if selected == nil then
		return
	end
	local slots = working[selected.Row]
	local target = selected.Index + step
	if target < 1 or target > Config.Deck.Slots or slots[selected.Index] == "" then
		return
	end
	slots[selected.Index], slots[target] = slots[target], slots[selected.Index]
	selected.Index = target
	save()
end

local function removeSelected()
	if selected and working[selected.Row][selected.Index] ~= "" then
		working[selected.Row][selected.Index] = ""
		save()
	end
end

-- Slots ---------------------------------------------------------------------------------------

local function drawSlots()
	for _, row in Deck.Rows do
		for _, child in columns[row]:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for i = 1, Config.Deck.Slots do
			local id = working[row][i]
			local isSelected = selected ~= nil and selected.Row == row and selected.Index == i
			local tile
			if id ~= "" then
				local own = entry(id)
				tile = CardTile.new(id, {
					Owned = true,
					Stars = if own then own.Stars else 0,
					Power = Deck.CardPower(id, State.Cards),
					Selected = isSelected,
					Spin = true,
				})
			else
				tile = CardTile.Empty(row, isSelected)
			end
			tile.LayoutOrder = i
			tile.Parent = columns[row]
			tile.Activated:Connect(function()
				if isSelected then
					selected = nil
				else
					selected = { Row = row, Index = i }
					if tab ~= row then
						tab = row
					end
				end
				refresh()
			end)
		end
	end
	slotTools.Visible = selected ~= nil and working[selected.Row][selected.Index] ~= ""
end

-- Grid ----------------------------------------------------------------------------------------

local SORTS = {
	Power = function(a, b)
		return Deck.CardPower(a.Id, State.Cards) > Deck.CardPower(b.Id, State.Cards)
	end,
	Rarity = function(a, b)
		return Rarity.Index(a.Rarity) > Rarity.Index(b.Rarity)
	end,
	Stars = function(a, b)
		return (entry(a.Id) and entry(a.Id).Stars or 0) > (entry(b.Id) and entry(b.Id).Stars or 0)
	end,
	Name = function(a, b)
		return a.Name < b.Name
	end,
}

local function drawGrid()
	for _, child in grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local list = {}
	for id in State.Cards do
		local card = Cards.Get(id)
		if card and card.Type == tab then
			local inDeck = findInDeck(id) ~= nil
			local matchesFilter = filterBy == "All" or (filterBy == "In deck" and inDeck) or (filterBy == "Not in deck" and not inDeck)
			local matchesSearch = search == "" or string.find(string.lower(card.Name), search, 1, true) ~= nil
			if matchesFilter and matchesSearch then
				table.insert(list, card)
			end
		end
	end
	local compare = SORTS[sortBy] or SORTS.Power
	table.sort(list, function(a, b)
		local before, after = compare(a, b), compare(b, a)
		if before ~= after then
			return before
		end
		return a.Id < b.Id
	end)
	for i, card in list do
		local own = entry(card.Id)
		local tile = CardTile.new(card.Id, {
			Owned = true,
			Stars = own.Stars,
			Copies = own.Copies,
			Power = Deck.CardPower(card.Id, State.Cards),
			InDeck = findInDeck(card.Id) ~= nil,
		})
		tile.LayoutOrder = i
		tile.Parent = grid
		tile.Activated:Connect(function()
			tapCard(card.Id)
		end)
	end
	emptyLabel.Visible = #list == 0
	emptyLabel.Text = if search ~= "" then "No cards match your search"
		elseif filterBy ~= "All" then `No {tab} cards here`
		else `No {tab} cards yet. Keep rolling!`
end

local function sizeGrid()
	local width = grid.AbsoluteSize.X - 12
	if width <= 0 then
		return
	end
	local columnsCount = math.clamp(math.floor(width / 124), 2, 8)
	local gap = 10
	local cell = math.floor((width - gap * (columnsCount - 1)) / columnsCount)
	gridLayout.CellPadding = UDim2.fromOffset(gap, gap)
	gridLayout.CellSize = UDim2.fromOffset(cell, cell)
end

function refresh()
	if not modal.IsOpen or working == nil then
		return
	end
	drawSlots()
	drawGrid()
	for name, set in tabSetters do
		set(name == tab)
	end
	powerLabel.Text = `⚡ {Kit.commas(Deck.Power(working, State.Cards))}`
	presetLabel.Text = `DECK {State.Decks.Active}`
	backButton.Visible = returnTo ~= nil
	task.defer(sizeGrid)
end

local function queueRefresh()
	if refreshQueued then
		return
	end
	refreshQueued = true
	task.delay(0.5, function()
		refreshQueued = false
		refresh()
	end)
end

local function loadWorking()
	local preset = State.ActiveDeck()
	working = if preset then Deck.Copy(preset) else Deck.Empty()
end

function DeckBuilder.Init(playerGui: Instance)
	modal = Modal.new(playerGui, "DeckGui", "Deck", Vector2.new(0.96, 0.9), Vector2.new(1300, 780))

	Controls.Search(modal.Header, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -72, 0, -10),
		Size = UDim2.fromOffset(200, 40),
	}, function(text)
		search = text
		refresh()
	end)

	-- Left: slot columns -------------------------------------------------------------
	local left = Kit.new("Frame", {
		Name = "Slots",
		Size = UDim2.new(0.32, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = modal.Body,
	})
	local columnArea = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 1, -112),
		BackgroundTransparency = 1,
		Parent = left,
	})
	for i, row in Deck.Rows do
		local column = Kit.new("Frame", {
			Name = row,
			Position = UDim2.new((i - 1) * 0.5, if i == 1 then 0 else 6, 0, 0),
			Size = UDim2.new(0.5, -6, 1, 0),
			BackgroundColor3 = ROW_COLORS[row]:Lerp(Color3.new(0, 0, 0), 0.72),
			BackgroundTransparency = 0.15,
			Parent = columnArea,
		}, {
			Kit.corner(UDim.new(0, 16)),
			Kit.stroke(ROW_COLORS[row], 3, 0),
		})
		Controls.Header(column, if row == "Attack" then "Attack" else "Support", ROW_COLORS[row], {
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(1, -12, 0, 36),
		})
		local slots = Kit.new("Frame", {
			Name = "Slots",
			Position = UDim2.fromOffset(8, 50),
			Size = UDim2.new(1, -16, 1, -58),
			BackgroundTransparency = 1,
			Parent = column,
		})
		local layout = Kit.new("UIGridLayout", {
			CellSize = UDim2.new(0.5, -4, 0.5, -4),
			CellPadding = UDim2.fromOffset(8, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = slots,
		})
		Kit.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = layout })
		columns[row] = slots
	end

	-- Under the columns: selected-slot tools, presets, power, auto-build.
	local bottom = Kit.new("Frame", {
		Name = "Bottom",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 104),
		BackgroundTransparency = 1,
		Parent = left,
	})
	slotTools = Kit.new("Frame", {
		Name = "SlotTools",
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = bottom,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	Controls.Icon(slotTools, "◀", Controls.Purple, 1, function()
		moveSelected(-1)
	end)
	Controls.Icon(slotTools, "▶", Controls.Purple, 2, function()
		moveSelected(1)
	end)
	Controls.Icon(slotTools, "✕", Theme.Color.Danger, 3, removeSelected)

	local presetRow = Kit.new("Frame", {
		Name = "Presets",
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		Parent = bottom,
	})
	Controls.Icon(presetRow, "◀", Controls.Purple, 1, function()
		local nextPreset = (State.Decks.Active - 2) % Config.Deck.Presets + 1
		call("Select", nextPreset)
	end).Position = UDim2.fromScale(0, 0)
	local rightArrow = Controls.Icon(presetRow, "▶", Controls.Purple, 2, function()
		local nextPreset = State.Decks.Active % Config.Deck.Presets + 1
		call("Select", nextPreset)
	end)
	rightArrow.AnchorPoint = Vector2.new(1, 0)
	rightArrow.Position = UDim2.fromScale(1, 0)
	presetLabel = Controls.Outlined(Kit.label({
		Text = "DECK 1",
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.31, 0.5),
		Size = UDim2.new(0.3, 0, 1, 0),
		Parent = presetRow,
	}, 24), 2)
	powerLabel = Controls.Outlined(Kit.label({
		Text = "",
		Font = Theme.Font.Display,
		TextColor3 = Theme.Color.Gold,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.65, 0.5),
		Size = UDim2.new(0.3, 0, 1, 0),
		Parent = presetRow,
	}, 24), 2)

	local actions = Kit.new("Frame", {
		Name = "Actions",
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		Parent = bottom,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	backButton = Kit.button("< BOSS", Theme.Color.Roll, Theme.Color.RollDeep, {
		LayoutOrder = 0,
		Size = UDim2.new(0, 90, 1, 0),
		Parent = actions,
	})
	backButton.Activated:Connect(function()
		local back = returnTo
		returnTo = nil
		if back then
			back()
		end
	end)
	local auto = Kit.button("AUTO-BUILD", Theme.Color.Quick, Theme.Color.QuickDeep, {
		LayoutOrder = 1,
		Size = UDim2.new(0, 140, 1, 0),
		Parent = actions,
	})
	auto.Activated:Connect(function()
		if call("AutoBuild", State.Decks.Active) then
			Sfx.Play("Impact", 1.4)
			hint("Filled with your strongest cards")
		end
	end)

	-- Right: the card grid -------------------------------------------------------------
	local right = Kit.new("Frame", {
		Name = "Collection",
		Position = UDim2.new(0.33, 8, 0, 0),
		Size = UDim2.new(0.67, -8, 1, 0),
		BackgroundColor3 = Color3.fromRGB(14, 8, 32),
		BackgroundTransparency = 0.3,
		Parent = modal.Body,
	}, { Kit.corner(UDim.new(0, 18)), Kit.stroke(Color3.fromRGB(150, 110, 255), 2, 0.4) })

	local bar = Kit.new("Frame", {
		Name = "Bar",
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.new(1, -24, 0, 50),
		BackgroundTransparency = 1,
		Parent = right,
	})
	local tabs = Kit.new("Frame", {
		Size = UDim2.new(0.45, 0, 0, 42),
		Position = UDim2.fromOffset(0, 4),
		BackgroundTransparency = 1,
		Parent = bar,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10),
		}),
	})
	for i, row in Deck.Rows do
		local button, set = Controls.Tab(tabs, row, ROW_COLORS[row], i, 130)
		button.Activated:Connect(function()
			tab = row
			selected = nil
			refresh()
		end)
		tabSetters[row] = set
	end
	local options = Kit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.55, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = bar,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	Controls.Option(options, "Sort", { "Power", "Rarity", "Stars", "Name" }, 1, function(value)
		sortBy = value
		refresh()
	end)
	Controls.Option(options, "Filter", { "All", "Not in deck", "In deck" }, 2, function(value)
		filterBy = value
		refresh()
	end)

	grid = Kit.new("ScrollingFrame", {
		Name = "Grid",
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 1, -78),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Color3.fromRGB(170, 130, 255),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = right,
	}, { Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8) }) })
	gridLayout = Kit.new("UIGridLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		Parent = grid,
	})
	grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(sizeGrid)
	emptyLabel = Kit.label({
		Text = "",
		Font = Theme.Font.Display,
		TextColor3 = Theme.Color.Muted,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(0.8, 0.08),
		Visible = false,
		Parent = right,
	}, 24)

	hintLabel = Controls.Outlined(Kit.label({
		Text = "",
		Font = Theme.Font.Display,
		TextColor3 = Theme.Color.Gold,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(0.9, 0, 0, 26),
		ZIndex = 10,
		Parent = right,
	}, 22), 2)

	modal.OnOpen = function()
		loadWorking()
		selected = nil
		local index = firstEmpty("Attack")
		if index then
			selected = { Row = "Attack", Index = index }
		end
		refresh()
		if Deck.Count(working, "Attack") + Deck.Count(working, "Support") == 0 then
			hint("Tap cards to add them, or press AUTO-BUILD")
		end
	end

	State.Changed:Connect(function(kind)
		if not modal.IsOpen then
			return
		end
		if kind == "decks" or kind == "all" then
			loadWorking()
			refresh()
		else
			queueRefresh() -- e.g. Auto Roll results: redraw at most twice a second
		end
	end)
end

function DeckBuilder.Toggle()
	returnTo = nil
	modal:Toggle()
end

-- Opens the deck screen; `back` adds a button that returns to wherever it was opened from.
function DeckBuilder.Open(back: (() -> ())?)
	returnTo = back
	modal:Open()
	refresh()
end

function DeckBuilder.Close()
	modal:Close()
end

return DeckBuilder
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Test-phase tools. Only shown when Config.TestMode is on, and the server
-- refuses every request once it's off.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared.Rarity)
local Cards = require(Shared.Cards)
local Config = require(Shared.Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Reveal = require(script.Parent.Reveal)
local State = require(script.Parent.Parent.State)

local DevPanel = {}

local modal

local function section(parent: Instance, order: number, title: string): Frame
	Kit.label({
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 22),
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = false,
		TextSize = 15,
		Text = title,
		Parent = parent,
	}, 15)
	return Kit.new("Frame", {
		LayoutOrder = order + 1,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Wraps = true,
		}),
	})
end

local function devCall(action: string, value: any?)
	local ok, result = pcall(function()
		return Remotes.Dev:InvokeServer(action, value)
	end)
	if ok and result and result.Ok then
		State.ApplyFull(result)
		return true
	end
	return false
end

function DevPanel.Init(playerGui: Instance)
	modal = Modal.new(playerGui, "DevGui", "TEST TOOLS", Vector2.new(0.62, 0.8), Vector2.new(640, 560))

	local list = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = modal.Body,
	}, {
		Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
	})

	-- Luck
	local luckRow = section(list, 1, "LUCK (server-side, this session only)")
	for i, luck in { 1, 2, 3, Config.Roll.LuckCap } do
		local button = Kit.button(`{luck}x`, Theme.Color.Quick, Theme.Color.QuickDeep, {
			LayoutOrder = i,
			Size = UDim2.fromOffset(72, 36),
			Parent = luckRow,
		})
		button.Activated:Connect(function()
			devCall("SetLuck", luck)
		end)
	end

	-- Reveal previews (client only, nothing is saved)
	local previewRow = section(list, 3, "PREVIEW A REVEAL (not saved)")
	previewRow.Size = UDim2.new(1, 0, 0, 80)
	for i, name in Rarity.Order do
		local tier = Rarity.Get(name)
		local top = if name == "Secret" then Color3.fromRGB(150, 110, 255) else tier.Color
		local button = Kit.button(string.upper(name), top, tier.Dark, {
			LayoutOrder = i,
			Size = UDim2.fromOffset(110, 36),
			Parent = previewRow,
		})
		button.Activated:Connect(function()
			local pool = Cards.ByRarity[name]
			local card = pool[math.random(1, #pool)]
			modal:Close()
			Reveal.Full({
				CardId = card.Id,
				Rarity = name,
				Outcome = "New",
				Stars = 0,
				Copies = 1,
				ShardsGained = 0,
				PityTriggered = false,
			})
		end)
	end

	-- Data
	local dataRow = section(list, 5, "MY DATA")
	local grant = Kit.button("GIVE ALL CARDS", Theme.Color.Auto, Theme.Color.AutoDeep, {
		LayoutOrder = 1,
		Size = UDim2.fromOffset(160, 36),
		Parent = dataRow,
	})
	grant.Activated:Connect(function()
		devCall("GrantAll")
	end)

	-- The 8 Commons + Uncommons: the ~14.6k first deck World 1 Normal is tuned around.
	local starter = Kit.button("GIVE STARTER 8", Theme.Color.Quick, Theme.Color.QuickDeep, {
		LayoutOrder = 2,
		Size = UDim2.fromOffset(160, 36),
		Parent = dataRow,
	})
	starter.Activated:Connect(function()
		devCall("GrantStarter")
	end)

	-- Fights: open every world / difficulty, and max out stars to try the late fights.
	local fightRow = section(list, 7, "FIGHTS")
	local unlock = Kit.button("UNLOCK ALL FIGHTS", Theme.Color.Roll, Theme.Color.RollDeep, {
		LayoutOrder = 1,
		Size = UDim2.fromOffset(180, 36),
		Parent = fightRow,
	})
	unlock.Activated:Connect(function()
		devCall("UnlockFights")
	end)
	local maxStars = Kit.button("MAX MY STARS", Theme.Color.Gold, Color3.fromRGB(150, 100, 10), {
		LayoutOrder = 2,
		Size = UDim2.fromOffset(160, 36),
		Parent = fightRow,
	})
	maxStars.Activated:Connect(function()
		devCall("MaxStars")
	end)
	local loot = Kit.button("GIVE LOOT", Color3.fromRGB(176, 92, 255), Theme.Color.AccentDeep, {
		LayoutOrder = 3,
		Size = UDim2.fromOffset(140, 36),
		Parent = fightRow,
	})
	loot.Activated:Connect(function()
		devCall("GiveLoot") -- 1,000 Shards and 3 of every potion
	end)

	local reset = Kit.button("RESET MY DATA", Theme.Color.Danger, Color3.fromRGB(120, 20, 40), {
		LayoutOrder = 3,
		Size = UDim2.fromOffset(160, 36),
		Parent = dataRow,
	})
	local armed = false
	reset.Activated:Connect(function()
		if not armed then
			armed = true
			reset.Label.Text = "TAP AGAIN"
			task.delay(2.5, function()
				armed = false
				reset.Label.Text = "RESET MY DATA"
			end)
			return
		end
		armed = false
		reset.Label.Text = "RESET MY DATA"
		devCall("Reset")
	end)

	Kit.label({
		LayoutOrder = 10,
		Size = UDim2.new(1, 0, 0, 40),
		Font = Theme.Font.Medium,
		TextColor3 = Theme.Color.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextScaled = false,
		TextSize = 14,
		Text = "Set Config.TestMode to false in ReplicatedStorage > Shared > Config before launch. "
			.. "That hides this panel, turns the unlock rules on and makes the server refuse these tools.",
		Parent = list,
	}, 14)
end

function DevPanel.Toggle()
	modal:Toggle()
end

return DevPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!nonstrict
-- 2D effects built from plain frames and tweens: no textures, no 3D particles,
-- so they cost almost nothing on low-end phones.

local RunService = game:GetService("RunService")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Effects = {}

local function fxCount(high: number): number
	return if Theme.FxLow then math.max(1, math.floor(high * 0.4)) else high
end

-- Full-screen colour flash that fades out.
function Effects.Flash(parent: Instance, color: Color3, duration: number, startTransparency: number?)
	local flash = Kit.new("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = startTransparency or 0.1,
		BorderSizePixel = 0,
		ZIndex = 50,
		Parent = parent,
	})
	Kit.tween(flash, duration, { BackgroundTransparency = 1 }).Completed:Connect(function()
		flash:Destroy()
	end)
end

-- Shakes a GuiObject around its current position, then puts it back.
function Effects.Shake(target: GuiObject, intensity: number, duration: number)
	local origin = target.Position
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - start
		if elapsed >= duration or target.Parent == nil then
			connection:Disconnect()
			target.Position = origin
			return
		end
		local falloff = 1 - elapsed / duration
		local dx = (math.random() * 2 - 1) * intensity * falloff
		local dy = (math.random() * 2 - 1) * intensity * falloff
		target.Position = origin + UDim2.fromOffset(dx, dy)
	end)
end

-- Little diamonds that burst outward from the centre of `parent` and fade.
function Effects.Sparks(parent: GuiObject, color: Color3, count: number, spread: number?)
	local n = fxCount(count)
	local reach = spread or 0.6
	for _ = 1, n do
		local size = math.random(6, 14)
		local spark = Kit.new("Frame", {
			Name = "Spark",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size, size),
			Rotation = 45,
			BackgroundColor3 = if math.random() < 0.3 then Color3.new(1, 1, 1) else color,
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = parent,
		})
		local angle = math.random() * math.pi * 2
		local distance = (0.35 + math.random() * 0.65) * reach
		local goal = UDim2.fromScale(0.5 + math.cos(angle) * distance, 0.5 + math.sin(angle) * distance)
		local time = 0.6 + math.random() * 0.5
		Kit.tween(spark, time, {
			Position = goal,
			BackgroundTransparency = 1,
			Rotation = 45 + math.random(-180, 180),
		}, Enum.EasingStyle.Quart).Completed:Connect(function()
			spark:Destroy()
		end)
	end
end

-- Light rays behind the card. Returns the container; destroy it to remove the rays.
function Effects.Rays(parent: GuiObject, color: Color3, count: number): Frame
	local n = fxCount(count)
	local container = Kit.new("Frame", {
		Name = "Rays",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = parent,
	}, { Kit.aspect(1, Enum.DominantAxis.Height) })
	for i = 1, n do
		local ray = Kit.new("Frame", {
			Name = "Ray",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.07, 1.9),
			Rotation = (i - 1) * (180 / n),
			BackgroundColor3 = color,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = container,
		})
		Kit.new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.35, 0.55),
				NumberSequenceKeypoint.new(0.5, 0.3),
				NumberSequenceKeypoint.new(0.65, 0.55),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = ray,
		})
	end

	local spin
	spin = RunService.RenderStepped:Connect(function(dt)
		if container.Parent == nil then
			spin:Disconnect()
			return
		end
		container.Rotation = (container.Rotation + dt * 18) % 360
	end)

	container.BackgroundTransparency = 1
	container.Size = UDim2.fromScale(0.2, 0.2)
	Kit.tween(container, 0.5, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back)
	return container
end

-- Sweeps the foil band across a card's Shine layer.
function Effects.Shimmer(card: Frame, times: number)
	local shine = card:FindFirstChild("Shine")
	local gradient = shine and shine:FindFirstChild("ShineGradient")
	if not gradient then
		return
	end
	task.spawn(function()
		for _ = 1, times do
			if card.Parent == nil then
				return
			end
			gradient.Offset = Vector2.new(-1, 0)
			Kit.tween(gradient, 0.9, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Sine).Completed:Wait()
			task.wait(0.6)
		end
	end)
end

-- Keeps a gradient rotating (prismatic Secret frames). Stops when the gradient is removed.
function Effects.Spin(gradient: UIGradient, degreesPerSecond: number)
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		if gradient.Parent == nil then
			connection:Disconnect()
			return
		end
		gradient.Rotation = (gradient.Rotation + dt * degreesPerSecond) % 360
	end)
end

-- Scale pulses on a UIScale.
function Effects.Pulse(scale: UIScale, times: number, period: number, amount: number)
	for _ = 1, times do
		Kit.tween(scale, period * 0.5, { Scale = 1 + amount }, Enum.EasingStyle.Sine).Completed:Wait()
		Kit.tween(scale, period * 0.5, { Scale = 1 }, Enum.EasingStyle.Sine).Completed:Wait()
	end
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Gifts</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Gifts: the 7-day login streak, free gifts for time played this session, and lifetime roll
-- milestones. The server checks every claim (MetaService).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Meta = require(Shared.Meta)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Effects = require(script.Parent.Effects)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.Parent.State)
local MetaClient = require(script.Parent.Parent.MetaClient)

local Gifts = {}

local modal
local list: ScrollingFrame
local hintLabel: TextLabel
local hintToken = 0
local built = false
local dailyTiles = {}
local giftTiles = {}
local milestoneRows = {}

local GOLD_DEEP = Color3.fromRGB(170, 110, 0)

local function hint(text: string)
	hintToken += 1
	local token = hintToken
	hintLabel.Text = text
	hintLabel.TextTransparency = 0
	task.delay(2.2, function()
		if token == hintToken then
			Kit.tween(hintLabel, 0.4, { TextTransparency = 1 })
		end
	end)
end

local function clockText(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function heading(text: string, order: number)
	Kit.label({
		LayoutOrder = order,
		Text = text,
		Font = Theme.Font.Display,
		TextColor3 = Theme.Color.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = list,
	}, 24)
end

local function claim(action: string, arg: any?, frame: GuiObject)
	local result = MetaClient.Call(action, arg)
	if result.Ok then
		Sfx.Play("Impact", 1.5)
		Effects.Sparks(frame, Theme.Color.Gold, 18, 0.9)
	else
		hint(MetaClient.Message(result))
	end
	Gifts.Refresh()
end

local function tile(parent: Instance, order: number, width: number, height: number)
	local frame = Kit.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = Theme.Color.PanelLight,
		Parent = parent,
	}, { Kit.corner(UDim.new(0, 14)) })
	local stroke = Kit.stroke(Theme.Color.Line, 2, 0.3)
	stroke.Parent = frame
	return frame, stroke
end

local function build()
	built = true
	heading("📅 DAILY STREAK", 1)
	local dailyRow = Kit.new("Frame", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 120),
		BackgroundTransparency = 1,
		Parent = list,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	for day, bundle in Meta.Daily do
		local frame, stroke = tile(dailyRow, day, 96, 118)
		frame.Size = UDim2.new(1 / #Meta.Daily, -7, 1, -2) -- seven tiles always fit the row
		Kit.label({
			Text = `DAY {day}`,
			Font = Theme.Font.Heavy,
			TextColor3 = Theme.Color.Muted,
			Position = UDim2.fromScale(0.05, 0.05),
			Size = UDim2.fromScale(0.9, 0.16),
			Parent = frame,
		}, 15)
		Kit.label({
			Text = if day == #Meta.Daily then "🎁" else "📦",
			Font = Theme.Font.Heavy,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.38),
			Size = UDim2.fromScale(0.5, 0.26),
			Parent = frame,
		}, 34)
		Kit.label({
			Text = Meta.Describe(bundle),
			Font = Theme.Font.Heavy,
			Position = UDim2.fromScale(0.05, 0.54),
			Size = UDim2.fromScale(0.9, 0.16),
			Parent = frame,
		}, 15)
		local button = Kit.button("CLAIM", Theme.Color.Gold, GOLD_DEEP, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Size = UDim2.new(0.86, 0, 0.24, 0),
			Parent = frame,
		})
		button.Activated:Connect(function()
			claim("ClaimDaily", nil, frame)
		end)
		local state = Kit.label({
			Text = "",
			Font = Theme.Font.Heavy,
			TextColor3 = Theme.Color.Quick,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(0.86, 0, 0.18, 0),
			Parent = frame,
		}, 15)
		dailyTiles[day] = { Frame = frame, Stroke = stroke, Button = button, State = state }
	end

	heading("⏳ PLAYTIME GIFTS (this session)", 3)
	local giftRow = Kit.new("Frame", {
		LayoutOrder = 4,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = list,
	}, {
		Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(110, 118),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, gift in Meta.Playtime do
		local frame, stroke = tile(giftRow, i, 110, 118)
		local box = Kit.label({
			Text = "🎁",
			Font = Theme.Font.Heavy,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.24),
			Size = UDim2.fromScale(0.5, 0.3),
			Parent = frame,
		}, 38)
		Kit.label({
			Text = Meta.Describe(gift.Reward),
			Font = Theme.Font.Heavy,
			Position = UDim2.fromScale(0.05, 0.44),
			Size = UDim2.fromScale(0.9, 0.16),
			Parent = frame,
		}, 15)
		local button = Kit.button("CLAIM", Theme.Color.Gold, GOLD_DEEP, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Size = UDim2.new(0.86, 0, 0.24, 0),
			Parent = frame,
		})
		button.Activated:Connect(function()
			claim("ClaimGift", i, frame)
		end)
		local state = Kit.label({
			Text = "",
			Font = Theme.Font.Heavy,
			TextColor3 = Theme.Color.Muted,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(0.86, 0, 0.18, 0),
			Parent = frame,
		}, 15)
		local scale = Kit.new("UIScale", { Scale = 1, Parent = box })
		TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
			Scale = 1.12,
		}):Play()
		giftTiles[i] = { Frame = frame, Stroke = stroke, Button = button, State = state, Gift = gift, Box = box }
	end

	heading("🎲 ROLL MILESTONES", 5)
	for i, milestone in Meta.Milestones do
		local row = Kit.new("Frame", {
			LayoutOrder = 5 + i,
			Size = UDim2.new(1, -6, 0, 46),
			BackgroundColor3 = Theme.Color.PanelLight,
			Parent = list,
		}, { Kit.corner(UDim.new(0, 12)) })
		local stroke = Kit.stroke(Theme.Color.Line, 1.5, 0.3)
		stroke.Parent = row
		Kit.label({
			Text = `{Kit.commas(milestone.Rolls)} rolls`,
			Font = Theme.Font.Heavy,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0, 12, 0, 4),
			Size = UDim2.new(0.25, 0, 0, 20),
			Parent = row,
		}, 18)
		Kit.label({
			Text = Meta.Describe(milestone.Reward),
			Font = Theme.Font.Heavy,
			TextColor3 = Theme.Color.Gold,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0.27, 0, 0, 4),
			Size = UDim2.new(0.35, 0, 0, 20),
			Parent = row,
		}, 16)
		local track = Kit.new("Frame", {
			Position = UDim2.new(0, 12, 0, 30),
			Size = UDim2.new(0.62, -12, 0, 8),
			BackgroundColor3 = Theme.Color.Backdrop,
			Parent = row,
		}, { Kit.corner(UDim.new(1, 0)) })
		local fill = Kit.new("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Theme.Color.Gold,
			Parent = track,
		}, { Kit.corner(UDim.new(1, 0)) })
		local button = Kit.button("CLAIM", Theme.Color.Gold, GOLD_DEEP, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.new(0.22, 0, 0, 34),
			Parent = row,
		})
		button.Activated:Connect(function()
			claim("ClaimMilestone", i, row)
		end)
		local state = Kit.label({
			Text = "",
			Font = Theme.Font.Heavy,
			TextColor3 = Theme.Color.Muted,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0.3, 0, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		}, 15)
		milestoneRows[i] = { Row = row, Stroke = stroke, Fill = fill, Button = button, State = state, Milestone = milestone }
	end
end

function Gifts.Refresh()
	if not modal or not modal.IsOpen then
		return
	end
	if not built then
		build()
	end
	-- Daily streak.
	local daily = State.Meta.Daily
	for day, refs in dailyTiles do
		local claimed = if daily.CanClaim then day < daily.Day else day <= daily.Day
		local today = daily.CanClaim and day == daily.Day
		refs.Button.Visible = today
		refs.State.Text = if claimed then "✓ CLAIMED" elseif today then "" elseif not daily.CanClaim and day == daily.Day + 1 then "TOMORROW" else ""
		refs.Stroke.Color = if today then Theme.Color.Gold elseif claimed then Theme.Color.Quick else Theme.Color.Line
		refs.Stroke.Thickness = if today then 3 else 2
		refs.Frame.BackgroundTransparency = if claimed then 0.5 else 0
	end
	-- Playtime gifts.
	local session = State.SessionSeconds()
	for i, refs in giftTiles do
		local claimed = MetaClient.GiftClaimed(i)
		local ready = session >= refs.Gift.Minutes * 60
		refs.Button.Visible = ready and not claimed
		refs.State.Text = if claimed then "✓ CLAIMED" elseif ready then "" else `in {clockText(refs.Gift.Minutes * 60 - session)}`
		refs.Stroke.Color = if ready and not claimed then Theme.Color.Gold elseif claimed then Theme.Color.Quick else Theme.Color.Line
		refs.Frame.BackgroundTransparency = if claimed then 0.5 else 0
	end
	-- Milestones.
	local rolls = State.Rolls()
	for _, refs in milestoneRows do
		local target = refs.Milestone.Rolls
		local claimed = State.Meta.Milestones[tostring(target)] == true
		local ready = rolls >= target
		refs.Fill.Size = UDim2.fromScale(math.clamp(rolls / target, 0, 1), 1)
		refs.Button.Visible = ready and not claimed
		refs.State.Text = if claimed then "✓ CLAIMED" elseif ready then "" else `{Kit.commas(rolls)} / {Kit.commas(target)}`
		refs.Stroke.Color = if ready and not claimed then Theme.Color.Gold elseif claimed then Theme.Color.Quick else Theme.Color.Line
	end
end

function Gifts.Init(playerGui: Instance)
	modal = Modal.new(playerGui, "GiftsGui", "GIFTS", Vector2.new(0.84, 0.86), Vector2.new(860, 680))
	hintLabel = Kit.label({
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Gold,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -58, 0, 16),
		Size = UDim2.new(0.4, 0, 0, 20),
		Parent = modal.Header,
	}, 16)
	list = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Color.Gold,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = modal.Body,
	}, {
		Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
		Kit.new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2) }),
	})
	modal.OnOpen = function()
		-- Ask for fresh numbers (session time, daily status) each time it opens.
		task.spawn(function()
			MetaClient.Call("Get")
			Gifts.Refresh()
		end)
		Gifts.Refresh()
	end
	State.Changed:Connect(Gifts.Refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			Gifts.Refresh()
		end
	end)
end

function Gifts.Toggle()
	modal:Toggle()
end

return Gifts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Main screen: the three roll buttons bottom-middle with running potions and stats above them,
-- the icon menu on the left (red badges when something is ready to claim), the Auto Roll feed
-- on the right, the server announcement banner and reward toasts.
-- Bottom corners stay clear for Roblox's mobile thumbstick and jump button.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared.Rarity)
local Cards = require(Shared.Cards)
local Config = require(Shared.Config)
local Meta = require(Shared.Meta)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Skin = require(script.Parent.Skin)
local Effects = require(script.Parent.Effects)
local State = require(script.Parent.Parent.State)

local Hud = {}

local gui: ScreenGui
local dock: Frame
local menu: Frame
local rollButton: any -- children are read by name
local autoButton: any
local quickButton: any
local cooldownBar: any
local statsLabel: TextLabel
local autoStopButton: any
local boostRow: Frame
local hintLabel: TextLabel
local feed: Frame
local banner: any
local bannerLabel: TextLabel
local toast: any
local fxButton: any
local menuButtons = {} -- [name] = button (children read by name)
local locks = {} -- [feature] = overlay frame
local feedOrder = 0
local bannerToken = 0
local hintToken = 0
local toastToken = 0

local function rollButtonFace(button: TextButton, title: string, sub: string, color: Color3, deep: Color3, skin: string)
	button.AutoButtonColor = false
	button.BackgroundColor3 = Color3.new(1, 1, 1)
	button.Text = ""
	Kit.corner(UDim.new(0.28, 0)).Parent = button
	Kit.gradient(ColorSequence.new(color, deep), 90).Parent = button
	Kit.stroke(Color3.new(1, 1, 1), 2, 0.55).Parent = button
	-- Glossy top half.
	Kit.new("Frame", {
		Name = "Gloss",
		Position = UDim2.fromScale(0.06, 0.06),
		Size = UDim2.fromScale(0.88, 0.42),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		Parent = button,
	}, { Kit.corner(UDim.new(0.4, 0)) })
	Skin.Apply(button, skin) -- uploaded button art replaces the gradient, outline and gloss
	local titleLabel = Kit.label({
		Name = "Title",
		Text = title,
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.12),
		Size = UDim2.fromScale(0.86, 0.5),
		Parent = button,
	}, 44)
	Kit.textStroke(deep:Lerp(Color3.new(0, 0, 0), 0.4), 2, 0.2).Parent = titleLabel
	Kit.label({
		Name = "Sub",
		Text = sub,
		Font = Theme.Font.Heavy,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextTransparency = 0.15,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.6),
		Size = UDim2.fromScale(0.8, 0.26),
		Parent = button,
	}, 20)
	Kit.pressable(button)
end

local function lockOverlay(button: TextButton, feature: string)
	local overlay = Kit.new("Frame", {
		Name = "Lock",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 8, 20),
		BackgroundTransparency = 0.25,
		Visible = false,
		ZIndex = 5,
		Parent = button,
	}, { Kit.corner(UDim.new(0.28, 0)) })
	Kit.label({
		Name = "Text",
		Text = "LOCKED",
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.86, 0.6),
		ZIndex = 6,
		Parent = overlay,
	}, 20)
	locks[feature] = overlay
end

-- Square menu button: emoji icon, small caption, red badge for things to claim.
local function menuButton(text: string, icon: string, order: number, color: Color3, onClick: () -> (), iconKey: string?)
	local button = Kit.new("TextButton", {
		Name = text,
		LayoutOrder = order,
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
		Parent = menu,
	}, {
		Kit.corner(UDim.new(0.26, 0)),
		Kit.gradient(ColorSequence.new(color:Lerp(Theme.Color.Panel, 0.55), Theme.Color.Panel), 90),
		Kit.stroke(color, 1.5, 0.35),
	})
	Skin.Apply(button, "MenuButton")
	local iconLabel = Kit.label({
		Name = "Icon",
		Text = icon,
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.1),
		Size = UDim2.fromScale(0.62, 0.52),
		Parent = button,
	}, 40)
	Skin.Icon(iconLabel, iconKey or text) -- uploaded icon art replaces the emoji
	local label = Kit.label({
		Name = "Label",
		Text = text,
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.94),
		Size = UDim2.fromScale(0.9, 0.24),
		Parent = button,
	}, 14)
	Kit.textStroke(Color3.new(0, 0, 0), 1, 0.4).Parent = label
	local badge = Kit.new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.9, 0.1),
		Size = UDim2.fromScale(0.36, 0.36),
		BackgroundColor3 = Theme.Color.Danger,
		Visible = false,
		ZIndex = 4,
		Parent = button,
	}, {
		Kit.corner(UDim.new(1, 0)),
		Kit.aspect(1, Enum.DominantAxis.Width),
		Kit.stroke(Color3.new(1, 1, 1), 1.5, 0),
	})
	Kit.label({
		Name = "Count",
		Text = "!",
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.8),
		ZIndex = 5,
		Parent = badge,
	}, 14)
	Kit.pressable(button)
	button.Activated:Connect(onClick)
	menuButtons[text] = button
	return button
end

export type Handlers = {
	OnRoll: () -> (),
	OnQuick: () -> (),
	OnAuto: () -> (),
	OnAutoStop: () -> (),
	OnBattle: () -> (),
	OnDeck: () -> (),
	OnIndex: () -> (),
	OnPotions: () -> (),
	OnShop: () -> (),
	OnGifts: () -> (),
	OnOdds: () -> (),
	OnFx: () -> (),
	OnDev: (() -> ())?,
}

function Hud.Init(playerGui: Instance, handlers: Handlers)
	gui = Kit.screenGui("HudGui", 5, playerGui)
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets

	-- Bottom dock: buttons row, with potions, stats and hint stacked above it -----------
	dock = Kit.new("Frame", {
		Name = "Dock",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromScale(0.56, 0.15),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Kit.new("UISizeConstraint", { MinSize = Vector2.new(300, 64), MaxSize = Vector2.new(620, 112) }),
	})
	local bar = Kit.new("Frame", {
		Name = "Buttons",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = dock,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0.025, 0),
		}),
	})

	autoButton = Kit.new("TextButton", {
		Name = "AutoRoll",
		LayoutOrder = 1,
		Size = UDim2.fromScale(0.29, 0.84),
		Parent = bar,
	})
	rollButtonFace(autoButton, "AUTO", "OFF", Theme.Color.Auto, Theme.Color.AutoDeep, "AutoButton")
	lockOverlay(autoButton, "AutoRoll")

	rollButton = Kit.new("TextButton", {
		Name = "Roll",
		LayoutOrder = 2,
		Size = UDim2.fromScale(0.37, 1),
		Parent = bar,
	})
	rollButtonFace(rollButton, "ROLL", `{Config.Roll.Cooldown}s`, Theme.Color.Roll, Theme.Color.RollDeep, "RollButton")
	cooldownBar = Kit.new("Frame", {
		Name = "Cooldown",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0.12, 0, 1, -6),
		Size = UDim2.new(0.76, 0, 0, 5),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6,
		Parent = rollButton,
	}, { Kit.corner(UDim.new(1, 0)) })
	Kit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = cooldownBar,
	}, { Kit.corner(UDim.new(1, 0)) })

	quickButton = Kit.new("TextButton", {
		Name = "QuickRoll",
		LayoutOrder = 3,
		Size = UDim2.fromScale(0.29, 0.84),
		Parent = bar,
	})
	rollButtonFace(quickButton, "QUICK", "ROLL", Theme.Color.Quick, Theme.Color.QuickDeep, "QuickButton")
