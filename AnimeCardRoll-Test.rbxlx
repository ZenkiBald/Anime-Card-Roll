		Name = "InfoRow",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 0, -6),
		Size = UDim2.fromScale(1, 0.34),
		BackgroundTransparency = 1,
		Parent = dock,
	})
	local statsButton = Kit.new("TextButton", {
		Name = "Stats",
		Position = UDim2.fromScale(0.39, 0),
		Size = UDim2.fromScale(0.61, 1),
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Color.Panel,
		BackgroundTransparency = 0.3,
		Text = "",
		Parent = row,
	}, { Kit.corner(UDim.new(0.5, 0)), Kit.stroke(Theme.Color.Line, 1.5, 0.4) })
	statsLabel = Kit.label({
		Name = "Text",
		Text = "",
		RichText = true,
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.72),
		Parent = statsButton,
	}, 18)
	Kit.pressable(statsButton)
