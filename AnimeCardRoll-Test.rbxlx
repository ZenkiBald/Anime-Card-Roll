			Hair = Color3.fromRGB(255, 214, 120),
			Outfit = Color3.fromRGB(255, 250, 240),
			Outfit2 = Color3.fromRGB(240, 200, 120),
			Trim = Color3.fromRGB(255, 190, 60),
			Eyes = Color3.fromRGB(255, 180, 60),
			Style = "Long",
			Head = "Crown",
			Prop = "Sun",
			PropColor = Color3.fromRGB(255, 200, 90),
			Aura = Color3.fromRGB(255, 214, 140),
		},
		Accent = Color3.fromRGB(255, 214, 140),
		Abilities = {
			ability("Basic", "Radiant Heal", "Heal all Attack cards 80% PWR", {
				{ Kind = "Heal", Pct = 0.8, Target = "All" },
			}),
			ability("Skill", "Sunshield", "Every 3 actions: shield all Attack cards 200% PWR", {
				{ Kind = "Shield", Pct = 2, Target = "All" },
			}, 3),
			ability("Ultimate", "Radiant Crown", "All Attack cards +50% damage for 2 turns", {
				{ Kind = "Buff", Stat = "ATK", Amount = 0.5, Turns = 2, Target = "Attack" },
			}),
			ability(
				"Signature",
				"Dawn Oath",
				"Once per battle, an Attack card that would be KO'd survives at 1 HP, invulnerable for 1 turn",
				{ { Kind = "DawnOath", Turns = 1 } }
			),
		},
	},
}

local Cards = {}

Cards.List = list
Cards.ById = {} :: { [string]: Card }
Cards.ByRarity = {} :: { [string]: { Card } }

for _, card in list do
	assert(Cards.ById[card.Id] == nil, `Duplicate card id "{card.Id}"`)
	Cards.ById[card.Id] = card
	local pool = Cards.ByRarity[card.Rarity]
	if pool == nil then
		pool = {}
		Cards.ByRarity[card.Rarity] = pool
	end
	table.insert(pool, card)
end

function Cards.Get(id: string): Card?
	return Cards.ById[id]
end

-- The card's ability in a slot ("Basic", "Skill", "Ultimate", ...), or nil.
function Cards.Ability(card: Card, slot: string): Ability?
	for _, ability in card.Abilities do
		if ability.Slot == slot then
			return ability
		end
	end
	return nil
end

-- Stat with the star bonus applied (+5% per star, max 5 stars).
function Cards.StatWithStars(base: number, stars: number): number
	return math.floor(base * (1 + 0.05 * math.clamp(stars, 0, 5)) + 0.5)
end

-- Deck Power used for boss recommendations: Attack = ATK x 10 + HP, Support = PWR x 24.
function Cards.Power(card: Card, stars: number): number
	local main = Cards.StatWithStars(card.Main, stars)
	if card.Type == "Attack" then
		return main * Config.Power.PerATK + Cards.StatWithStars(card.HP or 0, stars)
	end
	return main * Config.Power.PerPWR
end

function Cards.MainLabel(card: Card): string
	return if card.Type == "Attack" then "ATK" else "PWR"
end

return Cards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Game-wide tuning. Every number the design doc calls "tunable" lives here.

local Config = {}

Config.GameName = "Anime Card Roll"

-- TEST PHASE SWITCH
-- true  = dev panel on, all roll buttons unlocked, saves go to a separate test store.
-- false = launch behaviour (unlock rules apply, dev tools are refused by the server).
Config.TestMode = true

Config.Roll = {
	Cooldown = 1.2, -- seconds between rolls, enforced on the server
	LuckCap = 5, -- at 5x, Common reaches 0%
}

Config.Unlocks = {
	-- Off during the test phase: Roll, Quick Roll and Auto Roll all work from the start.
	-- Turns on by itself when TestMode is switched off.
	Enabled = not Config.TestMode,
	QuickRoll = { Rolls = 20, Seconds = 180 },
	AutoRoll = { Rolls = 50, Seconds = 600 },
}

Config.Pity = {
	Epic = 50, -- an Epic or better is guaranteed by the 50th roll without one
	Legendary = 300, -- a Legendary or better by the 300th
}

Config.MaxStars = 5
Config.StarBonus = 0.05 -- +5% stats per star

-- Auto Roll stops by itself when it pulls this rarity or better.
Config.AutoStopOptions = { "Legendary", "Mythic", "Secret", "Never" }
Config.DefaultAutoStop = "Legendary"

-- Pulls of this rarity or better are announced to the whole server.
Config.AnnounceFrom = "Mythic"

Config.Deck = {
	Slots = 4, -- per row: 4 Attack (front) + 4 Support (back)
	Presets = 3,
}

-- Deck Power per card. Support cards have no HP (they can't be hit), so their power is PWR only.
Config.Power = {
	PerATK = 10, -- Attack: ATK x 10 + HP
	PerPWR = 24, -- Support: PWR x 24 (keeps the first Common + Uncommon deck at about 14.6k)
}

-- Boss reward rolls (design doc, "Boss reward rolls"). D is the fight's difficulty score, 1 to 9.
Config.Rewards = {
	BaseRolls = 3, -- rolls = 3 + 2D
	RollsPerD = 2,
	LuckPerD = 0.35, -- boss luck = 1 + 0.35D, capped at 4x; the player's own luck multiplies on top (total cap 5x)
	BossLuckCap = 4,
	Floors = { -- any result below the floor is upgraded to it
		{ MaxD = 2, Floor = "Uncommon" },
		{ MaxD = 6, Floor = "Rare" },
		{ MaxD = math.huge, Floor = "Epic" },
	},
	ShardsPerD = 15, -- every win also pays 15 x D Shards
	PotionChance = 0.5, -- and has this chance to drop a potion, better ones at higher D
	PotionDrops = {
		{ MaxD = 3, Potion = "luck" },
		{ MaxD = 6, Potion = "superluck" },
		{ MaxD = math.huge, Potion = "mythic" },
	},
}

-- Battle rules from the design doc. Boss stats live in Bosses.luau.
Config.Battle = {
	TurnSeconds = 2, -- a SPD 100 card acts once per turn; buff, burn and shield durations count turns
	Tick = 0.1, -- simulation step, in battle seconds
	TimeLimit = 180, -- lose when the 3-minute timer ends
	IntroSeconds = 2, -- "FIGHT!" banner before the first tick
	UltimateCost = 100,
	EnergyPerAction = 20,
	EnergyPerHit = 10,
	CritChance = 0.1,
	CritDamage = 1.5,
	ShieldTurns = 2,
	BarrierLeak = 0.3, -- while a boss barrier is up, Basic hits and burns deal only 30%; Skills and Ultimates break it
	BreakVuln = 0.25, -- a broken barrier leaves the boss taking +25% damage
	BreakTurns = 2,
	MaxDEF = 0.4, -- boss DEF runs 0-40%
	PhaseAt = 0.5, -- boss adds its phase-2 move at 50% HP
	EnrageAt = 0.2, -- and enrages at 20%
	EnrageATK = 0.3,
	Speeds = { 1, 2 }, -- 2x unlocks after clearing World 1 Normal (always on while unlock rules are off)
	SpeedUnlock = "kurogane:Normal",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Deck</string>
          <string name="Source"><![CDATA[--!strict
-- Deck rules, shared so the deck screen shows exactly what the server accepts.
-- A deck is 4 Attack slots (front row) + 4 Support slots (back row). "" is an empty slot.
-- Rules: each slot takes only its type, no card twice, only owned cards, empty slots allowed.

local Config = require(script.Parent.Config)
local Cards = require(script.Parent.Cards)

export type Deck = { Attack: { string }, Support: { string } }
export type Owned = { [string]: { Copies: number, Stars: number } }

local Deck = {}

Deck.Rows = { "Attack", "Support" }

function Deck.Empty(): Deck
	local deck: Deck = { Attack = {}, Support = {} }
	for i = 1, Config.Deck.Slots do
		deck.Attack[i] = ""
		deck.Support[i] = ""
	end
	return deck
end

function Deck.Copy(deck: Deck): Deck
	return { Attack = table.clone(deck.Attack), Support = table.clone(deck.Support) }
end

-- Checks a deck sent by a client. Returns a clean copy, or nil and the reason.
function Deck.Validate(raw: unknown, owned: Owned): (Deck?, string?)
	if type(raw) ~= "table" then
		return nil, "BadDeck"
	end
	local input = raw :: { [unknown]: unknown }
	for key in input do
		if key ~= "Attack" and key ~= "Support" then
			return nil, "BadDeck"
		end
	end

	local deck = Deck.Empty()
	local seen: { [string]: boolean } = {}
	for _, row in Deck.Rows do
		local slots = input[row]
		if type(slots) ~= "table" then
			return nil, "BadDeck"
		end
		local count = 0
		for key, id in slots :: { [unknown]: unknown } do
			count += 1
			if type(key) ~= "number" or key ~= math.floor(key) or key < 1 or key > Config.Deck.Slots then
				return nil, "BadDeck"
			end
			if type(id) ~= "string" then
				return nil, "BadDeck"
			end
			if id ~= "" then
				local card = Cards.Get(id)
				if card == nil then
					return nil, "BadDeck"
				end
				if card.Type ~= row then
					return nil, "WrongType"
				end
				if owned[id] == nil then
					return nil, "NotOwned"
				end
				if seen[id] then
					return nil, "Duplicate"
				end
				seen[id] = true
			end
			(deck :: any)[row][key] = id
		end
		if count ~= Config.Deck.Slots then
			return nil, "BadDeck"
		end
	end
	return deck, nil
end

-- Drops cards the player no longer owns (e.g. after a test-data reset).
function Deck.Clean(deck: Deck, owned: Owned): Deck
	local clean = Deck.Copy(deck)
	for _, row in Deck.Rows do
		local slots = (clean :: any)[row] :: { string }
		for i, id in slots do
			if id ~= "" and owned[id] == nil then
				slots[i] = ""
			end
		end
	end
	return clean
end

-- Card power with the owner's stars.
function Deck.CardPower(id: string, owned: Owned): number
	local card = Cards.Get(id)
	if card == nil then
		return 0
	end
	local entry = owned[id]
	return Cards.Power(card, if entry then entry.Stars else 0)
end

-- Deck Power: the sum of the cards in it.
function Deck.Power(deck: Deck, owned: Owned): number
	local total = 0
	for _, row in Deck.Rows do
		for _, id in (deck :: any)[row] :: { string } do
			if id ~= "" then
				total += Deck.CardPower(id, owned)
			end
		end
	end
	return total
end

function Deck.Count(deck: Deck, row: string): number
	local n = 0
	for _, id in (deck :: any)[row] :: { string } do
		if id ~= "" then
			n += 1
		end
	end
	return n
end

-- Fills each row with the highest-power cards owned, strongest on the left.
function Deck.AutoBuild(owned: Owned): Deck
	local deck = Deck.Empty()
	for _, row in Deck.Rows do
		local pool = {}
		for id in owned do
			local card = Cards.Get(id)
			if card and card.Type == row then
				table.insert(pool, id)
			end
		end
		table.sort(pool, function(a, b)
			local pa, pb = Deck.CardPower(a, owned), Deck.CardPower(b, owned)
			if pa ~= pb then
				return pa > pb
			end
			return a < b
		end)
		for i = 1, math.min(#pool, Config.Deck.Slots) do
			(deck :: any)[row][i] = pool[i]
		end
	end
	return deck
end

return Deck
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Meta</string>
          <string name="Source"><![CDATA[--!strict
-- Long-term progression, shared so the screens show exactly what the server pays:
-- potions, Shard upgrades, Index completion rewards, daily streak, playtime gifts, roll milestones.
-- Everything here is earned in game; nothing is sold for Robux (see CLAUDE.md before changing that).

local Config = require(script.Parent.Config)

export type Bundle = { Shards: number?, Potions: { [string]: number }? }

export type Potion = {
	Id: string,
	Name: string,
	Icon: string,
	Color: Color3,
	Kind: string, -- "Luck" (multiplies luck) | "Speed" (shorter roll cooldown)
	Amount: number, -- luck multiplier, or cooldown cut (0.3 = 30% faster)
	Seconds: number,
	Price: number, -- Shards in the shop
	Text: string,
}

export type Upgrade = {
	Id: string,
	Name: string,
	Icon: string,
	Text: string,
	Step: number,
	Costs: { number }, -- cost of each level; its length is the max level
}

export type Gift = { Minutes: number, Reward: Bundle }
export type Milestone = { Rolls: number, Reward: Bundle }
export type IndexReward = { Luck: number, Reward: Bundle }

local Meta = {}

Meta.Potions = {
	{
		Id = "luck",
		Name = "Luck Potion",
		Icon = "🍀",
		Color = Color3.fromRGB(86, 214, 138),
		Kind = "Luck",
		Amount = 1.5,
		Seconds = 300,
		Price = 40,
		Text = "x1.5 luck for 5 min",
	},
	{
		Id = "speed",
		Name = "Speed Potion",
		Icon = "⚡",
		Color = Color3.fromRGB(80, 180, 255),
		Kind = "Speed",
		Amount = 0.3,
		Seconds = 300,
		Price = 40,
		Text = "Rolls 30% faster for 5 min",
	},
	{
		Id = "superluck",
		Name = "Super Luck Potion",
		Icon = "🌟",
		Color = Color3.fromRGB(255, 196, 46),
		Kind = "Luck",
		Amount = 2,
		Seconds = 300,
		Price = 150,
		Text = "x2 luck for 5 min",
	},
	{
		Id = "mythic",
		Name = "Mythic Elixir",
		Icon = "🔮",
		Color = Color3.fromRGB(255, 58, 92),
		Kind = "Luck",
		Amount = 3,
		Seconds = 120,
		Price = 600,
		Text = "x3 luck for 2 min",
	},
} :: { Potion }

Meta.PotionById = {} :: { [string]: Potion }
for _, potion in Meta.Potions do
	Meta.PotionById[potion.Id] = potion
end

-- Using a potion that is already running adds to its time, up to this much.
Meta.MaxPotionSeconds = 3600

Meta.Upgrades = {
	{
		Id = "RollSpeed",
		Name = "Quick Hands",
		Icon = "⏱️",
		Text = "-0.1 s roll cooldown per level",
		Step = 0.1,
		Costs = { 60, 180, 450, 1100 }, -- 1.2 s down to 0.8 s, as in the design doc
	},
	{
		Id = "Luck",
		Name = "Lucky Charm",
		Icon = "🍀",
		Text = "+0.05x base luck per level",
		Step = 0.05,
		Costs = { 40, 70, 110, 160, 230, 320, 440, 600, 800, 1100 },
	},
} :: { Upgrade }

Meta.UpgradeById = {} :: { [string]: Upgrade }
for _, upgrade in Meta.Upgrades do
	Meta.UpgradeById[upgrade.Id] = upgrade
end

-- Finding every card of a rarity pays permanent luck plus a bundle, once.
Meta.IndexRewards = {
	Common = { Luck = 0.02, Reward = { Shards = 25, Potions = { luck = 1 } } },
	Uncommon = { Luck = 0.03, Reward = { Shards = 50, Potions = { luck = 2 } } },
	Rare = { Luck = 0.05, Reward = { Shards = 100, Potions = { speed = 2, luck = 2 } } },
	Epic = { Luck = 0.05, Reward = { Shards = 200, Potions = { superluck = 1 } } },
	Legendary = { Luck = 0.1, Reward = { Shards = 400, Potions = { superluck = 2 } } },
	Mythic = { Luck = 0.1, Reward = { Shards = 800, Potions = { mythic = 1 } } },
	Secret = { Luck = 0.15, Reward = { Shards = 2000, Potions = { mythic = 3 } } },
} :: { [string]: IndexReward }

-- Daily login streak: claim once per day; missing a day restarts at day 1; day 7 loops back.
Meta.Daily = {
	{ Shards = 20 },
	{ Potions = { luck = 1 } },
	{ Shards = 50 },
	{ Potions = { speed = 2 } },
	{ Shards = 100, Potions = { luck = 1 } },
	{ Potions = { superluck = 1 } },
	{ Shards = 250, Potions = { mythic = 1 } },
} :: { Bundle }

-- Free gifts for time spent in this server session.
Meta.Playtime = {
	{ Minutes = 3, Reward = { Shards = 10 } },
	{ Minutes = 6, Reward = { Potions = { luck = 1 } } },
	{ Minutes = 10, Reward = { Shards = 25 } },
	{ Minutes = 15, Reward = { Potions = { speed = 1 } } },
	{ Minutes = 25, Reward = { Shards = 60, Potions = { luck = 1 } } },
	{ Minutes = 40, Reward = { Potions = { superluck = 1 } } },
	{ Minutes = 60, Reward = { Shards = 150, Potions = { superluck = 1 } } },
	{ Minutes = 90, Reward = { Potions = { mythic = 1 } } },
} :: { Gift }

-- Lifetime roll milestones.
Meta.Milestones = {
	{ Rolls = 50, Reward = { Shards = 20 } },
	{ Rolls = 100, Reward = { Potions = { luck = 2 } } },
	{ Rolls = 250, Reward = { Shards = 60, Potions = { speed = 2 } } },
	{ Rolls = 500, Reward = { Potions = { superluck = 1 } } },
	{ Rolls = 1000, Reward = { Shards = 200, Potions = { superluck = 1 } } },
	{ Rolls = 2500, Reward = { Potions = { mythic = 1 } } },
	{ Rolls = 5000, Reward = { Shards = 600, Potions = { mythic = 1 } } },
	{ Rolls = 10000, Reward = { Shards = 1500, Potions = { mythic = 2 } } },
	{ Rolls = 25000, Reward = { Shards = 4000, Potions = { mythic = 4 } } },
} :: { Milestone }

-- Luck and speed -----------------------------------------------------------------------------

-- 1x, plus Lucky Charm levels, plus every claimed Index reward.
function Meta.BaseLuck(upgrades: { [string]: number }, indexClaimed: { [string]: boolean }): number
	local luck = 1 + (upgrades.Luck or 0) * Meta.UpgradeById.Luck.Step
	for rarity, claimed in indexClaimed do
		local reward = Meta.IndexRewards[rarity]
		if claimed and reward then
			luck += reward.Luck
		end
	end
	return luck
end

-- The strongest running luck potion (potions don't multiply each other).
function Meta.PotionLuck(active: { [string]: number }): number
	local best = 1
	for id, seconds in active do
		local potion = Meta.PotionById[id]
		if potion and potion.Kind == "Luck" and seconds > 0 then
			best = math.max(best, potion.Amount)
		end
	end
	return best
end

function Meta.TotalLuck(base: number, potionLuck: number): number
	return math.min(Config.Roll.LuckCap, base * potionLuck)
end

function Meta.Cooldown(upgrades: { [string]: number }, active: { [string]: number }): number
	local cooldown = Config.Roll.Cooldown - (upgrades.RollSpeed or 0) * Meta.UpgradeById.RollSpeed.Step
	for id, seconds in active do
		local potion = Meta.PotionById[id]
		if potion and potion.Kind == "Speed" and seconds > 0 then
			cooldown *= 1 - potion.Amount
		end
	end
	return math.max(0.4, math.floor(cooldown * 100 + 0.5) / 100)
end

-- Next level's cost, or nil at max level.
function Meta.UpgradeCost(id: string, level: number): number?
	local upgrade = Meta.UpgradeById[id]
	if upgrade == nil then
		return nil
	end
	return upgrade.Costs[level + 1]
end

-- Daily streak -------------------------------------------------------------------------------

function Meta.DayNumber(unixTime: number): number
	return math.floor(unixTime / 86400)
end

-- Whether today's reward can be claimed, and which streak day (1-7) it would be.
function Meta.DailyStatus(daily: { Day: number, Streak: number }, today: number): (boolean, number)
	if daily.Day == today then
		return false, daily.Streak
	end
	if daily.Day == today - 1 then
		return true, daily.Streak % #Meta.Daily + 1
	end
	return true, 1
end

-- "+25 Shards · 🍀x1" for labels.
function Meta.Describe(bundle: Bundle): string
	local parts = {}
	if bundle.Shards and bundle.Shards > 0 then
		table.insert(parts, `💎{bundle.Shards}`)
	end
	if bundle.Potions then
		for _, potion in Meta.Potions do
			local count = bundle.Potions[potion.Id]
			if count and count > 0 then
				table.insert(parts, `{potion.Icon}x{count}`)
			end
		end
	end
	return table.concat(parts, "  ")
end

return Meta
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Odds</string>
          <string name="Source"><![CDATA[--!strict
-- Roll odds. Shared by the server (to roll) and the client (to show the Odds panel),
-- so what players see is exactly what the server uses.
--
-- Luck multiplies every Rare-and-above chance; the extra comes out of Common.
-- A rarity floor upgrades any result below it to the floor tier, so luck still
-- decides the rare pulls.

local Config = require(script.Parent.Config)
local Rarity = require(script.Parent.Rarity)

local Odds = {}

export type Chances = { [string]: number }
export type Pity = { Epic: number, Legendary: number }

-- Percent chance for each rarity at the given luck and optional floor. Always sums to 100.
function Odds.Chances(luck: number, floor: string?): Chances
	luck = math.clamp(luck, 1, Config.Roll.LuckCap)

	local chances: Chances = {}
	local rarePlus = 0
	for i = 3, #Rarity.Order do
		local name = Rarity.Order[i]
		local chance = Rarity.Tiers[name].BaseChance * luck
		chances[name] = chance
		rarePlus += chance
	end
	chances.Uncommon = Rarity.Tiers.Uncommon.BaseChance
	chances.Common = math.max(0, 100 - chances.Uncommon - rarePlus)

	if floor ~= nil then
		local floorIndex = Rarity.Index(floor)
		for i = 1, floorIndex - 1 do
			local name = Rarity.Order[i]
			chances[floor] += chances[name]
			chances[name] = 0
		end
	end

	-- Normalise so the total is exactly 100 even with floating-point error.
	local total = 0
	for _, name in Rarity.Order do
		total += chances[name]
	end
	for _, name in Rarity.Order do
		chances[name] = chances[name] / total * 100
	end
	return chances
end

-- The higher of two floors (either may be nil).
function Odds.HigherFloor(a: string?, b: string?): string?
	if a == nil then
		return b
	end
	if b == nil then
		return a
	end
	return if Rarity.Index(a) >= Rarity.Index(b) then a else b
end

-- Floor forced by pity on the NEXT roll, or nil.
function Odds.PityFloor(pity: Pity): string?
	if pity.Legendary >= Config.Pity.Legendary - 1 then
		return "Legendary"
	end
	if pity.Epic >= Config.Pity.Epic - 1 then
		return "Epic"
	end
	return nil
end

-- Rolls left until each pity guarantee kicks in (1 = the next roll).
function Odds.PityRemaining(pity: Pity): (number, number)
	return Config.Pity.Epic - pity.Epic, Config.Pity.Legendary - pity.Legendary
end

-- Pick a rarity from a chance table using the given Random.
function Odds.PickTier(chances: Chances, rng: Random): string
	local roll = rng:NextNumber() * 100
	local acc = 0
	local lastNonZero = Rarity.Order[1]
	for i = #Rarity.Order, 1, -1 do
		local name = Rarity.Order[i]
		local chance = chances[name]
		if chance > 0 then
			lastNonZero = name
			acc += chance
			if roll < acc then
				return name
			end
		end
	end
	return lastNonZero
end

-- Record a pulled rarity in the pity counters.
function Odds.UpdatePity(pity: Pity, pulled: string)
	if Rarity.AtLeast(pulled, "Epic") then
		pity.Epic = 0
	else
		pity.Epic += 1
	end
	if Rarity.AtLeast(pulled, "Legendary") then
		pity.Legendary = 0
	else
		pity.Legendary += 1
	end
end

-- "12.5%", "0.900%", "0.0100%" depending on size.
function Odds.FormatPercent(pct: number): string
	if pct <= 0 then
		return "0%"
	elseif pct >= 10 then
		return string.format("%.1f%%", pct)
	elseif pct >= 1 then
		return string.format("%.2f%%", pct)
	elseif pct >= 0.1 then
		return string.format("%.3f%%", pct)
	end
	return string.format("%.4f%%", pct)
end

-- "1 in 1,111"
function Odds.FormatOneIn(pct: number): string
	if pct <= 0 then
		return "-"
	end
	local n = 100 / pct
	if n < 10 then
		return string.format("1 in %.1f", n)
	end
	local whole = tostring(math.floor(n + 0.5))
	local withCommas = whole:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return "1 in " .. withCommas
end

return Odds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Rarity</string>
          <string name="Source"><![CDATA[--!strict
-- The seven rarity tiers. Each tier's stats are at least 1.6x the tier below,
-- more than the most a lower card can gain (+-10% variance, +25% at 5 stars),
-- so a higher rarity always wins.

export type Tier = {
	Name: string,
	Index: number,
	BaseChance: number, -- percent at 1x luck
	Multiplier: number, -- stat multiplier
	ShardValue: number, -- Shards for a duplicate past 5 stars
	Color: Color3,
	Dark: Color3,
	Abilities: string,
}

local Rarity = {}

Rarity.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

local tiers: { [string]: Tier } = {
	Common = {
		Name = "Common",
		Index = 1,
		BaseChance = 60,
		Multiplier = 1.0,
		ShardValue = 1,
		Color = Color3.fromRGB(176, 184, 196),
		Dark = Color3.fromRGB(58, 62, 72),
		Abilities = "Basic",
	},
	Uncommon = {
		Name = "Uncommon",
		Index = 2,
		BaseChance = 25,
		Multiplier = 1.6,
		ShardValue = 2,
		Color = Color3.fromRGB(86, 214, 138),
		Dark = Color3.fromRGB(22, 72, 48),
		Abilities = "Basic + Passive",
	},
	Rare = {
		Name = "Rare",
		Index = 3,
		BaseChance = 10,
		Multiplier = 2.6,
		ShardValue = 5,
		Color = Color3.fromRGB(64, 156, 255),
		Dark = Color3.fromRGB(16, 48, 96),
		Abilities = "Basic + Skill",
	},
	Epic = {
		Name = "Epic",
		Index = 4,
		BaseChance = 4,
		Multiplier = 4.2,
		ShardValue = 15,
		Color = Color3.fromRGB(176, 92, 255),
		Dark = Color3.fromRGB(56, 22, 96),
		Abilities = "Basic + Skill + Passive",
	},
	Legendary = {
		Name = "Legendary",
		Index = 5,
		BaseChance = 0.9,
		Multiplier = 7.0,
		ShardValue = 60,
		Color = Color3.fromRGB(255, 196, 46),
		Dark = Color3.fromRGB(96, 64, 8),
		Abilities = "+ Ultimate",
	},
	Mythic = {
		Name = "Mythic",
		Index = 6,
		BaseChance = 0.09,
		Multiplier = 12,
		ShardValue = 300,
		Color = Color3.fromRGB(255, 58, 92),
		Dark = Color3.fromRGB(96, 10, 28),
		Abilities = "2-effect Ultimate + Aura",
	},
	Secret = {
		Name = "Secret",
		Index = 7,
		BaseChance = 0.01,
		Multiplier = 20,
		ShardValue = 1500,
		Color = Color3.fromRGB(240, 236, 255),
		Dark = Color3.fromRGB(14, 12, 24),
		Abilities = "+ Signature mechanic",
	},
}

Rarity.Tiers = tiers

function Rarity.Get(name: string): Tier
	local tier = tiers[name]
	assert(tier, `Unknown rarity "{name}"`)
	return tier
end

function Rarity.Index(name: string): number
	return Rarity.Get(name).Index
end

-- true when rarity a is the same as or better than rarity b
function Rarity.AtLeast(a: string, b: string): boolean
	return Rarity.Index(a) >= Rarity.Index(b)
end

-- Two-tone gradient for card frames; Secret is prismatic.
function Rarity.Gradient(name: string): ColorSequence
	if name == "Secret" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 92, 140)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 196, 46)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(110, 240, 160)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 190, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(176, 110, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 92, 140)),
		})
	end
	local tier = Rarity.Get(name)
	local h, s, v = tier.Color:ToHSV()
	local light = Color3.fromHSV(h, math.max(0, s - 0.25), math.min(1, v + 0.15))
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, light),
		ColorSequenceKeypoint.new(0.5, tier.Color),
		ColorSequenceKeypoint.new(1, light),
	})
end

return Rarity
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Rewards</string>
          <string name="Source"><![CDATA[--!strict
-- Boss reward rolls, shared so the boss screen previews exactly what the server pays.
-- Each fight has a difficulty score D (World 1 Normal = 1 ... World 3 Nightmare = 9).

local Config = require(script.Parent.Config)
local Rarity = require(script.Parent.Rarity)

export type Reward = {
	Rolls: number, -- 3 + 2D
	Luck: number, -- 1 + 0.35D, capped at 4x (the player's own luck multiplies on top)
	Floor: string, -- results below this rarity are upgraded to it
	Bonus: string, -- first clear: one extra card of at least this rarity (one tier above the floor)
	Shards: number, -- 15 x D
	Potion: string, -- potion that may drop (Config.Rewards.PotionChance)
}

local Rewards = {}

function Rewards.For(d: number): Reward
	local r = Config.Rewards
	local floor = r.Floors[#r.Floors].Floor
	for _, step in r.Floors do
		if d <= step.MaxD then
			floor = step.Floor
			break
		end
	end
	local bonusIndex = math.min(#Rarity.Order, Rarity.Index(floor) + 1)
	local potion = r.PotionDrops[#r.PotionDrops].Potion
	for _, step in r.PotionDrops do
		if d <= step.MaxD then
			potion = step.Potion
			break
		end
	end
	return {
		Rolls = r.BaseRolls + r.RollsPerD * d,
		Luck = math.min(r.BossLuckCap, 1 + r.LuckPerD * d),
		Floor = floor,
		Bonus = Rarity.Order[bonusIndex],
		Shards = r.ShardsPerD * d,
		Potion = potion,
	}
end

-- Boss luck x the player's own luck, under the overall cap.
function Rewards.TotalLuck(bossLuck: number, playerLuck: number): number
	return math.min(Config.Roll.LuckCap, bossLuck * playerLuck)
end

return Rewards
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">BattleEngine</string>
          <string name="Source"><![CDATA[--!nonstrict
-- The battle engine: up to 8 cards against one boss on action timers.
-- A pure simulation with no Roblox services: BattleService steps it in real time and
-- streams its events to the client, and tests/battle_test.luau runs whole fights headless.
--
-- Rules (design doc, "Battle system"):
--   * Every card and the boss has an action bar that fills at its SPD; a SPD 100 bar fills once
--     per turn (Config.Battle.TurnSeconds). A full bar means it acts. Ties go to the leftmost card.
--   * A card's action is its Skill when the cooldown is ready, otherwise its Basic.
--   * Attack cards (front row) have HP and take every boss hit. Support cards (back row) have no HP:
--     they can't be hit or KO'd, and each casts its Basic once as the fight opens.
--   * Ultimates cost 100 energy (+20 per action, +10 per hit taken); fired by UseUltimate or AutoUlt.
--   * Big boss moves show a warning first. At 50% HP the boss adds its phase-2 move; at 20% it enrages.
--   * Win at boss 0 HP. Lose when every Attack card is KO'd or the timer runs out.
--   * Damage = ATK x Skill% x (1 + sum of buffs) x Crit x (1 - boss DEF).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Cards = require(Shared.Cards)
local Bosses = require(Shared.Bosses)

local B = Config.Battle

local Engine = {}
Engine.__index = Engine

export type UnitSpec = { Id: string, CardId: string, Stars: number }
export type Setup = { Units: { UnitSpec }, BossId: string, Difficulty: string, Rng: Random? }

-- Effects that only make sense on a card with HP.
local HP_ONLY = { Heal = true, Shield = true, Cleanse = true, Evade = true, Revive = true }

local function round(x: number): number
	return math.floor(x + 0.5)
end

local function turns(n: number?): number
	return if n then n * B.TurnSeconds else math.huge
end

local function sumStat(effects, stat: string): number
	local total = 0
	for _, effect in effects do
		if effect.Stat == stat then
			total += effect.Amount
		end
	end
	return total
end

local function newUnit(spec: UnitSpec)
	local card = Cards.Get(spec.CardId)
	assert(card, `Unknown card {spec.CardId}`)
	local hasHP = card.Type == "Attack"
	local unit = {
		Id = spec.Id,
		Order = 0,
		Type = card.Type,
		HasHP = hasHP,
		Card = card,
		Main = Cards.StatWithStars(card.Main, spec.Stars),
		MaxHP = if hasHP then Cards.StatWithStars(card.HP or 0, spec.Stars) else 0,
		SPD = card.SPD,
		Gauge = 0,
		Energy = 0,
		Shield = 0,
		ShieldLeft = 0,
		Alive = true,
		Frozen = false,
		Actions = 0,
		Buffs = {}, -- [source key] = { Stat, Amount, Left (seconds) }
		Burns = {}, -- { Damage, Ticks, Timer }
		Taunt = 0,
		Invuln = 0,
		Evades = 0,
		Basic = Cards.Ability(card, "Basic"),
		Skill = Cards.Ability(card, "Skill"),
		Ultimate = Cards.Ability(card, "Ultimate"),
		Passives = {}, -- passive effects with a When condition
		Dealt = 0, -- damage dealt this battle
		Healed = 0, -- HP healed + shields given this battle
	}
	unit.HP = unit.MaxHP
	unit.SkillCooldown = if unit.Skill then (unit.Skill.Every or 3) - 1 else 0
	return unit
end

function Engine.new(setup: Setup)
	local def = Bosses.Get(setup.BossId)
	assert(def, `Unknown boss {setup.BossId}`)
	local difficulty = def.Difficulties[setup.Difficulty]
	assert(difficulty, `Unknown difficulty {setup.Difficulty}`)

	local self = setmetatable({}, Engine)
	self.Rng = setup.Rng or Random.new()
	self.Time = 0
	self.Over = false
	self.Result = nil
	self.AutoUlt = false
	self.Events = {}
	self.Opened = false
	self.Slot = nil -- the slot of the ability being cast (Basic | Skill | Ultimate | Opening)
	self.WarnSeconds = difficulty.WarnSeconds
	self.BossId = def.Id
	self.Difficulty = setup.Difficulty
	self.DifficultyIndex = Bosses.DifficultyIndex(setup.Difficulty)

	local moves = {}
	for _, move in def.Moves do
		if move.MinDifficulty == nil or Bosses.DifficultyIndex(move.MinDifficulty) <= self.DifficultyIndex then
			table.insert(moves, move)
		end
	end

	self.Boss = {
		Id = "Boss",
		Order = 99,
		Type = "Boss",
		Def = def,
		Moves = moves,
		MaxHP = difficulty.HP,
		ATK = difficulty.ATK,
		DEF = def.DEF,
		SPD = def.SPD,
		Gauge = 0,
		Alive = true,
		Actions = 0,
		PhaseActions = 0,
		Phase = 1,
		Enraged = false,
		BonusATK = 0, -- from stolen buffs
		Barrier = 0,
		Pending = nil, -- { Move, Target, Left } while a warned move winds up
		Debuffs = {}, -- [source key] = { Stat, Amount, Left }
		Burns = {},
	}
	self.Boss.HP = self.Boss.MaxHP

	self.Allies = {}
	self.ById = { Boss = self.Boss }
	for _, spec in setup.Units do
		local unit = newUnit(spec)
		table.insert(self.Allies, unit)
		self.ById[unit.Id] = unit
	end
	table.sort(self.Allies, function(a, b)
		-- Front row first, then left to right.
		if a.Type ~= b.Type then
			return a.Type == "Attack"
		end
		return a.Id < b.Id
	end)
	for i, unit in self.Allies do
		unit.Order = i
	end

	-- Passives, auras and signatures that are on from the start.
	for _, unit in self.Allies do
		for _, ability in unit.Card.Abilities do
			for _, effect in ability.Effects do
				if ability.Slot == "Passive" then
					if effect.When then
						table.insert(unit.Passives, effect)
					else
						self:RunEffect(unit, effect, true)
					end
				elseif ability.Slot == "Aura" then
					self:RunEffect(unit, effect, true)
				elseif ability.Slot == "Signature" then
					if effect.Kind == "Eclipse" then
						unit.EclipseEvery = effect.Every or 5
					elseif effect.Kind == "DawnOath" then
						self.DawnOath = { Owner = unit, Used = false, Seconds = turns(effect.Turns or 1) }
					end
				end
			end
		end
	end
	self.Events = {} -- start-of-battle effects are part of the initial state, not news
	return self
end

-- Events ------------------------------------------------------------------------

function Engine:Emit(event)
	table.insert(self.Events, event)
end

-- Returns and clears the events since the last call.
function Engine:TakeEvents()
	local events = self.Events
	self.Events = {}
	return events
end

function Engine:Finish(result: string)
	if self.Over then
		return
	end
	self.Over = true
	self.Result = result
	self:Emit({ K = "End", R = result, Time = self.Time })
end

function Engine:Forfeit()
	self:Finish("Forfeit")
end

-- Stats ---------------------------------------------------------------------------

function Engine:Buff(unit, stat: string): number
	local total = sumStat(unit.Buffs, stat)
	local boss = self.Boss
	for _, effect in unit.Passives do
		if effect.Kind == "Buff" and effect.Stat == stat then
			local on = (effect.When == "BossAbove50" and boss.HP > boss.MaxHP * 0.5)
				or (effect.When == "SelfBelow50" and unit.HasHP and unit.HP < unit.MaxHP * 0.5)
			if on then
				total += effect.Amount
			end
		end
	end
	return total
end

function Engine:BossDebuff(stat: string): number
	return sumStat(self.Boss.Debuffs, stat)
end

function Engine:BossDEF(): number
	return math.clamp(self.Boss.DEF - self:BossDebuff("DEF"), 0, B.MaxDEF)
end

function Engine:BossATK(): number
	local boss = self.Boss
	local factor = 1 + (if boss.Enraged then B.EnrageATK else 0) + boss.BonusATK - self:BossDebuff("ATK")
	return boss.ATK * math.max(0.1, factor)
end

function Engine:Speed(unit): number
	if unit == self.Boss then
		return unit.SPD * math.max(0.2, 1 - self:BossDebuff("SPD"))
	end
	return unit.SPD * math.max(0.2, 1 + self:Buff(unit, "SPD"))
end

function Engine:AttackAlive(): boolean
	for _, unit in self.Allies do
		if unit.HasHP and unit.Alive then
			return true
		end
	end
	return false
end

function Engine:GainEnergy(unit, amount: number)
	if unit.Alive and unit.Ultimate then
		unit.Energy = math.min(B.UltimateCost, unit.Energy + amount)
	end
end

-- Targeting -------------------------------------------------------------------------

function Engine:Alive(filter: string?)
	local list = {}
	for _, unit in self.Allies do
		if unit.Alive and (filter == nil or unit.Type == filter) then
			table.insert(list, unit)
		end
	end
	return list
end

local function lowest(list)
	local best, bestRatio = nil, math.huge
	for _, unit in list do
		local ratio = unit.HP / unit.MaxHP
		if ratio < bestRatio then
			best, bestRatio = unit, ratio
		end
	end
	return best
end

-- Who an effect reaches. Heals, shields, cleanses and evades only reach Attack cards.
function Engine:Targets(source, target: string, kind: string?)
	local hpOnly = kind ~= nil and HP_ONLY[kind] == true
	if target == "Self" then
		return if hpOnly and not source.HasHP then {} else { source }
	elseif target == "Lowest" then
		local unit = lowest(self:Alive("Attack"))
		return if unit then { unit } else {}
	elseif target == "Attack" then
		return self:Alive("Attack")
	elseif target == "All" then
		return if hpOnly then self:Alive("Attack") else self:Alive()
	elseif target == "Random" then
		-- Energy only matters to cards with an Ultimate.
		local pool = {}
		for _, unit in self:Alive() do
			if unit.Ultimate then
				table.insert(pool, unit)
			end
		end
		if #pool == 0 then
			return {}
		end
		return { pool[self.Rng:NextInteger(1, #pool)] }
	end
	return {}
end

local function ids(list)
	local out = {}
	for _, unit in list do
		table.insert(out, unit.Id)
	end
	return out
end

-- Damage ----------------------------------------------------------------------------

function Engine:BreakBarrier()
	local boss = self.Boss
	boss.Barrier = 0
	boss.Debuffs["Boss:Broken"] = { Stat = "Vuln", Amount = B.BreakVuln, Left = turns(B.BreakTurns) }
	self:Emit({ K = "Break" })
end

-- A boss barrier soaks Skill / Ultimate damage and lets only a little of anything else through.
function Engine:ThroughBarrier(amount: number, burst: boolean): number
	local boss = self.Boss
	if boss.Barrier <= 0 then
		return amount
	end
	if not burst then
		return round(amount * B.BarrierLeak)
	end
	local absorbed = math.min(boss.Barrier, amount)
	boss.Barrier -= absorbed
	if boss.Barrier <= 0 then
		self:BreakBarrier()
	end
	return amount - absorbed
end

function Engine:StealBuffs()
	local steal = self.Boss.Def.OnPhase and self.Boss.Def.OnPhase.Steal
	if not steal then
		return
	end
	local stolen = 0
	for _, unit in self:Alive("Attack") do
		local bestKey, bestAmount = nil, 0
		for key, buff in unit.Buffs do
			if buff.Left ~= math.huge and buff.Amount > bestAmount then
				bestKey, bestAmount = key, buff.Amount
			end
		end
		if bestKey then
			unit.Buffs[bestKey] = nil
			stolen += 1
		end
	end
	self.Boss.BonusATK += steal
	self:Emit({ K = "Steal", A = stolen, Stat = steal })
end

function Engine:DamageBoss(source, amount: number, crit: boolean, kind: string)
	local boss = self.Boss
	if self.Over then
		return
	end
	boss.HP = math.max(0, boss.HP - amount)
	source.Dealt += amount
	self:Emit({ K = kind, U = source.Id, T = "Boss", A = amount, C = crit or nil, Bl = if boss.Barrier > 0 then true else nil })

	if boss.HP <= 0 then
		self:Finish("Win")
		return
	end
	if boss.Phase == 1 and boss.HP <= boss.MaxHP * B.PhaseAt then
		boss.Phase = 2
		boss.PhaseActions = 0
		local added = {}
		for _, move in boss.Moves do
			if move.Phase == 2 then
				table.insert(added, move.Name)
			end
		end
		self:Emit({ K = "Phase", N = table.concat(added, ", ") })
		self:StealBuffs()
	end
	if not boss.Enraged and boss.HP <= boss.MaxHP * B.EnrageAt then
		boss.Enraged = true
		self:Emit({ K = "Enrage" })
		self:StealBuffs()
	end
end

function Engine:HitBoss(unit, pct: number, ignoreDef: boolean?)
	local buffs = self:Buff(unit, "ATK") + self:BossDebuff("Vuln")
	local crit = self.Rng:NextNumber() < B.CritChance + self:Buff(unit, "Crit")
	local critMult = if crit then B.CritDamage + self:Buff(unit, "CritDamage") else 1
	local def = if ignoreDef then 0 else self:BossDEF()
	local amount = math.max(1, round(unit.Main * pct * (1 + buffs) * critMult * (1 - def)))
	local burst = self.Slot == "Skill" or self.Slot == "Ultimate"
	amount = if ignoreDef then amount else self:ThroughBarrier(amount, burst)
	self:DamageBoss(unit, amount, crit, "Hit")
end

function Engine:DamageAlly(target, amount: number, kind: string)
	if not target.Alive or not target.HasHP or self.Over then
		return
	end
	if target.Invuln > 0 then
		self:Emit({ K = kind, U = "Boss", T = target.Id, A = 0 })
		return
	end
	local absorbed = math.min(target.Shield, amount)
	target.Shield -= absorbed
	target.HP -= amount - absorbed
	self:Emit({ K = kind, U = "Boss", T = target.Id, A = amount, Sh = if absorbed > 0 then absorbed else nil })

	if target.HP > 0 then
		return
	end
	local oath = self.DawnOath
	if oath and not oath.Used then
		oath.Used = true
		target.HP = 1
		target.Invuln = oath.Seconds
		self:Emit({ K = "Signature", U = oath.Owner.Id, T = target.Id, N = "Dawn Oath" })
		return
	end
	target.HP = 0
	target.Alive = false
	target.Shield = 0
	target.Burns = {}
	target.Frozen = false
	target.Taunt = 0
	target.Gauge = 0
	target.Energy = 0
	self:Emit({ K = "KO", T = target.Id })
	if not self:AttackAlive() then
		self:Finish("Lose")
	end
end

function Engine:HitAlly(target, move)
	if not target.Alive then
		return
	end
	if target.Evades > 0 then
		target.Evades -= 1
		self:Emit({ K = "Miss", T = target.Id })
		return
	end
	local atk = self:BossATK()
	local amount = math.max(1, round(atk * move.Pct * (1 - math.min(0.8, self:Buff(target, "Guard")))))
	self:DamageAlly(target, amount, "Hit")
	if not target.Alive then
		return
	end
	self:GainEnergy(target, B.EnergyPerHit)
	if move.Burn then
		table.insert(target.Burns, {
			Damage = math.max(1, round(atk * move.Burn.Pct)),
			Ticks = move.Burn.Turns,
			Timer = B.TurnSeconds,
		})
	end
	if move.Freeze and not target.Frozen then
		target.Frozen = true
		self:Emit({ K = "Frozen", T = target.Id })
	end
end

-- Effects -----------------------------------------------------------------------------

-- quiet: passive/aura upkeep that shouldn't pop text on screen.
function Engine:RunEffect(unit, effect, quiet: boolean?, abilityName: string?)
	local kind = effect.Kind
	local rng = self.Rng
	if kind == "Damage" then
		for _ = 1, effect.Hits or 1 do
			if self.Over then
				return
			end
			self:HitBoss(unit, effect.Pct, effect.IgnoreDef)
		end
		for _, passive in unit.Passives do
			if passive.When == "OnHit" then
				self:RunEffect(unit, passive, false)
			end
		end
	elseif kind == "Burn" then
		if effect.Chance == nil or rng:NextNumber() < effect.Chance then
			table.insert(self.Boss.Burns, {
				Damage = math.max(1, round(unit.Main * effect.Pct)),
				Ticks = effect.Turns or 3,
				Timer = B.TurnSeconds,
				Source = unit,
			})
			self:Emit({ K = "Burned", U = unit.Id, T = "Boss" })
		end
	elseif kind == "Heal" then
		for _, target in self:Targets(unit, effect.Target or "Lowest", kind) do
			local healed = math.min(round(unit.Main * effect.Pct), target.MaxHP - target.HP)
			target.HP += healed
			unit.Healed += healed
			if not quiet then
				self:Emit({ K = "Heal", U = unit.Id, T = target.Id, A = healed })
			end
		end
	elseif kind == "Shield" then
		local amount = round(unit.Main * effect.Pct)
		for _, target in self:Targets(unit, effect.Target or "Lowest", kind) do
			unit.Healed += math.max(0, amount - target.Shield)
			target.Shield = math.max(target.Shield, amount)
			target.ShieldLeft = turns(B.ShieldTurns)
			if not quiet then
				self:Emit({ K = "Shield", U = unit.Id, T = target.Id, A = amount })
			end
		end
	elseif kind == "Buff" then
		local targets = self:Targets(unit, effect.Target or "Self", kind)
		local key = `{unit.Id}:{abilityName or "Passive"}:{effect.Stat}`
		for _, target in targets do
			target.Buffs[key] = { Stat = effect.Stat, Amount = effect.Amount, Left = turns(effect.Turns) }
		end
		if not quiet then
			self:Emit({ K = "Buff", U = unit.Id, T = ids(targets), Stat = effect.Stat, A = effect.Amount })
		end
	elseif kind == "Debuff" then
		local key = `{unit.Id}:{abilityName or "Passive"}:{effect.Stat}`
		self.Boss.Debuffs[key] = { Stat = effect.Stat, Amount = effect.Amount, Left = turns(effect.Turns) }
		if not quiet then
			self:Emit({ K = "Debuff", U = unit.Id, T = "Boss", Stat = effect.Stat, A = effect.Amount })
		end
	elseif kind == "Energy" then
		local targets = self:Targets(unit, effect.Target or "All", kind)
		for _, target in targets do
			self:GainEnergy(target, effect.Amount)
			if effect.ResetSkill and target.Skill then
				target.SkillCooldown = 0
			end
		end
		if not quiet and effect.When == nil then
			self:Emit({ K = "Energy", U = unit.Id, T = ids(targets), A = effect.Amount })
		end
	elseif kind == "Cleanse" then
		for _, target in self:Targets(unit, effect.Target or "All", kind) do
			local removed = 0
			for _ = 1, effect.Amount or 1 do
				if target.Frozen then
					target.Frozen = false
					removed += 1
				elseif #target.Burns > 0 then
					table.remove(target.Burns, 1)
					removed += 1
				end
			end
			if removed > 0 and not quiet then
				self:Emit({ K = "Cleanse", U = unit.Id, T = target.Id })
			end
		end
	elseif kind == "Taunt" then
		if unit.HasHP then
			unit.Taunt = turns(effect.Turns or 2)
			self:Emit({ K = "Taunt", U = unit.Id })
		end
	elseif kind == "Revive" then
		for _, target in self.Allies do
			if target.HasHP and not target.Alive then
				target.Alive = true
				target.HP = math.max(1, round(target.MaxHP * effect.Pct))
				target.Gauge = 0
				self:Emit({ K = "Revive", U = unit.Id, T = target.Id, A = target.HP })
			end
		end
	elseif kind == "Evade" then
		for _, target in self:Targets(unit, effect.Target or "Self", kind) do
			target.Evades += effect.Hits or 1
		end
	end
end

function Engine:RunAbility(unit, ability, slot: string)
	local previous = self.Slot
	self.Slot = slot
	for _, effect in ability.Effects do
		if self.Over then
			break
		end
		self:RunEffect(unit, effect, false, ability.Name)
	end
	self.Slot = previous
end

-- Actions ---------------------------------------------------------------------------

-- As the fight opens, every Support card casts its Basic once (shields up, buffs on, debuffs out).
function Engine:Opening()
	self.Opened = true
	local any = false
	for _, unit in self.Allies do
		if unit.Type == "Support" and unit.Basic then
			if not any then
				self:Emit({ K = "Opening" })
				any = true
			end
			self:Emit({ K = "Act", U = unit.Id, Ab = "Opening", N = unit.Basic.Name })
			self:RunAbility(unit, unit.Basic, "Opening")
		end
	end
end

function Engine:CardAct(unit)
	unit.Actions += 1
	local ability, slot = unit.Basic, "Basic"
	if unit.Skill then
		if unit.SkillCooldown <= 0 then
			ability, slot = unit.Skill, "Skill"
			unit.SkillCooldown = (unit.Skill.Every or 3) - 1
		else
			unit.SkillCooldown -= 1
		end
	end
	if ability then
		self:Emit({ K = "Act", U = unit.Id, Ab = slot, N = ability.Name })
		self:RunAbility(unit, ability, slot)
	end
	if self.Over then
		return
	end
	self:GainEnergy(unit, B.EnergyPerAction)
	for _, passive in unit.Passives do
		if passive.When == "OnAct" then
			self:RunEffect(unit, passive, true)
		end
	end
	if unit.EclipseEvery and unit.Actions % unit.EclipseEvery == 0 and unit.Alive then
		self:Emit({ K = "Signature", U = unit.Id, N = "Eclipse" })
		self:CardAct(unit)
	end
end

function Engine:ChooseMove()
	local boss = self.Boss
	local moves = boss.Moves
	for _, move in moves do
		local phase = move.Phase or 1
		if phase <= boss.Phase then
			if move.Every == nil then
				return move
			end
			local count = if phase >= 2 then boss.PhaseActions else boss.Actions
			if count % move.Every == 0 then
				return move
			end
		end
	end
	return moves[#moves]
end

-- Single-target pick: the taunting card, else a random Attack card.
function Engine:PickTarget()
	local front = self:Alive("Attack")
	for _, unit in front do
		if unit.Taunt > 0 then
			return unit
		end
	end
	if #front == 0 then
		return nil
	end
	return front[self.Rng:NextInteger(1, #front)]
end

function Engine:BossAct()
	local boss = self.Boss
	boss.Actions += 1
	if boss.Phase >= 2 then
		boss.PhaseActions += 1
	end
	local move = self:ChooseMove()
	local target = if move.Target == "Single" then self:PickTarget() else nil
	if move.Warn then
		boss.Pending = { Move = move, Target = target, Left = self.WarnSeconds }
		local marked = if target then { target.Id } elseif move.Target == "Self" then {} else ids(self:Alive("Attack"))
		self:Emit({ K = "Warn", N = move.Name, T = marked, S = self.WarnSeconds })
	else
		self:BossStrike(move, target)
	end
end

function Engine:BossStrike(move, target)
	local boss = self.Boss
	self:Emit({ K = "Act", U = "Boss", Ab = if move.Warn then "Skill" else "Basic", N = move.Name })

	if move.Target == "Self" then
		if move.Barrier then
			boss.Barrier = round(boss.MaxHP * move.Barrier)
			self:Emit({ K = "Barrier", A = boss.Barrier })
		end
		return
	end

	local hitList = {}
	if move.Target == "All" then
		for _, unit in self:Alive("Attack") do
			for _ = 1, move.Hits or 1 do
				table.insert(hitList, unit)
			end
		end
	elseif move.Target == "Random" then
		for _ = 1, move.Hits or 1 do
			local unit = self:PickTarget()
			if unit then
				table.insert(hitList, unit)
			end
		end
	else
		-- A taunt raised during the warning still pulls the hit; a KO'd target is replaced.
		local pick = self:PickTarget()
		if pick and pick.Taunt > 0 then
			target = pick
		elseif target == nil or not target.Alive then
			target = pick
		end
		if target then
			for _ = 1, move.Hits or 1 do
				table.insert(hitList, target)
			end
		end
	end
	for _, unit in hitList do
		if self.Over then
			return
		end
		self:HitAlly(unit, move)
	end

	if move.Slow and not self.Over then
		for _, unit in self:Alive() do
			unit.Buffs["Boss:Slow"] = { Stat = "SPD", Amount = -move.Slow.Amount, Left = turns(move.Slow.Turns) }
		end
		self:Emit({ K = "Slow", A = move.Slow.Amount })
	end
end

-- Ultimates -------------------------------------------------------------------------------

function Engine:CanUltimate(unit): boolean
	return unit ~= nil
		and unit ~= self.Boss
		and unit.Alive
		and unit.Ultimate ~= nil
		and unit.Energy >= B.UltimateCost
		and not self.Over
end

function Engine:UseUltimate(id: string): (boolean, string?)
	local unit = self.ById[id]
	if not self:CanUltimate(unit) then
		return false, "NotReady"
	end
	unit.Energy = 0
	self:Emit({ K = "Act", U = unit.Id, Ab = "Ultimate", N = unit.Ultimate.Name })
	self:RunAbility(unit, unit.Ultimate, "Ultimate")
	return true, nil
end

-- Time -------------------------------------------------------------------------------------

local function tickTimers(list, dt: number)
	for key, entry in list do
		entry.Left -= dt
		if entry.Left <= 0 then
			list[key] = nil
		end
	end
end

-- Advances burns: calls hit(burn) for each tick that is due.
local function tickBurns(burns, dt: number, hit)
	local i = 1
	while i <= #burns do
		local burn = burns[i]
		burn.Timer -= dt
		if burn.Timer <= 0 then
			burn.Timer += B.TurnSeconds
			burn.Ticks -= 1
			hit(burn)
		end
		if burn.Ticks <= 0 then
			table.remove(burns, i)
		else
			i += 1
		end
	end
end

function Engine:Step(dt: number)
	if self.Over then
		return
	end
	if not self:AttackAlive() then
		self:Finish("Lose")
		return
	end
	if not self.Opened then
		self:Opening()
		if self.Over then
			return
		end
	end
	self.Time += dt
	local boss = self.Boss

	-- Durations and damage over time.
	for _, unit in self.Allies do
		if unit.Alive then
			tickTimers(unit.Buffs, dt)
			unit.Taunt = math.max(0, unit.Taunt - dt)
			unit.Invuln = math.max(0, unit.Invuln - dt)
			if unit.Shield > 0 then
				unit.ShieldLeft -= dt
				if unit.ShieldLeft <= 0 then
					unit.Shield = 0
				end
			end
			tickBurns(unit.Burns, dt, function(burn)
				self:DamageAlly(unit, burn.Damage, "Burn")
			end)
		end
	end
	tickTimers(boss.Debuffs, dt)
	tickBurns(boss.Burns, dt, function(burn)
		self:DamageBoss(burn.Source, self:ThroughBarrier(burn.Damage, false), false, "Burn")
	end)
	if self.Over then
		return
	end

	-- A warned boss move lands when its warning runs out.
	if boss.Pending then
		boss.Pending.Left -= dt
		if boss.Pending.Left <= 0 then
			local pending = boss.Pending
			boss.Pending = nil
			self:BossStrike(pending.Move, pending.Target)
		end
	end

	-- Fill action bars, then let every full bar act (fullest first, ties to the left).
	local ready = {}
	for _, unit in self.Allies do
		if unit.Alive then
			unit.Gauge += self:Speed(unit) * dt / (100 * B.TurnSeconds)
			if unit.Gauge >= 1 then
				table.insert(ready, unit)
			end
		end
	end
	if boss.Pending == nil then
		boss.Gauge += self:Speed(boss) * dt / (100 * B.TurnSeconds)
		if boss.Gauge >= 1 then
			table.insert(ready, boss)
		end
	end
	table.sort(ready, function(a, b)
		if a.Gauge ~= b.Gauge then
			return a.Gauge > b.Gauge
		end
		return a.Order < b.Order
	end)
	for _, unit in ready do
		if self.Over then
			return
		end
		if unit.Alive and unit.Gauge >= 1 then
			unit.Gauge -= 1
			if unit == boss then
				self:BossAct()
			elseif unit.Frozen then
				unit.Frozen = false
				self:Emit({ K = "Thaw", U = unit.Id })
			else
				self:CardAct(unit)
			end
		end
	end

	if self.AutoUlt then
		for _, unit in self.Allies do
			if self:CanUltimate(unit) then
				self:UseUltimate(unit.Id)
			end
		end
	end

	if not self.Over and self.Time >= B.TimeLimit then
		self:Finish("Timeout")
	end
end

-- For the client ------------------------------------------------------------------------------

-- Static facts the battle screen needs once.
function Engine:Info()
	local allies = {}
	for _, unit in self.Allies do
		table.insert(allies, {
			Id = unit.Id,
			CardId = unit.Card.Id,
			MaxHP = if unit.HasHP then unit.MaxHP else nil,
			Main = unit.Main,
			Ultimate = if unit.Ultimate then unit.Ultimate.Name else nil,
		})
	end
	local boss = self.Boss
	return {
		BossId = self.BossId,
		Difficulty = self.Difficulty,
		Boss = { MaxHP = boss.MaxHP, ATK = round(boss.ATK), DEF = boss.DEF, SPD = boss.SPD },
		Allies = allies,
		TimeLimit = B.TimeLimit,
		UltimateCost = B.UltimateCost,
	}
end

local function gauge(value: number): number
	return math.floor(math.clamp(value, 0, 1) * 100) / 100
end

-- Live numbers for every unit. Card flags: B burning, Z frozen, T taunt, U buffed, S slowed,
-- G guarded, I invulnerable. Boss flags: D DEF down, A ATK down, S slowed, V takes more damage,
-- B burning, E enraged, W winding up, R barrier up. Support cards send no HP.
function Engine:Snapshot()
	local units = {}
	for _, unit in self.Allies do
		local flags = ""
		if #unit.Burns > 0 then
			flags ..= "B"
		end
		if unit.Frozen then
			flags ..= "Z"
		end
		if unit.Taunt > 0 then
			flags ..= "T"
		end
		local up, slowed, guarded = false, false, false
		for _, buff in unit.Buffs do
			local stat: string = buff.Stat
			if buff.Left ~= math.huge then
				if stat == "Guard" then
					guarded = true
				elseif buff.Amount > 0 then
					up = true
				elseif stat == "SPD" then
					slowed = true
				end
			end
		end
		if up then
			flags ..= "U"
		end
		if slowed then
			flags ..= "S"
		end
		if guarded then
			flags ..= "G"
		end
		if unit.Invuln > 0 then
			flags ..= "I"
		end
		units[unit.Id] = {
			H = if unit.HasHP then math.max(0, round(unit.HP)) else nil,
			S = if unit.HasHP then round(unit.Shield) else nil,
			E = unit.Energy,
			G = if unit.Alive then gauge(unit.Gauge) else 0,
			F = flags,
		}
	end
	local boss = self.Boss
	local flags = ""
	for _, stat in { "DEF", "ATK", "SPD", "Vuln" } do
		for _, debuff in boss.Debuffs do
			if debuff.Stat == stat and debuff.Left ~= math.huge then
				flags ..= if stat == "DEF" then "D" elseif stat == "ATK" then "A" elseif stat == "SPD" then "S" else "V"
				break
			end
		end
	end
	if #boss.Burns > 0 then
		flags ..= "B"
	end
	if boss.Enraged then
		flags ..= "E"
	end
	if boss.Pending then
		flags ..= "W"
	end
	if boss.Barrier > 0 then
		flags ..= "R"
	end
	units.Boss = {
		H = round(boss.HP),
		G = if boss.Pending then 1 else gauge(boss.Gauge),
		F = flags,
		Bar = if boss.Barrier > 0 then boss.Barrier else nil,
	}
	return { T = math.floor(self.Time * 10) / 10, U = units }
end

-- End-of-fight numbers for the results screen.
function Engine:Summary()
	local dealt = {}
	for _, unit in self.Allies do
		dealt[unit.Id] = { Dealt = unit.Dealt, Healed = unit.Healed, Alive = unit.Alive }
	end
	return {
		Result = self.Result,
		Time = math.floor(self.Time * 10) / 10,
		BossHP = round(self.Boss.HP),
		BossMaxHP = self.Boss.MaxHP,
		Units = dealt,
	}
end

return Engine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">BattleService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Boss fights run here, on the server, in real time. The client only asks (start, fire an
-- Ultimate, toggle Auto, change speed, give up) and animates the events streamed back.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Bosses = require(Shared.Bosses)
local Deck = require(Shared.Deck)

local Remotes = ReplicatedStorage.Remotes
local DataService = require(script.Parent.DataService)
local DeckService = require(script.Parent.DeckService)
local RateLimit = require(script.Parent.RateLimit)
local Engine = require(script.Parent.BattleEngine)

local BattleService = {}

local B = Config.Battle
local FLUSH_SECONDS = 0.15 -- how often event batches go to the client

local active = {} -- [Player] = { Engine, Speed, Started }
local startLimiter = RateLimit.new(1, 3)
local inputLimiter = RateLimit.new(15, 30)

local function speedAllowed(data, speed: unknown): boolean
	if speed == 1 then
		return true
	end
	if not table.find(B.Speeds, speed) then
		return false
	end
	return not Config.Unlocks.Enabled or data.Progress.Cleared[B.SpeedUnlock] == true
end

-- Pays boss reward rolls; set by Main.server to RollService.RewardRolls (which needs this module).
local rewardRolls: ((player: Player, d: number, firstClear: boolean) -> any)? = nil

function BattleService.SetRewardHandler(handler)
	rewardRolls = handler
end

local function recordResult(player: Player, battle)
	local profile = DataService.Get(player)
	if profile == nil then
		return nil
	end
	local data = profile.Data
	local key = Bosses.FightKey(battle.BossId, battle.Difficulty)
	local record = { FirstClear = false, NewBest = false }
	if battle.Result == "Win" then
		record.FirstClear = data.Progress.Cleared[key] ~= true
		data.Progress.Cleared[key] = true
		local time = math.floor(battle.Time * 10) / 10
		local best = data.Progress.BestTime[key]
		if best == nil or time < best then
			data.Progress.BestTime[key] = time
			record.NewBest = true
		end
	end
	record.Progress = data.Progress
	record.SpeedUnlocked = speedAllowed(data, 2)
	return record
end

local function run(player: Player, state)
	local battle = state.Engine
	task.wait(B.IntroSeconds)
	state.Started = true

	local pending = 0 -- battle seconds not yet simulated
	local sinceFlush = 0
	while active[player] == state and player.Parent == Players do
		local dt = RunService.Heartbeat:Wait()
		pending += dt * state.Speed
		sinceFlush += dt
		while pending >= B.Tick and not battle.Over do
			battle:Step(B.Tick)
			pending -= B.Tick
		end
		if battle.Over or sinceFlush >= FLUSH_SECONDS then
			sinceFlush = 0
			Remotes.BattleEvent:FireClient(player, { Events = battle:TakeEvents(), Snap = battle:Snapshot() })
		end
		if battle.Over then
			break
		end
	end

	if active[player] ~= state then
		return -- stopped from outside (player left, test-data reset)
	end
	active[player] = nil
	local summary = battle:Summary()
	local record = recordResult(player, battle)
	if record then
		summary.FirstClear = record.FirstClear
		summary.NewBest = record.NewBest
		summary.Progress = record.Progress
		summary.SpeedUnlocked = record.SpeedUnlocked
		local boss = Bosses.Get(battle.BossId)
		if battle.Result == "Win" and rewardRolls and boss then
			summary.Rewards = rewardRolls(player, boss.Difficulties[battle.Difficulty].D, record.FirstClear)
		end
	end
	if player.Parent == Players then
		Remotes.BattleEvent:FireClient(player, { Done = summary })
	end
end

function BattleService.InBattle(player: Player): boolean
	return active[player] ~= nil
end

-- Ends a fight without a result (used by the test-data reset).
function BattleService.Stop(player: Player)
	if active[player] then
		active[player] = nil
		Remotes.BattleEvent:FireClient(player, { Done = { Result = "Stopped" } })
	end
end

local function start(player: Player, bossId: unknown, difficulty: unknown)
	if type(bossId) ~= "string" or type(difficulty) ~= "string" then
		return { Ok = false, Reason = "BadRequest" }
	end
	local boss = Bosses.Get(bossId)
	if boss == nil or boss.Difficulties[difficulty] == nil then
		return { Ok = false, Reason = "BadRequest" }
	end
	if active[player] then
		return { Ok = false, Reason = "InBattle" }
	end
	local profile = DataService.Get(player)
	if profile == nil then
		return { Ok = false, Reason = "Loading" }
	end
	local data = profile.Data
	if not Bosses.IsUnlocked(data.Progress.Cleared, boss.Id, difficulty) then
		return { Ok = false, Reason = "Locked" }
	end

	-- The saved deck is checked again here: the fight only ever uses owned cards.
	local deck = DeckService.Active(data)
	if Deck.Count(deck, "Attack") == 0 then
		return { Ok = false, Reason = "NoAttack" }
	end
	local units = {}
	for _, row in Deck.Rows do
		for i, id in deck[row] do
			if id ~= "" then
				table.insert(units, { Id = `{string.sub(row, 1, 1)}{i}`, CardId = id, Stars = data.Cards[id].Stars })
			end
		end
	end

	local battle = Engine.new({ Units = units, BossId = boss.Id, Difficulty = difficulty, Rng = Random.new() })
	battle.AutoUlt = data.Settings.AutoUlt == true
	local speed = if speedAllowed(data, data.Settings.BattleSpeed) then data.Settings.BattleSpeed else 1
	local state = { Engine = battle, Speed = speed, Started = false }
	active[player] = state
	task.spawn(run, player, state)

	return {
		Ok = true,
		Info = battle:Info(),
		Snap = battle:Snapshot(),
		AutoUlt = battle.AutoUlt,
		Speed = speed,
		SpeedUnlocked = speedAllowed(data, 2),
		Intro = B.IntroSeconds,
		DeckPower = Deck.Power(deck, data.Cards),
	}
end

function BattleService.Start()
	Remotes.BattleStart.OnServerInvoke = function(player: Player, bossId: unknown, difficulty: unknown)
		if not startLimiter:Allow(player) then
			return { Ok = false, Reason = "TooFast" }
		end
		return start(player, bossId, difficulty)
	end

	Remotes.BattleInput.OnServerEvent:Connect(function(player: Player, action: unknown, value: unknown)
		if not inputLimiter:Allow(player) then
			return
		end
		local state = active[player]
		local profile = DataService.Get(player)
		if action == "Auto" then
			if type(value) ~= "boolean" or profile == nil then
				return
			end
			profile.Data.Settings.AutoUlt = value
			if state then
				state.Engine.AutoUlt = value
			end
		elseif action == "Speed" then
			if profile == nil or not speedAllowed(profile.Data, value) then
				return
			end
			profile.Data.Settings.BattleSpeed = value
			if state then
				state.Speed = value
			end
		elseif state == nil then
			return
		elseif action == "Ultimate" then
			-- The engine checks the card is alive, has an Ultimate and 100 energy.
			if type(value) == "string" and state.Started then
				state.Engine:UseUltimate(value)
			end
		elseif action == "Forfeit" then
			state.Engine:Forfeit()
		end
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		active[player] = nil
	end)
end

return BattleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Player saves through ProfileStore (session-locked, auto-saving).
-- In Studio without API access, ProfileStore falls back to an in-memory mock,
-- so the game still runs; data just won't persist between test sessions.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ProfileStore = require(script.Parent.ProfileStore)
local Config = require(ReplicatedStorage.Shared.Config)
local Deck = require(ReplicatedStorage.Shared.Deck)

local presets = {}
for i = 1, Config.Deck.Presets do
	presets[i] = Deck.Empty()
end

local TEMPLATE = {
	DataVersion = 1,
	Cards = {}, -- [cardId] = { Copies = number, Stars = number }
	TotalRolls = 0,
	Shards = 0,
	Pity = { Epic = 0, Legendary = 0 },
	Playtime = 0, -- seconds, saved when the player leaves
	Settings = { AutoStop = Config.DefaultAutoStop, AutoUlt = false, BattleSpeed = 1 },
	Decks = { Active = 1, Presets = presets }, -- each preset: { Attack = {4 ids}, Support = {4 ids} }, "" = empty
	Progress = { Cleared = {}, BestTime = {} }, -- keyed by Bosses.FightKey, e.g. "kurogane:Normal"
	-- Long-term progression (Meta.luau): potions owned / seconds left running (ticks only while online),
	-- Shard upgrade levels, claimed Index rarities, daily streak, claimed roll milestones ("50", "100", ...).
	Potions = { Inventory = {}, Active = {} },
	Upgrades = { RollSpeed = 0, Luck = 0 },
	IndexClaimed = {},
	Daily = { Day = 0, Streak = 0 },
	Milestones = {},
}

-- Test saves live in their own store so launch data starts clean.
local STORE_NAME = if Config.TestMode then "PlayerData_Test_1" else "PlayerData_1"

local PlayerStore = ProfileStore.New(STORE_NAME, TEMPLATE)

local DataService = {}

local profiles = {} -- [Player] = Profile
local sessionStart = {} -- [Player] = os.clock() when the profile loaded

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

function DataService.Template()
	return deepCopy(TEMPLATE)
end

function DataService.Get(player: Player)
	return profiles[player]
end

-- Waits until the player's profile has loaded (or they leave / time runs out).
function DataService.WaitFor(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 20)
	while profiles[player] == nil and player.Parent == Players and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Saved playtime plus this session so far.
function DataService.Playtime(player: Player): number
	local profile = profiles[player]
	if profile == nil then
		return 0
	end
	local start = sessionStart[player]
	local live = if start then os.clock() - start else 0
	return profile.Data.Playtime + live
end

-- Seconds since this server session's profile loaded (playtime gifts count this).
function DataService.SessionSeconds(player: Player): number
	local start = sessionStart[player]
	return if start then os.clock() - start else 0
end

-- Wipes the player's data back to the template (test phase only).
function DataService.Reset(player: Player)
	local profile = profiles[player]
	if profile == nil then
		return
	end
	local fresh = DataService.Template()
	for key in profile.Data do
		profile.Data[key] = nil
	end
	for key, value in fresh do
		profile.Data[key] = value
	end
	sessionStart[player] = os.clock()
end

local function onPlayerAdded(player: Player)
	local profile = PlayerStore:StartSessionAsync(`{player.UserId}`, {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})

	if profile == nil then
		-- Only happens when the server is shutting down or the player left.
		if player.Parent == Players then
			player:Kick("Could not load your data - please rejoin.")
		end
		return
	end

	profile:AddUserId(player.UserId) -- GDPR compliance
	profile:Reconcile() -- fill in fields added to TEMPLATE after this save was made

	profile.OnSessionEnd:Connect(function()
		profiles[player] = nil
		sessionStart[player] = nil
		if player.Parent == Players then
			player:Kick("Your data was opened on another server - please rejoin.")
		end
	end)

	if player.Parent == Players then
		profiles[player] = profile
		sessionStart[player] = os.clock()
	else
		profile:EndSession()
	end
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile == nil then
		return
	end
	local start = sessionStart[player]
	if start then
		profile.Data.Playtime += os.clock() - start
	end
	profile:EndSession()
end

function DataService.Start()
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">DeckService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Deck presets: save, switch and auto-build. Every deck a client sends goes through
-- Deck.Validate (4 + 4 slots, right types, no copies, owned cards only).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Deck = require(Shared.Deck)

local Remotes = ReplicatedStorage.Remotes
local DataService = require(script.Parent.DataService)
local RateLimit = require(script.Parent.RateLimit)

local DeckService = {}

local limiter = RateLimit.new(8, 16)

-- What the client gets: all presets (cleaned of cards no longer owned) and the active one.
function DeckService.State(data)
	local presets = {}
	for i = 1, Config.Deck.Presets do
		presets[i] = Deck.Clean(data.Decks.Presets[i] or Deck.Empty(), data.Cards)
	end
	return { Active = data.Decks.Active, Presets = presets }
end

-- The deck a fight starts with.
function DeckService.Active(data)
	return Deck.Clean(data.Decks.Presets[data.Decks.Active] or Deck.Empty(), data.Cards)
end

local function validPreset(preset: unknown): boolean
	return type(preset) == "number" and preset == math.floor(preset) and preset >= 1 and preset <= Config.Deck.Presets
end

function DeckService.Start()
	Remotes.Deck.OnServerInvoke = function(player: Player, action: unknown, preset: unknown, deck: unknown)
		if not limiter:Allow(player) then
			return { Ok = false, Reason = "TooFast" }
		end
		local profile = DataService.Get(player)
		if profile == nil then
			return { Ok = false, Reason = "Loading" }
		end
		if not validPreset(preset) then
			return { Ok = false, Reason = "BadRequest" }
		end
		local data = profile.Data
		if action == "Save" then
			local clean, reason = Deck.Validate(deck, data.Cards)
			if clean == nil then
				return { Ok = false, Reason = reason, Decks = DeckService.State(data) }
			end
			data.Decks.Presets[preset] = clean
		elseif action == "Select" then
			data.Decks.Active = preset
		elseif action == "AutoBuild" then
			data.Decks.Presets[preset] = Deck.AutoBuild(data.Cards)
		else
			return { Ok = false, Reason = "BadRequest" }
		end
		return { Ok = true, Decks = DeckService.State(data) }
	end
end

return DeckService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point.

local World = require(script.Parent.World)
local DataService = require(script.Parent.DataService)
local RollService = require(script.Parent.RollService)
local DeckService = require(script.Parent.DeckService)
local BattleService = require(script.Parent.BattleService)
local MetaService = require(script.Parent.MetaService)

World.Build()
BattleService.SetRewardHandler(RollService.RewardRolls)
RollService.Start()
DeckService.Start()
MetaService.Start()
BattleService.Start()
DataService.Start()
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">MetaService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Long-term progression on the server: potions (use, buy, timers), Shard upgrades, Index
-- completion rewards, the daily streak, playtime gifts and roll milestones. Meta.luau has the numbers;
-- every claim and purchase is checked here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Cards = require(Shared.Cards)
local Meta = require(Shared.Meta)
local Rarity = require(Shared.Rarity)

local Remotes = ReplicatedStorage.Remotes
local DataService = require(script.Parent.DataService)
local RateLimit = require(script.Parent.RateLimit)

local MetaService = {}

local limiter = RateLimit.new(6, 12)
local giftsClaimed = {} -- [Player] = { [index] = true } for this server session

-- Adds a reward bundle to a save. Returns the bundle actually given.
function MetaService.Grant(data, bundle: Meta.Bundle)
	if bundle.Shards and bundle.Shards > 0 then
		data.Shards += bundle.Shards
	end
	if bundle.Potions then
		for id, count in bundle.Potions do
			if Meta.PotionById[id] and count > 0 then
				data.Potions.Inventory[id] = (data.Potions.Inventory[id] or 0) + count
			end
		end
	end
	return bundle
end

local devLuck = {} -- [Player] = base luck set from the dev panel (test phase only)

function MetaService.SetDevLuck(player: Player, luck: number?)
	devLuck[player] = luck
end

-- Base luck: 1x + Lucky Charm + Index rewards (or the dev panel's value).
function MetaService.BaseLuck(player: Player, data): number
	return devLuck[player] or Meta.BaseLuck(data.Upgrades, data.IndexClaimed)
end

-- The player's own luck: base x the strongest running luck potion, capped.
function MetaService.Luck(player: Player, data): number
	return Meta.TotalLuck(MetaService.BaseLuck(player, data), Meta.PotionLuck(data.Potions.Active))
end

function MetaService.Cooldown(data): number
	return Meta.Cooldown(data.Upgrades, data.Potions.Active)
end

local function indexComplete(data, rarity: string): boolean
	local pool = Cards.ByRarity[rarity]
	if pool == nil or #pool == 0 then
		return false
	end
	for _, card in pool do
		if data.Cards[card.Id] == nil then
			return false
		end
	end
	return true
end

-- Everything the progression screens need.
function MetaService.State(player: Player, data)
	local today = Meta.DayNumber(os.time())
	local canClaim, streakDay = Meta.DailyStatus(data.Daily, today)
	local complete = {}
	for _, rarity in Rarity.Order do
		complete[rarity] = indexComplete(data, rarity)
	end
	local claimedGifts = {}
	for index in giftsClaimed[player] or {} do
		table.insert(claimedGifts, index)
	end
	return {
		Shards = data.Shards,
		TotalRolls = data.TotalRolls,
		Inventory = data.Potions.Inventory,
		Active = data.Potions.Active,
		Upgrades = data.Upgrades,
		IndexClaimed = data.IndexClaimed,
		IndexComplete = complete,
		Daily = { CanClaim = canClaim, Day = streakDay, Streak = data.Daily.Streak },
		SessionSeconds = DataService.SessionSeconds(player),
		GiftsClaimed = claimedGifts,
		Milestones = data.Milestones,
		BaseLuck = MetaService.BaseLuck(player, data),
		Luck = MetaService.Luck(player, data),
		Cooldown = MetaService.Cooldown(data),
	}
end

-- Clears this session's playtime gifts (test-data reset).
function MetaService.ResetSession(player: Player)
	giftsClaimed[player] = nil
end

local function validIndex(value: unknown, list): boolean
	return type(value) == "number" and value == math.floor(value) and value >= 1 and value <= #list
end

local function handle(player: Player, data, action: unknown, arg: unknown)
	if action == "UsePotion" then
		local potion = type(arg) == "string" and Meta.PotionById[arg]
		if not potion then
			return false, "BadRequest"
		end
		local owned = data.Potions.Inventory[potion.Id] or 0
		if owned <= 0 then
			return false, "NoPotion"
		end
		local running = data.Potions.Active[potion.Id] or 0
		if running + potion.Seconds > Meta.MaxPotionSeconds then
			return false, "PotionFull"
		end
		data.Potions.Inventory[potion.Id] = owned - 1
		data.Potions.Active[potion.Id] = running + potion.Seconds
		return true
	elseif action == "BuyPotion" then
		local potion = type(arg) == "string" and Meta.PotionById[arg]
		if not potion then
			return false, "BadRequest"
		end
		if data.Shards < potion.Price then
			return false, "NoShards"
		end
		data.Shards -= potion.Price
		MetaService.Grant(data, { Potions = { [potion.Id] = 1 } })
		return true
	elseif action == "BuyUpgrade" then
		local upgrade = type(arg) == "string" and Meta.UpgradeById[arg]
		if not upgrade then
			return false, "BadRequest"
		end
		local level = data.Upgrades[upgrade.Id] or 0
		local cost = Meta.UpgradeCost(upgrade.Id, level)
		if cost == nil then
			return false, "MaxLevel"
		end
		if data.Shards < cost then
			return false, "NoShards"
		end
		data.Shards -= cost
		data.Upgrades[upgrade.Id] = level + 1
		return true
	elseif action == "ClaimDaily" then
		local today = Meta.DayNumber(os.time())
		local canClaim, streakDay = Meta.DailyStatus(data.Daily, today)
		if not canClaim then
			return false, "Claimed"
		end
		data.Daily.Day = today
		data.Daily.Streak = streakDay
		return true, nil, MetaService.Grant(data, Meta.Daily[streakDay])
	elseif action == "ClaimGift" then
		if not validIndex(arg, Meta.Playtime) then
			return false, "BadRequest"
		end
		local index = arg :: number
		local gift = Meta.Playtime[index]
		local claimed = giftsClaimed[player] or {}
		if claimed[index] then
			return false, "Claimed"
		end
		if DataService.SessionSeconds(player) < gift.Minutes * 60 then
			return false, "NotYet"
		end
		claimed[index] = true
		giftsClaimed[player] = claimed
		return true, nil, MetaService.Grant(data, gift.Reward)
	elseif action == "ClaimMilestone" then
		if not validIndex(arg, Meta.Milestones) then
			return false, "BadRequest"
		end
		local milestone = Meta.Milestones[arg :: number]
		local key = tostring(milestone.Rolls)
		if data.Milestones[key] then
			return false, "Claimed"
		end
		if data.TotalRolls < milestone.Rolls then
			return false, "NotYet"
		end
		data.Milestones[key] = true
		return true, nil, MetaService.Grant(data, milestone.Reward)
	elseif action == "ClaimIndex" then
		local reward = type(arg) == "string" and Meta.IndexRewards[arg]
		if not reward then
			return false, "BadRequest"
		end
		local rarity = arg :: string
		if data.IndexClaimed[rarity] then
			return false, "Claimed"
		end
		if not indexComplete(data, rarity) then
			return false, "NotYet"
		end
		data.IndexClaimed[rarity] = true
		return true, nil, MetaService.Grant(data, reward.Reward)
	end
	return false, "BadRequest"
end

function MetaService.Start()
	Remotes.Meta.OnServerInvoke = function(player: Player, action: unknown, arg: unknown)
		local profile = DataService.Get(player)
		if profile == nil then
			return { Ok = false, Reason = "Loading" }
		end
		if action == "Get" then
			return { Ok = true, Meta = MetaService.State(player, profile.Data) }
		end
		if not limiter:Allow(player) then
			return { Ok = false, Reason = "TooFast" }
		end
		local ok, reason, granted = handle(player, profile.Data, action, arg)
		return { Ok = ok, Reason = reason, Granted = granted, Meta = MetaService.State(player, profile.Data) }
	end

	-- Running potions tick down once a second while their owner is in the game.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local profile = DataService.Get(player)
				if profile then
					local active = profile.Data.Potions.Active
					for id, seconds in active do
						if seconds <= 1 then
							active[id] = nil
						else
							active[id] = seconds - 1
						end
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		giftsClaimed[player] = nil
		devLuck[player] = nil
	end)
end

return MetaService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source">--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --&gt; [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --&gt; [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -&gt; (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --&gt; is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --&gt; [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --&gt; [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --&gt; is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --&gt; [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --&gt; [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal do

	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()

		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end

	end

	function SignalClass.New()

		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self

	end

	function SignalClass:Connect(listener: (...any) -&gt; ())

		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection

	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})

end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue = { -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
	--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
}

local function WaitInUpdateQueue(session_token) --&gt; next_in_queue()

	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end

end

local function SessionToken(store_name, profile_key, is_mock)

	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token

end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --&gt; loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --&gt; loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(latest_data),
	--}

	local loaded_data, key_info
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local overwritten = false
			local global_updates = {0, {}}

			if latest_data == nil then

				missing_profile = true

			elseif type(latest_data) ~= "table" then

				missing_profile = true
				overwritten = true

			else

				if type(latest_data.Data) == "table" and type(latest_data.MetaData) == "table" and type(latest_data.GlobalUpdates) == "table" then

					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end

				elseif latest_data.Data == nil and latest_data.MetaData == nil and type(latest_data.GlobalUpdates) == "table" then

					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true

				else

					missing_profile = true
					overwritten = true

				end

			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

			loaded_data, key_info = MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		elseif DataStoreState ~= "Access" then -- Used when API access is disabled

			loaded_data, key_info = MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		else

			if is_get_call == true then

				if version ~= nil then

					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end

				else

					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)

				end

				loaded_data = transform_function(loaded_data)

			else

				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)

			end

		end

	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(
				profile_store.Name,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(
			error_message or "Undefined error",
			profile_store.Name,
			profile_key
		)
		-- Return nothing:
		return nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList &gt; 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end

end

local function RemoveProfileFromAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index &lt; AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end

end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)

	if type(profile.Data) ~= "table" then
		error(`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do

		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(
			profile.ProfileStore,
			profile.Key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					
					-- Check if this session still owns the profile:

					local session_owns_profile = false

					if is_overwriting ~= true then

						local active_session = latest_data.MetaData.ActiveSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
						end

					else
						session_owns_profile = true
					end

					-- We may only edit the profile if this server has ownership of the profile:

					if session_owns_profile == true then

						-- Clear processed updates (messages):

						local locked_updates = profile.locked_global_updates -- [index] = true, ...
						local active_updates = latest_data.GlobalUpdates[2]
						-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
						-- ProfileStore module format: {{update_id, update_data}, ...}

						if next(locked_updates) ~= nil then
							local i = 1
							while i &lt;= #active_updates do
								local update = active_updates[i]
								if locked_updates[update[1]] == true then
									table.remove(active_updates, i)
								else
									i += 1
								end
							end
						end

						-- Save profile data:

						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then

							latest_data.MetaData.LastUpdate = os.time()

							if is_ending_session == true then
								latest_data.MetaData.ActiveSession = nil
							end

						else

							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil

						end

					end

				end,
			},
			profile.is_mock
		)

		if loaded_data ~= nil and key_info ~= nil then

			if is_overwriting == true then
				break
			end
			
			repeat_save_flag = false
			
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end
			
			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end
			
			local is_active = profile:IsActive()
			
			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end
			
			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then

					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do

						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do

							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end
							
							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end

						end

					end

				end
			else
				
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end

			end

			profile.OnAfterSave:Fire(profile.LastSavedData)

		elseif repeat_save_flag == true then
			
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)

		end

	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1

end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type JSONAcceptable = { JSONAcceptable } | { [string]: JSONAcceptable } | number | string | boolean | buffer

export type Profile&lt;T&gt; = {
	Data: T &amp; JSONAcceptable,
	LastSavedData: T &amp; JSONAcceptable,
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: {PlaceId: number, JobId: string}?,
	RobloxMetaData: JSONAcceptable,
	UserIds: {number},
	KeyInfo: DataStoreKeyInfo,
	OnSave: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnLastSave: {Connect: (self: any, listener: (reason: "Manual" | "External" | "Shutdown") -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnSessionEnd: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnAfterSave: {Connect: (self: any, listener: (last_saved_data: T &amp; JSONAcceptable) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	ProfileStore: JSONAcceptable,
	Key: string,

	IsActive: (self: any) -&gt; (boolean),
	Reconcile: (self: any) -&gt; (),
	EndSession: (self: any) -&gt; (),
	AddUserId: (self: any, user_id: number) -&gt; (),
	RemoveUserId: (self: any, user_id: number) -&gt; (),
	MessageHandler: (self: any, fn: (message: JSONAcceptable, processed: () -&gt; ()) -&gt; ()) -&gt; (),
	Save: (self: any) -&gt; (),
	SetAsync: (self: any) -&gt; (),
}

export type VersionQuery&lt;T&gt; = {
	NextAsync: (self: any) -&gt; (Profile&lt;T&gt;?),
}

type ProfileStoreStandard&lt;T&gt; = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: {Steal: boolean?}) -&gt; (Profile&lt;T&gt;?),
	MessageAsync: (self: any, profile_key: string, message: JSONAcceptable) -&gt; (boolean),
	GetAsync: (self: any, profile_key: string, version: string?) -&gt; (Profile&lt;T&gt;?),
	VersionQuery: (self: any, profile_key: string, sort_direction: Enum.SortDirection?, min_date: DateTime | number | nil, max_date: DateTime | number | nil) -&gt; (VersionQuery&lt;T&gt;),
	RemoveAsync: (self: any, profile_key: string) -&gt; (boolean),
}

export type ProfileStore&lt;T&gt; = {
	Mock: ProfileStoreStandard&lt;T&gt;,
} &amp; ProfileStoreStandard&lt;T&gt;

type ConstantName = "AUTO_SAVE_PERIOD" | "LOAD_REPEAT_PERIOD" | "FIRST_LOAD_REPEAT" | "SESSION_STEAL"
| "ASSUME_DEAD" | "START_SESSION_TIMEOUT" | "CRITICAL_STATE_ERROR_COUNT" | "CRITICAL_STATE_ERROR_EXPIRE"
| "CRITICAL_STATE_EXPIRE" | "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {Connect: (self: any, listener: (message: string, store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnOverwrite: {Connect: (self: any, listener: (store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnCriticalToggle: {Connect: (self: any, listener: (is_critical: boolean) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: &lt;T&gt;(store_name: string, template: (T &amp; JSONAcceptable)?) -&gt; (ProfileStore&lt;T&gt;),
	SetConstant: (name: ConstantName, value: number) -&gt; ()
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)

	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and {PlaceId = session[1], JobId = session[2]},

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,

	}
	setmetatable(self, Profile)

	return self

end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	if user_id &lt; 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end

end

function Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock

	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)

end

function Profile:MessageHandler(fn)

	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do

		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then

			local processed_callback = function()
				locked_updates[index] = true
			end
			
			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)

		end

	end

end

function Profile:Save()
	
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end
	
	if self:IsActive() == false then
		warn(`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
			.. ` Traceback:\n` .. debug.traceback())
		return
	end
	
	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)
	
	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)

end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")

}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)

	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end

end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)

	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) &gt; 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,

	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({v2 = true})

	if DataStoreState == "NotReady" then

		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()

			repeat task.wait() until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true

		end)

	elseif DataStoreState == "Access" then

		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)

	end

	return self

end

local function RobloxMessageSubscription(profile, unique_session_id)

	local last_roblox_message = 0
	
	local roblox_message_subscription = MessagingService:SubscribeAsync("PS_" .. unique_session_id, function(message)
		if type(message.Data) == "table" and message.Data.LoadCount == profile.SessionLoadCount then
			-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
			if os.clock() - last_roblox_message &gt; 6 then 
				last_roblox_message = os.clock()
				if profile:IsActive() == true then
					if message.Data.EndSession == true then
						SaveProfileAsync(profile, true, false, "External")
					else
						profile:Save()
					end
				end
			end
		end
	end)

	if profile:IsActive() == true then
		profile.roblox_message_subscription = roblox_message_subscription
	else
		roblox_message_subscription:Disconnect()
	end

end

function ProfileStore:StartSessionAsync(profile_key, params)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end
	
	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end
	
	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end
	
	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	
	local is_user_cancel = false
	
	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end
	
	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do

		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behavior in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then

			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

		else

			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession

						if active_session == nil then
							latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
							latest_data.MetaData.ForceLoadSession = nil
						elseif type(active_session) == "table" then
							if IsThisSession(active_session) == false then
								local last_update = latest_data.MetaData.LastUpdate
								if last_update ~= nil then
									if os.time() - last_update &gt; ASSUME_DEAD then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
										return
									end
								end
								if steal_session == true or user_steal == true then
									local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true
									if force_load_interrupted == false or user_steal == true then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
									end
								elseif request_force_load == true then
									latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
								end
							else
								latest_data.MetaData.ForceLoadSession = nil
							end
						end

					end,
					MissingProfileHandle = function(latest_data)
						
						local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

						latest_data.Data = DeepCopyTable(self.template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = if is_cancel == false then {PlaceId, JobId, unique_session_id} else nil,
							ForceLoadSession = nil,
							MetaTags = {}, -- Backwards compatibility with ProfileService
						}

					end,
					EditProfile = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						if active_session ~= nil and IsThisSession(active_session) == true then
							latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
							latest_data.MetaData.LastUpdate = os.time()
						end

					end,
				},
				is_mock
				))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then

				if IsThisSession(active_session) == true then

					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)
					
					if is_mock ~= true and DataStoreState == "Access" then
						
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:
						task.spawn(RobloxMessageSubscription, profile, unique_session_id) -- Blocking prevention
						
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile

				else
					
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true

					if force_load_interrupted == false then

						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps &gt;= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end
						
						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count, EndSession = true})
						end
						
						-- Attempt to load the profile again after a delay
						local wait_until = os.clock() + if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat task.wait() until os.clock() &gt;= wait_until or ProfileStore.IsClosing == true

					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once

				end

			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start &gt;= START_SESSION_TIMEOUT
			end
			
			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
			
			task.wait(exp_backoff)  -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
			
		end

	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile

end

function ProfileStore:MessageAsync(profile_key, message)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Updating profile:

		local loaded_data = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local global_updates = latest_data.GlobalUpdates
					local update_list = global_updates[2]
					--{
					--	update_index,
					--	{
					--		{update_index, data}, ...
					--	},
					--},

					global_updates[1] += 1
					table.insert(update_list, {global_updates[1], message})

					-- Clearing queue if above limit:

					while #update_list &gt; MAX_MESSAGE_QUEUE do
						table.remove(update_list, 1)
					end

				end,
			},
			is_mock
		)

		if loaded_data ~= nil then
			
			local session_token = SessionToken(self.Name, profile_key, is_mock)
			
			local profile = ActiveSessionCheck[session_token]
			
			if profile ~= nil then
				
				-- The message was sent to a profile that is active in this server:
				profile:Save()
				
			else
				
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0
				
				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count})
				end
				
			end

			return true

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return false

end

function ProfileStore:GetAsync(profile_key, version)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}

				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then

			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return nil -- Game started shutting down - don't return the profile

end

function ProfileStore:RemoveAsync(profile_key)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	elseif DataStoreState ~= "Access" then -- Used when API access is disabled

		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	else -- Live DataStore

		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)

	end
	
	next_in_queue()

	return wipe_status

end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date, is_mock)

	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},

		is_mock = is_mock,
	}
	setmetatable(self, ProfileVersionQuery)

	return self

end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue &gt; 0 do

		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end

	end
end

local VersionQueryNextAsyncStackingFlag = false
local WarnAboutVersionQueryOnce = false

function ProfileVersionQuery:NextAsync()

	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	WaitForStoreReady(self.profile_store)

	if ProfileStore.IsClosing == true then
		return nil -- Silently fail :NextAsync() requests
	end

	if self.is_mock == true or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return nil -- Silently fail :NextAsync() requests
	end

	local profile
	local is_finished = false

	local function query_job()

		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then

			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return

		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return

		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true

	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	-- Type check:

	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date, is_mock)

end

-- DataStore API access check:

if IsStudio == true then

	task.spawn(function()

		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state

	end)

else
	
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
	
end

-- Update loop:

RunService.Heartbeat:Connect(function()

	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length &gt; 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave &gt; auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp &lt; AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex &gt; auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp &gt;= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex &gt; auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart &gt; CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time &gt; CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end

end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()

	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then

		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster

	end

	game:BindToClose(function()

		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count &gt; 0 or ActiveProfileLoadJobs &gt; 0 or ActiveProfileSaveJobs &gt; 0 do
			task.wait()
		end

		return -- We're done!

	end)

end)

return ProfileStore</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">RateLimit</string>
          <string name="Source"><![CDATA[--!strict
-- Per-player token bucket for remotes: `burst` requests at once, refilling at `perSecond`.

local Players = game:GetService("Players")

export type Limiter = { Allow: (self: Limiter, player: Player) -> boolean }

local RateLimit = {}

function RateLimit.new(perSecond: number, burst: number): Limiter
	local buckets: { [Player]: { Tokens: number, At: number } } = {}
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)

	local limiter = {}
	function limiter.Allow(_self, player: Player): boolean
		local now = os.clock()
		local bucket = buckets[player]
		if bucket == nil then
			bucket = { Tokens = burst, At = now }
			buckets[player] = bucket
		end
		bucket.Tokens = math.min(burst, bucket.Tokens + (now - bucket.At) * perSecond)
		bucket.At = now
		if bucket.Tokens < 1 then
			return false
		end
		bucket.Tokens -= 1
		return true
	end
	return limiter :: any
end

return RateLimit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">RollService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Every roll happens here, on the server. The client only asks and then animates.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Rarity = require(Shared.Rarity)
local Cards = require(Shared.Cards)
local Odds = require(Shared.Odds)
local Rewards = require(Shared.Rewards)
local Bosses = require(Shared.Bosses)

local Remotes = ReplicatedStorage.Remotes
local DataService = require(script.Parent.DataService)
local DeckService = require(script.Parent.DeckService)
local BattleService = require(script.Parent.BattleService)
local MetaService = require(script.Parent.MetaService)
local Meta = require(Shared.Meta)

local RollService = {}

local rng = Random.new()

local lastRoll = {} -- [Player] = os.clock() of their last roll
local autoGeneration = {} -- [Player] = number; bumping it stops the running Auto Roll loop
local autoActive = {} -- [Player] = true while Auto Roll is running

local COOLDOWN_TOLERANCE = 0.1 -- forgive small network timing differences

-- The player's own luck: base (1x + Lucky Charm + Index rewards, or the dev panel's value)
-- times the strongest running luck potion, capped at Config.Roll.LuckCap.
local function luckFor(player: Player, data): number
	return MetaService.Luck(player, data)
end

local function cooldownFor(data): number
	return MetaService.Cooldown(data)
end

local function isUnlocked(player: Player, data, feature: string): boolean
	if not Config.Unlocks.Enabled then
		return true
	end
	local rule = Config.Unlocks[feature]
	return data.TotalRolls >= rule.Rolls and DataService.Playtime(player) >= rule.Seconds
end

-- Everything the client needs to draw the HUD.
local function summary(player: Player, data)
	return {
		TotalRolls = data.TotalRolls,
		Shards = data.Shards,
		Pity = { Epic = data.Pity.Epic, Legendary = data.Pity.Legendary },
		Luck = luckFor(player, data),
		Cooldown = cooldownFor(data),
		AutoStop = data.Settings.AutoStop,
		AutoActive = autoActive[player] == true,
		Playtime = DataService.Playtime(player),
		Unlocked = {
			QuickRoll = isUnlocked(player, data, "QuickRoll"),
			AutoRoll = isUnlocked(player, data, "AutoRoll"),
		},
	}
end

local function fullState(player: Player, data)
	local cards = {}
	for id, entry in data.Cards do
		cards[id] = { Copies = entry.Copies, Stars = entry.Stars }
	end
	return {
		Ok = true,
		Cards = cards,
		Summary = summary(player, data),
		Decks = DeckService.State(data),
		Progress = data.Progress,
		Battle = { AutoUlt = data.Settings.AutoUlt, Speed = data.Settings.BattleSpeed },
		Meta = MetaService.State(player, data),
		TestMode = Config.TestMode,
	}
end

-- One roll: pick rarity (with luck, floor + pity), pick card, apply duplicates, update pity.
-- luck / minFloor default to the player's own luck and no floor (boss reward rolls pass both).
local function doRoll(player: Player, profile, luck: number?, minFloor: string?)
	local data = profile.Data

	local pityFloor = Odds.PityFloor(data.Pity)
	local floor = Odds.HigherFloor(pityFloor, minFloor)
	local chances = Odds.Chances(luck or luckFor(player, data), floor)
	local tier = Odds.PickTier(chances, rng)
	local pool = Cards.ByRarity[tier]
	local card = pool[rng:NextInteger(1, #pool)]

	Odds.UpdatePity(data.Pity, tier)
	data.TotalRolls += 1

	local entry = data.Cards[card.Id]
	local outcome = "New"
	local shardsGained = 0
	if entry == nil then
		entry = { Copies = 1, Stars = 0 }
		data.Cards[card.Id] = entry
	elseif entry.Stars < Config.MaxStars then
		entry.Copies += 1
		entry.Stars += 1
		outcome = "Star"
	else
		entry.Copies += 1
		shardsGained = Rarity.Get(tier).ShardValue
		data.Shards += shardsGained
		outcome = "Shards"
	end

	if Rarity.AtLeast(tier, Config.AnnounceFrom) then
		Remotes.Announce:FireAllClients(player.DisplayName, card.Id)
	end

	return {
		Ok = true,
		CardId = card.Id,
		Rarity = tier,
		Outcome = outcome, -- "New" | "Star" | "Shards"
		Stars = entry.Stars,
		Copies = entry.Copies,
		ShardsGained = shardsGained,
		PityTriggered = pityFloor ~= nil and floor == pityFloor and floor ~= minFloor,
		Summary = summary(player, data),
	}
end

-- Boss reward rolls for a win at difficulty score d: 3 + 2d rolls with boss luck and a rarity
-- floor, plus one card above the floor on a first clear (Rewards.luau has the numbers).
function RollService.RewardRolls(player: Player, d: number, firstClear: boolean)
	local profile = DataService.Get(player)
	if profile == nil then
		return nil
	end
	local reward = Rewards.For(d)
	local luck = Rewards.TotalLuck(reward.Luck, luckFor(player, profile.Data))
	local results = {}
	local function add(floor: string, bonus: boolean)
		local result = doRoll(player, profile, luck, floor)
		result.Summary = nil
		result.Bonus = bonus or nil
		table.insert(results, result)
	end
	for _ = 1, reward.Rolls do
		add(reward.Floor, false)
	end
	if firstClear then
		add(reward.Bonus, true)
	end
	-- Every win pays Shards and may drop a potion.
	local bundle = { Shards = reward.Shards, Potions = {} }
	if rng:NextNumber() < Config.Rewards.PotionChance then
		bundle.Potions[reward.Potion] = 1
	end
	MetaService.Grant(profile.Data, bundle)
	return {
		Results = results,
		Luck = luck,
		Floor = reward.Floor,
		Bundle = bundle,
		Summary = summary(player, profile.Data),
		Meta = MetaService.State(player, profile.Data),
	}
end

local function cooldownLeft(player: Player): number
	local last = lastRoll[player]
	local profile = DataService.Get(player)
	if last == nil or profile == nil then
		return 0
	end
	return cooldownFor(profile.Data) - (os.clock() - last)
end

local function stopAuto(player: Player)
	autoGeneration[player] = (autoGeneration[player] or 0) + 1
	autoActive[player] = nil
end

local function startAuto(player: Player)
	stopAuto(player) -- ends any loop that is still winding down
	local generation = autoGeneration[player]
	autoActive[player] = true

	task.spawn(function()
		while autoGeneration[player] == generation and player.Parent == Players do
			local wait = cooldownLeft(player)
			if wait > 0 then
				task.wait(wait)
			end
			if autoGeneration[player] ~= generation then
				break
			end

			local profile = DataService.Get(player)
			if profile == nil then
				break
			end

			lastRoll[player] = os.clock()
			local result = doRoll(player, profile)

			local stopAt = profile.Data.Settings.AutoStop
			local hitStop = stopAt ~= "Never" and Rarity.AtLeast(result.Rarity, stopAt)
			if hitStop then
				stopAuto(player)
				result.Summary.AutoActive = false
			end
			result.Stopped = hitStop
			Remotes.AutoResult:FireClient(player, result)

			if hitStop then
				break
			end
		end
		if autoGeneration[player] == generation then
			autoActive[player] = nil
		end
	end)
end

function RollService.Start()
	Remotes.GetState.OnServerInvoke = function(player: Player)
		local profile = DataService.WaitFor(player, 20)
		if profile == nil then
			return { Ok = false, Reason = "Loading" }
		end
		return fullState(player, profile.Data)
	end

	Remotes.Roll.OnServerInvoke = function(player: Player, mode: unknown)
		if mode ~= "Full" and mode ~= "Quick" then
			return { Ok = false, Reason = "BadRequest" }
		end
		local profile = DataService.Get(player)
		if profile == nil then
			return { Ok = false, Reason = "Loading" }
		end
		if autoActive[player] then
			return { Ok = false, Reason = "AutoActive" }
		end
		if mode == "Quick" and not isUnlocked(player, profile.Data, "QuickRoll") then
			return { Ok = false, Reason = "Locked" }
		end
		local left = cooldownLeft(player)
		if left > COOLDOWN_TOLERANCE then
			return { Ok = false, Reason = "Cooldown", Wait = left }
		end
		lastRoll[player] = os.clock()
		return doRoll(player, profile)
	end

	Remotes.SetAuto.OnServerEvent:Connect(function(player: Player, on: unknown, autoStop: unknown)
		local profile = DataService.Get(player)
		if profile == nil then
			return
		end
		if type(autoStop) == "string" and table.find(Config.AutoStopOptions, autoStop) then
			profile.Data.Settings.AutoStop = autoStop
		end
		if on == true then
			if not isUnlocked(player, profile.Data, "AutoRoll") then
				Remotes.AutoResult:FireClient(player, { Ok = false, Stopped = true, Reason = "Locked" })
				return
			end
			if not autoActive[player] then
				startAuto(player)
			end
		elseif on == false then
			stopAuto(player)
		end
	end)

	-- Test-phase tools. The server refuses all of them once Config.TestMode is false.
	Remotes.Dev.OnServerInvoke = function(player: Player, action: unknown, value: unknown)
		if not Config.TestMode then
			return { Ok = false, Reason = "Disabled" }
		end
		local profile = DataService.Get(player)
		if profile == nil then
			return { Ok = false, Reason = "Loading" }
		end
		if action == "SetLuck" then
			local luck = tonumber(value) or 1
			MetaService.SetDevLuck(player, math.clamp(luck, 1, Config.Roll.LuckCap))
		elseif action == "GrantAll" or action == "GrantStarter" then
			-- GrantStarter: just the Commons and Uncommons, i.e. the first ~14.6k deck.
			for _, card in Cards.List do
				local include = action == "GrantAll" or not Rarity.AtLeast(card.Rarity, "Rare")
				if include and profile.Data.Cards[card.Id] == nil then
					profile.Data.Cards[card.Id] = { Copies = 1, Stars = 0 }
				end
			end
		elseif action == "MaxStars" then
			for _, entry in profile.Data.Cards do
				if entry.Stars < Config.MaxStars then
					entry.Copies += Config.MaxStars - entry.Stars
					entry.Stars = Config.MaxStars
				end
			end
		elseif action == "UnlockFights" then
			-- Marks every fight cleared (no rewards), so every world and difficulty opens.
			for _, boss in Bosses.List do
				for _, difficulty in Bosses.DifficultyOrder do
					if boss.Difficulties[difficulty] then
						profile.Data.Progress.Cleared[Bosses.FightKey(boss.Id, difficulty)] = true
					end
				end
			end
		elseif action == "GiveLoot" then
			-- 1,000 Shards and 3 of every potion, to try the shop and boosts.
			local potions = {}
			for _, potion in Meta.Potions do
				potions[potion.Id] = 3
			end
			MetaService.Grant(profile.Data, { Shards = 1000, Potions = potions })
		elseif action == "Reset" then
			stopAuto(player)
			BattleService.Stop(player)
			DataService.Reset(player)
			MetaService.ResetSession(player)
			MetaService.SetDevLuck(player, nil)
			lastRoll[player] = nil
		else
			return { Ok = false, Reason = "BadRequest" }
		end
		return fullState(player, profile.Data)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		stopAuto(player)
		lastRoll[player] = nil
		autoGeneration[player] = nil
	end)
end

return RollService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the small hub at server start: few parts, neon accents, cheap on every device.
-- Each world gets a themed corner with a boss portal and its boss standing guard; the boss's
-- prompt opens the boss screen. The Card Sage on the altar gives tips.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Bosses = require(ReplicatedStorage.Shared.Bosses)
local BossModels = require(ReplicatedStorage.Shared.BossModels)

local World = {}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- cylinders point along X; stand them up

-- Where each world's portal stands (north of the altar), facing the centre.
local PORTALS = {
	Vector3.new(-34, 0, -44),
	Vector3.new(0, 0, -56),
	Vector3.new(34, 0, -44),
}

local THEMES = {
	Embers = { Floor = Color3.fromRGB(52, 30, 30), Stone = Color3.fromRGB(44, 30, 34), Glow = Color3.fromRGB(255, 140, 70) },
	Snow = { Floor = Color3.fromRGB(196, 214, 232), Stone = Color3.fromRGB(70, 90, 120), Glow = Color3.fromRGB(150, 230, 255) },
	Motes = { Floor = Color3.fromRGB(24, 16, 36), Stone = Color3.fromRGB(36, 26, 52), Glow = Color3.fromRGB(230, 90, 255) },
}

local function sign(parent: BasePart, offset: number, title: string, sub: string, color: Color3)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromOffset(260, 70)
	gui.StudsOffset = Vector3.new(0, offset, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	gui.Parent = parent
	local top = Instance.new("TextLabel")
	top.Name = "Title"
	top.BackgroundTransparency = 1
	top.Size = UDim2.fromScale(1, 0.58)
	top.Font = Enum.Font.FredokaOne
	top.TextScaled = true
	top.TextColor3 = Color3.new(1, 1, 1)
	top.TextStrokeTransparency = 0.3
	top.Text = title
	top.Parent = gui
	local bottom = Instance.new("TextLabel")
	bottom.Name = "Sub"
	bottom.BackgroundTransparency = 1
	bottom.Position = UDim2.fromScale(0, 0.6)
	bottom.Size = UDim2.fromScale(1, 0.4)
	bottom.Font = Enum.Font.BuilderSansBold
	bottom.TextScaled = true
	bottom.TextColor3 = color
	bottom.TextStrokeTransparency = 0.4
	bottom.Text = sub
	bottom.Parent = gui
end

-- An NPC figure with a prompt. Clients animate figures marked with the Bob attribute.
local function npc(id: string, pivot: CFrame, parent: Instance, action: string, objectText: string): Model
	local model = BossModels.Build(id)
	model:PivotTo(pivot)
	model:SetAttribute("Bob", true)
	model:SetAttribute("BaseCFrame", pivot)
	local root = model.PrimaryPart :: BasePart
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = objectText
	prompt.KeyboardKeyCode = Enum.KeyCode.F -- E is the Auto Roll shortcut
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	model.Parent = parent
	return model
end

local function buildWorld(hub: Instance, boss: Bosses.Boss, position: Vector3)
	local theme = THEMES[boss.Particles] or THEMES.Embers
	local area = Instance.new("Folder")
	area.Name = `World{boss.World}`
	area.Parent = hub
	local frame = CFrame.lookAt(position, Vector3.new(0, position.Y, 0)) -- -Z faces the altar

	part({
		Name = "Platform",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 22, 22),
		CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)) * FLAT,
		Color = theme.Floor,
		Material = Enum.Material.SmoothPlastic,
		Parent = area,
	})
	part({
		Name = "PlatformRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.1, 23, 23),
		CFrame = CFrame.new(position + Vector3.new(0, 0.45, 0)) * FLAT,
		Color = boss.Accent,
		Material = Enum.Material.Neon,
		Parent = area,
	})

	-- Gate with a glowing portal behind the boss.
	for _, x in { -6.5, 6.5 } do
		part({
			Name = "GatePost",
			Size = Vector3.new(2, 15, 2),
			CFrame = frame * CFrame.new(x, 8.5, 5),
			Color = theme.Stone,
			Material = Enum.Material.SmoothPlastic,
			Parent = area,
		})
	end
	part({
		Name = "GateBeam",
		Size = Vector3.new(17, 1.6, 2.6),
		CFrame = frame * CFrame.new(0, 16.6, 5),
		Color = theme.Stone,
		Material = Enum.Material.SmoothPlastic,
		Parent = area,
	})
	local beamGlow = part({
		Name = "GateGlow",
		Size = Vector3.new(17.2, 0.4, 2.8),
		CFrame = frame * CFrame.new(0, 15.7, 5),
		Color = boss.Accent,
		Material = Enum.Material.Neon,
		Parent = area,
	})
	part({
		Name = "Portal",
		Size = Vector3.new(11, 14, 0.4),
		CFrame = frame * CFrame.new(0, 8, 5),
		Color = theme.Glow,
		Material = Enum.Material.Neon,
		Transparency = 0.4,
		CanCollide = false,
		Parent = area,
	})
	sign(beamGlow, 4.5, `WORLD {boss.World} · {string.upper(boss.WorldName)}`, `{boss.Name}, {boss.Title}`, boss.Accent)

	-- Themed props.
	if boss.Particles == "Embers" then
		for i, x in { -9, 9 } do
			part({
				Name = `LanternPost{i}`,
				Size = Vector3.new(0.6, 6, 0.6),
				CFrame = frame * CFrame.new(x, 4, -6),
				Color = theme.Stone,
				Parent = area,
			})
			part({
				Name = `Lantern{i}`,
				Size = Vector3.new(1.4, 1.8, 1.4),
				CFrame = frame * CFrame.new(x, 7.6, -6),
				Color = theme.Glow,
				Material = Enum.Material.Neon,
				Parent = area,
			})
		end
	elseif boss.Particles == "Snow" then
		for i, spot in { Vector3.new(-9, 0, -4), Vector3.new(9, 0, -3), Vector3.new(-8, 0, 7), Vector3.new(8, 0, 7) } do
			local height = 4 + (i % 2) * 3
			part({
				Name = `Crystal{i}`,
				Size = Vector3.new(1.6, height, 1.6),
				CFrame = frame * CFrame.new(spot + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, math.rad(i * 30), math.rad(12 - i * 6)),
				Color = theme.Glow,
				Material = Enum.Material.Glass,
				Transparency = 0.2,
				Parent = area,
			})
		end
	else
		for i = 1, 6 do
			local angle = (i - 1) / 6 * math.pi * 2
			local cube = part({
				Name = `Shard{i}`,
				Size = Vector3.new(1.2, 1.2, 1.2),
				CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 9, 5 + (i % 3) * 2, math.sin(angle) * 9))
					* CFrame.Angles(math.rad(45), math.rad(i * 20), math.rad(45)),
				Color = theme.Glow,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = area,
			})
			cube:SetAttribute("Spin", true)
		end
	end

	-- Glowing path from the altar.
	local direction = (position - Vector3.new(0, position.Y, 0)).Unit
	for i = 1, 4 do
		local at = direction * (24 + i * 4)
		part({
			Name = "PathTile",
			Size = Vector3.new(3, 0.2, 2),
			CFrame = CFrame.lookAt(Vector3.new(at.X, 0.1, at.Z), Vector3.new(0, 0.1, 0)),
			Color = boss.Accent,
			Material = Enum.Material.Neon,
			Transparency = 0.3,
			Parent = area,
		})
	end

	-- The boss, standing guard in front of its portal.
	local height = BossModels.Height(boss.Id)
	local model = npc(boss.Id, frame * CFrame.new(0, 1 + height / 2, -3), area, "Challenge", `{boss.Name}, {boss.Title}`)
	local prompt = (model.PrimaryPart :: BasePart):FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt:SetAttribute("BossId", boss.Id)
	end
end

function World.Build()
	local hub = Instance.new("Folder")
	hub.Name = "Hub"

	part({
		Name = "Ground",
		Size = Vector3.new(400, 2, 400),
		CFrame = CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(26, 24, 40),
		Material = Enum.Material.SmoothPlastic,
		Parent = hub,
	})

	-- Round altar the player spawns on.
	part({
		Name = "Altar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, 44, 44),
		CFrame = CFrame.new(0, 0.6, 0) * FLAT,
		Color = Color3.fromRGB(40, 36, 64),
		Material = Enum.Material.SmoothPlastic,
		Parent = hub,
	})
	part({
		Name = "AltarRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.3, 46, 46),
		CFrame = CFrame.new(0, 0.55, 0) * FLAT,
		Color = Color3.fromRGB(176, 92, 255),
		Material = Enum.Material.Neon,
		Parent = hub,
	})

	-- Six glowing pillars, one per rarity colour above Common.
	local pillarColors = {
		Color3.fromRGB(86, 214, 138),
		Color3.fromRGB(64, 156, 255),
		Color3.fromRGB(176, 92, 255),
		Color3.fromRGB(255, 196, 46),
		Color3.fromRGB(255, 58, 92),
		Color3.fromRGB(240, 236, 255),
	}
	for i, color in pillarColors do
		local angle = math.rad((i - 1) * 60)
		local position = Vector3.new(math.cos(angle) * 30, 6, math.sin(angle) * 30)
		part({
			Name = `Pillar{i}`,
			Size = Vector3.new(2.4, 12, 2.4),
			CFrame = CFrame.new(position),
			Color = Color3.fromRGB(34, 30, 54),
			Material = Enum.Material.SmoothPlastic,
			Parent = hub,
		})
		part({
			Name = `PillarGlow{i}`,
			Size = Vector3.new(2.6, 0.6, 2.6),
			CFrame = CFrame.new(position + Vector3.new(0, 6.3, 0)),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = hub,
		})
	end

	for i, boss in Bosses.List do
		local position = PORTALS[i] or Vector3.new(-34 + (i - 1) * 34, 0, -56 - (i - 3) * 14)
		buildWorld(hub, boss, position)
	end

	-- The Card Sage: a friendly NPC on the altar who gives tips.
	local sageHeight = BossModels.Height("sage")
	local sagePivot = CFrame.lookAt(Vector3.new(11, 1.2 + sageHeight / 2, 8), Vector3.new(0, 1.2 + sageHeight / 2, 0))
	local sage = npc("sage", sagePivot, hub, "Talk", "Kenji, Card Sage")
	local sagePrompt = (sage.PrimaryPart :: BasePart):FindFirstChildOfClass("ProximityPrompt")
	if sagePrompt then
		sagePrompt:SetAttribute("Npc", "sage")
	end
	sign(sage.PrimaryPart :: BasePart, 5, "KENJI", "Card Sage", Color3.fromRGB(255, 214, 120))

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0 -- no force field bubble
	spawn.Size = Vector3.new(6, 0.4, 6)
	spawn.CFrame = CFrame.new(0, 1.4, 0)
	spawn.Transparency = 1
	spawn.CanCollide = true
	spawn.Parent = hub

	hub.Parent = workspace

	-- Evening sky, soft fog.
	Lighting.ClockTime = 18.2
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(70, 60, 100)
	Lighting.OutdoorAmbient = Color3.fromRGB(110, 96, 150)
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Color = Color3.fromRGB(150, 120, 200)
	atmosphere.Decay = Color3.fromRGB(60, 40, 90)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="36">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="37">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="38">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">HubFx</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Hub life, all client-side: NPC figures breathe and sway, void shards spin, Kenji the
-- Card Sage gives tips when you talk to him, and each portal sign shows whether it's open for you.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Bosses = require(Shared.Bosses)

local State = require(script.Parent.State)

local HubFx = {}

local TIPS = {
	"Attack cards deal the damage and take every boss hit. Keep them alive!",
	"Support cards can't be hit. They heal, shield and buff from the back row.",
	"Every Support card casts its Basic the moment a fight starts.",
	"A card glowing gold has a full Ultimate. Tap it, or switch on AUTO ULT.",
	"Red marker over your cards? A big boss move lands in a moment.",
	"Beat a boss to fire a burst of reward rolls with boosted luck.",
	"Your first clear of each fight adds a bonus card above the reward floor.",
	"Clear Normal to open Hard, and Hard to open Nightmare.",
	"Rimeveil's Rime Spear freezes a card: it skips its next action.",
	"Vex's Null Barrier shrugs off Basic hits. Break it with Skills and Ultimates.",
	"Duplicates add stars: +5% stats each, up to 5 stars.",
	"Find every card of a rarity in the INDEX for permanent luck and a prize.",
	"Luck Potions stack time, not power: the strongest running potion counts.",
	"Come back every day: the GIFTS streak gets better until day 7.",
	"Spend Shards in the SHOP on faster rolls and more base luck.",
	"Stay a while! Playtime gifts unlock the longer you play this session.",
	"Long reveal? Tap SKIP to jump straight to the card.",
}

local animated = {} -- [Model] = { Base, Phase }
local spinners = {} -- [BasePart] = { Base, Phase }
local tipIndex = 0
local bubble: any = nil -- Kenji's speech bubble (children read by name)
local bubbleToken = 0

local function track(inst: Instance)
	if inst:IsA("Model") and inst:GetAttribute("Bob") then
		local base = inst:GetAttribute("BaseCFrame")
		if typeof(base) == "CFrame" then
			animated[inst] = { Base = base, Phase = math.random() * 10 }
		end
	elseif inst:IsA("BasePart") and inst:GetAttribute("Spin") then
		spinners[inst] = { Base = inst.CFrame, Phase = math.random() * 10 }
	end
end

local function refreshSigns(hub: Instance)
	local cleared = State.Progress.Cleared or {}
	for _, boss in Bosses.List do
		local area = hub:FindFirstChild(`World{boss.World}`)
		local glow = area and area:FindFirstChild("GateGlow")
		local sign = glow and glow:FindFirstChild("Sign")
		local sub = sign and sign:FindFirstChild("Sub")
		if sub and sub:IsA("TextLabel") then
			if Bosses.IsUnlocked(cleared, boss.Id, "Normal") then
				local done = 0
				for _, difficulty in Bosses.DifficultyOrder do
					if cleared[Bosses.FightKey(boss.Id, difficulty)] then
						done += 1
					end
				end
				sub.Text = `{boss.Name} · {done}/{#Bosses.DifficultyOrder} cleared`
				sub.TextColor3 = boss.Accent
			else
				sub.Text = `LOCKED · {Bosses.UnlockHint(boss.Id, "Normal")}`
				sub.TextColor3 = Color3.fromRGB(170, 166, 190)
			end
		end
	end
end

-- Kenji's speech bubble with the next tip.
function HubFx.SageTalk(prompt: ProximityPrompt)
	local root = prompt.Parent
	if root == nil or not root:IsA("BasePart") then
		return
	end
	tipIndex = tipIndex % #TIPS + 1
	bubbleToken += 1
	local token = bubbleToken
	if bubble == nil or bubble.Parent == nil then
		bubble = Instance.new("BillboardGui")
		bubble.Name = "TipBubble"
		bubble.Size = UDim2.fromOffset(300, 90)
		bubble.StudsOffset = Vector3.new(0, 7, 0)
		bubble.MaxDistance = 60
		bubble.LightInfluence = 0
		local frame = Instance.new("Frame")
		frame.Name = "Bubble"
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(24, 21, 40)
		frame.BackgroundTransparency = 0.1
		frame.Parent = bubble
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 14)
		corner.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(255, 214, 120)
		stroke.Thickness = 2
		stroke.Parent = frame
		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.BackgroundTransparency = 1
		text.Position = UDim2.fromScale(0.05, 0.08)
		text.Size = UDim2.fromScale(0.9, 0.84)
		text.Font = Enum.Font.BuilderSansBold
		text.TextColor3 = Color3.fromRGB(246, 244, 255)
		text.TextScaled = true
		text.TextWrapped = true
		text.Parent = frame
	end
	bubble.Parent = root
	local frame = bubble:FindFirstChild("Bubble")
	local label = frame and frame:FindFirstChild("Text")
	if label then
		label.Text = TIPS[tipIndex]
	end
	task.delay(7, function()
		if token == bubbleToken and bubble then
			bubble.Parent = nil
		end
	end)
end

function HubFx.Start()
	task.spawn(function()
		local hub = Workspace:WaitForChild("Hub", 30)
		if hub == nil then
			return
		end
		for _, inst in hub:GetDescendants() do
			track(inst)
		end
		hub.DescendantAdded:Connect(function(inst)
			task.defer(track, inst)
		end)
		refreshSigns(hub)
		State.Changed:Connect(function(kind)
			if kind == "progress" or kind == "all" then
				refreshSigns(hub)
			end
		end)

		local camera = Workspace.CurrentCamera
		RunService.RenderStepped:Connect(function()
			if State.InBattle then
				return -- the battle screen covers the hub
			end
			local t = os.clock()
			local eye = camera.CFrame.Position
			for model, info in animated do
				if model.Parent == nil then
					animated[model] = nil
				elseif (info.Base.Position - eye).Magnitude < 160 then
					local p = t + info.Phase
					model:PivotTo(info.Base * CFrame.new(0, math.sin(p * 1.7) * 0.18, 0) * CFrame.Angles(0, math.sin(p * 0.5) * 0.12, 0))
				end
			end
			for part, info in spinners do
				if part.Parent == nil then
					spinners[part] = nil
				else
					local p = t + info.Phase
					part.CFrame = info.Base * CFrame.new(0, math.sin(p * 1.3) * 0.6, 0) * CFrame.Angles(p * 0.9, p * 1.2, 0)
				end
			end
		end)
	end)
end

return HubFx
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="40">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client entry point: loads the player's state, builds the screens and wires the buttons.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local Skin = require(UI.Skin)
local Hud = require(UI.Hud)
local Reveal = require(UI.Reveal)
local Index = require(UI.Index)
local Potions = require(UI.Potions)
local Shop = require(UI.Shop)
local Gifts = require(UI.Gifts)
local OddsPanel = require(UI.OddsPanel)
local DevPanel = require(UI.DevPanel)
local DeckBuilder = require(UI.DeckBuilder)
local BossScreen = require(UI.BossScreen)
local Battle = require(UI.Battle)
local State = require(script.Parent.State)
local HubFx = require(script.Parent.HubFx)
local MetaClient = require(script.Parent.MetaClient)
local Meta = require(Shared.Meta)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- The backpack isn't used in this game.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- Phones and tablets start on lighter effects; the FX button switches.
Theme.FxLow = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Load state (the server waits for the save to load).
local function loadState()
	for _ = 1, 10 do
		local ok, result = pcall(function()
			return Remotes.GetState:InvokeServer()
		end)
		if ok and result and result.Ok then
			State.ApplyFull(result)
			return true
		end
		task.wait(1)
	end
	return false
end
if not loadState() then
	warn("Could not load player state")
end

-- Roll handling ----------------------------------------------------------------
local busy = false -- true while a request is in flight or a full reveal is showing
local lastRollAt = 0 -- os.clock() of our last accepted roll
local autoWanted = false -- what the player last asked Auto Roll to be

local REASONS = {
	Cooldown = "Rolling too fast",
	Locked = "Locked for now",
	AutoActive = "Turn off Auto Roll first",
	Loading = "Still loading your cards",
}

local function requestRoll(mode: string)
	if State.InBattle then
		return
	end
	if busy or Reveal.IsBusy() or State.Summary.AutoActive then
		if State.Summary.AutoActive then
			Hud.Hint(REASONS.AutoActive)
		end
		return
	end
	busy = true
	-- If a reveal was tapped away early, wait out the rest of the cooldown instead of being refused.
	local wait = State.Cooldown() - (os.clock() - lastRollAt)
	if wait > 0 then
		task.wait(wait)
	end
	local ok, result = pcall(function()
		return Remotes.Roll:InvokeServer(mode)
	end)
	if not ok or not result or not result.Ok then
		busy = false
		local reason = if ok and result then result.Reason else nil
		Hud.Hint(REASONS[reason] or "Roll failed, try again")
		return
	end

	lastRollAt = os.clock()
	State.ApplyRoll(result)
	Hud.StartCooldown(State.Cooldown())

	if mode == "Full" then
		Reveal.Full(result, function()
			busy = false
		end)
	else
		Reveal.Quick(result)
		Hud.FeedAdd(result)
		task.delay(State.Cooldown(), function()
			busy = false
		end)
	end
end

local function toggleAuto()
	local on = not State.Summary.AutoActive
	autoWanted = on
	State.Summary.AutoActive = on -- optimistic; the server confirms with each result
	Hud.SetAuto(on)
	Remotes.SetAuto:FireServer(on, State.Summary.AutoStop)
	if on then
		Hud.Hint("Auto Roll on")
	end
end

local function cycleAutoStop()
	local options = Config.AutoStopOptions
	local index = table.find(options, State.Summary.AutoStop) or 1
	State.Summary.AutoStop = options[index % #options + 1]
	-- Tell the server without changing whether Auto Roll is running.
	Remotes.SetAuto:FireServer(nil, State.Summary.AutoStop)
	Hud.Refresh()
end

Remotes.AutoResult.OnClientEvent:Connect(function(result)
	if result.Ok == false then
		autoWanted = false
		State.Summary.AutoActive = false
		Hud.SetAuto(false)
		Hud.Hint(REASONS[result.Reason] or "Auto Roll stopped")
		return
	end
	if result.Stopped then
		autoWanted = false
	end
	-- A result already on its way when the player switched Auto Roll off must not switch it back on.
	result.Summary.AutoActive = autoWanted
	lastRollAt = os.clock()
	State.ApplyRoll(result)
	Hud.StartCooldown(State.Cooldown())
	Hud.FeedAdd(result)
	if State.InBattle then
		return -- during a fight Auto Roll results only go to the feed
	end
	if result.Stopped then
		Hud.Hint(`Auto Roll stopped: {result.Rarity}!`)
		Reveal.Full(result)
	else
		Reveal.Quick(result)
	end
end)

Remotes.Announce.OnClientEvent:Connect(function(playerName: string, cardId: string)
	Hud.Announce(playerName, cardId)
end)

-- Build screens -------------------------------------------------------------------
Reveal.Init(playerGui)
OddsPanel.Init(playerGui)
Index.Init(playerGui, OddsPanel.Toggle)
Potions.Init(playerGui)
Shop.Init(playerGui)
Gifts.Init(playerGui)
DeckBuilder.Init(playerGui)
BossScreen.Init(playerGui, {
	EditDeck = function()
		DeckBuilder.Open(function()
			BossScreen.Open()
		end)
	end,
	Fight = Battle.Start,
})
if State.TestMode then
	DevPanel.Init(playerGui)
end

-- Character controls (and the mobile thumbstick) are off while a fight is on screen.
local controls = nil
task.spawn(function()
	local ok, result = pcall(function()
		-- Roblox's default PlayerModule is added at runtime, so it isn't in the sourcemap.
		local playerModule = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)
		return (require :: any)(playerModule):GetControls()
	end)
	if ok then
		controls = result
	end
end)

Battle.Init(playerGui, {
	OnStart = function()
		Hud.SetBattleMode(true)
		if controls then
			controls:Disable()
		end
	end,
	OnEnd = function()
		Hud.SetBattleMode(false)
		if controls then
			controls:Enable()
		end
	end,
})

-- Hub NPCs: bosses open the boss screen, Kenji the Card Sage gives tips.
HubFx.Start()
ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
	if State.InBattle then
		return
	end
	local bossId = prompt:GetAttribute("BossId")
	if type(bossId) == "string" then
		BossScreen.Open(bossId)
	elseif prompt:GetAttribute("Npc") == "sage" then
		HubFx.SageTalk(prompt)
	end
end)

Hud.Init(playerGui, {
	OnRoll = function()
		requestRoll("Full")
	end,
	OnQuick = function()
		requestRoll("Quick")
	end,
	OnAuto = toggleAuto,
	OnAutoStop = cycleAutoStop,
	OnDeck = DeckBuilder.Toggle,
	OnBattle = BossScreen.Toggle,
	OnIndex = Index.Toggle,
	OnPotions = Potions.Toggle,
	OnShop = Shop.Toggle,
	OnGifts = Gifts.Toggle,
	OnOdds = OddsPanel.Toggle,
	OnFx = function()
		Theme.FxLow = not Theme.FxLow
		Hud.Refresh()
	end,
	OnDev = if State.TestMode then DevPanel.Toggle else nil,
})

State.Changed:Connect(function()
	Hud.Refresh()
end)

-- Red badges: rewards ready in GIFTS and INDEX, potions to use in POTIONS.
Hud.SetBadgeSource(function()
	return {
		GIFTS = MetaClient.GiftsClaimable(),
		INDEX = MetaClient.IndexClaimable(),
		POTIONS = MetaClient.PotionCount(),
	}
end)
Hud.RefreshBadges()

-- Anything granted (gifts, Index, daily) pops a reward toast.
MetaClient.OnGranted = function(bundle)
	Hud.Reward(Meta.Describe(bundle))
end

-- Test phase: report UI skin images that don't load (wrong id or still in moderation).
if State.TestMode then
	task.spawn(function()
		local failed = Skin.Verify()
		if #failed > 0 then
			warn(`[Skin] {#failed} UI image(s) failed to load:\n  ` .. table.concat(failed, "\n  "))
			Hud.Hint(`{#failed} UI images didn't load: see Output`)
		end
	end)
end

-- Welcome back: point at the daily reward.
if State.Meta.Daily and State.Meta.Daily.CanClaim then
	task.delay(2, function()
		Hud.Hint(`Daily reward ready: day {State.Meta.Daily.Day} of 7. Open GIFTS!`)
	end)
end

-- Keyboard shortcuts on PC: R = Roll, Q = Quick Roll, E = Auto Roll.
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.R then
		requestRoll("Full")
	elseif input.KeyCode == Enum.KeyCode.Q then
		requestRoll("Quick")
	elseif input.KeyCode == Enum.KeyCode.E then
		toggleAuto()
	end
end)

-- Refresh unlock countdowns once a second when the unlock rules are on.
if Config.Unlocks.Enabled then
	task.spawn(function()
		while true do
			task.wait(1)
			State.Summary.Playtime += 1
			Hud.Refresh()
		end
	end)
end

]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">MetaClient</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Talks to MetaService (potions, shop, gifts, Index rewards) and counts what's ready to claim,
-- for the red badges on the menu.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cards = require(Shared.Cards)
local Meta = require(Shared.Meta)
local Rarity = require(Shared.Rarity)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local State = require(script.Parent.State)

local MetaClient = {}

MetaClient.Reasons = {
	NoShards = "Not enough Shards",
	NoPotion = "You don't have that potion",
	PotionFull = "That potion is already running for an hour",
	MaxLevel = "Already at max level",
	Claimed = "Already claimed",
	NotYet = "Not ready yet",
	TooFast = "Slow down a little",
	Loading = "Still loading",
}

-- Called with (bundle) whenever something is granted, to show a reward toast.
MetaClient.OnGranted = nil :: ((bundle: any) -> ())?

function MetaClient.Call(action: string, arg: any?)
	local ok, result = pcall(function()
		return Remotes.Meta:InvokeServer(action, arg)
	end)
	if not ok or result == nil then
		return { Ok = false, Reason = "Network" }
	end
	if result.Meta then
		State.ApplyMeta(result.Meta)
	end
	if result.Ok and result.Granted and MetaClient.OnGranted then
		MetaClient.OnGranted(result.Granted)
	end
	return result
end

function MetaClient.Message(result): string
	return MetaClient.Reasons[result.Reason] or "Something went wrong"
end

-- Found every card of a rarity (computed here, checked again by the server on claim).
function MetaClient.RarityComplete(rarity: string): boolean
	local pool = Cards.ByRarity[rarity]
	if pool == nil or #pool == 0 then
		return false
	end
	for _, card in pool do
		if State.Cards[card.Id] == nil then
			return false
		end
	end
	return true
end

function MetaClient.IndexClaimable(): number
	local n = 0
	for _, rarity in Rarity.Order do
		if MetaClient.RarityComplete(rarity) and not State.Meta.IndexClaimed[rarity] then
			n += 1
		end
	end
	return n
end

function MetaClient.GiftClaimed(index: number): boolean
	for _, claimed in (State.Meta.GiftsClaimed or {}) :: { any } do
		if claimed == index then
			return true
		end
	end
	return false
end

function MetaClient.GiftsClaimable(): number
	local n = if State.Meta.Daily.CanClaim then 1 else 0
	local session = State.SessionSeconds()
	for i, gift in Meta.Playtime do
		if session >= gift.Minutes * 60 and not MetaClient.GiftClaimed(i) then
			n += 1
		end
	end
	local rolls = State.Rolls()
	for _, milestone in Meta.Milestones do
		if rolls >= milestone.Rolls and not State.Meta.Milestones[tostring(milestone.Rolls)] then
			n += 1
		end
	end
	return n
end

function MetaClient.PotionCount(): number
	local n = 0
	for _, count in (State.Meta.Inventory or {}) :: { [string]: number } do
		n += count
	end
	return n
end

return MetaClient
]]></string>
          </Properties>
