	autoStopButton = Kit.new("TextButton", {
		Name = "AutoStop",
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(0.37, 1),
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Color.Panel,
		BackgroundTransparency = 0.15,
		Text = "",
		Parent = row,
	}, {
		Kit.corner(UDim.new(0.5, 0)),
		Kit.stroke(Theme.Color.Auto, 1.5, 0.3),
	})
	Kit.label({
		Name = "Label",
		Text = "",
		Font = Theme.Font.Bold,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.7),
		Parent = autoStopButton,
	}, 16)
	Kit.pressable(autoStopButton)
	autoStopButton.Activated:Connect(handlers.OnAutoStop)

	-- Running potions, above the stats.
	boostRow = Kit.new("Frame", {
		Name = "Boosts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, -0.34, -12),
		Size = UDim2.fromScale(1, 0.26),
		BackgroundTransparency = 1,
		Parent = dock,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}),
	})

	hintLabel = Kit.label({
		Name = "Hint",
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Gold,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, -0.62, -18),
		Size = UDim2.fromScale(1, 0.3),
		Parent = dock,
	}, 22)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.3).Parent = hintLabel

	-- Left menu: a 2-column grid of icon buttons -------------------------------------------
	menu = Kit.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.45, 0),
		Size = UDim2.fromScale(0.14, 0.66),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Kit.new("UISizeConstraint", { MinSize = Vector2.new(112, 220), MaxSize = Vector2.new(176, 600) }),
	})
	local grid = Kit.new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0.25, -6),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = menu,
	})
	Kit.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = grid })
	menuButton("BATTLE", "⚔️", 1, Theme.Color.Roll, handlers.OnBattle)
	menuButton("DECK", "🃏", 2, Theme.Color.Accent, handlers.OnDeck)
	menuButton("INDEX", "📖", 3, Theme.Color.Auto, handlers.OnIndex)
	menuButton("POTIONS", "🧪", 4, Theme.Color.Quick, handlers.OnPotions)
	menuButton("SHOP", "💎", 5, Color3.fromRGB(176, 92, 255), handlers.OnShop)
	menuButton("GIFTS", "🎁", 6, Theme.Color.Gold, handlers.OnGifts)
	fxButton = menuButton("FX HIGH", "✨", 7, Theme.Color.Support, handlers.OnFx, "FX")
	if handlers.OnDev then
		menuButton("DEV", "🛠️", 8, Theme.Color.Danger, handlers.OnDev)
	end

	-- Auto Roll feed (right side) ------------------------------------------------------------
	feed = Kit.new("Frame", {
		Name = "Feed",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.42, 0),
		Size = UDim2.fromScale(0.22, 0.42),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Kit.new("UISizeConstraint", { MinSize = Vector2.new(150, 120), MaxSize = Vector2.new(280, 360) }),
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}),
	})

	-- Server announcement banner (top centre, below Roblox's top bar) --------------------------
	banner = Kit.new("Frame", {
		Name = "Announce",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -80),
		Size = UDim2.fromScale(0.55, 0.075),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = gui,
	}, {
		Kit.corner(UDim.new(0.4, 0)),
		Kit.new("UISizeConstraint", { MinSize = Vector2.new(260, 34), MaxSize = Vector2.new(720, 60) }),
	})
	Kit.new("UIGradient", { Name = "Gradient", Rotation = 0, Parent = banner })
	bannerLabel = Kit.label({
		Name = "Text",
		Text = "",
		RichText = true,
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.66),
		Parent = banner,
	}, 24)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.2).Parent = bannerLabel

	-- Reward toast (top centre, under the banner) ----------------------------------------------
	toast = Kit.new("Frame", {
		Name = "Reward",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.fromScale(0.4, 0.07),
		BackgroundColor3 = Theme.Color.Panel,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	}, {
		Kit.corner(UDim.new(0.5, 0)),
		Kit.stroke(Theme.Color.Gold, 2, 0),
		Kit.new("UISizeConstraint", { MinSize = Vector2.new(240, 36), MaxSize = Vector2.new(520, 56) }),
	})
	Kit.new("UIScale", { Name = "Scale", Scale = 1, Parent = toast })
	Kit.label({
		Name = "Text",
		Text = "",
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.62),
		ZIndex = 21,
		Parent = toast,
	}, 24)

	-- Potion timers and badges tick once a second.
	task.spawn(function()
		while true do
			task.wait(1)
			Hud.RefreshBoosts()
			Hud.RefreshBadges()
		end
	end)

	Hud.Refresh()
end

function Hud.Refresh()
	local s = State.Summary
	statsLabel.Text = string.format(
		'🎲 <font color="#FFC42E">%s</font>   💎 <font color="#D9A6FF">%s</font>   🍀 <font color="#56D68A">%.2fx</font>   <font color="#A8A2C8">ODDS ›</font>',
		Kit.commas(s.TotalRolls),
		Kit.commas(s.Shards),
		State.Luck()
	)
	autoStopButton.Label.Text = if s.AutoStop == "Never" then "Auto stops: never" else `Auto stops at: {s.AutoStop}+`
	rollButton.Sub.Text = string.format("%.2gs", State.Cooldown())
	Hud.SetAuto(s.AutoActive)
	fxButton.Label.Text = if Theme.FxLow then "FX LOW" else "FX HIGH"

	for feature, overlay in locks do
		local unlocked = s.Unlocked[feature]
		overlay.Visible = not unlocked
		if not unlocked then
			local rule = Config.Unlocks[feature]
			local rollsLeft = math.max(0, rule.Rolls - s.TotalRolls)
			local secondsLeft = math.floor(math.max(0, rule.Seconds - s.Playtime))
			overlay.Text.Text = if rollsLeft > 0
				then `{rollsLeft} rolls`
				else string.format("%d:%02d", secondsLeft // 60, secondsLeft % 60)
		end
	end
	Hud.RefreshBoosts()
	Hud.RefreshBadges()
end

-- Chips for running potions: icon + time left.
function Hud.RefreshBoosts()
	local wanted = {}
	for i, potion in Meta.Potions do
		local left = State.PotionLeft(potion.Id)
		if left > 0 then
			wanted[potion.Id] = { Potion = potion, Left = left, Order = i }
		end
	end
	for _, chip in boostRow:GetChildren() do
		if chip:IsA("GuiObject") and wanted[chip.Name] == nil then
			chip:Destroy()
		end
	end
	for id, info in wanted do
		local chip = boostRow:FindFirstChild(id)
		if chip == nil then
			chip = Kit.new("Frame", {
				Name = id,
				LayoutOrder = info.Order,
				Size = UDim2.new(0, 88, 1, 0),
				BackgroundColor3 = Theme.Color.Panel,
				BackgroundTransparency = 0.1,
				Parent = boostRow,
			}, { Kit.corner(UDim.new(0.5, 0)), Kit.stroke(info.Potion.Color, 2, 0) })
			Kit.label({
				Name = "Text",
				Text = "",
				Font = Theme.Font.Heavy,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.9, 0.7),
				Parent = chip,
			}, 16)
			local scale = Kit.new("UIScale", { Scale = 0.3, Parent = chip })
			Kit.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		local seconds = math.ceil(info.Left)
		chip.Text.Text = string.format("%s %d:%02d", info.Potion.Icon, seconds // 60, seconds % 60)
		chip.Text.TextColor3 = if seconds <= 15 then Theme.Color.Danger else Theme.Color.Text
	end
end

-- Red badge counts: things to claim in GIFTS / INDEX, potions owned in POTIONS.
function Hud.SetBadge(name: string, count: number)
	local button = menuButtons[name]
	if button == nil then
		return
	end
	button.Badge.Visible = count > 0
	button.Badge.Count.Text = if count > 9 then "9+" else tostring(count)
end

local badgeSource = nil -- set by Main: () -> { [menuName] = count }

function Hud.SetBadgeSource(source)
	badgeSource = source
end

function Hud.RefreshBadges()
	if badgeSource then
		for name, count in badgeSource() do
			Hud.SetBadge(name, count)
		end
	end
end

-- During a fight the roll dock and menu hide; the Auto Roll feed moves to the top-right
-- corner, clear of the cards, so Auto Roll results still show.
function Hud.SetBattleMode(on: boolean)
	dock.Visible = not on
	menu.Visible = not on
	if on then
		feed.AnchorPoint = Vector2.new(1, 0)
		feed.Position = UDim2.new(1, -12, 0.08, 0)
		feed.Size = UDim2.fromScale(0.18, 0.36)
	else
		feed.AnchorPoint = Vector2.new(1, 0.5)
		feed.Position = UDim2.new(1, -12, 0.42, 0)
		feed.Size = UDim2.fromScale(0.22, 0.42)
	end
end

function Hud.SetAuto(on: boolean)
	autoButton.Sub.Text = if on then "ON" else "OFF"
	autoButton.UIStroke.Transparency = if on then 0 else 0.55
	autoButton.UIStroke.Thickness = if on then 3 else 2
	local dimmed = on
	rollButton.Title.TextTransparency = if dimmed then 0.6 else 0
	quickButton.Title.TextTransparency = if dimmed then 0.6 else 0
end

function Hud.StartCooldown(seconds: number)
	local fill = cooldownBar.Fill
	fill.Size = UDim2.fromScale(0, 1)
	Kit.tween(fill, seconds, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Linear)
end

function Hud.Hint(text: string)
	hintToken += 1
	local token = hintToken
	hintLabel.Text = text
	Kit.tween(hintLabel, 0.15, { TextTransparency = 0 })
	task.delay(1.6, function()
		if token == hintToken then
			Kit.tween(hintLabel, 0.4, { TextTransparency = 1 })
		end
	end)
end

-- "+💎25  🍀x1" popping in at the top of the screen.
function Hud.Reward(text: string)
	if text == "" then
		return
	end
	toastToken += 1
	local token = toastToken
	toast.Text.Text = `🎁 {text}`
	toast.Visible = true
	toast.Scale.Scale = 0.4
	Kit.tween(toast.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	Effects.Sparks(toast, Theme.Color.Gold, 10, 1.2)
	task.delay(2.6, function()
		if token == toastToken then
			Kit.tween(toast.Scale, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Connect(function()
				if token == toastToken then
					toast.Visible = false
				end
			end)
		end
	end)
end

function Hud.FeedAdd(result)
	local card = Cards.Get(result.CardId)
	if card == nil then
		return
	end
	local tier = Rarity.Get(result.Rarity)
	feedOrder += 1
	local suffix = if result.Outcome == "New"
		then " <font color='#FFC42E'>NEW</font>"
		elseif result.Outcome == "Star" then ` ★{result.Stars}`
		else ` +{result.ShardsGained} Shards`
	local entry = Kit.new("Frame", {
		Name = "Entry",
		LayoutOrder = feedOrder,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.Color.Panel,
		BackgroundTransparency = 0.25,
		Parent = feed,
	}, {
		Kit.corner(UDim.new(0.4, 0)),
		Kit.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	})
	Kit.new("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = tier.Color,
		Parent = entry,
	}, { Kit.corner(UDim.new(1, 0)) })
	local hex = tier.Color:ToHex()
	local text = Kit.label({
		Text = `<font color="#{hex}">{tier.Name}</font> {card.Name}{suffix}`,
		RichText = true,
		Font = Theme.Font.Bold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 14, 0.15, 0),
		Size = UDim2.new(1, -14, 0.7, 0),
		Parent = entry,
	}, 16)

	-- Keep the latest seven.
	local entries = {}
	for _, child in feed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(entries, child)
		end
	end
	table.sort(entries, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #entries - 7 do
		entries[i]:Destroy()
	end

	task.delay(8, function()
		if entry.Parent then
			Kit.tween(entry, 0.4, { BackgroundTransparency = 1 })
			Kit.tween(text, 0.4, { TextTransparency = 1 }).Completed:Wait()
			entry:Destroy()
		end
	end)
end

function Hud.Announce(playerName: string, cardId: string)
	local card = Cards.Get(cardId)
	if card == nil then
		return
	end
	local tier = Rarity.Get(card.Rarity)
	bannerToken += 1
	local token = bannerToken
	banner.Gradient.Color = Rarity.Gradient(card.Rarity)
	banner.BackgroundColor3 = Color3.new(1, 1, 1)
	bannerLabel.Text = `{playerName} pulled <b>{string.upper(tier.Name)}</b> {card.Name}, {card.Title}!`
	bannerLabel.TextColor3 = if tier.Name == "Secret" then Color3.fromRGB(20, 16, 40) else Color3.new(1, 1, 1)
	Kit.tween(banner, 0.35, { Position = UDim2.new(0.5, 0, 0, 8) }, Enum.EasingStyle.Back)
	task.delay(4.5, function()
		if token == bannerToken then
			Kit.tween(banner, 0.3, { Position = UDim2.new(0.5, 0, 0, -80) })
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Index</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The Index: every card by rarity, found or not, with each rarity's odds, how many copies you
-- have, and a completion reward (permanent luck + loot) for finding every card of a rarity.
-- Tap a card for its details; ODDS opens the live odds panel.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared.Rarity)
local Cards = require(Shared.Cards)
local Config = require(Shared.Config)
local Odds = require(Shared.Odds)
local Meta = require(Shared.Meta)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local CardView = require(script.Parent.CardView)
local CardTile = require(script.Parent.CardTile)
local Controls = require(script.Parent.Controls)
local Effects = require(script.Parent.Effects)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.Parent.State)
local MetaClient = require(script.Parent.Parent.MetaClient)

local Index = {}

local modal
local list: ScrollingFrame
local progressLabel: TextLabel
local progressFill: Frame
local detail: TextButton? = nil
local onOdds: (() -> ())? = nil
local dirty = true
local tabSetters = {}
local tab = "All"
local filterBy = "All"
local search = ""
local cellSize = 110 -- card tile size, fitted to the list width

local function closeDetail()
	if detail then
		detail:Destroy()
		detail = nil
	end
end

local function showDetail(card)
	closeDetail()
	local entry = State.Cards[card.Id]
	local owned = entry ~= nil
	local stars = if entry then entry.Stars else 0
	local tier = Rarity.Get(card.Rarity)

	local panel = Kit.new("TextButton", {
		Name = "Detail",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Color.Panel,
		BackgroundTransparency = 0.02,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 20,
		Parent = modal.Body,
	}, { Kit.corner(UDim.new(0, 12)) })
	detail = panel

	local left = Kit.new("Frame", {
		Name = "CardSide",
		Size = UDim2.fromScale(0.4, 1),
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = panel,
	}, { Kit.padding(10) })
	local view = CardView.new(card.Id, { Owned = owned, Stars = stars, Animate = owned })
	view.AnchorPoint = Vector2.new(0.5, 0.5)
	view.Position = UDim2.fromScale(0.5, 0.5)
	view.Parent = left
	if owned and Rarity.AtLeast(card.Rarity, "Legendary") then
		Effects.Shimmer(view, 2)
	end

	local right = Kit.new("ScrollingFrame", {
		Name = "Info",
		Position = UDim2.fromScale(0.42, 0),
		Size = UDim2.fromScale(0.58, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 21,
		Parent = panel,
	}, {
		Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
		Kit.new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingRight = UDim.new(0, 10) }),
	})

	local order = 0
	local function line(text: string, font: Enum.Font, color: Color3, height: number, maxText: number)
		order += 1
		return Kit.label({
			Text = text,
			RichText = true,
			Font = font,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextScaled = false,
			TextSize = maxText,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, height),
			LayoutOrder = order,
			ZIndex = 22,
			Parent = right,
		}, maxText)
	end

	line(if owned then card.Name else "???", Theme.Font.Display, Theme.Color.Text, 30, 28)
	line(
		`<font color="#{tier.Color:ToHex()}">{string.upper(card.Rarity)}</font>  ·  {card.Type}  ·  {if owned then card.Title else "Not found yet"}`,
		Theme.Font.Heavy,
		Theme.Color.Muted,
		20,
		17
	)
	local chance = Odds.Chances(State.Luck())[card.Rarity] / #Cards.ByRarity[card.Rarity]
	line(`Chance per roll right now: <b>{Odds.FormatPercent(chance)}</b> ({Odds.FormatOneIn(chance)})`, Theme.Font.Bold, Theme.Color.Support, 18, 15)
	if owned then
		line(
			`★ {stars}/{Config.MaxStars} stars (+{math.floor(stars * Config.StarBonus * 100 + 0.5)}% stats)  ·  {entry.Copies} pulled`,
			Theme.Font.Bold,
			Theme.Color.Gold,
			20,
			16
		)
		local hpText = if card.HP then `   ❤️ HP <b>{Kit.commas(Cards.StatWithStars(card.HP, stars))}</b>` else ""
		line(
			`{if card.Type == "Attack" then "⚔️ ATK" else "✨ PWR"} <b>{Kit.commas(Cards.StatWithStars(card.Main, stars))}</b>{hpText}   ⚡ SPD <b>{card.SPD}</b>   Power <b>{Kit.commas(
				Cards.Power(card, stars)
			)}</b>`,
			Theme.Font.Medium,
			Theme.Color.Text,
			20,
			16
		)
		for _, ability in card.Abilities do
			order += 1
			local box = Kit.new("Frame", {
				Name = "Ability",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = Theme.Color.PanelLight,
				LayoutOrder = order,
				ZIndex = 22,
				Parent = right,
			}, {
				Kit.corner(UDim.new(0, 10)),
				Kit.padding(8),
				Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
			})
			local head = Kit.label({
				Text = `<font color="#{tier.Color:ToHex()}">{string.upper(ability.Slot)}</font>  {ability.Name}`,
				RichText = true,
				Font = Theme.Font.Heavy,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextScaled = false,
				TextSize = 16,
				Size = UDim2.new(1, 0, 0, 18),
				LayoutOrder = 1,
				ZIndex = 23,
				Parent = box,
			}, 16)
			head.AutomaticSize = Enum.AutomaticSize.Y
			local body = Kit.label({
				Text = ability.Text,
				Font = Theme.Font.Medium,
				TextColor3 = Theme.Color.Muted,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextScaled = false,
				TextSize = 15,
				Size = UDim2.new(1, 0, 0, 16),
				LayoutOrder = 2,
				ZIndex = 23,
				Parent = box,
			}, 15)
			body.AutomaticSize = Enum.AutomaticSize.Y
		end
	else
		line("Keep rolling to discover this card and its abilities!", Theme.Font.Bold, Theme.Color.Muted, 20, 16)
	end
	line("Tap anywhere on this panel to go back.", Theme.Font.Medium, Theme.Color.Muted, 18, 14)
	panel.Activated:Connect(function()
		closeDetail()
		Index.Refresh()
	end)
end

local function section(rarity: string, order: number)
	local tier = Rarity.Get(rarity)
	local pool = Cards.ByRarity[rarity] or {}
	local found = 0
	for _, card in pool do
		if State.Cards[card.Id] then
			found += 1
		end
	end
	-- Cards in this section after the tab / filter / search.
	local shown = {}
	for _, card in pool do
		local owned = State.Cards[card.Id] ~= nil
		local matchesTab = tab == "All" or card.Type == tab
		local matchesFilter = filterBy == "All" or (filterBy == "Found" and owned) or (filterBy == "Missing" and not owned)
		local matchesSearch = search == "" or (owned and string.find(string.lower(card.Name), search, 1, true) ~= nil)
		if matchesTab and matchesFilter and matchesSearch then
			table.insert(shown, card)
		end
	end
	if #shown == 0 and (search ~= "" or filterBy ~= "All" or tab ~= "All") then
		return -- nothing to show here
	end
	local reward = Meta.IndexRewards[rarity]
	local claimed = State.Meta.IndexClaimed[rarity] == true
	local complete = found == #pool and #pool > 0
	local chance = Odds.Chances(State.Luck())[rarity]

	local box = Kit.new("Frame", {
		Name = rarity,
		LayoutOrder = order,
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = tier.Dark:Lerp(Color3.new(0, 0, 0), 0.3),
		BackgroundTransparency = 0.2,
		Parent = list,
	}, {
		Kit.corner(UDim.new(0, 18)),
		Kit.stroke(tier.Color, if complete then 3 else 2, if complete then 0 else 0.5),
		Kit.padding(10),
		Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }),
	})

	-- Header strip in the rarity's colour: name, odds and progress, reward / claim.
	local header = Kit.new("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = box,
	}, {
		Kit.corner(UDim.new(0, 14)),
		Kit.gradient(ColorSequence.new(tier.Color:Lerp(Color3.new(0, 0, 0), 0.15), tier.Dark), 0),
		Kit.stroke(Color3.new(1, 1, 1), 2, 0.4),
	})
	if rarity == "Secret" then
		Kit.gradient(Rarity.Gradient("Secret"), 0).Parent = header
	end
	local badge = Kit.new("Frame", {
		Position = UDim2.new(0, 8, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(38, 38),
		BackgroundColor3 = tier.Color,
		Parent = header,
	}, { Kit.corner(UDim.new(1, 0)), Kit.stroke(Color3.new(1, 1, 1), 2, 0) })
	Controls.Outlined(Kit.label({
		Text = CardTile.Letters[rarity],
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromScale(0.75, 0.75),
		Parent = badge,
	}, 24), 1.5)
	Controls.Outlined(Kit.label({
		Text = string.upper(rarity),
		Font = Theme.Font.Display,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(56, 4),
		Size = UDim2.new(0.4, 0, 0, 26),
		Parent = header,
	}, 26), 2)
	Controls.Outlined(Kit.label({
		Text = `{Odds.FormatPercent(chance)}  ·  {Odds.FormatOneIn(chance)}  ·  {found}/{#pool} found`,
		Font = Theme.Font.Heavy,
		TextColor3 = Color3.fromRGB(235, 230, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(56, 30),
		Size = UDim2.new(0.45, 0, 0, 16),
		Parent = header,
	}, 15), 1.5)

	local rewardText = `+{reward.Luck}x luck  {Meta.Describe(reward.Reward)}`
	if claimed then
		Controls.Outlined(Kit.label({
			Text = `✓ CLAIMED  ·  {rewardText}`,
			Font = Theme.Font.Display,
			TextColor3 = Theme.Color.Quick,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0.5, 0, 0, 22),
			Parent = header,
		}, 18), 1.5)
	elseif complete then
		local claim = Kit.button(`CLAIM  {rewardText}`, Theme.Color.Gold, Color3.fromRGB(170, 110, 0), {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.new(0.48, 0, 0, 40),
			Parent = header,
		})
		local scale = claim:FindFirstChildOfClass("UIScale")
		if scale then
			task.spawn(Effects.Pulse, scale, 3, 0.6, 0.06)
		end
		claim.Activated:Connect(function()
			local result = MetaClient.Call("ClaimIndex", rarity)
			if result.Ok then
				Sfx.Play("Impact", 1.3)
				dirty = true
				Index.Refresh()
			end
		end)
	else
		Controls.Outlined(Kit.label({
			Text = `Find all {#pool}:  {rewardText}`,
			Font = Theme.Font.Heavy,
			TextColor3 = Color3.fromRGB(235, 230, 255),
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0.5, 0, 0, 20),
			Parent = header,
		}, 16), 1.5)
	end

	-- Cards.
	local grid = Kit.new("Frame", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = box,
	}, {
		Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(cellSize, cellSize),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	table.sort(shown, function(a, b)
		if a.Type ~= b.Type then
			return a.Type == "Attack"
		end
		return a.Name < b.Name
	end)
	for i, card in shown do
		local own = State.Cards[card.Id]
		local tile = CardTile.new(card.Id, {
			Owned = own ~= nil,
			Stars = if own then own.Stars else 0,
			Copies = if own then own.Copies else nil,
		})
		tile.LayoutOrder = i
		tile.Parent = grid
		tile.Activated:Connect(function()
			showDetail(card)
		end)
	end
end

function Index.Refresh()
	if not modal.IsOpen or not dirty or detail ~= nil then
		return
	end
	dirty = false
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local width = list.AbsoluteSize.X - 40
	if width > 0 then
		local count = math.clamp(math.floor(width / 120), 3, 9)
		cellSize = math.floor((width - 10 * (count - 1)) / count)
	end
	local total, found = #Cards.List, 0
	for _, card in Cards.List do
		if State.Cards[card.Id] then
			found += 1
		end
	end
	progressLabel.Text = `FOUND {found} / {total}  ·  {math.floor(found / total * 100)}%`
	Kit.tween(progressFill, 0.4, { Size = UDim2.fromScale(math.max(0.02, found / total), 1) })
	for name, set in tabSetters do
		set(name == tab)
	end
	for i, rarity in Rarity.Order do
		section(rarity, i)
	end
end

local function redraw()
	dirty = true
	Index.Refresh()
end

function Index.Init(playerGui: Instance, openOdds: () -> ())
	onOdds = openOdds
	modal = Modal.new(playerGui, "IndexGui", "Index", Vector2.new(0.94, 0.9), Vector2.new(1200, 760))

	Controls.Search(modal.Header, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -72, 0, -10),
		Size = UDim2.fromOffset(200, 40),
	}, function(text)
		search = text
		redraw()
	end)

	-- Top bar: tabs, filter, completion bar, odds.
	local bar = Kit.new("Frame", {
		Name = "Bar",
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
		Parent = modal.Body,
	})
	local tabs = Kit.new("Frame", {
		Position = UDim2.fromOffset(0, 4),
		Size = UDim2.new(0.5, 0, 0, 42),
		BackgroundTransparency = 1,
		Parent = bar,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	for i, info in { { "All", Controls.Purple }, { "Attack", Theme.Color.Attack }, { "Support", Theme.Color.Quick } } do
		local button, set = Controls.Tab(tabs, info[1], info[2], i, 110)
		button.Activated:Connect(function()
			tab = info[1]
			redraw()
		end)
		tabSetters[info[1]] = set
	end
	local right = Kit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = bar,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	local track = Kit.new("Frame", {
		Name = "Progress",
		LayoutOrder = 1,
		Size = UDim2.new(0, 220, 0, 30),
		BackgroundColor3 = Color3.fromRGB(14, 8, 32),
		Parent = right,
	}, { Kit.corner(UDim.new(0.5, 0)), Kit.stroke(Theme.Color.Gold, 2, 0.3) })
	progressFill = Kit.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = track,
	}, {
		Kit.corner(UDim.new(0.5, 0)),
		Kit.gradient(ColorSequence.new(Theme.Color.Gold, Theme.Color.Roll), 0),
	})
	progressLabel = Controls.Outlined(Kit.label({
		Text = "",
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.95, 0.75),
		ZIndex = 2,
		Parent = track,
	}, 17), 1.5)
	Controls.Option(right, "Filter", { "All", "Found", "Missing" }, 2, function(value)
		filterBy = value
		redraw()
	end)
	local oddsButton = Kit.button("📊 ODDS", Theme.Color.Auto, Theme.Color.AutoDeep, {
		LayoutOrder = 3,
		Size = UDim2.new(0, 104, 1, 0),
		Parent = right,
	})
	oddsButton.Activated:Connect(function()
		if onOdds then
			onOdds()
		end
	end)

	list = Kit.new("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 1, -58),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Color3.fromRGB(170, 130, 255),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = modal.Body,
	}, {
		Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 12) }),
		Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 2), PaddingBottom = UDim.new(0, 10) }),
	})

	modal.OnOpen = function()
		closeDetail()
		task.defer(redraw) -- after the list has its size, for the tile size
	end
	-- Rebuild at most every 0.8 s, so Auto Roll results don't redraw it every roll.
	local pending = false
	State.Changed:Connect(function()
		dirty = true
		if pending or not modal.IsOpen then
			return
		end
		pending = true
		task.delay(0.8, function()
			pending = false
			Index.Refresh()
		end)
	end)
end

function Index.Toggle()
	modal:Toggle()
end

return Index
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Small helpers so the UI code reads like a layout, not boilerplate.

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Skin = require(script.Parent.Skin)

local Kit = {}

-- Kit.new("Frame", { Size = ..., Parent = ... }, { childA, childB })
function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				inst[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(radius: UDim?): UICorner
	return Kit.new("UICorner", { CornerRadius = radius or UDim.new(0.18, 0) })
end

function Kit.stroke(color: Color3, thickness: number?, transparency: number?): UIStroke
	return Kit.new("UIStroke", {
		Color = color,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- Outline around the letters of a TextLabel (not a box around it).
function Kit.textStroke(color: Color3, thickness: number?, transparency: number?): UIStroke
	return Kit.new("UIStroke", {
		Color = color,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function Kit.gradient(sequence: ColorSequence, rotation: number?): UIGradient
	return Kit.new("UIGradient", { Color = sequence, Rotation = rotation or 90 })
end

function Kit.twoTone(top: Color3, bottom: Color3): ColorSequence
	return ColorSequence.new(top, bottom)
end

function Kit.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Kit.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Kit.aspect(ratio: number, dominant: Enum.DominantAxis?): UIAspectRatioConstraint
	return Kit.new("UIAspectRatioConstraint", {
		AspectRatio = ratio,
		DominantAxis = dominant or Enum.DominantAxis.Width,
		AspectType = Enum.AspectType.FitWithinMaxSize,
	})
end

function Kit.textMax(max: number, min: number?): UITextSizeConstraint
	return Kit.new("UITextSizeConstraint", { MaxTextSize = max, MinTextSize = min or 8 })
end

-- Scaled text label with a size cap so it stays crisp on big screens.
function Kit.label(props: { [string]: any }, maxText: number?): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Color.Text,
		Font = Theme.Font.Bold,
		TextScaled = true,
		TextWrapped = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	local label = Kit.new("TextLabel", defaults)
	Kit.textMax(maxText or 28).Parent = label
	return label
end

-- Plays and returns a tween.
function Kit.tween(
	inst: Instance,
	time: number,
	goal: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local tween = TweenService:Create(inst, info, goal)
	tween:Play()
	return tween
end

-- Press feedback: shrink on press, spring back on release. Cheap and works on touch.
function Kit.pressable(button: GuiButton)
	local scale = button:FindFirstChildOfClass("UIScale") or Kit.new("UIScale", { Parent = button })
	button.MouseButton1Down:Connect(function()
		Kit.tween(scale, 0.08, { Scale = 0.92 })
	end)
	local function release()
		Kit.tween(scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
end

-- Standard panel button with a label.
function Kit.button(text: string, color: Color3, deep: Color3, props: { [string]: any }?): TextButton
	local base = {
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
	}
	if props then
		for key, value in props do
			base[key] = value
		end
	end
	local button = Kit.new("TextButton", base, {
		Kit.corner(UDim.new(0.25, 0)),
		Kit.gradient(Kit.twoTone(color, deep), 90),
		Kit.stroke(Color3.new(1, 1, 1), 1.5, 0.75),
	})
	Skin.Apply(button, Skin.ButtonFor(color)) -- uploaded button art, when there is some
	local label = Kit.label({
		Name = "Label",
		Text = text,
		Font = Theme.Font.Display,
		Size = UDim2.fromScale(0.86, 0.62),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = button,
	}, 22)
	Kit.textStroke(Color3.fromRGB(30, 10, 70), 1.5, 0.1).Parent = label
	Kit.pressable(button)
	return button
end

function Kit.screenGui(name: string, displayOrder: number, parent: Instance): ScreenGui
	return Kit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		DisplayOrder = displayOrder,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = parent,
	})
end

function Kit.commas(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[--!nonstrict
-- A centred panel over a blurred game world: purple gradient panel, a slanted title banner with a
-- sparkle, and a red close pill. Tap outside or press the close pill to close.

local Lighting = game:GetService("Lighting")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Skin = require(script.Parent.Skin)

local Modal = {}
Modal.__index = Modal

local openModal = nil -- only one panel open at a time
local blur: BlurEffect? = nil

local PANEL_TOP = Color3.fromRGB(62, 32, 128)
local PANEL_BOTTOM = Color3.fromRGB(22, 13, 50)
local PANEL_EDGE = Color3.fromRGB(150, 110, 255)
local BANNER_LEFT = Color3.fromRGB(150, 100, 255)
local BANNER_RIGHT = Color3.fromRGB(80, 40, 210)

export type Modal = {
	Gui: ScreenGui,
	Panel: Frame,
	Body: Frame,
	Header: Frame,
	IsOpen: boolean,
	Open: (self: Modal) -> (),
	Close: (self: Modal) -> (),
	OnOpen: (() -> ())?,
}

-- The game world behind an open panel goes soft (skipped on low effects).
local function setBlur(on: boolean)
	local effect = blur
	if effect == nil then
		effect = Instance.new("BlurEffect")
		effect.Name = "MenuBlur"
		effect.Size = 0
		effect.Parent = Lighting
		blur = effect
	end
	local goal = if on and not Theme.FxLow then 14 else 0
	Kit.tween(effect, 0.25, { Size = goal })
end

-- Slanted title banner with a sparkle, used by every panel (and the deck screen).
function Modal.Banner(parent: Instance, title: string, textSize: number?): any -- children read by name
	local banner = Kit.new("Frame", {
		Name = "Banner",
		Position = UDim2.fromOffset(-14, -16),
		Size = UDim2.fromOffset(0, 58),
		AutomaticSize = Enum.AutomaticSize.X,
		Rotation = -3,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 5,
		Parent = parent,
	}, {
		Kit.corner(UDim.new(0, 12)),
		Kit.gradient(ColorSequence.new(BANNER_LEFT, BANNER_RIGHT), 0),
		Kit.stroke(Color3.fromRGB(230, 220, 255), 2.5, 0),
		Kit.new("UIPadding", { PaddingLeft = UDim.new(0, 52), PaddingRight = UDim.new(0, 26) }),
	})
	local sparkle = Kit.label({
		Name = "Sparkle",
		Text = "✦",
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, -24, 0.5, 0),
		Size = UDim2.fromOffset(56, 56),
		Rotation = 12,
		ZIndex = 7,
		Parent = banner,
	}, 52)
	Kit.textStroke(Color3.fromRGB(70, 30, 160), 2, 0).Parent = sparkle
	local label = Kit.new("TextLabel", {
		Name = "Title",
		Text = title,
		Font = Theme.Font.Display,
		TextSize = textSize or 36,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		ZIndex = 6,
		Parent = banner,
	})
	Kit.textStroke(Color3.fromRGB(40, 14, 90), 3, 0).Parent = label
	if Skin.Apply(banner, "Banner") then
		sparkle.Visible = false -- the banner art has its own
	end
	return banner
end

-- Red pill with a cross.
function Modal.CloseButton(parent: Instance): TextButton
	local close = Kit.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 8, 0, -14),
		Size = UDim2.fromOffset(64, 42),
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
		ZIndex = 6,
		Parent = parent,
	}, {
		Kit.corner(UDim.new(0.5, 0)),
		Kit.gradient(ColorSequence.new(Color3.fromRGB(255, 110, 110), Color3.fromRGB(215, 40, 70)), 90),
		Kit.stroke(Color3.new(1, 1, 1), 2, 0.2),
	})
	local cross = Kit.label({
		Text = "✕",
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.6, 0.7),
		ZIndex = 7,
		Parent = close,
	}, 28)
	Kit.textStroke(Color3.fromRGB(110, 10, 30), 2, 0).Parent = cross
	if Skin.Apply(close, "Close") then
		cross.Visible = false -- the button art has its own X
		close.Size = UDim2.fromOffset(46, 46)
	end
	Kit.pressable(close)
	return close
end

function Modal.new(playerGui: Instance, name: string, title: string, size: Vector2, maxSize: Vector2)
	local self = setmetatable({}, Modal)
	self.IsOpen = false

	self.Gui = Kit.screenGui(name, 10, playerGui)
	self.Gui.Enabled = false

	local backdrop = Kit.new("TextButton", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Color.Backdrop,
		BackgroundTransparency = 0.45,
		AutoButtonColor = false,
		Text = "",
		Parent = self.Gui,
	})
	backdrop.Activated:Connect(function()
		self:Close()
	end)

	self.Panel = Kit.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromScale(size.X, size.Y),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Active = true, -- taps on the panel don't fall through to the backdrop
		Parent = self.Gui,
	}, {
		Kit.corner(UDim.new(0, 22)),
		Kit.gradient(ColorSequence.new(PANEL_TOP, PANEL_BOTTOM), 90),
		Kit.stroke(PANEL_EDGE, 3, 0),
		Kit.new("UISizeConstraint", { MaxSize = maxSize, MinSize = Vector2.new(280, 220) }),
	})
	self.Scale = Kit.new("UIScale", { Scale = 1, Parent = self.Panel })
	Skin.Apply(self.Panel, "Panel")

	self.Header = Kit.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = self.Panel,
	})
	self.Banner = Modal.Banner(self.Header, title)
	self.TitleLabel = self.Banner.Title
	local close = Modal.CloseButton(self.Header)
	close.Activated:Connect(function()
		self:Close()
	end)

	self.Body = Kit.new("Frame", {
		Name = "Body",
		Position = UDim2.new(0, 16, 0, 62),
		Size = UDim2.new(1, -32, 1, -78),
		BackgroundTransparency = 1,
		Parent = self.Panel,
	})

	return self
end

function Modal:Open()
	if openModal and openModal ~= self then
		openModal:Close()
	end
	openModal = self
	self.IsOpen = true
	self.Gui.Enabled = true
	self.Scale.Scale = 0.88
	Kit.tween(self.Scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	setBlur(true)
	if self.OnOpen then
		self.OnOpen()
	end
end

function Modal:Close()
	if not self.IsOpen then
		return
	end
	self.IsOpen = false
	if openModal == self then
		openModal = nil
		setBlur(false)
	end
	self.Gui.Enabled = false
end

function Modal:Toggle()
	if self.IsOpen then
		self:Close()
	else
		self:Open()
	end
end

return Modal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">ModelView</string>
              <string name="Source"><![CDATA[--!nonstrict
-- A 3D figure (boss or NPC) inside a ViewportFrame: idle breathing, slow turn, recoil when hit
-- and colour flashes. One model per view, so it stays cheap on phones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BossModels = require(Shared.BossModels)

local Kit = require(script.Parent.Kit)

local ModelView = {}
ModelView.__index = ModelView

export type View = {
	Frame: ViewportFrame,
	Kick: (self: View, strength: number?) -> (),
	Lunge: (self: View) -> (),
	Flash: (self: View, color: Color3, seconds: number?) -> (),
	SetTint: (self: View, color: Color3) -> (),
	SetTurn: (self: View, degrees: number) -> (),
}

-- turn: degrees of slow left-right sway (0 = always face the camera); spin = full turns per minute.
function ModelView.new(id: string, props: { [string]: any }?, turn: number?, spin: number?)
	local self = setmetatable({}, ModelView)
	local viewport = Kit.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(150, 140, 170),
		LightColor = Color3.fromRGB(255, 244, 230),
		LightDirection = Vector3.new(-0.6, -1, 0.8),
		ImageColor3 = Color3.new(1, 1, 1),
	})
	if props then
		for key, value in props do
			viewport[key] = value
		end
	end
	self.Frame = viewport
	self.Tint = Color3.new(1, 1, 1)
	self.Turn = turn or 8
	self.Spin = spin or 0
	self.KickAmount = 0
	self.LungeAmount = 0

	local height = BossModels.Height(id)
	local model = BossModels.Build(id)
	model.Parent = viewport
	self.Model = model
	self.Base = CFrame.new(0, height / 2, 0)
	model:PivotTo(self.Base)

	local camera = Instance.new("Camera")
	camera.FieldOfView = 32
	camera.CFrame = CFrame.lookAt(Vector3.new(0, height * 0.62, -height * 2.15), Vector3.new(0, height * 0.5, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local start = os.clock()
	local phase = math.random() * 10
	self.Connection = RunService.RenderStepped:Connect(function(dt)
		if viewport.Parent == nil then
			self.Connection:Disconnect()
			return
		end
		if not viewport.Visible then
			return
		end
		local t = os.clock() - start + phase
		self.KickAmount *= math.exp(-dt * 9)
		self.LungeAmount *= math.exp(-dt * 7)
		local bob = math.sin(t * 2.1) * height * 0.012
		local yaw = math.rad(self.Turn) * math.sin(t * 0.6) + (t - phase) * self.Spin * math.pi / 30
		local recoil = CFrame.new(0, 0, height * 0.06 * self.KickAmount) * CFrame.Angles(math.rad(-6 * self.KickAmount), 0, 0)
		local lunge = CFrame.new(0, 0, -height * 0.12 * self.LungeAmount)
		model:PivotTo(self.Base * CFrame.new(0, bob, 0) * lunge * recoil * CFrame.Angles(0, yaw, 0))
	end)
	return self
end

-- Knocked back by a hit.
function ModelView:Kick(strength: number?)
	self.KickAmount = math.min(1.6, self.KickAmount + (strength or 1))
end

-- Lunges toward the camera (the boss attacking).
function ModelView:Lunge()
	self.LungeAmount = 1
end

function ModelView:Flash(color: Color3, seconds: number?)
	self.Frame.ImageColor3 = color
	Kit.tween(self.Frame, seconds or 0.25, { ImageColor3 = self.Tint })
end

-- Resting colour (e.g. red when enraged).
function ModelView:SetTint(color: Color3)
	self.Tint = color
	Kit.tween(self.Frame, 0.4, { ImageColor3 = color })
end

function ModelView:SetTurn(degrees: number)
	self.Turn = degrees
end

return ModelView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">OddsPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Live odds with the player's current luck and any pity guarantee applied.
-- Uses the same Odds module as the server, so the numbers always match.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared.Rarity)
local Cards = require(Shared.Cards)
local Odds = require(Shared.Odds)
local Config = require(Shared.Config)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local OddsPanel = {}

local modal
local rows = {} -- [rarity] = { Chance, OneIn }
local luckLabel: TextLabel
local epicBar: Frame
local legendaryBar: Frame
local epicLabel: TextLabel
local legendaryLabel: TextLabel

local function pityBar(parent: Instance, y: number, color: Color3)
	local track = Kit.new("Frame", {
		Position = UDim2.new(0, 0, 0, y + 22),
		Size = UDim2.new(1, 0, 0, 10),
		BackgroundColor3 = Theme.Color.PanelLight,
		Parent = parent,
	}, { Kit.corner(UDim.new(1, 0)) })
	local fill = Kit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color,
		Parent = track,
	}, { Kit.corner(UDim.new(1, 0)) })
	local label = Kit.label({
		Position = UDim2.new(0, 0, 0, y),
		Size = UDim2.new(1, 0, 0, 20),
		Font = Theme.Font.Bold,
		TextColor3 = Theme.Color.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = false,
		TextSize = 16,
		Text = "",
		Parent = parent,
	}, 16)
	return fill, label
end

local function refresh()
	local summary = State.Summary
	local floor = Odds.PityFloor(summary.Pity)
	local luck = State.Luck()
	local chances = Odds.Chances(luck, floor)
	for name, row in rows do
		row.Chance.Text = Odds.FormatPercent(chances[name])
		row.OneIn.Text = Odds.FormatOneIn(chances[name])
	end
	local floorText = if floor then `   ·   Next roll guaranteed {floor} or better` else ""
	luckLabel.Text = string.format("Luck %.2fx%s", luck, floorText)

	local epicLeft, legendaryLeft = Odds.PityRemaining(summary.Pity)
	epicLabel.Text = `Epic or better guaranteed within {epicLeft} rolls`
	legendaryLabel.Text = `Legendary or better guaranteed within {legendaryLeft} rolls`
	epicBar.Size = UDim2.fromScale(summary.Pity.Epic / Config.Pity.Epic, 1)
	legendaryBar.Size = UDim2.fromScale(summary.Pity.Legendary / Config.Pity.Legendary, 1)
end

function OddsPanel.Init(playerGui: Instance)
	modal = Modal.new(playerGui, "OddsGui", "ODDS", Vector2.new(0.6, 0.86), Vector2.new(620, 640))

	local scroll = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = modal.Body,
	}, {
		Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
		Kit.new("UIPadding", { PaddingRight = UDim.new(0, 8) }),
	})

	luckLabel = Kit.label({
		LayoutOrder = 0,
		Size = UDim2.new(1, 0, 0, 22),
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Quick,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = false,
		TextSize = 17,
		Text = "",
		Parent = scroll,
	}, 17)

	for i = #Rarity.Order, 1, -1 do
		local name = Rarity.Order[i]
		local tier = Rarity.Get(name)
		local count = #(Cards.ByRarity[name] or {})
		local row = Kit.new("Frame", {
			Name = name,
			LayoutOrder = #Rarity.Order - i + 1,
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = Theme.Color.PanelLight,
			Parent = scroll,
		}, { Kit.corner(UDim.new(0, 10)) })
		Kit.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = tier.Color,
			Parent = row,
		}, { Kit.corner(UDim.new(1, 0)) })
		Kit.label({
			Text = `<font color="#{tier.Color:ToHex()}">{string.upper(name)}</font>  <font color="#A8A2C8">{count} card{if count == 1
				then ""
				else "s"}</font>`,
			RichText = true,
			Font = Theme.Font.Heavy,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0, 36, 0.2, 0),
			Size = UDim2.new(0.45, -36, 0.6, 0),
			Parent = row,
		}, 18)
		local chance = Kit.label({
			Name = "Chance",
			Text = "",
			Font = Theme.Font.Heavy,
			TextXAlignment = Enum.TextXAlignment.Right,
			Position = UDim2.new(0.45, 0, 0.2, 0),
			Size = UDim2.new(0.25, 0, 0.6, 0),
			Parent = row,
		}, 18)
		local oneIn = Kit.label({
			Name = "OneIn",
			Text = "",
			Font = Theme.Font.Medium,
			TextColor3 = Theme.Color.Muted,
			TextXAlignment = Enum.TextXAlignment.Right,
			Position = UDim2.new(0.7, 0, 0.2, 0),
			Size = UDim2.new(0.28, -6, 0.6, 0),
			Parent = row,
		}, 16)
		rows[name] = { Chance = chance, OneIn = oneIn }
	end

	local pity = Kit.new("Frame", {
		Name = "Pity",
		LayoutOrder = 20,
		Size = UDim2.new(1, 0, 0, 96),
		BackgroundTransparency = 1,
		Parent = scroll,
	}, { Kit.new("UIPadding", { PaddingTop = UDim.new(0, 10) }) })
	epicBar, epicLabel = pityBar(pity, 0, Rarity.Get("Epic").Color)
	legendaryBar, legendaryLabel = pityBar(pity, 44, Rarity.Get("Legendary").Color)

	Kit.label({
		LayoutOrder = 30,
		Size = UDim2.new(1, 0, 0, 40),
		Font = Theme.Font.Medium,
		TextColor3 = Theme.Color.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextScaled = false,
		TextSize = 14,
		Text = "Rolls are free. Each card within a rarity is equally likely. Probabilities are rounded, so the "
			.. "displayed values may not add up to exactly 100%.",
		Parent = scroll,
	}, 14)

	modal.OnOpen = refresh
	State.Changed:Connect(function()
		if modal.IsOpen then
			refresh()
		end
	end)
end

function OddsPanel.Toggle()
	modal:Toggle()
end

return OddsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Potions</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Potions: what you own, what's running (with timers), and USE / BUY buttons.
-- The server checks every use and purchase (MetaService).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Meta = require(Shared.Meta)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Effects = require(script.Parent.Effects)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.Parent.State)
local MetaClient = require(script.Parent.Parent.MetaClient)

local Potions = {}

local modal
local summaryLabel: TextLabel
local hintLabel: TextLabel
local cards = {} -- [potionId] = { Owned, Timer, Use, Buy }
local hintToken = 0

local function hint(text: string)
	hintToken += 1
	local token = hintToken
	hintLabel.Text = text
	hintLabel.TextTransparency = 0
	task.delay(2.2, function()
		if token == hintToken then
			Kit.tween(hintLabel, 0.4, { TextTransparency = 1 })
		end
	end)
end

local function clockText(seconds: number): string
	seconds = math.ceil(seconds)
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Potions.Refresh()
	if not modal or not modal.IsOpen then
		return
	end
	summaryLabel.Text = string.format(
		'Luck now <font color="#56D68A"><b>%.2fx</b></font>   ·   Roll cooldown <font color="#50B4FF"><b>%.2fs</b></font>   ·   💎 <b>%s</b> Shards',
		State.Luck(),
		State.Cooldown(),
		Kit.commas(State.Summary.Shards or 0)
	)
	for id, refs in cards do
		local potion = Meta.PotionById[id]
		local owned = State.Meta.Inventory[id] or 0
		local left = State.PotionLeft(id)
		refs.Owned.Text = `Owned: {owned}`
		refs.Timer.Text = if left > 0 then `RUNNING  {clockText(left)}` else ""
		refs.Use.BackgroundTransparency = if owned > 0 then 0 else 0.6
		refs.Buy.Label.Text = `BUY 💎{potion.Price}`
		refs.Buy.BackgroundTransparency = if (State.Summary.Shards or 0) >= potion.Price then 0 else 0.6
		refs.Glow.Visible = left > 0
	end
end

local function potionCard(parent: Instance, potion, order: number)
	local card = Kit.new("Frame", {
		Name = potion.Id,
		LayoutOrder = order,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = parent,
	}, {
		Kit.corner(UDim.new(0, 16)),
		Kit.gradient(ColorSequence.new(potion.Color:Lerp(Theme.Color.Panel, 0.55), Theme.Color.Panel), 90),
		Kit.stroke(potion.Color, 2, 0.3),
	})
	local glow = Kit.new("Frame", {
		Name = "Glow",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = card,
	}, { Kit.corner(UDim.new(0, 16)) })
	local glowStroke = Kit.stroke(potion.Color, 4, 0)
	glowStroke.Parent = glow
	TweenService:Create(glowStroke, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.7,
	}):Play()
	-- Bottle: a round flask with a neck, filled with the potion's colour.
	local bottle = Kit.new("Frame", {
		Name = "Bottle",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.05),
		Size = UDim2.fromScale(0.44, 0.34),
		BackgroundTransparency = 1,
		Parent = card,
	}, { Kit.aspect(0.8, Enum.DominantAxis.Height) })
	Kit.new("Frame", {
		Name = "Flask",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1, 0.78),
		BackgroundColor3 = potion.Color,
		Parent = bottle,
	}, {
		Kit.corner(UDim.new(1, 0)),
		Kit.gradient(ColorSequence.new(potion.Color:Lerp(Color3.new(1, 1, 1), 0.35), potion.Color:Lerp(Color3.new(0, 0, 0), 0.25)), 90),
		Kit.stroke(Color3.new(1, 1, 1), 2, 0.4),
	})
	Kit.new("Frame", {
		Name = "Neck",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.36, 0.3),
		BackgroundColor3 = Color3.fromRGB(220, 230, 240),
		BackgroundTransparency = 0.3,
		Parent = bottle,
	}, { Kit.corner(UDim.new(0.3, 0)) })
	Kit.label({
		Name = "Icon",
		Text = potion.Icon,
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.fromScale(0.6, 0.45),
		Parent = bottle,
	}, 40)
	local name = Kit.label({
		Text = potion.Name,
		Font = Theme.Font.Display,
		Position = UDim2.fromScale(0.05, 0.41),
		Size = UDim2.fromScale(0.9, 0.11),
		Parent = card,
	}, 22)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.3).Parent = name
	Kit.label({
		Text = potion.Text,
		Font = Theme.Font.Bold,
		TextColor3 = Theme.Color.Muted,
		Position = UDim2.fromScale(0.05, 0.52),
		Size = UDim2.fromScale(0.9, 0.08),
		Parent = card,
	}, 15)
	local owned = Kit.label({
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Gold,
		Position = UDim2.fromScale(0.05, 0.6),
		Size = UDim2.fromScale(0.9, 0.08),
		Parent = card,
	}, 15)
	local timer = Kit.label({
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = potion.Color,
		Position = UDim2.fromScale(0.05, 0.68),
		Size = UDim2.fromScale(0.9, 0.07),
		Parent = card,
	}, 14)
	local use = Kit.button("USE", potion.Color, potion.Color:Lerp(Color3.new(0, 0, 0), 0.45), {
		Position = UDim2.fromScale(0.06, 0.78),
		Size = UDim2.fromScale(0.42, 0.16),
		Parent = card,
	})
	use.Activated:Connect(function()
		local result = MetaClient.Call("UsePotion", potion.Id)
		if result.Ok then
			Sfx.Play("Impact", 1.5)
			Effects.Sparks(card, potion.Color, 16, 0.8)
			hint(`{potion.Name} running!`)
		else
			hint(MetaClient.Message(result))
		end
		Potions.Refresh()
	end)
	local buy = Kit.button("BUY", Theme.Color.Accent, Theme.Color.AccentDeep, {
		Position = UDim2.fromScale(0.52, 0.78),
		Size = UDim2.fromScale(0.42, 0.16),
		Parent = card,
	})
	buy.Activated:Connect(function()
		local result = MetaClient.Call("BuyPotion", potion.Id)
		if result.Ok then
			Sfx.Play("Click", 1.2)
			hint(`Bought a {potion.Name}`)
		else
			hint(MetaClient.Message(result))
		end
		Potions.Refresh()
	end)
	cards[potion.Id] = { Owned = owned, Timer = timer, Use = use, Buy = buy, Glow = glow }
	return card
end

function Potions.Init(playerGui: Instance)
	modal = Modal.new(playerGui, "PotionsGui", "POTIONS", Vector2.new(0.8, 0.8), Vector2.new(900, 560))

	summaryLabel = Kit.label({
		Text = "",
		RichText = true,
		Font = Theme.Font.Heavy,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 22),
		Parent = modal.Body,
	}, 17)
	hintLabel = Kit.label({
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Gold,
		TextTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -58, 0, 16),
		Size = UDim2.new(0.4, 0, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = modal.Header,
	}, 16)

	local grid = Kit.new("Frame", {
		Name = "Grid",
		Position = UDim2.new(0, 0, 0, 30),
		Size = UDim2.new(1, 0, 1, -48),
		BackgroundTransparency = 1,
		Parent = modal.Body,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10),
		}),
	})
	for i, potion in Meta.Potions do
		local card = potionCard(grid, potion, i)
		card.Size = UDim2.new(1 / #Meta.Potions, -10, 1, 0)
	end
	Kit.label({
		Text = "Potions of the same kind add time (up to 1 hour). Luck potions don't stack with each other: the strongest one counts. Timers only run while you're in the game.",
		Font = Theme.Font.Medium,
		TextColor3 = Theme.Color.Muted,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = modal.Body,
	}, 13)

	modal.OnOpen = Potions.Refresh
	State.Changed:Connect(Potions.Refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			Potions.Refresh()
		end
	end)
end

function Potions.Toggle()
	modal:Toggle()
end

return Potions
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Reveal</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The reveal ladder: every rarity gets a bigger show than the one below it.
--   Common / Uncommon  quick pop
--   Rare               coloured build-up pulse + light rays
--   Epic               + screen shake + sparks
--   Legendary          + longer build-up, gold flash, foil shimmer
--   Mythic             + full-screen cut-in banner
--   Secret             + blackout heartbeat, prismatic frame

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared.Rarity)
local Cards = require(Shared.Cards)
local Config = require(Shared.Config)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Effects = require(script.Parent.Effects)
local CardView = require(script.Parent.CardView)

local Reveal = {}

local gui: ScreenGui
local toastArea: Frame
local queue = {}
local running = false
local toastOrder = 0

local BUILD_PULSES = { Rare = 1, Epic = 2, Legendary = 3, Mythic = 3, Secret = 4 }

local function outcomeText(result): string
	local text
	if result.Outcome == "New" then
		text = "NEW CARD!"
	elseif result.Outcome == "Star" then
		text = `★ Star up!  {result.Stars}/{Config.MaxStars}`
	else
		text = `Max stars: +{result.ShardsGained} Shards`
	end
	if result.PityTriggered then
		text ..= "   ·   Pity guarantee"
	end
	return text
end

local function callout(parent: Instance, text: string, color: Color3, y: number, size: number, maxText: number)
	local label = Kit.label({
		Text = text,
		Font = Theme.Font.Display,
		TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, y),
		Size = UDim2.fromScale(0.8, size),
		ZIndex = 30,
		Parent = parent,
	}, maxText)
	Kit.textStroke(Color3.new(0, 0, 0), 3, 0.2).Parent = label
	local scale = Kit.new("UIScale", { Scale = 0.4, Parent = label })
	Kit.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	return label
end

-- Waits for a tween (or a number of seconds) unless the player hits SKIP.
local function waitFor(thing: any, skipped: () -> boolean) -- a Tween, or a number of seconds
	local deadline = if type(thing) == "number" then os.clock() + thing else nil
	while not skipped() do
		if deadline then
			if os.clock() >= deadline then
				return
			end
		elseif thing.PlaybackState ~= Enum.PlaybackState.Playing and thing.PlaybackState ~= Enum.PlaybackState.Begin then
			return
		end
		task.wait()
	end
end

local function pulse(scale: UIScale, period: number, amount: number, skipped: () -> boolean)
	waitFor(Kit.tween(scale, period * 0.5, { Scale = 1 + amount }, Enum.EasingStyle.Sine), skipped)
	waitFor(Kit.tween(scale, period * 0.5, { Scale = 1 }, Enum.EasingStyle.Sine), skipped)
end

local function cutInBanner(root: Instance, tier, skipped: () -> boolean)
	local banner = Kit.new("Frame", {
		Name = "CutIn",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(-0.7, 0.44),
		Size = UDim2.fromScale(1.4, 0.2),
		Rotation = -5,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 60,
		Parent = root,
	}, {
		Kit.gradient(ColorSequence.new(tier.Dark, tier.Color), 0),
	})
	local label = Kit.label({
		Text = string.upper(tier.Name),
		Font = Theme.Font.Display,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.5, 0.8),
		ZIndex = 61,
		Parent = banner,
	}, 110)
	Kit.textStroke(Color3.new(0, 0, 0), 4, 0.1).Parent = label
	waitFor(Kit.tween(banner, 0.3, { Position = UDim2.fromScale(0.5, 0.44) }, Enum.EasingStyle.Quart), skipped)
	if not skipped() then
		Effects.Shake(banner, 10, 0.4)
		waitFor(0.75, skipped)
		waitFor(Kit.tween(banner, 0.28, { Position = UDim2.fromScale(1.7, 0.44) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In), skipped)
	end
	banner:Destroy()
end

local function heartbeat(root: Instance, skipped: () -> boolean)
	local label = Kit.label({
		Text = "? ? ?",
		Font = Theme.Font.Display,
		TextColor3 = Color3.fromRGB(230, 220, 255),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.44),
		Size = UDim2.fromScale(0.5, 0.18),
		ZIndex = 60,
		Parent = root,
	}, 110)
	local scale = Kit.new("UIScale", { Scale = 1, Parent = label })
	for _ = 1, 3 do
		pulse(scale, 0.55, 0.25, skipped)
	end
	label:Destroy()
end

local function playFull(result)
	local card = Cards.Get(result.CardId)
	if card == nil then
		return
	end
	local tier = Rarity.Get(result.Rarity)
	local idx = tier.Index

	local root = Kit.new("Frame", {
		Name = "Reveal",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local dim = Kit.new("TextButton", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Color.Backdrop,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = root,
	})
	local dimTarget = if idx >= 7 then 0 elseif idx >= 5 then 0.15 else 0.35
	Kit.tween(dim, 0.25, { BackgroundTransparency = dimTarget })

	local stage = Kit.new("Frame", {
		Name = "Stage",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.44),
		Size = UDim2.fromScale(0.62, 0.6),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = root,
	})
	local holder = Kit.new("Frame", {
		Name = "Holder",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 10,
		Parent = stage,
	}, { Kit.aspect(0.72, Enum.DominantAxis.Height) })
	local scale = Kit.new("UIScale", { Scale = 0, Parent = holder })

	-- SKIP jumps straight to the card for the long build-ups (Rare and up).
	local skippedFlag = false
	local function skipped(): boolean
		return skippedFlag
	end
	local skipButton = nil
	if idx >= 3 then
		skipButton = Kit.button("SKIP  ▶▶", Theme.Color.PanelLight, Theme.Color.Panel, {
			Name = "Skip",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -24, 1, -24),
			Size = UDim2.fromOffset(130, 46),
			ZIndex = 80,
			Parent = root,
		})
		skipButton.Activated:Connect(function()
			skippedFlag = true
		end)
	end

	-- Mythic and Secret open with their own intro.
	if idx == 6 then
		cutInBanner(root, tier, skipped)
	elseif idx == 7 then
		heartbeat(root, skipped)
	end

	-- Face-down card drops in.
	local back = CardView.back()
	back.Parent = holder
	waitFor(Kit.tween(scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back), skipped)

	-- Build-up: the back glows in the tier's colour and pulses faster for rarer cards.
	local pulses = BUILD_PULSES[tier.Name]
	if pulses then
		local stroke = back:FindFirstChild("BackStroke")
		if stroke then
			Kit.tween(stroke, 0.3, { Color = tier.Color, Thickness = 6, Transparency = 0 })
		end
		local emblem = back:FindFirstChild("Emblem")
		if emblem then
			Kit.tween(emblem, 0.3, { BackgroundColor3 = tier.Color })
		end
		for i = 1, pulses do
			if skipped() then
				break
			end
			local period = math.max(0.22, 0.55 - i * 0.1)
			if idx >= 5 then
				Effects.Sparks(stage, tier.Color, 6, 0.35)
			end
			pulse(scale, period, 0.07 + i * 0.02, skipped)
		end
	else
		Kit.tween(holder, 0.07, { Rotation = -5 }).Completed:Wait()
		Kit.tween(holder, 0.07, { Rotation = 5 }).Completed:Wait()
		Kit.tween(holder, 0.07, { Rotation = 0 }).Completed:Wait()
	end
	if skipButton then
		skipButton:Destroy()
	end
	dim.BackgroundTransparency = dimTarget
	holder.Rotation = 0

	-- The reveal.
	local flashColor = if idx == 7 then Color3.new(1, 1, 1) else tier.Color
	Effects.Flash(root, flashColor, 0.4 + idx * 0.06, if idx >= 5 then 0 else 0.4)
	back:Destroy()
	local front = CardView.new(card.Id, { Owned = true, Stars = result.Stars, Animate = true })
	front.Parent = holder
	scale.Scale = 1.3
	Kit.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)

	if idx >= 3 then
		Effects.Rays(stage, if idx == 7 then Color3.new(1, 1, 1) else tier.Color, 4 + idx * 2)
	end
	if idx >= 4 then
		Effects.Shake(stage, 4 + (idx - 4) * 5, 0.45)
		Effects.Sparks(stage, tier.Color, 10 * (idx - 2), 0.75)
	end
	if idx >= 5 then
		Effects.Shimmer(front, 3)
	end
	if idx == 7 then
		local stroke = front:FindFirstChild("RarityStroke")
		local gradient = stroke and stroke:FindFirstChild("RarityGradient")
		if gradient then
			Effects.Spin(gradient, 140)
		end
	end

	-- Text under the card.
	local callSize = 0.06 + idx * 0.008
	callout(root, if idx >= 4 then string.upper(tier.Name) .. "!" else string.upper(tier.Name), tier.Color, 0.81, callSize, 70)
	local outcome = Kit.label({
		Text = outcomeText(result),
		Font = Theme.Font.Heavy,
		TextColor3 = if result.Outcome == "New" then Theme.Color.Gold else Theme.Color.Text,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.875),
		Size = UDim2.fromScale(0.7, 0.045),
		TextTransparency = 1,
		ZIndex = 30,
		Parent = root,
	}, 30)
	Kit.tween(outcome, 0.3, { TextTransparency = 0 })
	local hint = Kit.label({
		Text = "Tap to continue",
		Font = Theme.Font.Medium,
		TextColor3 = Theme.Color.Muted,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.925),
		Size = UDim2.fromScale(0.4, 0.03),
		TextTransparency = 1,
		ZIndex = 30,
		Parent = root,
	}, 20)
	task.delay(0.6, function()
		if hint.Parent then
			Kit.tween(hint, 0.3, { TextTransparency = 0.2 })
		end
	end)

	-- Close on tap, or by itself after a while.
	local shownAt = os.clock()
	local closeSignal = Instance.new("BindableEvent")
	local tapConnection = dim.Activated:Connect(function()
		if os.clock() - shownAt > 0.35 then
			closeSignal:Fire()
		end
	end)
	local autoClose = if idx <= 2 then 1.3 elseif idx == 3 then 2.2 else 6
	task.delay(autoClose, function()
		closeSignal:Fire()
	end)
	closeSignal.Event:Wait()
	tapConnection:Disconnect()
	closeSignal:Destroy()

	Kit.tween(scale, 0.18, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Kit.tween(dim, 0.2, { BackgroundTransparency = 1 })
	for _, child in root:GetDescendants() do
		if child:IsA("TextLabel") then
			Kit.tween(child, 0.15, { TextTransparency = 1 })
		end
	end
	task.wait(0.2)
	root:Destroy()
end

local function pump()
	if running then
		return
	end
	running = true
	task.spawn(function()
		while #queue > 0 do
			local item = table.remove(queue, 1)
			local ok, err = pcall(playFull, item.Result)
			if not ok then
				warn("Reveal failed:", err)
			end
			if item.OnDone then
				item.OnDone()
			end
		end
		running = false
	end)
end

function Reveal.Init(playerGui: Instance)
	gui = Kit.screenGui("RevealGui", 20, playerGui)
	gui.IgnoreGuiInset = true

	toastArea = Kit.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.7),
		Size = UDim2.fromScale(0.7, 0.16),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
end

function Reveal.IsBusy(): boolean
	return running or #queue > 0
end

-- Full reveal. Queued, so several can arrive at once (e.g. Auto Roll hits).
function Reveal.Full(result, onDone: (() -> ())?)
	table.insert(queue, { Result = result, OnDone = onDone })
	pump()
end

-- Fast pop near the buttons (Quick Roll and Auto Roll). Mythic and up always get the full show.
function Reveal.Quick(result)
	local card = Cards.Get(result.CardId)
	if card == nil then
		return
	end
	local tier = Rarity.Get(result.Rarity)
	if tier.Index >= 6 then
		Reveal.Full(result)
		return
	end

	toastOrder += 1
	local slot = Kit.new("Frame", {
		Name = "Toast",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		LayoutOrder = toastOrder,
		Parent = toastArea,
	}, { Kit.aspect(0.72, Enum.DominantAxis.Height) })
	local scale = Kit.new("UIScale", { Scale = 0, Parent = slot })
	local view = CardView.new(card.Id, { Owned = true, Stars = result.Stars, Compact = true })
	view.Parent = slot

	local badgeText = if result.Outcome == "New"
		then "NEW"
		elseif result.Outcome == "Star" then `★{result.Stars}`
		else `+{result.ShardsGained}`
	local badge = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.7, 0.16),
		BackgroundColor3 = if result.Outcome == "New" then Theme.Color.Gold else Theme.Color.PanelLight,
		ZIndex = 20,
		Parent = slot,
	}, { Kit.corner(UDim.new(0.5, 0)) })
	Kit.label({
		Text = badgeText,
		Font = Theme.Font.Heavy,
		TextColor3 = if result.Outcome == "New" then Color3.fromRGB(40, 24, 0) else Theme.Color.Text,
		Size = UDim2.fromScale(0.9, 0.8),
		Position = UDim2.fromScale(0.05, 0.1),
		ZIndex = 21,
		Parent = badge,
	}, 18)

	Kit.tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
	if tier.Index >= 4 then
		Effects.Flash(gui, tier.Color, 0.35, 0.65)
		Effects.Sparks(slot, tier.Color, 10, 0.9)
	end
	if tier.Index >= 5 then
		Effects.Shimmer(view, 1)
	end

	-- Keep at most five on screen.
	local toasts = {}
	for _, child in toastArea:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #toasts - 5 do
		toasts[i]:Destroy()
	end

	task.delay(if tier.Index >= 4 then 2.2 else 1.4, function()
		if slot.Parent == nil then
			return
		end
		Kit.tween(scale, 0.18, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
		slot:Destroy()
	end)
end

return Reveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">RewardReveal</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Boss reward reveal: the reward cards fan out face down and flip one by one, sorted so the
-- rarest flips last. Each flip applies the result to the client's state.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared.Rarity)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Effects = require(script.Parent.Effects)
local CardView = require(script.Parent.CardView)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.Parent.State)

local RewardReveal = {}

local function badgeText(result): string
	if result.Outcome == "New" then
		return "NEW"
	elseif result.Outcome == "Star" then
		return `★{result.Stars}`
	end
	return `+{result.ShardsGained}`
end

-- Cards keep a 0.72 shape by default; the grid cell already has that shape, so dropping the
-- constraint lets the flip squash the card sideways instead of shrinking it.
function RewardReveal.Unlock(card: Frame)
	local aspect = card:FindFirstChildOfClass("UIAspectRatioConstraint")
	if aspect then
		aspect:Destroy()
	end
end

-- NEW / ★ / Shards badge under a flipped card, and a ribbon on the first-clear bonus card.
function RewardReveal.Badges(slot, result)
	local badge = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(0.78, 0.15),
		BackgroundColor3 = if result.Outcome == "New" then Theme.Color.Gold else Theme.Color.PanelLight,
		ZIndex = 20,
		Parent = slot.Slot,
	}, { Kit.corner(UDim.new(0.5, 0)) })
	Kit.label({
		Text = badgeText(result),
		Font = Theme.Font.Heavy,
		TextColor3 = if result.Outcome == "New" then Color3.fromRGB(40, 24, 0) else Theme.Color.Text,
		Size = UDim2.fromScale(0.9, 0.8),
		Position = UDim2.fromScale(0.05, 0.1),
		ZIndex = 21,
		Parent = badge,
	}, 16)
	if result.Bonus then
		local ribbon = Kit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0),
			Size = UDim2.fromScale(1.05, 0.14),
			BackgroundColor3 = Theme.Color.Roll,
			ZIndex = 20,
			Parent = slot.Slot,
		}, { Kit.corner(UDim.new(0.5, 0)) })
		Kit.label({
			Text = "FIRST CLEAR",
			Font = Theme.Font.Heavy,
			Size = UDim2.fromScale(0.9, 0.8),
			Position = UDim2.fromScale(0.05, 0.1),
			ZIndex = 21,
			Parent = ribbon,
		}, 14)
	end
end

-- Plays the reveal inside `parent`. Calls onDone when every card has flipped.
function RewardReveal.Play(parent: Frame, rewards, onDone: (() -> ())?)
	local results = table.clone(rewards.Results or {})
	table.sort(results, function(a, b)
		local ra, rb = Rarity.Index(a.Rarity), Rarity.Index(b.Rarity)
		if ra ~= rb then
			return ra < rb
		end
		return (a.Bonus and 1 or 0) < (b.Bonus and 1 or 0)
	end)
	local count = #results
	-- The cards are already the player's: record them now, so leaving early loses nothing.
	for _, result in rewards.Results or {} do
		State.ApplyRoll(result)
	end
	if rewards.Summary then
		State.ApplyRoll({ Summary = rewards.Summary })
	end
	local columns = if count <= 7 then count else math.ceil(count / 2)
	local rows = math.ceil(count / math.max(1, columns))

	local area = Kit.new("Frame", {
		Name = "RewardCards",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local grid = Kit.new("UIGridLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = area,
	})
	local function size()
		local w, h = area.AbsoluteSize.X, area.AbsoluteSize.Y
		if w <= 0 then
			return
		end
		local gap = 8
		local cellW = math.floor((w - gap * (columns - 1)) / math.max(1, columns))
		local cellH = math.floor((h - gap * (rows - 1)) / math.max(1, rows))
		cellW = math.min(cellW, math.floor(cellH * 0.72), 130)
		grid.CellPadding = UDim2.fromOffset(gap, gap)
		grid.CellSize = UDim2.fromOffset(cellW, math.floor(cellW / 0.72))
	end
	area:GetPropertyChangedSignal("AbsoluteSize"):Connect(size)
	task.defer(size)

	-- Face-down cards deal in.
	local slots = {}
	for i = 1, count do
		local slot = Kit.new("Frame", {
			Name = `Reward{i}`,
			LayoutOrder = i,
			BackgroundTransparency = 1,
			Parent = area,
		})
		local holder = Kit.new("Frame", {
			Name = "Holder",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Parent = slot,
		})
		local scale = Kit.new("UIScale", { Scale = 0, Parent = holder })
		local back = CardView.back()
		RewardReveal.Unlock(back)
		back.Parent = holder
		slots[i] = { Slot = slot, Holder = holder, Scale = scale, Back = back }
		task.delay(i * 0.04, function()
			Kit.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end

	-- SKIP flips everything that's left at once.
	local skipped = false
	local skipButton = Kit.button("SKIP  ▶▶", Theme.Color.PanelLight, Theme.Color.Panel, {
		Name = "Skip",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 0, -2),
		Size = UDim2.fromOffset(110, 30),
		ZIndex = 30,
		Parent = parent,
	})
	skipButton.Activated:Connect(function()
		skipped = true
		skipButton.Visible = false
	end)

	task.spawn(function()
		task.wait(0.35 + count * 0.04)
		for i, result in results do
			if area.Parent == nil then
				return
			end
			local slot = slots[i]
			local tier = Rarity.Get(result.Rarity)
			local idx = tier.Index
			if skipped then
				slot.Back:Destroy()
				local front = CardView.new(result.CardId, { Owned = true, Stars = result.Stars, Compact = true })
				RewardReveal.Unlock(front)
				front.Parent = slot.Holder
				slot.Scale.Scale = 1
				slot.Holder.Size = UDim2.fromScale(1, 1)
				RewardReveal.Badges(slot, result)
				continue
			end
			-- Build-up for the rare ones.
			if idx >= 4 then
				local stroke = slot.Back:FindFirstChild("BackStroke")
				if stroke then
					Kit.tween(stroke, 0.25, { Color = tier.Color, Thickness = 6, Transparency = 0 })
				end
				Effects.Pulse(slot.Scale, 1, 0.3 + (idx - 4) * 0.08, 0.12)
			end
			-- Flip: squash to nothing, swap faces, spring back.
			Kit.tween(slot.Holder, 0.12, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
			slot.Back:Destroy()
			local front = CardView.new(result.CardId, { Owned = true, Stars = result.Stars, Compact = true })
			RewardReveal.Unlock(front)
			front.Parent = slot.Holder
			Kit.tween(slot.Holder, 0.2, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back)
			Sfx.Play("Click", 0.9 + idx * 0.08)
			RewardReveal.Badges(slot, result)
			if idx >= 3 then
				Effects.Sparks(slot.Slot, tier.Color, 6 + idx * 3, 0.9)
			end
			if idx >= 4 then
				Effects.Flash(parent, tier.Color, 0.35, 0.6)
			end
			if idx >= 5 then
				Effects.Shimmer(front, 2)
				Effects.Shake(parent, 4 + (idx - 5) * 4, 0.3)
				Sfx.Play("Impact", 1.2)
			end
			task.wait(if idx >= 5 then 0.5 elseif idx >= 4 then 0.32 else 0.16)
		end
		skipButton.Visible = false
		if onDone then
			onDone()
		end
	end)
	return area
end

return RewardReveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Sfx</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Sound effects. Only a handful of sounds ship with Roblox (rbxasset://sounds), so these are
-- placeholders: upload real hit / skill / reveal sounds and put their rbxassetid:// ids here.

local SoundService = game:GetService("SoundService")

local Sfx = {}

local SOUNDS = {
	Click = { Id = "rbxasset://sounds/volume_slider.ogg", Volume = 0.35 },
	Impact = { Id = "rbxasset://sounds/impact_explosion_03.mp3", Volume = 0.4 },
	Thud = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.45 },
}

local cache = {}

function Sfx.Play(name: string, pitch: number?)
	local def = SOUNDS[name]
	if def == nil then
		return
	end
	local sound = cache[name]
	if sound == nil then
		sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = def.Id
		sound.Volume = def.Volume
		sound.Parent = SoundService
		cache[name] = sound
	end
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

return Sfx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Shard Shop: permanent upgrades (faster rolls, more base luck). Potions are bought on the
-- POTIONS screen. The server checks every purchase (MetaService).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Meta = require(Shared.Meta)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Effects = require(script.Parent.Effects)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.Parent.State)
local MetaClient = require(script.Parent.Parent.MetaClient)

local Shop = {}

local modal
local balance: TextLabel
local hintLabel: TextLabel
local rows = {} -- [upgradeId] = refs
local hintToken = 0

local COLORS = {
	RollSpeed = Color3.fromRGB(80, 180, 255),
	Luck = Color3.fromRGB(86, 214, 138),
}

local function hint(text: string)
	hintToken += 1
	local token = hintToken
	hintLabel.Text = text
	hintLabel.TextTransparency = 0
	task.delay(2.2, function()
		if token == hintToken then
			Kit.tween(hintLabel, 0.4, { TextTransparency = 1 })
		end
	end)
end

-- "1.2s -> 1.1s" / "1.25x -> 1.30x"
local function effectText(upgrade, level: number): string
	if upgrade.Id == "RollSpeed" then
		local now = Config.Roll.Cooldown - level * upgrade.Step
		local nextValue = now - upgrade.Step
		return if level >= #upgrade.Costs
			then string.format("Roll cooldown %.1fs (max)", now)
			else string.format("Roll cooldown %.1fs  →  %.1fs", now, nextValue)
	end
	local now = level * upgrade.Step
	return if level >= #upgrade.Costs
		then string.format("+%.2fx base luck (max)", now)
		else string.format("+%.2fx base luck  →  +%.2fx", now, now + upgrade.Step)
end

function Shop.Refresh()
	if not modal or not modal.IsOpen then
		return
	end
	local shards = State.Summary.Shards or 0
	balance.Text = `💎 {Kit.commas(shards)} Shards`
	for id, refs in rows do
		local upgrade = Meta.UpgradeById[id]
		local level = State.Meta.Upgrades[id] or 0
		local cost = Meta.UpgradeCost(id, level)
		refs.Level.Text = `LEVEL {level} / {#upgrade.Costs}`
		refs.Effect.Text = effectText(upgrade, level)
		for i, pip in refs.Pips do
			pip.BackgroundColor3 = if i <= level then COLORS[id] else Theme.Color.Backdrop
		end
		if cost then
			refs.Buy.Label.Text = `UPGRADE  💎{Kit.commas(cost)}`
			refs.Buy.BackgroundTransparency = if shards >= cost then 0 else 0.6
		else
			refs.Buy.Label.Text = "MAXED"
			refs.Buy.BackgroundTransparency = 0.6
		end
	end
end

local function upgradeRow(parent: Instance, upgrade, order: number)
	local color = COLORS[upgrade.Id] or Theme.Color.Accent
	local row = Kit.new("Frame", {
		Name = upgrade.Id,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 104),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = parent,
	}, {
		Kit.corner(UDim.new(0, 16)),
		Kit.gradient(ColorSequence.new(color:Lerp(Theme.Color.Panel, 0.6), Theme.Color.Panel), 0),
		Kit.stroke(color, 2, 0.35),
	})
	local icon = Kit.new("Frame", {
		Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(76, 76),
		BackgroundColor3 = color,
		Parent = row,
	}, { Kit.corner(UDim.new(0.3, 0)), Kit.stroke(Color3.new(1, 1, 1), 2, 0.4) })
	Kit.label({
		Text = upgrade.Icon,
		Font = Theme.Font.Heavy,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.7),
		Parent = icon,
	}, 48)
	local name = Kit.label({
		Text = upgrade.Name,
		Font = Theme.Font.Display,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 100, 0, 10),
		Size = UDim2.new(0.5, 0, 0, 26),
		Parent = row,
	}, 26)
	Kit.textStroke(Color3.new(0, 0, 0), 1.5, 0.3).Parent = name
	local level = Kit.label({
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 100, 0, 38),
		Size = UDim2.new(0.3, 0, 0, 16),
		Parent = row,
	}, 14)
	local effect = Kit.label({
		Text = "",
		Font = Theme.Font.Bold,
		TextColor3 = Theme.Color.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 100, 0, 56),
		Size = UDim2.new(0.5, 0, 0, 18),
		Parent = row,
	}, 16)
	local pipFrame = Kit.new("Frame", {
		Position = UDim2.new(0, 100, 0, 80),
		Size = UDim2.new(0.5, 0, 0, 12),
		BackgroundTransparency = 1,
		Parent = row,
	}, {
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}),
	})
	local pips = {}
	for i = 1, #upgrade.Costs do
		pips[i] = Kit.new("Frame", {
			LayoutOrder = i,
			Size = UDim2.new(1 / #upgrade.Costs, -4, 1, 0),
			BackgroundColor3 = Theme.Color.Backdrop,
			Parent = pipFrame,
		}, { Kit.corner(UDim.new(1, 0)) })
	end
	local buy = Kit.button("UPGRADE", color, color:Lerp(Color3.new(0, 0, 0), 0.45), {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0.3, 0, 0, 52),
		Parent = row,
	})
	buy.Activated:Connect(function()
		local result = MetaClient.Call("BuyUpgrade", upgrade.Id)
		if result.Ok then
			Sfx.Play("Impact", 1.4)
			Effects.Sparks(row, color, 18, 0.8)
			hint(`{upgrade.Name} upgraded!`)
		else
			hint(MetaClient.Message(result))
		end
		Shop.Refresh()
	end)
	rows[upgrade.Id] = { Level = level, Effect = effect, Pips = pips, Buy = buy }
end

function Shop.Init(playerGui: Instance)
	modal = Modal.new(playerGui, "ShopGui", "SHARD SHOP", Vector2.new(0.66, 0.7), Vector2.new(760, 460))

	balance = Kit.label({
		Text = "",
		Font = Theme.Font.Display,
		TextColor3 = Color3.fromRGB(230, 200, 255),
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -70, 0, 4),
		Size = UDim2.new(0.34, 0, 0, 26),
		Parent = modal.Header,
	}, 24)
	Kit.textStroke(Color3.fromRGB(40, 14, 90), 2, 0).Parent = balance
	hintLabel = Kit.label({
		Text = "",
		Font = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Gold,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -70, 0, 32),
		Size = UDim2.new(0.4, 0, 0, 20),
		Parent = modal.Header,
	}, 16)

	local list = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = modal.Body,
	}, {
		Kit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }),
		Kit.new("UIPadding", { PaddingRight = UDim.new(0, 6) }),
	})
	for i, upgrade in Meta.Upgrades do
		upgradeRow(list, upgrade, i)
	end
	Kit.label({
		LayoutOrder = 10,
		Text = "Earn Shards from boss wins, gifts, the daily streak, Index rewards and duplicates past 5 stars. Potions are on the POTIONS screen.",
		Font = Theme.Font.Medium,
		TextColor3 = Theme.Color.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = false,
		TextSize = 14,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 18),
		Parent = list,
	}, 14)

	modal.OnOpen = Shop.Refresh
	State.Changed:Connect(Shop.Refresh)
end

function Shop.Toggle()
	modal:Toggle()
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Skin</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Image skins for the UI (art/UI_KIT_PROMPTS.md lists what to make).
-- Paste each uploaded asset id ("rbxassetid://123...") next to its key. Anything left empty keeps the
-- built-in look, so the game reskins piece by piece as images arrive.
--
-- Panels, banners, buttons and card frames are 9-sliced: Size is the image's pixel size, Margin how
-- many pixels at each edge stay unstretched (or MarginX / MarginY separately), Scale how big those
-- edges draw on screen (0.25 = a quarter).

local Skin = {}

-- Sizes and margins match the kit drawn in the "Anime Card Roll - UI Kit" Figma file (exported at 2x).
Skin.Images = {
	Panel = { Id = "rbxassetid://99549726104701", Size = Vector2.new(1024, 1024), Margin = 220, Scale = 0.22 },
	Banner = { Id = "rbxassetid://88017292818555", Size = Vector2.new(1024, 256), MarginX = 130, MarginY = 100, Scale = 0.3 },
	Close = { Id = "rbxassetid://133025751933251" }, -- stretched to fit
	ButtonPurple = { Id = "rbxassetid://91155976916866", Size = Vector2.new(1024, 384), Margin = 176, Scale = 0.2 },
	ButtonRed = { Id = "rbxassetid://83414148044207", Size = Vector2.new(1024, 384), Margin = 176, Scale = 0.2 },
	ButtonGreen = { Id = "rbxassetid://117800565483201", Size = Vector2.new(1024, 384), Margin = 176, Scale = 0.2 },
	ButtonBlue = { Id = "rbxassetid://91757618249539", Size = Vector2.new(1024, 384), Margin = 176, Scale = 0.2 },
	ButtonGold = { Id = "rbxassetid://109648775223698", Size = Vector2.new(1024, 384), Margin = 176, Scale = 0.2 },
	RollButton = { Id = "rbxassetid://134557607861668", Size = Vector2.new(1024, 512), Margin = 180, Scale = 0.25 },
	AutoButton = { Id = "rbxassetid://91673460322131", Size = Vector2.new(1024, 512), Margin = 180, Scale = 0.25 },
	QuickButton = { Id = "rbxassetid://89611639513414", Size = Vector2.new(1024, 512), Margin = 180, Scale = 0.25 },
	MenuButton = { Id = "rbxassetid://113764172105747", Size = Vector2.new(512, 512), Margin = 120, Scale = 0.3 },
}

-- Card frames by rarity, drawn over the card art (9-sliced so they fit tiles and tall cards).
Skin.Frames = {
	Common = "rbxassetid://110538208908575",
	Uncommon = "rbxassetid://139892795772037",
	Rare = "rbxassetid://83013583282176",
	Epic = "rbxassetid://123691093410661",
	Legendary = "rbxassetid://101806230893459",
	Mythic = "rbxassetid://102169641123682",
	Secret = "rbxassetid://85990645797859",
}
Skin.FrameSlice = { Size = Vector2.new(1024, 1024), Margin = 200, Scale = 0.12 }

-- Icons: menu buttons by their caption, plus currencies.
Skin.Icons = {
	BATTLE = "rbxassetid://71123240303125",
	DECK = "rbxassetid://136503784714496",
	INDEX = "rbxassetid://123000232647835",
	POTIONS = "rbxassetid://89341890216235",
	SHOP = "rbxassetid://98020168089759",
	GIFTS = "rbxassetid://126862775859746",
	FX = "rbxassetid://101163202245560",
	DEV = "rbxassetid://77762881503907",
	Shard = "rbxassetid://105504428224041",
	Luck = "rbxassetid://116998892373970",
}

local BUTTON_COLORS = {
	ButtonPurple = Color3.fromRGB(130, 90, 255),
	ButtonRed = Color3.fromRGB(255, 100, 80),
	ButtonGreen = Color3.fromRGB(86, 214, 138),
	ButtonBlue = Color3.fromRGB(64, 156, 255),
	ButtonGold = Color3.fromRGB(255, 196, 46),
}

local function image(id: string, slice): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = "Skin"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Image = id
	if slice and slice.Size then
		local mx = slice.MarginX or slice.Margin
		local my = slice.MarginY or slice.Margin
		label.ScaleType = Enum.ScaleType.Slice
		label.SliceCenter = Rect.new(mx, my, slice.Size.X - mx, slice.Size.Y - my)
		label.SliceScale = slice.Scale or 1
	else
		label.ScaleType = Enum.ScaleType.Stretch
	end
	return label
end

function Skin.Has(name: string): boolean
	local def = Skin.Images[name]
	return def ~= nil and def.Id ~= ""
end

-- Puts the named image behind `target`'s content and hides its built-in fill, gradient, outline and
-- gloss. Returns the image, or nil when that skin has no id yet (the built-in look stays).
function Skin.Apply(target: GuiObject, name: string): ImageLabel?
	local def = Skin.Images[name]
	if def == nil or def.Id == "" then
		return nil
	end
	target.BackgroundTransparency = 1
	for _, child in target:GetChildren() do
		if child:IsA("UIGradient") or child:IsA("UIStroke") then
			child.Enabled = false
		elseif child.Name == "Gloss" and child:IsA("GuiObject") then
			child.Visible = false
		end
	end
	local label = image(def.Id, def)
	label.ZIndex = 0 -- behind the button's own text and icons
	label.Parent = target
	return label
end

-- The button skin closest to a colour (the game's buttons are purple, red, green, blue or gold).
function Skin.ButtonFor(color: Color3): string
	local best, bestDistance = "ButtonPurple", math.huge
	for name, swatch in BUTTON_COLORS do
		local distance = (color.R - swatch.R) ^ 2 + (color.G - swatch.G) ^ 2 + (color.B - swatch.B) ^ 2
		if distance < bestDistance then
			best, bestDistance = name, distance
		end
	end
	return best
end

-- Draws the rarity's card frame over a card or tile; returns nil when there's no frame image yet.
function Skin.Frame(target: GuiObject, rarity: string, zIndex: number): ImageLabel?
	local id = Skin.Frames[rarity]
	if id == nil or id == "" then
		return nil
	end
	for _, child in target:GetChildren() do
		if child:IsA("UIStroke") then
			child.Enabled = false
		end
	end
	local label = image(id, Skin.FrameSlice)
	label.Name = "Frame"
	label.ZIndex = zIndex
	label.Parent = target
	return label
end

-- Loads every skin image once and returns the keys that failed (a wrong id, or an image still
-- waiting for Roblox moderation). Used in test mode so a broken id shows up in the Output.
function Skin.Verify(): { string }
	local ContentProvider = game:GetService("ContentProvider")
	local keyById = {}
	local ids = {}
	local function add(key: string, id: string)
		if id ~= "" then
			keyById[id] = key
			table.insert(ids, id)
		end
	end
	for key, def in Skin.Images do
		add(key, def.Id)
	end
	for key, id in Skin.Frames do
		add(`{key} frame`, id)
	end
	for key, id in Skin.Icons do
		add(`{key} icon`, id)
	end
	local failed = {}
	pcall(function()
		ContentProvider:PreloadAsync(ids, function(contentId: string, status: Enum.AssetFetchStatus)
			if status ~= Enum.AssetFetchStatus.Success then
				table.insert(failed, `{keyById[contentId] or "?"} ({contentId})`)
			end
		end)
	end)
	return failed
end

-- Replaces an emoji icon label with the uploaded icon image, if there is one.
function Skin.Icon(label: TextLabel, key: string): ImageLabel?
	local id = Skin.Icons[key]
	if id == nil or id == "" then
		return nil
	end
	local icon = Instance.new("ImageLabel")
	icon.Name = label.Name
	icon.BackgroundTransparency = 1
	icon.AnchorPoint = label.AnchorPoint
	icon.Position = label.Position
	icon.Size = label.Size
	icon.ZIndex = label.ZIndex
	icon.Image = id
	icon.ScaleType = Enum.ScaleType.Fit
	icon.Parent = label.Parent
	label:Destroy()
	return icon
end

return Skin
]]></string>
